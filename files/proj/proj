#!/usr/bin/env bash
# proj: one Incus box per project. The only tool to create, wipe, snapshot, back up or delete a box.
# Installed by ~/.dotfiles setup.sh step 70-hosting. Run with sudo. Rules: docs/HOSTING.md.
#
# Usage: sudo proj <command> [args]
#   new <name> --tier try|mvp|long [--repo URL] [--docker] [--pg] [--ttl 7d] [--owner WHO]
#   list                         all boxes and host projects
#   status <name>                details of one box or host project
#   shell <name>                 log in to the box as dev (tmux session "main")
#   snapshot <name> [label]      snapshot the box and its data volume
#   snapshots <name>             list snapshots
#   restore <name> <label>       go back to a snapshot (makes a pre-restore snapshot first)
#   fork <src> <new> [--tier try|mvp] [--ttl 3d]   instant copy of a box (and its workspace)
#   wipe <name> [--yes]          delete box and data. Refused for long and protected boxes.
#                                Asks about the workspace: kept in .trash unless you type delete
#   recreate <name> [--yes]      rebuild the system from scratch, keep /srv/data and the workspace
#   workspace <name>             give an older box its workspace (copies its /srv/app out first)
#   protect <name> | unprotect <name>   delete protection on or off (back on after 2 h)
#   promote <name> --to mvp|long  move a box up a tier
#   extend <name> <dur>          move the expiry date of a try box (dur: 7d, 12h)
#   backup <name> | --long       export box + data volume + workspace to BACKUP_DIR/boxes
#   expire                       daily job: warn, stop, then delete expired try boxes
#   registry                     rewrite /srv/proj/REGISTRY.md and REGISTRY.json
#   sync-rules <name> | --all    push the host's current agent rules + /etc/proj-box into boxes
#   doctor [--net]               health checks (--net: also run selftest)
#   selftest                     throwaway box: DHCP, DNS, internet, home gateway blocked, workspace
# Code of every box: the workspace /srv/proj/work/<box> on the host = /srv/app in the box.
set -euo pipefail
export LC_ALL=C.UTF-8

POOL=boxes
ETC=/etc/proj
HOST_PROJECTS=$ETC/host-projects
REGISTRY=/srv/proj/REGISTRY.md
REGISTRY_JSON=/srv/proj/REGISTRY.json
LOG=/var/log/proj.log
SHARE=/usr/local/share/proj
NOTIFY=/usr/local/sbin/discord-notify
# shellcheck source=/dev/null
[ -r /etc/server/host.env ] && . /etc/server/host.env
IMAGE=${PROJ_IMAGE:-images:ubuntu/26.04}
BACKUP_ROOT=${BACKUP_DIR:-/var/backups}/boxes
KEEP=${PROJ_BACKUP_KEEP:-7}
WORK_ROOT=${WORK_ROOT:-/srv/proj/work}
WS_GROUP=${SHARED_GROUP:-devs}
WS_ROOT_OWNER=root
BOX_UID=1000          # user dev in every box (box-bootstrap.sh)
# KEEP >= 1: 0 would delete every export, also the one just made.
[[ "$KEEP" =~ ^[0-9]+$ ]] && [ "$KEEP" -ge 1 ] || KEEP=1
YES=0

usage() { sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
die()  { echo "proj: $*" >&2; exit 1; }
say()  { echo "proj: $*"; }
now()  { date +%s; }
stamp() { date +%Y%m%d-%H%M; }
note() { printf '%s %s %s\n' "$(date -Is)" "${SUDO_USER:-root}" "$*" >> "$LOG"; }
notify() { [ -x "$NOTIFY" ] && "$NOTIFY" "$@" || true; }

need_root() { [ "$(id -u)" -eq 0 ] || die "run with sudo: sudo proj $*"; }

valid_name() {
    [[ "$1" =~ ^[a-z][a-z0-9-]{1,30}$ ]] || die "bad name '$1': lower case letters, digits and -, 2 to 31 chars, starts with a letter"
}

# Host projects (kind host): listed and checked, never touched.
host_line() { grep -m1 "^$1|" "$HOST_PROJECTS" 2>/dev/null || true; }
is_host()   { [ -n "$(host_line "$1")" ]; }
refuse_host() {
    if is_host "$1"; then
        die "'$1' is a protected HOST project. proj only lists, shows and checks it. It never changes it."
    fi
}

exists()  { incus query "/1.0/instances/$1" >/dev/null 2>&1; }
# Exact state (incus list NAME would also match names that start with NAME).
state_of() { incus query "/1.0/instances/$1/state" 2>/dev/null | jq -r '.status // "Unknown"'; }
need_box() { refuse_host "$1"; exists "$1" || die "no box named '$1' (see: proj list)"; }
key()     { incus config get "$1" "user.proj.$2" 2>/dev/null || true; }
setkey()  { incus config set "$1" "user.proj.$2=$3"; }
tier_of() { local t; t=$(key "$1" tier); echo "${t:-none}"; }
protected() { [ "$(incus config get "$1" security.protection.delete 2>/dev/null)" = true ]; }
has_vol() { incus storage volume show "$POOL" "custom/$1-data" >/dev/null 2>&1; }

# dur_s 7d|12h|30m -> seconds
dur_s() {
    case "$1" in
        *d) echo $(( ${1%d} * 86400 )) ;;
        *h) echo $(( ${1%h} * 3600 )) ;;
        *m) echo $(( ${1%m} * 60 )) ;;
        *) die "bad duration '$1' (use 7d, 12h or 30m)" ;;
    esac
}
day() { [ -n "${1:-}" ] && date -d "@$1" '+%F %H:%M' || echo "-"; }

# confirm NAME: typed confirmation. --yes skips it, except for long boxes.
confirm() {
    local name=$1 tier
    tier=$(tier_of "$name")
    if [ "$YES" = 1 ] && [ "$tier" != long ]; then return 0; fi
    local typed
    read -rp "Type the box name to confirm ($name): " typed
    [ "$typed" = "$name" ] || die "not confirmed"
}

vol_size() { case "$1" in long) echo 40GiB ;; *) echo 20GiB ;; esac; }
vol_expiry() { case "$1" in long) echo 7d ;; mvp) echo 3d ;; *) echo "" ;; esac; }

profiles_for() {  # tier docker
    local p="box-base,tier-$1"
    [ "$2" = yes ] && p="$p,docker"
    echo "$p"
}

# Data volume <box>-data on /srv/data (device "data"). Code and system are disposable, data is not.
add_volume() {
    local name=$1 tier=$2 path=${3:-/srv/data}
    if ! has_vol "$name"; then
        say "create data volume $name-data ($(vol_size "$tier"))"
        incus storage volume create "$POOL" "$name-data" "size=$(vol_size "$tier")"
    fi
    set_volume_schedule "$name" "$tier"
    incus storage volume attach "$POOL" "$name-data" "$name" data "$path"
}
set_volume_schedule() {
    local name=$1 tier=$2 exp
    exp=$(vol_expiry "$tier")
    has_vol "$name" || return 0
    if [ -n "$exp" ]; then
        incus storage volume set "$POOL" "$name-data" snapshots.schedule=@daily snapshots.expiry="$exp"
    fi
}

# ---- Workspace: the box's code on the HOST, /srv/app inside the box ----
# Host agents (MAIN_USER, AGENT_USER) edit the code in WORK_ROOT/<box> with their normal tools;
# it builds and runs only in the box (proj-agent exec). Disk device "app" with shift=true: an
# idmapped mount. The box sees host uid N as its uid N, so MAIN_USER (uid 1000) is dev (uid 1000)
# in the box and the shared group keeps its gid. The box processes keep their own isolated ID
# range (security.idmap.isolated): nothing in the box runs as a host user. Not in box snapshots.
ws_dir() { echo "$WORK_ROOT/$1"; }
ws_source() { incus query "/1.0/instances/$1" 2>/dev/null | jq -r '.devices.app.source // empty'; }
ws_gid() { getent group "$WS_GROUP" | cut -d: -f3; }

# ws_check: the ids must line up, or the code would not belong to dev in the box.
ws_check() {
    local uid gid
    [ -n "${MAIN_USER:-}" ] && id "$MAIN_USER" >/dev/null 2>&1 \
        || die "MAIN_USER (/etc/server/host.env) is empty or does not exist: no workspace possible"
    gid=$(ws_gid || true)
    [ -n "$gid" ] || die "group $WS_GROUP is missing (setup.sh step 70 makes it)"
    uid=$(id -u "$MAIN_USER")
    [ "$uid" = "$BOX_UID" ] || die "$MAIN_USER has uid $uid, not $BOX_UID. shift=true shows host uid N as uid N in the box, so the code would not belong to dev. See docs/HOSTING.md (Workspace)."
    [ "$gid" -lt 65536 ] || die "group $WS_GROUP has gid $gid: a box sees only ids below 65536"
}

# ws_root: WORK_ROOT, root:WS_GROUP 750. Only proj makes folders in it; the group may look inside.
ws_root() {
    mkdir -p "$WORK_ROOT"
    chown "$WS_ROOT_OWNER:$WS_GROUP" "$WORK_ROOT"
    chmod 750 "$WORK_ROOT"
}

# ws_acl DIR: group WS_GROUP may write, and new files and folders inherit that (default ACL).
# The default ACL also beats every umask, so a file made by dev in the box stays group-writable.
ws_acl() {
    setfacl -m "g:$WS_GROUP:rwx" "$1"
    setfacl -d -m "u::rwx,g::rwx,g:$WS_GROUP:rwx,o::rx" "$1"
}

# ws_make NAME: WORK_ROOT/NAME, MAIN_USER:WS_GROUP 2775 + default ACL. An existing one is kept.
ws_make() {
    local d
    d=$(ws_dir "$1")
    ws_root
    if [ -d "$d" ]; then
        say "workspace $d exists: kept (it is /srv/app again)"
    else
        say "workspace $d (the code; /srv/app in the box)"
        mkdir "$d"
    fi
    chown "$MAIN_USER:$WS_GROUP" "$d"
    chmod 2775 "$d"
    ws_acl "$d"
}

# ws_attach NAME: disk device "app" = WORK_ROOT/NAME at /srv/app. A fork carries its source's
# device: then only the source path is changed.
ws_attach() {
    local d src
    d=$(ws_dir "$1")
    src=$(ws_source "$1")
    if [ -z "$src" ]; then
        incus config device add "$1" app disk source="$d" path=/srv/app shift=true >/dev/null
    elif [ "$src" != "$d" ]; then
        incus config device set "$1" app source="$d"
    fi
}

# ws_copy_out NAME: a box made before workspaces keeps its code inside the box. Copy /srv/app out
# into the (empty) workspace. As root on the host, so: no owners or setuid bits from the box,
# links are never followed, then everything belongs to MAIN_USER:WS_GROUP.
ws_copy_out() {
    local name=$1 d
    d=$(ws_dir "$name")
    if [ -n "$(ls -A "$d")" ]; then
        say "workspace $d is not empty: nothing copied from the box"
        return 0
    fi
    if [ "$(state_of "$name")" != Running ]; then
        say "WARN: $name is not running: its old /srv/app was NOT copied to $d"
        return 0
    fi
    incus exec "$name" -- test -d /srv/app || return 0
    say "copy $name:/srv/app -> $d"
    incus exec "$name" -- tar -C /srv/app -cf - . | tar -C "$d" -xf - --no-same-owner --no-same-permissions
    find "$d" -xdev ! -type l -exec chown "$MAIN_USER:$WS_GROUP" {} +
    find "$d" -xdev ! -type l \( -perm -4000 -o -perm -2000 \) -exec chmod ug-s {} +
    find "$d" -xdev ! -type l -perm -g=r -exec chmod g+w {} +
    find "$d" -xdev -type d -exec chmod g+s {} +
}

# ws_ask NAME: before a wipe. Sets WS_DROP=yes only when the owner types "delete".
# --yes, no answer or anything else: the workspace is kept (moved to .trash).
WS_DROP=no
ws_ask() {
    local d ans=""
    d=$(ws_dir "$1")
    WS_DROP=no
    [ -d "$d" ] || return 0
    [ "$YES" != 1 ] || return 0
    read -rp "Workspace $d (code, .env): Enter keeps it in $WORK_ROOT/.trash, or type delete: " ans || true
    if [ "$ans" = delete ]; then WS_DROP=yes; fi
}

# ws_trash NAME: move the workspace to WORK_ROOT/.trash/<name>-<date> (root only). Never deleted.
ws_trash() {
    local d t
    d=$(ws_dir "$1")
    [ -d "$d" ] || return 0
    mkdir -p "$WORK_ROOT/.trash"
    chown root:root "$WORK_ROOT/.trash" 2>/dev/null || true
    chmod 700 "$WORK_ROOT/.trash"
    t="$WORK_ROOT/.trash/$1-$(stamp)"
    [ ! -e "$t" ] || t="$t-$(date +%S)"
    mv -- "$d" "$t"
    say "workspace kept: $t"
}

# ws_dispose NAME: after a wipe (or expire, which never asks): trash, or delete when asked to.
ws_dispose() {
    local d
    d=$(ws_dir "$1")
    [ -d "$d" ] || return 0
    if [ "$WS_DROP" = yes ]; then
        rm -rf -- "$d"
        note "workspace deleted $d"
        say "workspace deleted: $d"
    else
        ws_trash "$1"
    fi
}

bootstrap() {  # name docker pg
    say "bootstrap $1 (user dev, tools$([ "$2" = yes ] && echo ', docker')$([ "$3" = yes ] && echo ', postgres'))"
    incus file push "$SHARE/box-bootstrap.sh" "$1/root/box-bootstrap.sh" --mode 0755
    # Last two: the shared group, so dev in the box may write files that AGENT_USER made.
    incus exec "$1" -- bash /root/box-bootstrap.sh "$1" "$2" "$3" "$(ws_gid)" "$WS_GROUP"
}

host_name() { echo "${SERVER_NAME:-$(hostname)}"; }

# push_text BOX PATH MODE < content: a root-owned file inside the box.
push_text() {
    local tmp rc=0
    tmp=$(mktemp)
    cat > "$tmp"
    incus file push "$tmp" "$1$2" --mode "$3" --uid 0 --gid 0 || rc=1
    rm -f "$tmp"
    return "$rc"
}

# /etc/proj-box: "where am I?" for agents inside the box (key=value, root 644).
box_marker() {
    local name=$1
    push_text "$name" /etc/proj-box 0644 <<EOF
# Written by proj on the host $(host_name). You are INSIDE a box, not on the host.
# Agent rules: /etc/proj-rules/AGENTS.md. Do not edit: proj rewrites this file.
name=$name
tier=$(tier_of "$name")
owner=$(key "$name" owner)
created=$(day "$(key "$name" created)")
host=$(host_name)
EOF
}

# house_rules: print MAIN_USER's ~/.dotfiles-ai/ai/AGENTS.md, read AS that user, never as root
# (a symlink to a root-only file must not end up in a box). Returns 1 when there is none.
house_rules() {
    local user=${MAIN_USER:-} home
    [ -n "$user" ] && id "$user" >/dev/null 2>&1 || return 1
    home=$(getent passwd "$user" | cut -d: -f6 || true)
    [ -n "$home" ] || return 1
    runuser -u "$user" -- test -f "$home/.dotfiles-ai/ai/AGENTS.md" || return 1
    runuser -u "$user" -- cat -- "$home/.dotfiles-ai/ai/AGENTS.md"
}

# push_rules BOX: /etc/proj-rules/AGENTS.md (root 644) = house rules + AGENTS-hosting.md, and a
# ~/.config/ai/AGENTS.md link for dev. Only these two text files go in: never ~/.claude, ~/.codex
# or any other credential folder of the host.
push_rules() {
    local name=$1 hosting=$SHARE/AGENTS-hosting.md tmp size have_house=yes
    [ -r "$hosting" ] || { say "WARN: $hosting is missing (setup.sh step 70)"; return 1; }
    tmp=$(mktemp)
    {
        echo "<!-- Copied by proj from the host $(host_name) on $(date '+%F %H:%M'). Read-only."
        echo "     Refresh, on the host: sudo proj sync-rules $name -->"
        echo
        if ! house_rules; then have_house=no; fi
        echo
        cat "$hosting"
    } > "$tmp"
    [ "$have_house" = yes ] || say "WARN: no ~${MAIN_USER:-?}/.dotfiles-ai/ai/AGENTS.md on the host: only the hosting rules go in"
    size=$(wc -c < "$tmp")
    [ "$size" -le 32768 ] || say "WARN: rules are $size bytes; Codex reads only the first 32 KiB"
    incus exec "$name" -- install -d -m 755 -o root -g root /etc/proj-rules || { rm -f "$tmp"; return 1; }
    push_text "$name" /etc/proj-rules/AGENTS.md 0644 < "$tmp" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    if incus exec "$name" -- id dev >/dev/null 2>&1; then
        # A file dev made by hand is kept; only a missing file or our own link is (re)written.
        incus exec "$name" -- su -l dev -c 'f=$HOME/.config/ai/AGENTS.md
            if [ -e "$f" ] && [ "$(readlink "$f")" != /etc/proj-rules/AGENTS.md ]; then
                echo "proj: $f is dev'"'"'s own file: kept (rules are in /etc/proj-rules/AGENTS.md)"
            else
                mkdir -p "$HOME/.config/ai" && ln -sfn /etc/proj-rules/AGENTS.md "$f"
            fi' || return 1
    fi
    say "rules pushed to $name:/etc/proj-rules/AGENTS.md$([ "$have_house" = yes ] && echo ' (house rules + hosting rules)')"
}

# marker_and_rules BOX: after new / recreate. A failure warns; the box itself is fine.
marker_and_rules() {
    box_marker "$1" || say "WARN: /etc/proj-box not written. Later: sudo proj sync-rules $1"
    push_rules "$1" || say "WARN: rules not pushed. Later: sudo proj sync-rules $1"
}

clone_and_setup() {  # name repo
    local name=$1 repo=$2
    [ -n "$repo" ] || return 0
    if incus exec "$name" -- test -d /srv/app/.git; then
        say "/srv/app already has a git checkout"
    elif [ -n "$(incus exec "$name" -- ls -A /srv/app 2>/dev/null)" ]; then
        say "WARN: /srv/app (the workspace) has files but no git checkout: $repo not cloned"
    else
        say "clone $repo into /srv/app"
        incus exec "$name" -- su -l dev -c "git clone '$repo' /srv/app"
    fi
    if incus exec "$name" -- test -f /srv/app/box/setup.sh; then
        say "run box/setup.sh from the repo"
        incus exec "$name" -- bash /srv/app/box/setup.sh
    fi
}

launch() {  # name tier docker
    say "launch $1 from $IMAGE (profiles $(profiles_for "$2" "$3"))"
    local args=() p
    IFS=, read -ra plist <<< "$(profiles_for "$2" "$3")"
    for p in "${plist[@]}"; do args+=(-p "$p"); done
    if ! incus launch "$IMAGE" "$1" "${args[@]}"; then
        die "launch failed. If it says the project memory limit is reached: proj list, then wipe or archive something."
    fi
}

cmd_new() {
    local name="" tier="" repo="" docker=no pg=no ttl=7d owner=${SUDO_USER:-root}
    name=${1:-}; shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --tier) tier=$2; shift 2 ;;
            --repo) repo=$2; shift 2 ;;
            --docker) docker=yes; shift ;;
            --pg) pg=yes; shift ;;
            --ttl) ttl=$2; shift 2 ;;
            --owner) owner=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    [ -n "$name" ] || usage 2
    valid_name "$name"
    case "$tier" in try|mvp|long) ;; *) die "--tier try|mvp|long is required" ;; esac
    refuse_host "$name"
    exists "$name" && die "a box named '$name' already exists"
    has_vol "$name" && die "a data volume $name-data already exists (left from an old box?)"
    ws_check

    launch "$name" "$tier" "$docker"
    ws_make "$name"
    ws_attach "$name"
    setkey "$name" tier "$tier"
    setkey "$name" owner "$owner"
    setkey "$name" created "$(now)"
    setkey "$name" docker "$docker"
    setkey "$name" pg "$pg"
    [ -z "$repo" ] || setkey "$name" repo "$repo"
    [ "$tier" != try ] || setkey "$name" expires $(( $(now) + $(dur_s "$ttl") ))
    if [ "$tier" != try ] || [ "$pg" = yes ]; then add_volume "$name" "$tier"; fi
    bootstrap "$name" "$docker" "$pg"
    marker_and_rules "$name"
    clone_and_setup "$name" "$repo"
    if [ "$tier" = long ]; then
        incus config set "$name" security.protection.delete=true
        cmd_backup "$name"
    fi
    note "new $name tier=$tier docker=$docker pg=$pg repo=${repo:-none}"
    cmd_registry >/dev/null
    say "ready. Code: $(ws_dir "$name") on the host (/srv/app in the box). Log in: sudo proj shell $name"
}

cmd_list() {
    printf '%-24s %-8s %-6s %-10s %-17s %-5s %s\n' NAME STATE TIER OWNER EXPIRES PROT "RAM USED"
    incus list -f json | jq -r '.[] | [
        .name, .status,
        (.config["user.proj.tier"] // "none"),
        (.config["user.proj.owner"] // "-"),
        (.config["user.proj.expires"] // ""),
        (if .config["security.protection.delete"] == "true" then "yes" else "no" end),
        ((((.state // {}).memory // {}).usage // 0) / 1048576 | floor | tostring) + " MB"
    ] | @tsv' | while IFS=$'\t' read -r n s t o e p m; do
        printf '%-24s %-8s %-6s %-10s %-17s %-5s %s\n' "$n" "$s" "$t" "$o" "$(day "$e")" "$p" "$m"
    done
    if [ -s "$HOST_PROJECTS" ]; then
        echo
        echo "Host projects (protected, proj never changes them):"
        while IFS='|' read -r n t u d; do
            [ -n "$n" ] && [ "${n:0:1}" != "#" ] || continue
            printf '  %-22s tier %-5s unit %-28s %s\n' "$n" "$t" "${u:--}" "$d"
        done < "$HOST_PROJECTS"
    fi
}

cmd_status() {
    local name=${1:?name}
    if is_host "$name"; then
        IFS='|' read -r n t u d <<< "$(host_line "$name")"
        echo "$n: HOST project, tier $t, protected. $d"
        [ -z "$u" ] || systemctl status --no-pager --lines=0 "$u" || true
        return 0
    fi
    exists "$name" || die "no box named '$name'"
    incus info "$name" | sed -n '1,/^Resources/p'
    incus config show "$name" | grep -E 'user\.proj\.|security\.protection|^profiles:|^- ' || true
    has_vol "$name" && echo "data volume: $name-data on /srv/data" || echo "data volume: none"
    local ws
    ws=$(ws_source "$name")
    if [ -n "$ws" ]; then echo "workspace: $ws on the host = /srv/app in the box"
    else echo "workspace: none, code only inside the box (sudo proj workspace $name)"; fi
}

cmd_shell() {
    need_box "${1:?name}"
    exec incus exec "$1" -- su -l dev -c 'tmux new -A -s main'
}

cmd_snapshot() {
    need_box "${1:?name}"
    local label=${2:-manual-$(stamp)}
    incus snapshot create "$1" "$label"
    if has_vol "$1"; then incus storage volume snapshot create "$POOL" "$1-data" "$label"; fi
    note "snapshot $1 $label"
    say "snapshot $label made (box$(has_vol "$1" && echo ' + data'))"
    [ -z "$(ws_source "$1")" ] || say "the workspace $(ws_dir "$1") (/srv/app) is on the host: not in the snapshot. Commit the code."
}

cmd_snapshots() {
    need_box "${1:?name}"
    echo "box $1:"; incus snapshot list "$1"
    if has_vol "$1"; then echo "data $1-data:"; incus storage volume snapshot list "$POOL" "$1-data"; fi
}

cmd_restore() {
    local name=${1:?name} label=${2:?usage: proj restore <name> <label>}
    need_box "$name"
    say "restore $name to snapshot $label. Changes since then are lost (a pre-restore snapshot is made first)."
    [ -z "$(ws_source "$name")" ] || say "the workspace $(ws_dir "$name") (/srv/app) is not in snapshots: it stays as it is now"
    confirm "$name"
    cmd_snapshot "$name" "pre-restore-$(stamp)"
    incus stop "$name" --timeout 60 2>/dev/null || incus stop "$name" --force
    incus snapshot restore "$name" "$label"
    if has_vol "$name"; then incus storage volume snapshot restore "$POOL" "$name-data" "$label"; fi
    incus start "$name"
    note "restore $name $label"
    cmd_registry >/dev/null
}

cmd_fork() {
    local src=${1:?source} new=${2:?new name} tier=try ttl=3d
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --tier) tier=$2; shift 2 ;;
            --ttl) ttl=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    need_box "$src"
    valid_name "$new"
    refuse_host "$new"
    exists "$new" && die "'$new' already exists"
    case "$tier" in try|mvp) ;; *) die "a fork is try or mvp" ;; esac
    ws_check
    [ ! -e "$(ws_dir "$new")" ] || die "a workspace $(ws_dir "$new") already exists (move it away first)"
    local snap docker sws
    snap="pre-fork-$(stamp)"
    docker=$(key "$src" docker)
    cmd_snapshot "$src" "$snap"
    incus copy "$src/$snap" "$new"
    incus config set "$new" security.protection.delete=false
    if ! incus profile assign "$new" "$(profiles_for "$tier" "${docker:-no}")"; then
        say "WARN: the fork does not fit tier $tier limits (disk too full?): it keeps the profiles of $src"
    fi
    if has_vol "$src"; then
        incus storage volume copy "$POOL/$src-data/$snap" "$POOL/$new-data"
        incus config device set "$new" data source="$new-data"
    fi
    # The fork gets its own copy of the workspace, as it is NOW (workspaces are not in snapshots).
    # A source without a workspace (made earlier) keeps its code inside the box: so does the fork.
    sws=$(ws_source "$src")
    if [ -n "$sws" ]; then
        [ -d "$sws" ] || die "workspace $sws of $src is missing on the host"
        say "copy workspace $sws -> $(ws_dir "$new")"
        cp -a -- "$sws" "$(ws_dir "$new")"
        ws_make "$new"
        ws_attach "$new"
    else
        say "$src has no workspace, so $new has none either (later: sudo proj workspace $new)"
    fi
    setkey "$new" tier "$tier"
    setkey "$new" owner "${SUDO_USER:-root}"
    setkey "$new" created "$(now)"
    setkey "$new" forked_from "$src"
    incus config unset "$new" user.proj.last_backup 2>/dev/null || true
    if [ "$tier" = try ]; then setkey "$new" expires $(( $(now) + $(dur_s "$ttl") )); fi
    incus start "$new"
    # The copy carries the source's /etc/proj-box: rewrite it with the fork's own name and tier.
    box_marker "$new" || say "WARN: /etc/proj-box of $new not updated. Later: sudo proj sync-rules $new"
    note "fork $src -> $new tier=$tier"
    cmd_registry >/dev/null
    say "fork ready: sudo proj shell $new  (throw it away with: sudo proj wipe $new)"
}

cmd_wipe() {
    local name=${1:?name}
    [ "${2:-}" = --yes ] && YES=1
    need_box "$name"
    [ "$(tier_of "$name")" != long ] || die "'$name' is tier long. Long boxes are never wiped. To remove one: unprotect, then archive by hand (docs/HOSTING.md)."
    protected "$name" && die "'$name' is protected. sudo proj unprotect $name first."
    say "WIPE $name: the box$(has_vol "$name" && echo ', its data volume') and all snapshots are deleted. No undo."
    confirm "$name"
    ws_ask "$name"
    incus delete --force "$name"
    if has_vol "$name"; then incus storage volume delete "$POOL" "$name-data"; fi
    ws_dispose "$name"
    note "wipe $name"
    cmd_registry >/dev/null
    say "wiped $name"
}

cmd_recreate() {
    local name=${1:?name}
    [ "${2:-}" = --yes ] && YES=1
    need_box "$name"
    local tier docker pg repo owner created expires was_protected=no
    tier=$(tier_of "$name"); docker=$(key "$name" docker); pg=$(key "$name" pg)
    repo=$(key "$name" repo); owner=$(key "$name" owner); created=$(key "$name" created)
    expires=$(key "$name" expires)
    ws_check
    say "RECREATE $name: the system is rebuilt from $IMAGE. /srv/data and the workspace $(ws_dir "$name") are kept. Box snapshots are lost."
    confirm "$name"
    if [ "$tier" = long ]; then cmd_backup "$name"; fi
    # An older box keeps its code inside the box: save it into the workspace before the rebuild.
    if [ -z "$(ws_source "$name")" ]; then ws_make "$name"; ws_copy_out "$name"; fi
    protected "$name" && was_protected=yes
    incus stop "$name" --timeout 60 2>/dev/null || incus stop "$name" --force 2>/dev/null || true
    if has_vol "$name"; then incus config device remove "$name" data; fi
    incus config set "$name" security.protection.delete=false
    incus delete "$name"
    launch "$name" "$tier" "${docker:-no}"
    ws_make "$name"
    ws_attach "$name"
    setkey "$name" tier "$tier"; setkey "$name" owner "${owner:-root}"; setkey "$name" created "${created:-$(now)}"
    setkey "$name" docker "${docker:-no}"; setkey "$name" pg "${pg:-no}"
    [ -z "$repo" ] || setkey "$name" repo "$repo"
    [ -z "$expires" ] || setkey "$name" expires "$expires"
    if has_vol "$name"; then incus storage volume attach "$POOL" "$name-data" "$name" data /srv/data; fi
    bootstrap "$name" "${docker:-no}" "${pg:-no}"
    marker_and_rules "$name"
    clone_and_setup "$name" "$repo"
    if [ "$was_protected" = yes ] || [ "$tier" = long ]; then
        incus config set "$name" security.protection.delete=true
    fi
    note "recreate $name"
    cmd_registry >/dev/null
    say "recreated $name"
}

# workspace NAME: give an older box (made before workspaces) its workspace. Its /srv/app is copied
# out first, then the workspace is mounted over it. Running services keep the old files open:
# restart them after.
cmd_workspace() {
    local name=${1:?name}
    need_box "$name"
    ws_check
    if [ -n "$(ws_source "$name")" ]; then
        say "$name already has its workspace: $(ws_source "$name")"
        return 0
    fi
    [ "$(state_of "$name")" = Running ] || die "$name is not running. Start it first: sudo incus start $name"
    ws_make "$name"
    ws_copy_out "$name"
    ws_attach "$name"
    note "workspace $name"
    cmd_registry >/dev/null
    say "$name: /srv/app is now $(ws_dir "$name"). Restart its services (they still hold the old files)."
}

cmd_protect() {
    need_box "${1:?name}"
    incus config set "$1" security.protection.delete=true
    systemctl stop "proj-reprotect-$1.timer" 2>/dev/null || true
    note "protect $1"
    cmd_registry >/dev/null
    say "$1 is protected: Incus refuses to delete it, proj refuses to wipe it"
}

cmd_unprotect() {
    local name=${1:?name}
    need_box "$name"
    say "UNPROTECT $name. A fresh backup is made first. Protection comes back by itself in 2 h."
    YES=0 confirm "$name"
    cmd_backup "$name"
    incus config set "$name" security.protection.delete=false
    systemctl stop "proj-reprotect-$name.timer" 2>/dev/null || true
    systemctl reset-failed "proj-reprotect-$name.service" 2>/dev/null || true
    systemd-run --unit="proj-reprotect-$name" --on-active=2h /usr/local/sbin/proj protect "$name" >/dev/null
    note "unprotect $name (back on in 2 h)"
    cmd_registry >/dev/null
}

cmd_promote() {
    local name=${1:?name} to=""
    [ "${2:-}" = --to ] && to=${3:-}
    need_box "$name"
    local from rank_from rank_to docker
    from=$(tier_of "$name")
    rank() { case "$1" in try) echo 1 ;; mvp) echo 2 ;; long) echo 3 ;; *) echo 0 ;; esac; }
    rank_from=$(rank "$from"); rank_to=$(rank "$to")
    [ "$rank_to" -gt 0 ] || die "usage: proj promote <name> --to mvp|long"
    [ "$rank_to" -gt "$rank_from" ] || die "$name is already $from. Promote only goes up."
    docker=$(key "$name" docker)
    incus profile assign "$name" "$(profiles_for "$to" "${docker:-no}")"
    if ! has_vol "$name"; then
        # Move what is in /srv/data now onto the new volume.
        add_volume "$name" "$to" /mnt/proj-newdata
        incus exec "$name" -- sh -c 'cp -a /srv/data/. /mnt/proj-newdata/ 2>/dev/null || true'
        incus config device remove "$name" data
        incus storage volume attach "$POOL" "$name-data" "$name" data /srv/data
    else
        incus storage volume set "$POOL" "$name-data" size="$(vol_size "$to")" 2>/dev/null || true
        set_volume_schedule "$name" "$to"
    fi
    setkey "$name" tier "$to"
    if [ "$(state_of "$name")" = Running ]; then
        box_marker "$name" || say "WARN: /etc/proj-box not updated. Later: sudo proj sync-rules $name"
    fi
    incus config unset "$name" user.proj.expires 2>/dev/null || true
    if [ "$to" = long ]; then
        incus config set "$name" security.protection.delete=true
        cmd_backup "$name"
    fi
    note "promote $name $from -> $to"
    cmd_registry >/dev/null
    say "$name is now $to"
}

cmd_extend() {
    local name=${1:?name} dur=${2:?duration, e.g. 7d}
    need_box "$name"
    [ "$(tier_of "$name")" = try ] || die "only try boxes expire"
    setkey "$name" expires $(( $(now) + $(dur_s "$dur") ))
    incus config unset "$name" user.proj.warned 2>/dev/null || true
    incus config unset "$name" user.proj.stopped_at 2>/dev/null || true
    note "extend $name $dur"
    cmd_registry >/dev/null
    say "$name now expires $(day "$(key "$name" expires)")"
}

# Export the box (no snapshots) and its data volume, zstd. Postgres inside is dumped first.
# Each export is written to .partial-<file> and renamed only when complete and tested, so a
# half-written file never counts as a backup (or pushes a good one out of the KEEP window).
backup_one() {
    local name=$1 dir st
    dir=$BACKUP_ROOT/$name
    st=$(date +%F-%H%M)
    install -d -m 700 "$dir"
    rm -f -- "$dir"/.partial-*
    if [ "$(key "$name" pg)" = yes ] && [ "$(state_of "$name")" = Running ]; then
        say "pg_dumpall inside $name -> /srv/data/backups/pg-dumpall.sql"
        incus exec "$name" -- sh -c 'install -d -m 700 /srv/data/backups && runuser -u postgres -- pg_dumpall > /srv/data/backups/pg-dumpall.sql'
    fi
    say "export $name -> $dir/$st-instance.tar.zst"
    incus export "$name" "$dir/.partial-$st-instance.tar.zst" --instance-only --compression zstd \
        || { rm -f -- "$dir/.partial-$st-instance.tar.zst"; die "export of $name failed"; }
    zstd -tq "$dir/.partial-$st-instance.tar.zst" \
        || { rm -f -- "$dir/.partial-$st-instance.tar.zst"; die "backup of $name is broken, removed"; }
    mv -- "$dir/.partial-$st-instance.tar.zst" "$dir/$st-instance.tar.zst"
    if has_vol "$name"; then
        say "export $name-data -> $dir/$st-data.tar.zst"
        incus storage volume export "$POOL" "$name-data" "$dir/.partial-$st-data.tar.zst" --volume-only --compression zstd \
            || { rm -f -- "$dir/.partial-$st-data.tar.zst"; die "export of $name-data failed"; }
        zstd -tq "$dir/.partial-$st-data.tar.zst" \
            || { rm -f -- "$dir/.partial-$st-data.tar.zst"; die "backup of $name-data is broken, removed"; }
        mv -- "$dir/.partial-$st-data.tar.zst" "$dir/$st-data.tar.zst"
    fi
    # The workspace (/srv/app) lives on the host, so incus export does not hold it: tar it.
    # tar exit 1 = a file changed while it was read (a live box): still a usable archive.
    local ws rc=0
    ws=$(ws_source "$name")
    if [ -n "$ws" ] && [ -d "$ws" ]; then
        say "archive workspace $ws -> $dir/$st-work.tar.zst"
        tar -C "$(dirname "$ws")" --zstd -cf "$dir/.partial-$st-work.tar.zst" "$(basename "$ws")" || rc=$?
        [ "$rc" -le 1 ] || { rm -f -- "$dir/.partial-$st-work.tar.zst"; die "archive of workspace $ws failed"; }
        zstd -tq "$dir/.partial-$st-work.tar.zst" \
            || { rm -f -- "$dir/.partial-$st-work.tar.zst"; die "archive of workspace $ws is broken, removed"; }
        mv -- "$dir/.partial-$st-work.tar.zst" "$dir/$st-work.tar.zst"
    fi
    # Keep the newest $KEEP backups of each kind.
    local kind f all
    for kind in instance data work; do
        mapfile -t all < <(ls -1 "$dir"/*-"$kind".tar.zst 2>/dev/null | sort)
        for ((i = 0; i < ${#all[@]} - KEEP; i++)); do rm -f -- "${all[$i]}"; done
    done
    setkey "$name" last_backup "$(now)"
    note "backup $name"
    du -sh "$dir" | sed 's/^/proj: /'
}

cmd_backup() {
    local target=${1:?name or --long}
    if [ "$target" = --long ]; then
        local n failed=0
        for n in $(incus list -f json | jq -r '.[] | select(.config["user.proj.tier"] == "long") | .name'); do
            ( backup_one "$n" ) || failed=1   # one broken box does not stop the others
        done
        cmd_registry >/dev/null
        [ "$failed" = 0 ] || die "some long backups failed"
        return 0
    fi
    if is_host "$target"; then
        say "$target is a host project: its own jobs back it up (for example pg-backup). Nothing to do."
        return 0
    fi
    need_box "$target"
    backup_one "$target"
}

# Daily: 2 days before expiry a note, at expiry stop, 3 days after stop delete. try boxes only.
cmd_expire() {
    local n exp t stopped
    t=$(now)
    for n in $(incus list -f json | jq -r '.[] | select(.config["user.proj.tier"] == "try") | .name'); do
        exp=$(key "$n" expires)
        [ -n "$exp" ] || continue
        stopped=$(key "$n" stopped_at)
        if [ -n "$stopped" ] && [ "$t" -ge $(( stopped + 3 * 86400 )) ]; then
            if protected "$n"; then say "$n expired but is protected: kept"; continue; fi
            incus delete --force "$n"
            if has_vol "$n"; then incus storage volume delete "$POOL" "$n-data"; fi
            WS_DROP=no ws_dispose "$n"
            note "expire: deleted $n"
            notify info "proj: box $n deleted" "try box expired $(day "$exp"), stopped 3 days ago"
        elif [ -z "$stopped" ] && [ "$t" -ge "$exp" ]; then
            incus stop "$n" --timeout 60 2>/dev/null || incus stop "$n" --force 2>/dev/null || true
            setkey "$n" stopped_at "$t"
            note "expire: stopped $n"
            notify info "proj: box $n stopped (expired)" "deleted in 3 days. Keep it: sudo proj extend $n 7d && sudo incus start $n"
        elif [ -z "$(key "$n" warned)" ] && [ "$t" -ge $(( exp - 2 * 86400 )) ]; then
            setkey "$n" warned "$t"
            notify info "proj: box $n expires $(day "$exp")" "keep it: sudo proj extend $n 7d, or promote it"
        fi
    done
    cmd_registry >/dev/null
}

cmd_registry() {
    install -d -m 755 "$(dirname "$REGISTRY")"
    local tmp
    tmp=$(mktemp)
    {
        echo "# Project registry"
        echo
        echo "Generated by proj on $(date '+%F %H:%M'). Do not edit: run \`sudo proj registry\`."
        echo "Rules: ~/.dotfiles docs/HOSTING.md. Same data for scripts: REGISTRY.json next to this file."
        echo
        echo "| Box | Tier | State | Owner | Created | Expires | Protected | Data volume | Repo | Last backup |"
        echo "|---|---|---|---|---|---|---|---|---|---|"
        incus list -f json | jq -r '.[] | [ .name, (.config["user.proj.tier"] // "none"), .status,
            (.config["user.proj.owner"] // "-"), (.config["user.proj.created"] // ""),
            (.config["user.proj.expires"] // ""), (.config["security.protection.delete"] // "false"),
            (.config["user.proj.repo"] // "-"), (.config["user.proj.last_backup"] // "") ] | @tsv' \
        | while IFS=$'\t' read -r n t s o c e p r b; do
            echo "| $n | $t | $s | $o | $(day "$c") | $(day "$e") | $p | $(has_vol "$n" && echo "$n-data" || echo -) | $r | $(day "$b") |"
        done
        if [ -s "$HOST_PROJECTS" ]; then
            echo
            echo "## Host projects (protected: proj never changes them)"
            echo
            echo "| Name | Tier | Unit | Notes |"
            echo "|---|---|---|---|"
            while IFS='|' read -r n t u d; do
                [ -n "$n" ] && [ "${n:0:1}" != "#" ] || continue
                echo "| $n | $t | ${u:--} | $d |"
            done < "$HOST_PROJECTS"
        fi
    } > "$tmp"
    install -m 644 "$tmp" "$REGISTRY"
    registry_json > "$tmp"
    install -m 644 "$tmp" "$REGISTRY_JSON"
    rm -f "$tmp"
    echo "$REGISTRY"
}

# host_projects_json: the host-projects file as a JSON array.
host_projects_json() {
    [ -s "$HOST_PROJECTS" ] || { echo '[]'; return 0; }
    awk '!/^[[:space:]]*#/ && NF' "$HOST_PROJECTS" | jq -R -s -c 'split("\n") | map(select(length > 0)
        | split("|") | {name: .[0], tier: (.[1] // null),
          unit: (if (.[2] // "") == "" then null else .[2] end), notes: (.[3:] | join("|"))})'
}

# registry_json: the same facts as REGISTRY.md, for scripts and agents. Times in UTC ISO 8601.
registry_json() {
    local vols
    vols=$(incus storage volume list "$POOL" -f json 2>/dev/null | jq -c '[.[] | select(.type == "custom") | .name]' || echo '[]')
    incus list -f json | jq --arg gen "$(date -Is)" --arg host "$(host_name)" \
        --argjson vols "${vols:-[]}" --argjson hp "$(host_projects_json)" '
        def t: if . == null or . == "" then null else (tonumber | todate) end;
        { generated: $gen, host: $host,
          boxes: [ .[] | .name as $n | {
              name: $n, state: .status,
              tier: (.config["user.proj.tier"] // null),
              owner: (.config["user.proj.owner"] // null),
              created: (.config["user.proj.created"] | t),
              expires: (.config["user.proj.expires"] | t),
              protected: (.config["security.protection.delete"] == "true"),
              data_volume: (if any($vols[]; . == ($n + "-data")) then $n + "-data" else null end),
              repo: (.config["user.proj.repo"] // null),
              workspace: (.devices.app.source // null),
              forked_from: (.config["user.proj.forked_from"] // null),
              last_backup: (.config["user.proj.last_backup"] | t) } ],
          host_projects: $hp }'
}

# sync-rules: refresh /etc/proj-box and /etc/proj-rules/AGENTS.md from the host's current files.
cmd_sync_rules() {
    local target=${1:-} n failed=0
    [ -n "$target" ] || die "usage: proj sync-rules <name> | --all"
    if [ "$target" = --all ]; then
        for n in $(incus list -f json | jq -r '.[] | select(.config["user.proj.tier"] != null) | .name'); do
            if [ "$(state_of "$n")" != Running ]; then
                say "$n is not running: skipped (sync it after: sudo incus start $n)"
                continue
            fi
            if box_marker "$n" && push_rules "$n"; then :; else say "WARN: $n not synced"; failed=1; fi
        done
        note "sync-rules --all"
        [ "$failed" = 0 ] || die "some boxes were not synced (see WARN above)"
        return 0
    fi
    need_box "$target"
    [ "$(state_of "$target")" = Running ] || die "$target is not running. Start it first: sudo incus start $target"
    box_marker "$target" || die "/etc/proj-box not written to $target"
    push_rules "$target" || die "rules not pushed to $target"
    note "sync-rules $target"
}

# Launch a throwaway try box and prove the network: DHCP address, DNS, internet out,
# and no way into the home network gateway. The box is always deleted at the end.
cmd_selftest() {
    local n ip="" gw port i fail=0
    n="proj-selftest-$(date +%s | tail -c 7)"
    say "selftest: launch $n (box-base + tier-try), check network, then delete it"
    if ! incus launch "$IMAGE" "$n" -p box-base -p tier-try >/dev/null; then
        die "selftest: launch failed (image $IMAGE? memory budget full? see: incus project info default)"
    fi
    trap 'incus delete --force "'"$n"'" >/dev/null 2>&1 || true; rm -rf -- "'"$WORK_ROOT/.selftest-$n"'"' EXIT
    for i in $(seq 1 30); do
        ip=$(incus query "/1.0/instances/$n/state" 2>/dev/null \
            | jq -r '[.network.eth0.addresses[]? | select(.family == "inet") | .address][0] // empty')
        [ -z "$ip" ] || break
        sleep 2
    done
    if [ -n "$ip" ]; then echo "ok    DHCP address $ip"; else echo "FAIL  no DHCP address after 60 s"; fail=1; fi
    if incus exec "$n" -- getent hosts archive.ubuntu.com >/dev/null 2>&1; then
        echo "ok    DNS works"
    else
        echo "FAIL  DNS does not resolve"; fail=1
    fi
    if incus exec "$n" -- timeout 5 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>/dev/null; then
        echo "ok    internet (1.1.1.1:443) reachable"
    else
        echo "FAIL  no internet from the box"; fail=1
    fi
    # Only a real connection counts as a leak (a closed port on the router also fails).
    gw=$(ip route show default | awk '{print $3; exit}')
    if [ -n "$gw" ]; then
        local leak=0
        for port in 80 443 53; do
            if incus exec "$n" -- timeout 3 bash -c "exec 3<>/dev/tcp/$gw/$port" 2>/dev/null; then
                echo "FAIL  the box reaches the home gateway $gw:$port (egress ACL not working)"
                leak=1; fail=1
            fi
        done
        [ "$leak" = 1 ] || echo "ok    home gateway $gw not reachable from the box"
    fi
    selftest_workspace "$n" || fail=1
    incus delete --force "$n" >/dev/null 2>&1 || true
    rm -rf -- "$WORK_ROOT/.selftest-$n"
    trap - EXIT
    [ "$fail" = 0 ] && echo "selftest: all ok" || { echo "selftest: FAILED"; return 1; }
}

# selftest_workspace BOX: mount a throwaway workspace at /srv/app (as proj new does) and prove the
# round trip: a file made on the host by MAIN_USER is readable and writable by uid 1000 (dev) in
# the box, a file made in the box belongs to MAIN_USER:WS_GROUP on the host, and AGENT_USER and
# dev (with the shared group) can write each other's files.
selftest_workspace() {
    local n=$1 ws msg gid fail=0
    ws="$WORK_ROOT/.selftest-$n"
    if ! msg=$(ws_check 2>&1); then echo "FAIL  workspace: ${msg#proj: }"; return 1; fi
    gid=$(ws_gid)
    ws_root
    mkdir "$ws"
    chown "$MAIN_USER:$WS_GROUP" "$ws"
    chmod 2775 "$ws"
    ws_acl "$ws"
    if ! incus config device add "$n" app disk source="$ws" path=/srv/app shift=true >/dev/null; then
        echo "FAIL  workspace: disk device with shift=true refused (idmapped mounts? incus info | grep idmapped_mounts)"
        return 1
    fi
    runuser -u "$MAIN_USER" -- sh -c 'echo host > "$1/from-host"' sh "$ws"
    if incus exec "$n" --user "$BOX_UID" --group "$BOX_UID" -- sh -c \
        '[ "$(stat -c %u /srv/app/from-host)" = '"$BOX_UID"' ] && grep -qx host /srv/app/from-host && echo box >> /srv/app/from-host && echo box > /srv/app/from-box' 2>/dev/null; then
        echo "ok    workspace: host file is uid $BOX_UID (dev) in the box, readable and writable there"
    else
        echo "FAIL  workspace: a file made on the host is not owned or not writable by uid $BOX_UID in the box"; fail=1
    fi
    if [ "$(stat -c %U:%G "$ws/from-box" 2>/dev/null)" = "$MAIN_USER:$WS_GROUP" ] && grep -qx box "$ws/from-host" \
        && runuser -u "$MAIN_USER" -- sh -c 'echo host >> "$1/from-box"' sh "$ws" 2>/dev/null; then
        echo "ok    workspace: box file is $MAIN_USER:$WS_GROUP on the host, writable there"
    else
        echo "FAIL  workspace: a file made in the box is not $MAIN_USER:$WS_GROUP or not writable on the host"; fail=1
    fi
    if [ -n "${AGENT_USER:-}" ] && id "$AGENT_USER" >/dev/null 2>&1; then
        if runuser -u "$AGENT_USER" -- sh -c 'echo agent >> "$1/from-box" && echo agent > "$1/from-agent"' sh "$ws" 2>/dev/null \
            && incus exec "$n" --user "$BOX_UID" --group "$gid" -- sh -c 'echo box >> /srv/app/from-agent' 2>/dev/null; then
            echo "ok    workspace: $AGENT_USER and dev (group $WS_GROUP) write each other's files"
        else
            echo "FAIL  workspace: $AGENT_USER and dev cannot write each other's files (group $WS_GROUP, default ACL)"; fail=1
        fi
    fi
    return "$fail"
}

cmd_doctor() {
    local bad=0 n
    ok()   { echo "ok    $*"; }
    fail() { echo "FAIL  $*"; bad=1; }
    systemctl is-active -q incus && ok "incus running" || fail "incus not running"
    local cap
    cap=$(zpool list -H -o capacity "$POOL" 2>/dev/null | tr -d '%' || true)
    if [ -z "$cap" ]; then fail "zpool $POOL missing"
    elif [ "$cap" -ge 80 ]; then fail "pool $POOL ${cap}% full"
    else ok "pool $POOL ${cap}% full"; fi
    zpool status -x "$POOL" 2>/dev/null | grep -q 'is healthy' && ok "pool $POOL healthy" || fail "pool $POOL not healthy (zpool status $POOL)"
    ok "ZFS ARC now $(awk '/^size/ {printf "%.1f GiB", $3/1073741824}' /proc/spl/kstat/zfs/arcstats 2>/dev/null)"
    if systemctl is-active -q docker; then
        # Same rules as files/sbin/incus-docker-fix: box traffic handed to ufw (RETURN), replies accepted.
        if iptables -C DOCKER-USER -i incusbr0 -j RETURN 2>/dev/null \
            && iptables -C DOCKER-USER -o incusbr0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; then
            ok "DOCKER-USER hands box traffic to ufw and accepts replies"
        else
            fail "DOCKER-USER rules for incusbr0 missing: boxes have no network (systemctl restart incus-docker-fix)"
        fi
    fi
    local budget used
    budget=$(incus project get default limits.memory 2>/dev/null || true)
    used=$(incus list -f json | jq -r '[.[] | (.expanded_config["limits.memory"] // "0") |
        if endswith("GiB") then (sub("GiB$"; "") | tonumber)
        elif endswith("MiB") then ((sub("MiB$"; "") | tonumber) / 1024)
        else 0 end] | add // 0' 2>/dev/null || echo "?")
    ok "memory caps: ${used} GiB of ${budget:-no limit}"
    local t ws
    t=$(now)
    if [ "$(stat -c %U:%G:%a "$WORK_ROOT" 2>/dev/null)" = "root:$WS_GROUP:750" ]; then
        ok "workspace root $WORK_ROOT (root:$WS_GROUP 750)"
    else
        fail "workspace root $WORK_ROOT missing or not root:$WS_GROUP 750 (setup.sh step 70)"
    fi
    if [ -d "$WORK_ROOT/.trash" ] && [ -n "$(ls -A "$WORK_ROOT/.trash")" ]; then
        echo "info  $WORK_ROOT/.trash: $(ls -A "$WORK_ROOT/.trash" | wc -l) old workspace(s), $(du -sh "$WORK_ROOT/.trash" | cut -f1) (empty it by hand)"
    fi
    for n in $(incus list -f json | jq -r '.[].name'); do
        local tier exp b
        tier=$(tier_of "$n"); exp=$(key "$n" expires); b=$(key "$n" last_backup)
        [ "$tier" != none ] || fail "$n has no tier (made by hand? proj does not know it)"
        ws=$(ws_source "$n")
        if [ -z "$ws" ]; then
            [ "$tier" = none ] || fail "$n has no workspace at /srv/app (sudo proj workspace $n)"
        elif [ ! -d "$ws" ]; then
            fail "$n: workspace $ws is missing on the host"
        fi
        if [ -n "$exp" ] && [ "$t" -ge "$exp" ] && [ "$(state_of "$n")" = Running ]; then
            fail "$n expired $(day "$exp") but runs"
        fi
        if [ "$tier" = long ]; then
            protected "$n" || fail "$n is long but NOT protected"
            if [ -z "$b" ] || [ "$t" -ge $(( b + 26 * 3600 )) ]; then fail "$n is long, last backup $(day "$b")"
            else ok "$n backup $(day "$b")"; fi
        fi
    done
    if [ -s "$HOST_PROJECTS" ]; then
        local hn ht hu hd
        while IFS='|' read -r hn ht hu hd; do
            [ -n "$hn" ] && [ "${hn:0:1}" != "#" ] || continue
            exists "$hn" && fail "host project $hn ALSO exists as a box"
            if [ -n "$hu" ]; then
                systemctl is-active -q "$hu" && ok "host project $hn: $hu active" || fail "host project $hn: $hu not active"
            else
                ok "host project $hn registered"
            fi
        done < "$HOST_PROJECTS"
    fi
    if [ "${1:-}" = --net ]; then
        cmd_selftest || bad=1
    else
        echo "info  network test of a fresh box: sudo proj doctor --net"
    fi
    [ "$bad" = 0 ] && echo "doctor: all ok" || { echo "doctor: problems above"; return 1; }
}

main() {
    local cmd=${1:-}
    [ -n "$cmd" ] || usage 2
    shift
    case "$cmd" in -h|--help|help) usage 0 ;; esac
    need_root "$cmd"
    command -v incus >/dev/null || die "incus is not installed (setup.sh step 70-hosting)"
    case "$cmd" in
        new) cmd_new "$@" ;;
        list|ls) cmd_list ;;
        status) cmd_status "$@" ;;
        shell) cmd_shell "$@" ;;
        snapshot) cmd_snapshot "$@" ;;
        snapshots) cmd_snapshots "$@" ;;
        restore) cmd_restore "$@" ;;
        fork) cmd_fork "$@" ;;
        wipe|rm) cmd_wipe "$@" ;;
        recreate|reset) cmd_recreate "$@" ;;
        workspace) cmd_workspace "$@" ;;
        protect) cmd_protect "$@" ;;
        unprotect) cmd_unprotect "$@" ;;
        promote) cmd_promote "$@" ;;
        extend) cmd_extend "$@" ;;
        backup) cmd_backup "$@" ;;
        expire) cmd_expire ;;
        registry) cmd_registry ;;
        sync-rules) cmd_sync_rules "$@" ;;
        doctor) cmd_doctor "$@" ;;
        selftest) cmd_selftest ;;
        *) die "unknown command '$cmd' (sudo proj --help)" ;;
    esac
}

# PROJ_LIB=1: load the functions only (tests/proj-workspace.test.sh). Runs nothing.
[ "${PROJ_LIB:-}" = 1 ] || main "$@"
