#!/bin/bash -p
# proj-agent: the ONLY root command AI agents may run. A strict allow-list in front of proj,
# journalctl, systemctl and incus. Every other root action: ask the owner.
# Installed by setup.sh step 70-hosting (root:root 755). Two ways in, same checks:
#   proj-agent ...       no sudo (works in sandboxes): a normal user's call goes through the root
#                        socket service /run/proj-agent.sock (proj-agent-socket), group devs only
#   sudo proj-agent ...  the older way (sudoers zzz-agents-proj), still works
#
# Usage: proj-agent <command> [args]
#   new <name> --tier try|mvp [--docker] [--pg]   new box (tier long: ask the owner)
#   list                          all boxes and host projects
#   snapshot <name>               snapshot a box, its data volume and its workspace
#   doctor                        proj health checks (no network test, no box is made)
#   logs <unit> [-n N]            host journal of one unit, last N lines (1 to 2000, default 200)
#   logs box <name> [-n N]        journal inside a box, last N lines ("box" is never a unit here)
#   status <unit>                 systemctl status of one host unit (read only)
#   restart <box> <service>       restart a systemd service INSIDE the box (never a host unit)
#   exec <box> [--cwd DIR] [--timeout S] -- <command...>
#                                 run a command INSIDE the box as dev (uid 1000), never as root,
#                                 in DIR (default /srv/app), stopped after S seconds (default 600,
#                                 at most 3600). The words after -- are joined and run by bash -lc
#   ports <box>                   listening ports inside the box
#   url <box> [port]              how to reach a service in the box from this host (box IP:port)
#   help                          this text
# Names: lower case letters, digits and -, 2 to 31 chars, starting with a letter (as proj).
# Units and services: letters, digits and @ . _ -, starting with a letter or digit.
# Host projects (/etc/proj/host-projects) are refused for every box command.
# The code of a box is /srv/proj/work/<box> on the host (= /srv/app in the box): edit it there,
# run it with exec. Nothing here opens a port to the LAN.
# Every call is logged to /var/log/proj-agent.log (who, what, result; exec command cut to 300).
#
# Why /bin/bash -p and not env: this runs as root; no lookup through a PATH set by the caller,
# and -p makes bash ignore BASH_ENV, SHELLOPTS and exported functions from the environment.
# It does not trust sudo for its environment either: PATH is fixed here and every child
# starts from an empty environment (env -i) with only the variables listed in child().

set -euo pipefail
IFS=$' \t\n'
umask 027
export LC_ALL=C                # the regexes below are ASCII-only in the C locale
unset CDPATH GLOBIGNORE 2>/dev/null || true

SAFE_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CALLER_PATH=${PATH:-}
PATH=$SAFE_PATH
export PATH
LOG=/var/log/proj-agent.log
HOST_PROJECTS=/etc/proj/host-projects
PROJ=/usr/local/sbin/proj
CHILD_HOME=/root
MAX_LINES=2000
DEFAULT_LINES=200
EXEC_TIMEOUT=600
EXEC_MAX_TIMEOUT=3600
EXEC_LOG_MAX=300
BOX_UID=1000            # user dev in every box (box-bootstrap.sh)

NAME_RE='^[a-z][a-z0-9-]{1,30}$'
UNIT_RE='^[A-Za-z0-9][A-Za-z0-9@._-]{0,127}$'
LINES_RE='^[1-9][0-9]{0,3}$'
USER_RE='^[a-z_][a-z0-9_-]{0,31}$'
ARG_RE='^[A-Za-z0-9@._-]{1,128}$'
CWD_RE='^/[A-Za-z0-9@._/+-]{0,255}$'
SECS_RE='^[1-9][0-9]{0,3}$'
PORT_RE='^[1-9][0-9]{0,4}$'

usage() { sed -n '9,31p' "$0" | sed 's/^# \{0,1\}//'; }

# Offline tests only: a NORMAL user with PROJ_AGENT_TEST=1 may point the tools, log and host list
# at fakes. As root (that is, under sudo) all of this is ignored.
if [ "$(id -u)" -ne 0 ]; then
    if [ "${PROJ_AGENT_TEST:-}" = 1 ]; then
        PATH=$CALLER_PATH
        LOG=${PROJ_AGENT_LOG:?PROJ_AGENT_LOG must be set in test mode}
        HOST_PROJECTS=${PROJ_AGENT_HOST_PROJECTS:-/dev/null}
        PROJ=$(command -v proj) || { echo "proj-agent: test mode: no proj on PATH" >&2; exit 1; }
        CHILD_HOME=${HOME:-/}
    else
        case "${1:-}" in help|-h|--help|"") usage; exit 0 ;; esac
        # A normal user: the root service does the work (it checks the caller by the kernel's
        # peer uid and runs this same script as root). No sudo, so it works under no_new_privs.
        exec /usr/bin/python3 -I /usr/local/lib/proj-agent/proj-agent-socket call "$@"
    fi
fi

WHO=root
VIA=sudo
if [ -n "${PROJ_AGENT_CALLER:-}" ] && [ "$(id -u)" -eq 0 ]; then
    # Set only by proj-agent-socket (from SO_PEERCRED). sudo's env_reset drops it, so a sudo
    # caller cannot pretend to be someone else.
    VIA=socket
    if [[ $PROJ_AGENT_CALLER =~ $USER_RE ]]; then WHO=$PROJ_AGENT_CALLER; else WHO=unknown; fi
elif [ -n "${SUDO_USER:-}" ]; then
    if [[ $SUDO_USER =~ $USER_RE ]]; then WHO=$SUDO_USER; else WHO=unknown; fi
fi

# The call as one log-safe line: every argument quoted with printf %q (no raw newlines).
# For exec, the command after -- is logged as one string, cut to EXEC_LOG_MAX characters.
ARGS_Q=""
quote_args() {
    local a after=0 rest=""
    for a in "$@"; do
        if [ "$after" = 1 ]; then rest="${rest:+$rest }$a"; continue; fi
        ARGS_Q="$ARGS_Q $(printf '%q' "$a")"
        if [ "$1" = exec ] && [ "$a" = -- ]; then after=1; fi
    done
    if [ "$after" = 1 ]; then
        if [ "${#rest}" -gt "$EXEC_LOG_MAX" ]; then rest="${rest:0:$EXEC_LOG_MAX}...cut"; fi
        ARGS_Q="$ARGS_Q $(printf '%q' "$rest")"
    fi
    ARGS_Q=${ARGS_Q# }
}
quote_args "$@"

logline() {
    printf '%s user=%s via=%s args=[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$WHO" "$VIA" "$ARGS_Q" "$1" >> "$LOG"
}

# refuse MSG: log it, explain it, exit 2. Nothing has run.
refuse() {
    logline "result=refused reason=$(printf '%q' "$1")" 2>/dev/null || true
    echo "proj-agent: refused: $1" >&2
    echo "proj-agent: allowed commands: proj-agent help. For anything else, give the owner the exact command." >&2
    exit 2
}

# child CMD...: run one allowed command as root with a clean, fixed environment, stdin closed.
# The pager can never open: --no-pager everywhere, plus empty SYSTEMD_PAGER and PAGER=cat.
# Returns the command's exit code (and logs it).
child() {
    local rc=0
    env -i PATH="$PATH" HOME="$CHILD_HOME" LC_ALL=C.UTF-8 LANG=C.UTF-8 TERM=dumb \
        SYSTEMD_PAGER= SYSTEMD_PAGERSECURE=1 SYSTEMD_COLORS=0 PAGER=cat LESSSECURE=1 \
        SUDO_USER="$WHO" "$@" < /dev/null || rc=$?
    logline "result=$([ "$rc" = 0 ] && echo ok || echo "rc=$rc")" || true
    return "$rc"
}

need_name() {
    [[ $1 =~ $NAME_RE ]] || refuse "bad box name '$1': lower case letters, digits and -, 2 to 31 chars, starts with a letter"
}
need_unit() {
    [[ $1 =~ $UNIT_RE ]] || refuse "bad unit name '$1': letters, digits and @ . _ -, starts with a letter or digit, no /"
}
# need_lines N: 1 to MAX_LINES, no leading zero.
need_lines() {
    [[ $1 =~ $LINES_RE ]] && [ "$1" -le "$MAX_LINES" ] || refuse "-n must be a number from 1 to $MAX_LINES, not '$1'"
}
is_host_project() {
    [ -r "$HOST_PROJECTS" ] || return 1
    awk -F'|' -v n="$1" '!/^[[:space:]]*#/ && $1 == n {f = 1} END {exit !f}' "$HOST_PROJECTS"
}
refuse_host() {
    if is_host_project "$1"; then
        refuse "'$1' is a protected HOST project, not a box. Agents never change it; ask the owner"
    fi
}
need_box() {
    need_name "$1"
    refuse_host "$1"
    incus query "/1.0/instances/$1" >/dev/null 2>&1 < /dev/null || refuse "no box named '$1' (see: proj-agent list)"
}

cmd_new() {
    [ $# -ge 1 ] || refuse "usage: new <name> --tier try|mvp [--docker] [--pg]"
    local name=$1 tier="" docker="" pg=""
    shift
    need_name "$name"
    while [ $# -gt 0 ]; do
        case "$1" in
            --tier)
                [ -z "$tier" ] || refuse "--tier given twice"
                [ $# -ge 2 ] || refuse "--tier needs try or mvp"
                case "$2" in
                    try|mvp) tier=$2 ;;
                    long) refuse "tier long is the owner's call. Ask the owner to run: sudo proj new $name --tier long" ;;
                    *) refuse "--tier must be try or mvp, not '$2'" ;;
                esac
                shift 2 ;;
            --docker) [ -z "$docker" ] || refuse "--docker given twice"; docker=--docker; shift ;;
            --pg) [ -z "$pg" ] || refuse "--pg given twice"; pg=--pg; shift ;;
            *) refuse "option '$1' is not allowed for new (allowed: --tier try|mvp, --docker, --pg)" ;;
        esac
    done
    [ -n "$tier" ] || refuse "--tier try|mvp is required"
    refuse_host "$name"
    # Unquoted $docker/$pg on purpose: each is empty or one fixed word.
    # shellcheck disable=SC2086
    child "$PROJ" new "$name" --tier "$tier" $docker $pg
}

cmd_logs() {
    local n=$DEFAULT_LINES box="" unit=""
    if [ "${1:-}" = box ]; then
        [ $# -ge 2 ] || refuse "usage: logs box <name> [-n N]"
        box=$2
        shift 2
    else
        [ $# -ge 1 ] || refuse "usage: logs <unit> [-n N]"
        unit=$1
        shift
    fi
    if [ $# -gt 0 ]; then
        [ "$1" = -n ] && [ $# -eq 2 ] || refuse "after the name only '-n N' is allowed"
        need_lines "$2"
        n=$2
    fi
    if [ -n "$box" ]; then
        need_box "$box"
        child incus exec -T "$box" -- journalctl --no-pager -n "$n"
    else
        need_unit "$unit"
        child journalctl --no-pager -u "$unit" -n "$n"
    fi
}

cmd_status() {
    [ $# -eq 1 ] || refuse "usage: status <unit>"
    need_unit "$1"
    child systemctl --no-pager status "$1"
}

cmd_restart() {
    [ $# -eq 2 ] || refuse "usage: restart <box> <service>"
    need_box "$1"
    need_unit "$2"
    child incus exec -T "$1" -- systemctl restart "$2"
}

# exec BOX [--cwd DIR] [--timeout S] -- WORDS...: WORDS joined by spaces, run by bash -lc INSIDE
# the box. The box is the boundary: any command is fine there. It never runs as root: setpriv
# drops to dev (uid/gid 1000) with dev's groups (docker, the shared group) before bash starts.
# (incus exec --user sets no supplementary groups, so docker and the workspace group would be
# missing.) timeout runs as dev inside the box; the outer one only catches a stuck incus.
cmd_exec() {
    [ $# -ge 1 ] || refuse "usage: exec <box> [--cwd DIR] [--timeout S] -- <command...>"
    local box=$1 cwd=/srv/app secs=$EXEC_TIMEOUT dd=0 command rc=0
    shift
    need_name "$box"
    while [ $# -gt 0 ]; do
        case "$1" in
            --) dd=1; shift; break ;;
            --cwd)
                [ $# -ge 2 ] || refuse "--cwd needs a folder"
                [[ $2 =~ $CWD_RE ]] && [[ "$2/" != *"/../"* ]] && [[ "$2/" != *"/./"* ]] \
                    || refuse "--cwd must be an absolute path inside the box (letters, digits, @ . _ / + -, no . or .. parts), not $(printf '%q' "$2")"
                cwd=$2; shift 2 ;;
            --timeout)
                [ $# -ge 2 ] || refuse "--timeout needs seconds"
                [[ $2 =~ $SECS_RE ]] && [ "$2" -le "$EXEC_MAX_TIMEOUT" ] \
                    || refuse "--timeout must be 1 to $EXEC_MAX_TIMEOUT seconds, not $(printf '%q' "$2")"
                secs=$2; shift 2 ;;
            *) refuse "exec needs -- before the command (only --cwd DIR and --timeout S may come first), got $(printf '%q' "$1")" ;;
        esac
    done
    [ "$dd" = 1 ] || refuse "exec needs -- before the command: exec <box> -- <command...>"
    [ $# -gt 0 ] || refuse "exec: no command after --"
    command="$*"
    [ -n "${command//[[:space:]]/}" ] || refuse "exec: the command is empty"
    need_box "$box"
    child timeout -k 10 "$((secs + 30))" incus exec -T "$box" --cwd "$cwd" \
        --env HOME=/home/dev --env USER=dev -- \
        setpriv --reuid="$BOX_UID" --regid="$BOX_UID" --init-groups -- \
        timeout -k 10 "$secs" bash -lc "$command" || rc=$?
    if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
        echo "proj-agent: exec stopped after the time limit ($secs s; more: --timeout up to $EXEC_MAX_TIMEOUT)" >&2
    fi
    return "$rc"
}

# box_ip BOX: the box's IPv4 address on incusbr0, or nothing (stopped box).
box_ip() {
    incus query "/1.0/instances/$1/state" 2>/dev/null < /dev/null \
        | jq -r '[.network.eth0.addresses[]? | select(.family == "inet") | .address][0] // empty' 2>/dev/null || true
}

# url BOX [PORT]: print the address to use from THIS host. Without a port: every listening TCP port.
# Read only. Boxes are reachable from the host, not from the LAN; sharing is the owner's call.
cmd_url() {
    [ $# -ge 1 ] && [ $# -le 2 ] || refuse "usage: url <box> [port]"
    local box=$1 port=${2:-} ip out
    if [ -n "$port" ]; then
        [[ $port =~ $PORT_RE ]] && [ "$port" -le 65535 ] || refuse "port must be 1 to 65535, not '$port'"
    fi
    need_box "$box"
    ip=$(box_ip "$box")
    if [ -z "$ip" ]; then
        logline "result=no-address" || true
        echo "proj-agent: $box has no IPv4 address (stopped? proj-agent list)" >&2
        return 1
    fi
    if [ -n "$port" ]; then
        logline "result=ok" || true
        echo "http://$ip:$port"
    else
        out=$(child incus exec -T "$box" -- ss -Hltn) || return 1
        echo "$box: $ip"
        printf '%s\n' "$out" | awk -v ip="$ip" '
            NF >= 4 { a = $4; p = a; sub(/.*:/, "", p); h = a; sub(/:[^:]*$/, "", h)
                      if (h ~ /^127\./ || h == "[::1]") { if (!(p in loc)) loc[p] = h } else pub[p] = 1 }
            END { for (p in pub) print "  http://" ip ":" p
                  for (p in loc) if (!(p in pub)) print "  port " p ": inside the box only (listens on " loc[p] ")" }' | sort
    fi
    echo "From this host only (curl, or an SSH tunnel). Nothing is open to the LAN; sharing a box is the owner's call."
}

main() {
    [ $# -gt 0 ] || { usage >&2; refuse "no command given"; }
    local a
    # One gate for every argument before anything else: no spaces, quotes, ; $ ( ) ` / | & < > * ? or newlines.
    # Except exec: cmd_exec checks each word before -- itself; the words after it run in the box only.
    if [ "$1" != exec ]; then
        for a in "$@"; do
            [[ $a =~ $ARG_RE ]] || refuse "argument $(printf '%q' "$a") has characters that are not allowed (only letters, digits and @ . _ -)"
        done
    fi
    local cmd=$1
    shift
    case "$cmd" in
        help|-h|--help) usage; return 0 ;;
    esac
    logline "start" || { echo "proj-agent: cannot write $LOG: refused" >&2; exit 2; }
    case "$cmd" in
        new) cmd_new "$@" ;;
        list) [ $# -eq 0 ] || refuse "list takes no arguments"; child "$PROJ" list ;;
        snapshot)
            [ $# -eq 1 ] || refuse "usage: snapshot <name> (no label; proj names it manual-<date>)"
            need_box "$1"
            child "$PROJ" snapshot "$1" ;;
        doctor) [ $# -eq 0 ] || refuse "doctor takes no arguments (the network test is the owner's: sudo proj doctor --net)"; child "$PROJ" doctor ;;
        logs) cmd_logs "$@" ;;
        status) cmd_status "$@" ;;
        restart) cmd_restart "$@" ;;
        exec) cmd_exec "$@" ;;
        ports) [ $# -eq 1 ] || refuse "usage: ports <box>"; need_box "$1"; child incus exec -T "$1" -- ss -ltnup ;;
        url) cmd_url "$@" ;;
        *) refuse "unknown command '$cmd'" ;;
    esac
}

main "$@"
