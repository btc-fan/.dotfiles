#!/bin/bash
# git-workspace-guard: installed as /usr/local/bin/git by setup.sh (step 70-hosting).
# SECURITY. Code inside a box can write the box's workspace (WORK_ROOT/<box> = /srv/app in the box),
# including .git/config, .git/hooks, .git files that point elsewhere, and whole planted repositories.
# The host agents (and Claude Code's own git status at startup) run git there as the main user.
# For any git call that touches a workspace (current folder, -C, --git-dir, --work-tree,
# GIT_DIR, GIT_WORK_TREE, GIT_COMMON_DIR, or the repository git finds):
#   - hooks never run, fsmonitor is off, bare repositories are used only when named
#     (safe.bareRepository=explicit), the ext:: transport is off, git never enters submodules;
#   - every config file of the repository (config, config.worktree, worktrees/*, modules/*) may
#     hold only keys from the ALLOW-LIST below. Anything else is refused: a key that is not known
#     to be harmless may start a program (pager, editor, filter, diff driver, alias, hook, ...);
#   - core.worktree, includes, extensions other than objectformat/refstorage: refused;
#   - remote and submodule URLs: plain https/http/ssh/git/file URLs, scp-like user@host:path,
#     or paths. "transport::address" and anything starting with "-" are refused;
#   - the repository git finds must live in the workspace (a .git file that points to a host
#     repository is refused), and objects/info/alternates may not point outside the workspaces;
#   - `git submodule` and --recurse-submodules are refused: run them inside the box.
# AGENT MODE: when the caller is an agent, the same hardened mode applies to EVERY repository,
# not only workspaces: sandboxed code can plant a repository anywhere it may write (/tmp/x,
# with hooks or a config), then an approved, unsandboxed `git -C /tmp/x push` would run it.
# An agent is: GIT_GUARD_AGENT=1 (set by the ai branch for every agent), CLAUDECODE (Claude
# Code), CODEX_SANDBOX or CODEX_THREAD_ID (Codex), or the agent user (AGENT_USER) itself.
# Outside workspaces, agent mode also accepts core.hooksPath and core.fsmonitor (both forced off
# anyway) and the gh and VS Code bookkeeping keys, and it does not require the repository to be
# in a workspace. The owner's shell has none of the markers: plain git, hooks work.
# Anywhere else this is plain /usr/bin/git. Fix a refused repository from inside the box:
#   sudo proj-agent exec <box> -- git config --local --list
REAL=/usr/bin/git
WORK_ROOT="@WORK_ROOT@"
AGENT_USER="@AGENT_USER@"
SAFE=(-c core.hooksPath=/dev/null -c core.fsmonitor=false -c safe.bareRepository=explicit
      -c protocol.ext.allow=never -c submodule.recurse=false -c fetch.recurseSubmodules=false
      -c push.recurseSubmodules=no -c diff.ignoreSubmodules=all -c status.submoduleSummary=false)

refuse() {
    echo "git-workspace-guard: refused. $*" >&2
    echo "git-workspace-guard: code in a box may have planted this. Check it from inside the box (sudo proj-agent exec <box> -- git config --local --list) or ask the owner." >&2
    exit 1
}

# phys PATH [BASE]: the physical folder (symlinks resolved), or empty when it does not exist.
phys() {
    local p=$1
    case "$p" in /*) ;; *) p=${2:-$PWD}/$p ;; esac
    [ -d "$p" ] || p=$(dirname -- "$p")
    (cd -- "$p" 2>/dev/null && pwd -P) || true
}
in_ws() { case "$1/" in "$WORK_ROOT"/?*) return 0 ;; *) return 1 ;; esac; }

# 1. Global options before the subcommand: where git will look. Nothing is changed here.
dir=$PWD
explicit=0
[ -z "${GIT_DIR:-}${GIT_WORK_TREE:-}${GIT_COMMON_DIR:-}" ] || explicit=1
loc=()       # the location options, replayed for rev-parse
paths=()     # every folder the call names
sub=""
take=""
for arg in "$@"; do
    if [ -n "$take" ]; then
        case "$take" in
            -C) case "$arg" in /*) dir=$arg ;; *) dir=$dir/$arg ;; esac; loc+=(-C "$arg") ;;
            --git-dir|--work-tree) explicit=1; loc+=("$take=$arg"); paths+=("$(phys "$arg" "$dir")") ;;
            -c) loc+=(-c "$arg") ;;
        esac
        take=""; continue
    fi
    case "$arg" in
        -C|-c|--git-dir|--work-tree|--namespace|--config-env|--attr-source|--super-prefix|--list-cmds) take=$arg ;;
        --git-dir=*|--work-tree=*) explicit=1; loc+=("$arg"); paths+=("$(phys "${arg#*=}" "$dir")") ;;
        --bare) explicit=1; loc+=("$arg") ;;
        -*) ;;
        *) sub=$arg; break ;;
    esac
done
cwd=$(phys "$dir")
[ -z "${GIT_DIR:-}" ] || paths+=("$(phys "$GIT_DIR" "$cwd")")
[ -z "${GIT_WORK_TREE:-}" ] || paths+=("$(phys "$GIT_WORK_TREE" "$cwd")")
[ -z "${GIT_COMMON_DIR:-}" ] || paths+=("$(phys "$GIT_COMMON_DIR" "$cwd")")

agent=0
if [ -n "${GIT_GUARD_AGENT:-}${CLAUDECODE:-}${CODEX_SANDBOX:-}${CODEX_THREAD_ID:-}" ]; then agent=1; fi
if [ -n "$AGENT_USER" ] && [ "$AGENT_USER" != "@AGENT_""USER@" ] && [ "$(id -un 2>/dev/null)" = "$AGENT_USER" ]; then agent=1; fi

# Fast path (not for agents): the current folder is outside the workspaces and no folder was
# named. Git only looks upward from here, so it cannot find a workspace repository.
if [ "$agent" = 0 ] && [ "$explicit" = 0 ] && ! in_ws "$cwd"; then
    exec "$REAL" "$@"
fi

# 2. Where the repository really is. rev-parse reads config but runs nothing (fsmonitor off).
info=$("$REAL" ${loc[@]+"${loc[@]}"} "${SAFE[@]}" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null) || info=""
gitdir=""; common=""; top=""
if [ -n "$info" ]; then
    gitdir=$(phys "$(printf '%s\n' "$info" | sed -n 1p)")
    common=$(phys "$(printf '%s\n' "$info" | sed -n 2p)")
    top=$("$REAL" ${loc[@]+"${loc[@]}"} "${SAFE[@]}" rev-parse --show-toplevel 2>/dev/null) || top=""
    [ -z "$top" ] || top=$(phys "$top")
fi

touch_ws=0
for p in "$cwd" "$gitdir" "$common" "$top" ${paths[@]+"${paths[@]}"}; do
    if [ -n "$p" ] && in_ws "$p"; then touch_ws=1; fi
done
[ "$touch_ws" = 1 ] || [ "$agent" = 1 ] || exec "$REAL" "$@"
# outside=1: agent mode on a repository that is not in a workspace.
outside=0
[ "$touch_ws" = 1 ] || outside=1

# 3. Inside a workspace (or any repository, for an agent).
case "$sub" in submodule) refuse "git submodule enters other repositories (no submodules for agents or in workspaces; the owner runs it)." ;; esac
for arg in "$@"; do
    case "$arg" in --recurse-submodules|--recurse-submodules=*|--recursive) refuse "$arg enters other repositories (no submodules for agents or in workspaces; the owner runs it)." ;; esac
done

if [ -n "$gitdir" ]; then
    if [ "$outside" = 0 ] && { ! in_ws "$gitdir" || ! in_ws "$common"; }; then
        # A host repository named by the caller (--git-dir, GIT_DIR) is the caller's choice.
        # One that git FOUND from a workspace was pointed to by a .git file the box can write.
        [ "$explicit" = 1 ] || refuse "the repository for $cwd is $gitdir, outside the workspace (a .git file points there)."
        exec "$REAL" "${SAFE[@]}" "$@"
    fi
    # Alternates: other object folders git reads. Only inside the workspaces.
    alt=$common/objects/info/alternates
    if [ -f "$alt" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|'#'*) continue ;; esac
            a=$(phys "$line" "$common/objects")
            [ "$outside" = 1 ] || { [ -n "$a" ] && in_ws "$a"; } || refuse "$alt points outside the workspaces: $line"
        done < "$alt"
    fi
    files=("$common/config" "$common/config.worktree" "$gitdir/config.worktree")
    while IFS= read -r -d '' f; do files+=("$f"); done < <(
        { find "$common/worktrees" -mindepth 2 -maxdepth 2 -type f -name config.worktree -print0
          find "$common/modules" \( -name config -o -name config.worktree \) -type f -print0; } 2>/dev/null)
    for f in "${files[@]}"; do
        [ -e "$f" ] || continue
        [ -f "$f" ] && [ ! -L "$f" ] || refuse "$f is not a plain file."
        "$REAL" config --file "$f" --no-includes --list >/dev/null 2>&1 \
            || refuse "$f cannot be read as a git config file."
        bad=""
        while IFS= read -r -d '' kv; do
            key=${kv%%$'\n'*}
            val=""
            case "$kv" in *$'\n'*) val=${kv#*$'\n'} ;; esac
            case "$key" in
                core.repositoryformatversion|core.filemode|core.bare|core.logallrefupdates|\
                core.ignorecase|core.precomposeunicode|core.symlinks|core.autocrlf|core.eol|\
                core.sparsecheckout|core.sparsecheckoutcone|core.abbrev|\
                extensions.objectformat|extensions.refstorage|\
                user.name|user.email|init.defaultbranch|pull.rebase|pull.ff|\
                push.default|push.autosetupremote|push.followtags|fetch.prune|fetch.prunetags|\
                merge.ff|merge.conflictstyle|rebase.autostash|gc.auto|lfs.repositoryformatversion)
                    ;;
                remote.*.fetch|remote.*.push|remote.*.tagopt|remote.*.prune|remote.*.prunetags|\
                remote.*.mirror|remote.*.skipdefaultupdate|remote.*.skipfetchall|\
                branch.*.remote|branch.*.merge|branch.*.rebase|branch.*.pushremote|\
                branch.*.description|submodule.*.active|submodule.*.branch)
                    ;;
                core.hookspath|core.fsmonitor|remote.*.gh-resolved|branch.*.vscode-merge-base)
                    # Agent mode outside workspaces only: hooks and fsmonitor are forced off by
                    # the -c options; the other two are gh / VS Code bookkeeping.
                    [ "$outside" = 1 ] || bad="$bad $key" ;;
                remote.*.url|remote.*.pushurl|submodule.*.url)
                    case "$val" in
                        -*|*::*|*@-*|*$'\n'*) bad="$bad $key=$val" ;;
                        https://?*|http://?*|ssh://[!-]*|git://[!-]*|file://?*|/*|./*|../*) ;;
                        [A-Za-z0-9_]*@[A-Za-z0-9]*:*) ;;
                        *) bad="$bad $key=$val" ;;
                    esac ;;
                *) bad="$bad $key" ;;
            esac
        done < <("$REAL" config --file "$f" --no-includes --null --list 2>/dev/null)
        [ -z "$bad" ] || refuse "$f sets keys that are not on the allow-list (they may start a program or write outside the workspace):$bad"
    done
fi
exec "$REAL" "${SAFE[@]}" "$@"
