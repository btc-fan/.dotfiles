#!/usr/bin/env bash
# disk-usage-check: alert #alerts when a disk is fuller than DISK_ALERT_PCT (default 85 %).
# Run every 30 min by disk-usage-check.timer. One alert per disk per day.
# Usage: disk-usage-check [--test]   (--test prints every disk and the message, posts nothing)
set -euo pipefail

test=0
if [ "${1:-}" = --test ]; then test=1; fi
# shellcheck source=/dev/null
[ -r /etc/server/host.env ] && . /etc/server/host.env
limit=${DISK_ALERT_PCT:-85}

found=0
while read -r target; do
    target=$(printf '%b' "$target")   # findmnt -r writes a space as \x20
    pct=$(df -P "$target" | awk 'NR==2 {gsub("%", "", $5); print $5}')
    free=$(df -hP "$target" | awk 'NR==2 {print $4}')
    if [ "$test" = 1 ]; then printf '%-30s %s%% used, %s free\n' "$target" "$pct" "$free"; fi
    [ "${pct:-0}" -ge "$limit" ] || continue
    found=1
    if [ "$test" = 1 ]; then
        /usr/local/sbin/discord-notify --test alerts "disk almost full: $target" "${pct}% used, $free free (limit ${limit}%)"
    else
        /usr/local/sbin/discord-notify --key "disk-full-$target" --every 1440 \
            alerts "disk almost full: $target" "${pct}% used, $free free (limit ${limit}%)" || true
    fi
done < <(findmnt -rn -o TARGET -t ext4,xfs,btrfs,vfat | sort -u)

if [ "$test" = 1 ] && [ "$found" = 0 ]; then
    echo "all disks are below ${limit}%: a real run posts nothing"
fi
exit 0
