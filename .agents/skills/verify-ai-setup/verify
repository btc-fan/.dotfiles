           "<a href=/contact>Contact</a></nav><h1>%s</h1>\n"
FILES = {
    "docs-only": {"README.md": "# docs-only\n\nA repo with Markdown only.\n",
                  "docs/guide.md": "# Guide\n\nStep 1. Read the README.\n"},
    "web-app": {
