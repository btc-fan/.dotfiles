#!/usr/bin/env python3
"""verify: drive the AI setup of this checkout on throwaway fixtures and keep evidence (verify-ai-setup).

  verify launch [--label L] KIND [KIND ...]   new run: evidence folder, fixture repos in a temp folder
  verify doctor [--no-agents]                  checks; writes the doctor line of run.log (once per run)
  verify drive hook [--fixture K] [--agent claude|codex] EVENT 'PAYLOAD JSON'
  verify drive session claude|codex [--fixture K] 'PROMPT'
  verify drive cli [--fixture K] [--timeout S] [KEY=VALUE ...] NAME [ARG ...]   NAME: a file in ai/bin here
  verify drive install dev-mac|server
  verify evidence                              list the run folder and check run.log
  verify cleanup                               remove the fixtures, finish run.log, keep the evidence

KIND: empty, docs-only, python-with-tests, web-app, existing-project-with-own-Done.
Evidence: <checkout>/.verify/evidence/<run>/ (run.log, state.json, one NN-<surface>.txt per drive).
"""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time

SKILL = os.path.dirname(os.path.realpath(__file__))
ROOT = subprocess.run(["git", "-C", SKILL, "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE,
                      text=True).stdout.strip()
AI = os.path.join(ROOT, "ai")
PLUGIN = os.path.join(AI, "marketplace", "plugins", "ai-core")
ROUTER = os.path.join(PLUGIN, "hooks", "router.py")
EVIDENCE = os.path.join(ROOT, ".verify", "evidence")
CURRENT = os.path.join(ROOT, ".verify", "current")
KINDS = ("empty", "docs-only", "python-with-tests", "web-app", "existing-project-with-own-Done")
HOME = os.path.expanduser("~")
# Real files a run must never change: Claude and Codex settings, the installed setup.
GUARDS = [os.path.join(HOME, p) for p in (".claude/settings.json", ".claude/plugins/installed_plugins.json",
                                          ".codex/config.toml", ".codex/hooks.json")]
INSTALLED = os.path.join(HOME, ".dotfiles-ai")
OWNER = "fixture-owner"     # remotes live in remotes/<OWNER>/: ai-adopt adopts only repos of AI_GITHUB_OWNERS
NO_INSTALLED_CORE = '{"enabledPlugins": {"ai-core@ai": false}}'     # the installed copy stays off in a session


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    cmd, args = argv[0], argv[1:]
    if cmd == "launch":
        return launch(args)
    if cmd == "doctor":
        return doctor("--no-agents" not in args)
    if cmd == "drive" and args:
        return drive(args[0], args[1:])
    if cmd == "evidence":
        return evidence()
    if cmd == "cleanup":
        return cleanup()
    print(__doc__)
    return 2


# ---------------------------------------------------------------- launch

def launch(args):
    label = "run"
    if args[:1] == ["--label"] and len(args) > 1:
        label, args = args[1], args[2:]
    bad = [k for k in args if k not in KINDS]
    if not args or bad:
        sys.exit("verify launch: name one or more kinds of %s (got %s)" % (", ".join(KINDS), bad or "none"))

    run = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + label
    folder = os.path.join(EVIDENCE, run)
    os.makedirs(folder)
    write(os.path.join(folder, "run.log"), "commit: %s\n" % head())
    tmp = os.path.realpath(tempfile.mkdtemp(prefix="verify-ai-setup-"))
    write(os.path.join(tmp, "bin", "gh"), FAKE_GH % os.path.join(tmp, "gh.log"))
    os.chmod(os.path.join(tmp, "bin", "gh"), 0o755)
    for kind in args:
        make_fixture(kind, os.path.join(tmp, kind), os.path.join(tmp, "remotes", OWNER, kind + ".git"))

    state = {"run": run, "root": ROOT, "tmp": tmp, "fixtures": list(args), "guards": guards(), "drives": 0}
    save(folder, state)
    write(CURRENT, run + "\n")
    print("run: %s\nevidence: %s\nfixtures: %s" % (run, folder, tmp))
    for kind in args:
        print("  %-32s %s" % (kind, os.path.join(tmp, kind)))
    return 0


def make_fixture(kind, repo, remote):
    files = dict(FILES.get(kind, {}))
    if kind in ("python-with-tests", "existing-project-with-own-Done"):
        files = dict({k: v for k, v in EVAL.APP_FILES.items() if not k.startswith(".claude/")}, **files)
    for rel, text in files.items():
        write(os.path.join(repo, rel), text)
    os.makedirs(repo, exist_ok=True)
    EVAL.git(repo, "init", "-q", "-b", "main")
    EVAL.git(repo, "add", "-A")
    EVAL.git(repo, "commit", "-q", "--allow-empty", "-m", "init")
    os.makedirs(remote)
    EVAL.git(remote, "init", "-q", "--bare")
    EVAL.git(repo, "remote", "add", "origin", remote)
    EVAL.git(repo, "push", "-q", "-u", "origin", "main")


# ---------------------------------------------------------------- doctor

def doctor(agents):
    folder, state = current()
    log = read(os.path.join(folder, "run.log"))
    if "\ndoctor: " in "\n" + log:
        sys.exit("verify doctor: this run already has a doctor line. Start a new run: verify launch ...")
    checks = []

    def check(name, ok, detail):
        checks.append(ok)
        print("%s %-10s %s" % ("PASS" if ok else "FAIL", name, detail))

    check("checkout", state["root"] == ROOT, "%s (run started in %s)" % (ROOT, state["root"]))
    check("commit", head() == log.split()[1], "HEAD %s, run.log %s" % (head()[:12], log.split()[1][:12]))
    home_guess = probe_ai_home()
    check("plugin", home_guess == ROOT and os.path.isfile(os.path.join(PLUGIN, ".claude-plugin", "plugin.json")),
          "sessions load --plugin-dir %s; its router reads ai_home %s" % (PLUGIN, home_guess))
    build = os.path.join(state["tmp"], "build")
    rc, out = call([sys.executable, os.path.join(AI, "bin", "ai-render"), "--profile", "dev-mac", "--out", build],
                   dict(os.environ), ROOT, 120)
    check("routing", rc == 0 and os.path.isfile(os.path.join(build, "routing.json")),
          "ai-render -> %s/routing.json (rc %s)" % (build, rc))
    for kind in state["fixtures"]:
        repo = os.path.join(state["tmp"], kind)
        branch = call(["git", "-C", repo, "branch", "--show-current"], None, repo, 30)[1].strip()
        origin = call(["git", "-C", repo, "remote", "get-url", "origin"], None, repo, 30)[1].strip()
        check("fixture", branch == "main" and origin.startswith(state["tmp"]), "%s: branch %s, origin %s"
              % (kind, branch, origin))
    gh = shutil.which("gh", path=fixture_env(state)["PATH"])
    check("fake-gh", gh == os.path.join(state["tmp"], "bin", "gh"), "gh on the drive PATH: %s" % gh)
    unsafe = [p for p in (os.path.join(HOME, ".claude"), os.path.join(HOME, ".codex"), INSTALLED, ROOT)
              if (state["tmp"] + os.sep).startswith(os.path.realpath(p) + os.sep)]
    check("isolation", not unsafe, "fixtures, state and CODEX_HOME under %s; guards: %s, git of %s"
          % (state["tmp"], ", ".join(os.path.basename(g) for g in GUARDS), INSTALLED))
    if agents:
        rc, out = call(["claude", "auth", "status"], None, ROOT, 60)
        check("claude", rc == 0 and '"loggedIn": true' in out, "%s, claude auth status rc %s"
              % (shutil.which("claude"), rc))
        rc, out = call(["codex", "login", "status"], None, ROOT, 60)
        check("codex", rc == 0 and "Logged in" in out, "%s, %s" % (shutil.which("codex"), out.strip()[:60]))
    state["agents"] = agents
    save(folder, state)

    result = "PASS" if all(checks) else "FAIL"
    append(os.path.join(folder, "run.log"), "doctor: %s\n" % result)
    print("doctor: %s" % result)
    return 0 if all(checks) else 1


def probe_ai_home():
    code = "import sys; sys.path.insert(0, sys.argv[1]); import hooklib; print(hooklib.ai_home())"
    env = {k: v for k, v in os.environ.items() if k != "AI_HOME"}
    return call([sys.executable, "-c", code, os.path.dirname(ROUTER)], env, ROOT, 30)[1].strip()


# ---------------------------------------------------------------- drive

def drive(surface, args):
    folder, state = current()
    if "doctor: PASS" not in read(os.path.join(folder, "run.log")):
        sys.exit("verify drive: run.log has no 'doctor: PASS'. Run verify doctor (or launch a new run).")
    fixture = state["fixtures"][0]
    if "--fixture" in args[:-1]:
        i = args.index("--fixture")
        fixture, args = args[i + 1], args[:i] + args[i + 2:]
    if fixture not in state["fixtures"]:
        sys.exit("verify drive: no fixture %s in this run (%s)" % (fixture, ", ".join(state["fixtures"])))
    repo = os.path.join(state["tmp"], fixture)
    state["drives"] += 1
    save(folder, state)
    out = os.path.join(folder, "%02d-%s" % (state["drives"], surface))
    if surface == "hook":
        return drive_hook(state, repo, out, args)
    if surface == "session" and args and args[0] in ("claude", "codex") and len(args) == 2:
        if not state.get("agents"):
            sys.exit("verify drive session: doctor ran with --no-agents. Launch a new run and run verify doctor.")
        return drive_session(state, repo, out, args[0], args[1])
    if surface == "cli" and args:
        return drive_cli(state, repo, out, args)
    if surface == "install" and args in (["dev-mac"], ["server"]):
        return drive_install(state, out, args[0])
    sys.exit(__doc__)


def drive_hook(state, repo, out, args):
    agent = "claude"
    if args[:1] == ["--agent"] and len(args) > 1:
        agent, args = args[1], args[2:]
    event, payload = args[0], json.loads(args[1])
    payload.setdefault("session_id", "verify-" + state["run"])
    payload.setdefault("cwd", repo)
    payload.setdefault("hook_event_name", event)
    hstate = os.path.join(state["tmp"], "state-hook")
    env = dict(fixture_env(state), HOME=os.path.join(state["tmp"], "home"), AI_STATE_DIR=hstate,
               AI_CLAUDE_MANAGED_SETTINGS=os.path.join(state["tmp"], "no-managed-settings.json"),
               AI_GRAPHIFY_BIN=os.path.join(state["tmp"], "no-graphify"))
    before = len(rows(os.path.join(hstate, "fired.jsonl")))
    res = subprocess.run([sys.executable, ROUTER, "--agent", agent, event], input=json.dumps(payload).encode(),
                         env=env, cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    text = res.stdout.decode() + res.stderr.decode()
    fired = sorted({r.get("rule") for r in rows(os.path.join(hstate, "fired.jsonl"))[before:] if r.get("rule")})
    errors = read(os.path.join(hstate, "router-errors.log")).strip().splitlines()
    summary = "decision: %s\nrules fired: %s\nrouter errors: %s\nrc: %s\n" % (
        decision(text), ", ".join(fired) or "none", errors[-1] if errors else "none", res.returncode)
    write(out + ".txt", "router.py --agent %s %s\ncwd: %s\npayload: %s\n%s\n--- output\n%s"
          % (agent, event, repo, json.dumps(payload), summary, text))
    print(summary + "evidence: %s.txt" % out)
    return 0


def drive_session(state, repo, out, agent, prompt):
    sstate = out + "-state"
    env = dict(EVAL.child_env(sstate), **fixture_env(state))
    cmd = EVAL.agent_cmd(agent, prompt, repo)
    remote = os.path.join(state["tmp"], "remotes")
    if agent == "claude":
        cmd += ["--plugin-dir", PLUGIN, "--settings", NO_INSTALLED_CORE, "--strict-mcp-config"]
    else:
        env["CODEX_HOME"] = codex_home(state)
        i = cmd.index("-c") + 1
        cmd[i] = 'sandbox_workspace_write.writable_roots=["%s", "%s"]' % (os.path.join(repo, ".git"), remote)
    before = remote_heads(state)
    t0 = time.time()
    rc, text = EVAL.call(cmd, env, repo, EVAL.RUN_TIMEOUT)
    write(out + "-stream.jsonl", text)

    seen = EVAL.score_stream(text)
    fired = EVAL.router_seen(sstate)["rules"]
    gates = sorted(set(re.findall(r"\[ai gate ([\w-]+)\]", text)))
    plugins = [p.get("path") for e in EVAL.json_lines(text) if e.get("subtype") == "init"
               for p in e.get("plugins") or [] if p.get("name") == "ai-core"]
    summary = ("agent: %s\nrc: %s\nseconds: %d\nai-core loaded from: %s\nrules fired: %s\ngates in output: %s\n"
               "remote heads changed: %s\ntool calls:\n%s\n"
               % (agent, rc, time.time() - t0, ", ".join(plugins) or ("CODEX_HOME hooks.json -> " + PLUGIN
                  if agent == "codex" else "none"), ", ".join(fired) or "none", ", ".join(gates) or "none",
                  "yes" if remote_heads(state) != before else "no", "\n".join("  " + t[:300] for t in seen["tools"])))
    write(out + ".txt", "%s\ncwd: %s\n%s" % (shlex.join(cmd), repo, summary))
    print(summary + "evidence: %s.txt, %s-stream.jsonl, %s-state/" % (out, out, out))
    return 0


def drive_cli(state, repo, out, args):
    timeout = 1800
    if args[:1] == ["--timeout"] and len(args) > 1:
        timeout, args = int(args[1]), args[2:]
    extra = {}
    while args and re.fullmatch(r"[A-Z_]+=.*", args[0]):      # KEY=VALUE before NAME, e.g. AI_PROFILE=server
        key, _eq, value = args.pop(0).partition("=")
        extra[key] = value
    tool = os.path.join(AI, "bin", args[0])
    if not os.path.isfile(tool):
        sys.exit("verify drive cli: no %s in %s" % (args[0], os.path.join(AI, "bin")))
    env = EVAL.adopt_env(os.path.join(state["tmp"], "home"))
    env.update(fixture_env(state))
    env.update(extra)
    rc, text = pty_run([tool] + args[1:], env, repo, timeout)
    status = call(["git", "-C", repo, "status", "--short"], None, repo, 30)[1]
    write(out + ".txt", "%s\ncwd: %s\nrc: %s\n--- transcript\n%s\n--- git status --short after\n%s"
          % (" ".join([tool] + args[1:]), repo, rc, text, status))
    print(text[-3000:] + "\nrc: %s\nevidence: %s.txt" % (rc, out))
    return 0


def drive_install(state, out, profile):
    home = os.path.join(state["tmp"], "home-install-" + profile)
    os.makedirs(home, exist_ok=True)
    env = dict(EVAL.child_env(os.path.join(home, ".local", "state", "ai")), HOME=home,
               XDG_CONFIG_HOME=os.path.join(home, ".config"), CLAUDE_CONFIG_DIR=os.path.join(home, ".claude"),
               CODEX_HOME=os.path.join(home, ".codex"))
    before = guards()
    rc, text = EVAL.call(["bash", os.path.join(ROOT, "install.sh"), "--dry-run", "--yes", "--profile", profile,
                          "--user"], env, home, 1800)
    changed = [g for g in GUARDS + [INSTALLED] if guards().get(g) != before.get(g)]
    written = sorted(os.path.relpath(os.path.join(d, f), home) for d, _s, fs in os.walk(home) for f in fs)
    summary = ("profile: %s\nrc: %s\nreal files changed: %s\nfiles in the temp HOME after: %s\n"
               % (profile, rc, ", ".join(changed) or "none", ", ".join(written) or "none"))
    write(out + "-%s.txt" % profile, "install.sh --dry-run --yes --profile %s --user (HOME=%s)\n%s--- output\n%s"
          % (profile, home, summary, text))
    print(summary + "playwright lines:\n" + "\n".join(l for l in text.splitlines() if "laywright" in l)
          + "\nevidence: %s-%s.txt" % (out, profile))
    return 0


# ---------------------------------------------------------------- evidence, cleanup

def evidence():
    folder, _state = current()
    for name in sorted(os.listdir(folder)):
        print(os.path.join(folder, name))
    lines = read(os.path.join(folder, "run.log")).splitlines()
    ok = (len(lines) == 4 and re.fullmatch(r"commit: [0-9a-f]{40}", lines[0]) and lines[1] == "doctor: PASS"
          and lines[2] == "db_writes: no" and re.fullmatch(r"finished: \d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", lines[3]))
    print("run.log: %s" % ("proof (4 lines, doctor PASS, db_writes no)" if ok else "NOT proof: %s" % lines))
    return 0 if ok else 1


def cleanup():
    folder, state = current()
    log = read(os.path.join(folder, "run.log"))
    if "\nfinished: " in "\n" + log:
        sys.exit("verify cleanup: this run already finished")
    # Processes this run started and that outlive their session (OMC session-end workers, the graphify rebuild):
    # their command line names the run's temp folder.
    for pid in call(["pgrep", "-f", state["tmp"]], None, ROOT, 30)[1].split():
        try:
            os.kill(int(pid), signal.SIGTERM)
        except (ValueError, OSError):
            pass
    shutil.rmtree(state["tmp"], ignore_errors=True)
    changed = [g for g in GUARDS + [INSTALLED] if guards().get(g) != state["guards"].get(g)]
    write(os.path.join(folder, "guard.txt"), "real files changed during the run: %s\n" % (", ".join(changed) or "none"))
    end = ("" if "\ndoctor: " in "\n" + log else "doctor: FAIL\n") + "db_writes: no\nfinished: %s\n" % (
        time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    append(os.path.join(folder, "run.log"), end)
    os.remove(CURRENT)
    print("removed %s\nreal files changed: %s\nevidence kept: %s" % (state["tmp"], ", ".join(changed) or "none",
                                                                     folder))
    return 1 if changed else 0


# ---------------------------------------------------------------- helpers

def current():
    run = read(CURRENT).strip()
    if not run:
        sys.exit("verify: no current run. Start one: verify launch KIND")
    folder = os.path.join(EVIDENCE, run)
    with open(os.path.join(folder, "state.json"), encoding="utf-8") as fh:
        return folder, json.load(fh)


def fixture_env(state):
    """PATH with the fake gh first and this checkout's ai/bin next; routing and AI_HOME from this checkout."""
    path = os.pathsep.join([os.path.join(state["tmp"], "bin"), os.path.join(AI, "bin"), os.environ.get("PATH", "")])
    return {"PATH": path, "AI_HOME": ROOT, "AI_ROUTING_JSON": os.path.join(state["tmp"], "build", "routing.json"),
            "AI_NOTIFY_DRY": "1", "AI_GITHUB_OWNERS": OWNER}


def codex_home(state):
    """A temp CODEX_HOME: the login by link, this checkout's hooks as user hooks, trust from aiconf."""
    home = os.path.join(state["tmp"], "codex-home")
    if not os.path.isdir(home):
        os.makedirs(home)
        os.symlink(os.path.join(HOME, ".codex", "auth.json"), os.path.join(home, "auth.json"))
        write(os.path.join(home, "hooks.json"),
              read(os.path.join(PLUGIN, "hooks", "codex-hooks.json")).replace("${PLUGIN_ROOT}", PLUGIN))
        write(os.path.join(home, "config.toml"), "[features]\nhooks = true\n")
        hooks = os.path.join(home, "hooks.json")
        call([sys.executable, os.path.join(AI, "lib", "aiconf.py"), "codex-trust-hooks",
              os.path.join(home, "config.toml"), "--source", "%s=%s" % (hooks, hooks)], None, home, 60)
    return home


def remote_heads(state):
    base = os.path.join(state["tmp"], "remotes", OWNER)
    return {r: call(["git", "-C", os.path.join(base, r), "show-ref"], None, base, 30)[1] for r in os.listdir(base)}


def guards():
    out = {g: hashlib.sha1(open(g, "rb").read()).hexdigest() if os.path.isfile(g) else "absent" for g in GUARDS}
    if os.path.isdir(INSTALLED):
        out[INSTALLED] = call(["git", "-C", INSTALLED, "rev-parse", "HEAD"], None, INSTALLED, 30)[1].strip() + \
            hashlib.sha1(call(["git", "-C", INSTALLED, "status", "--porcelain"], None, INSTALLED, 60)[1]
                         .encode()).hexdigest()
    return out


def decision(text):
    for line in text.splitlines():
        try:
            data = json.loads(line)
        except ValueError:
            continue
        if data.get("decision") == "block":
            return "block" if "hookSpecificOutput" not in data else "deny"
        d = (data.get("hookSpecificOutput") or {}).get("permissionDecision")
        if d in ("deny", "ask"):
            return d
    return "allow"


def pty_run(cmd, env, cwd, timeout):
    """One PTY per drive: the CLI sees a terminal, as with the owner. (exit code, transcript)."""
    import pty
    master, slave = pty.openpty()
    proc = subprocess.Popen(cmd, env=env, cwd=cwd, stdin=slave, stdout=slave, stderr=slave, close_fds=True)
    os.close(slave)
    chunks, end = [], time.time() + timeout
    while time.time() < end:
        ready, _w, _x = select.select([master], [], [], 1)
        if ready:
            try:
                chunk = os.read(master, 65536)
            except OSError:
                chunk = b""
            if not chunk:
                break
            chunks.append(chunk)
        elif proc.poll() is not None:
            break
    if proc.poll() is None:
        proc.kill()
    proc.wait()
    os.close(master)
    return proc.returncode, b"".join(chunks).decode("utf-8", "replace").replace("\r\n", "\n")


def head():
    return subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"], stdout=subprocess.PIPE, text=True).stdout.strip()


def call(cmd, env, cwd, timeout):
    return EVAL.call(cmd, env, cwd, timeout)


def rows(path):
    return EVAL.json_lines(read(path))


def save(folder, state):
    write(os.path.join(folder, "state.json"), json.dumps(state, indent=1) + "\n")


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)


def append(path, text):
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(text)


def load_eval():
    """ai-eval of this checkout: its fixtures, session command, scorer and env are the harness."""
    path = os.path.join(AI, "bin", "ai-eval")
    loader = importlib.machinery.SourceFileLoader("aieval", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("aieval", loader))
    sys.dont_write_bytecode = True
    loader.exec_module(mod)
    return mod


EVAL = load_eval()

FAKE_GH = """#!/bin/sh
