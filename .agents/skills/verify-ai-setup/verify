def remote_heads(repo):
    """The refs of the remotes this fixture names. A parallel session in another fixture never counts."""
    urls = set(call(["git", "-C", repo, "remote", "-v"], None, repo, 30)[1].split()[1::3])
    return {u: call(["git", "-C", u, "show-ref"], None, repo, 30)[1] for u in sorted(urls) if os.path.isdir(u)}


def guards():
    out = {g: hashlib.sha1(open(g, "rb").read()).hexdigest() if os.path.isfile(g) else "absent" for g in GUARDS}
    if os.path.isdir(INSTALLED):
        out[INSTALLED] = call(["git", "-C", INSTALLED, "rev-parse", "HEAD"], None, INSTALLED, 30)[1].strip() + \
            hashlib.sha1(call(["git", "-C", INSTALLED, "status", "--porcelain"], None, INSTALLED, 60)[1]
                         .encode()).hexdigest()
    for folder in LIVE_LINKS:       # the link targets only: a skill's own files may change
        names = sorted(os.listdir(folder)) if os.path.isdir(folder) else []
        out[folder] = hashlib.sha1("".join(n + os.readlink(os.path.join(folder, n)) for n in names
                                           if os.path.islink(os.path.join(folder, n))).encode()).hexdigest()
    return out


def decision(text):
    for line in text.splitlines():
        try:
            data = json.loads(line)
        except ValueError:
            continue
        if data.get("decision") == "block":
            return "block" if "hookSpecificOutput" not in data else "deny"
        d = (data.get("hookSpecificOutput") or {}).get("permissionDecision")
        if d in ("deny", "ask"):
            return d
    return "allow"


def pty_run(cmd, env, cwd, timeout):
    """One PTY per drive: the CLI sees a terminal, as with the owner. (exit code, transcript)."""
    import pty
    master, slave = pty.openpty()
    proc = subprocess.Popen(cmd, env=env, cwd=cwd, stdin=slave, stdout=slave, stderr=slave, close_fds=True)
    os.close(slave)
    chunks, end = [], time.time() + timeout
    while time.time() < end:
        ready, _w, _x = select.select([master], [], [], 1)
        if ready:
            try:
                chunk = os.read(master, 65536)
            except OSError:
                chunk = b""
            if not chunk:
                break
            chunks.append(chunk)
        elif proc.poll() is not None:
            break
    if proc.poll() is None:
        proc.kill()
    proc.wait()
    os.close(master)
    return proc.returncode, b"".join(chunks).decode("utf-8", "replace").replace("\r\n", "\n")


def run_name(label):
    """<branch>_<label>_<DD-MM-YYYY>_<HH-MM-SS> (UTC); the label is left out when it is the branch."""
    branch = subprocess.run(["git", "-C", ROOT, "branch", "--show-current"], stdout=subprocess.PIPE,
                            text=True).stdout.strip().replace("/", "-") or "detached"
    parts = [branch] + ([label] if label and label != branch else [])
    return "_".join(parts + [time.strftime("%d-%m-%Y_%H-%M-%S", time.gmtime())])


