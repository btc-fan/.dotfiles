# Copy to ~/.config/ai/secrets.env and set mode 600:
#   install -m 600 secrets.env.example ~/.config/ai/secrets.env
# Names only. Values never go into this repo. Plain KEY=value lines (no shell code):
# the MCP wrappers read this file as data, they do not run it.

# ---- MCP servers ----
GITHUB_PERSONAL_ACCESS_TOKEN=           # GitHub MCP, full access (SPEC 4)
CONTEXT7_API_KEY=                       # context7 MCP (free plan, 1,000 calls per month)
AI_DOCS_MCP_URL=                        # Grounded Docs on another machine, e.g. http://<docs-host>:6280/mcp (empty = local server)

# ---- model providers (opencode, OMC, OMX; optional) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---- Hermes (user hermes keeps its own copy in its home) ----
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=                  # owner only

# ---- claude-seo / claude-blog (all optional) ----
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
MOZ_API_KEY=
BING_WEBMASTER_API_KEY=
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
