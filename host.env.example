# host.env: every value that belongs to ONE server. It lives in /etc/server/host.env (root:root 644).
# First install:  sudo install -D -m 644 /opt/server-setup/host.env.example /etc/server/host.env
# It is plain bash, sourced by root (setup.sh, backup and alert scripts), so only root may write it.
# NO secrets here: webhook URLs go in /etc/server/webhooks/.
# All values below are examples. Replace them.

# ---- Machine ----
SERVER_NAME="myserver"            # hostname to set (also the Tailscale name you will use)
MAIN_USER="me"                    # your daily login user. Must already have an SSH key in ~/.ssh/authorized_keys
ADMIN_USER="admin"                # separate admin: SSH key only, passwordless sudo (gets a copy of MAIN_USER's keys once)
MAIN_SUDO="none"                  # after --drop-main-sudo: none (owner decision 2026-11-12: no sudo, admin work as ADMIN_USER) | password
TIMEZONE="Europe/Berlin"          # see: timedatectl list-timezones

# ---- Network ----
LAN_CIDR="192.168.1.0/24"         # your home network. SSH is allowed only from here and Tailscale
NIC="enp3s0"                      # wired interface (ip link). Used for Wake-on-LAN
SSH_PORT="22"                     # keep 22 unless you have a reason
KEEP_MULTIPATHD="no"              # yes = keep multipathd (only for SAN disks with several paths)
WAIT_ONLINE_TIMEOUT="30"          # boot waits at most this many seconds for the network (a timeout is not a failure)
SSH_EXTRA_USERS=""                # more users allowed to log in by SSH, space separated
LAN_PORTS=""                      # extra TCP ports open to the LAN only, e.g. "8501 8503"

# ---- Disks ----
# One line per data disk: "SERIAL|LABEL|MOUNT|ROLE".
# Find serials with:  lsblk -d -o NAME,SIZE,MODEL,SERIAL
# Do not list the system disk. A disk with no partitions is formatted only with --format.
DISKS=(
    "EXAMPLE-SERIAL-AAA|data|/data|main data: Postgres, Docker volumes, backups"
    "EXAMPLE-SERIAL-BBB|backup|/backup|backup: mirror of /data/backups"
)
DATA_MOUNT="/data"                # Postgres data and Docker volumes go here ("" = stay on the system disk)

# ---- Tools ----
INSTALL_DOCKER="yes"
INSTALL_NODE="yes"
INSTALL_POSTGRES="yes"
NODE_MAJOR=""                     # "" = newest LTS
UV_VERSION="0.13.7"               # pinned release tag, or "latest" for the newest
LAZYDOCKER_VERSION="0.25.2"       # pinned release (without the v), or "latest" for the newest
PG_VERSION="16"
PG_DISK="hdd"                     # hdd or ssd: tunes Postgres for the disk under DATA_MOUNT
EXTRA_PACKAGES=""                 # more apt packages, space separated

# ---- Backups (step 60) ----
# Times are local (TIMEZONE). Pick times when nothing heavy runs.
BACKUP_DIR="/data/backups"        # all backups land here first ("" = skip step 60)
BACKUP_MOUNT="/backup"            # mirror BACKUP_DIR to this disk every night ("" = no mirror)
PG_BACKUP_TIME="07:30"
PG_BACKUP_DIR=""                  # "" = BACKUP_MOUNT/postgres: dumps go straight to the backup disk
PG_BACKUP_KEEP_DAILY="7"          # daily dumps kept
PG_BACKUP_KEEP_WEEKLY="4"         # weekly dumps kept (first dump of each week, hard links)
PG_BACKUP_SKIP_DBS=""             # big databases, e.g. "md999": not in the normal dump, they get pg-backup --big
                                  # pg-backup refuses to run when free space < 2x the largest DB it dumps
PG_BIG_BACKUP_TIME="04:30"        # the big databases, one pg_dump -Fc each
PG_BIG_BACKUP_DIR=""              # "" = BACKUP_MOUNT/postgres-big
PG_BIG_KEEP_DAILY="7"
PG_BIG_KEEP_WEEKLY="4"
PG_DRILL_TIME="05:30"             # monthly (day 1): restore the newest dumps into a throwaway DB, result to Discord
PG_DRILL_SKIP_DBS=""              # databases the drill leaves out (it needs 1.3x the DB size free on the data disk)
BACKUP_MAX_AGE_H="30"             # the daily digest alerts when a dump or the mirror is older than this
WORK_DIR=""                       # folder with your projects, snapshot daily ("" = off), e.g. "/work"
WORK_SNAPSHOT_TIME="07:45"
WORK_SNAPSHOT_KEEP_DAYS="14"
BACKUP_MIRROR_TIME="08:30"        # after the two jobs above
BACKUP_MIRROR_EXCLUDE="md999-move"   # folders right under BACKUP_DIR that are NOT mirrored ("" = mirror all)

# ---- Alerts (step 50) ----
DISK_ALERT_PCT="85"               # alert when a disk (or a ZFS dataset) is fuller than this
INODE_ALERT_PCT="85"              # alert when more inodes are used than this (ext4, xfs)
ZFS_POOL_ALERT_PCT="80"           # alert when a ZFS pool is fuller than this (ZFS slows down above 80)
WORK_ROOT_ALERT_GB="40"           # alert when the workspaces (WORK_ROOT, on the system disk) pass this ("" = off)
DIGEST_TIME="09:15"               # one #info message a day. No digest on a day = something is wrong
DIGEST_UNITS=""                   # units the digest reports, e.g. "md999-crawler.service" (missing ones: "not installed")
SMART_DIGEST_DAY="Sun"            # weekly read-only SMART report (never a self-test)
SMART_DIGEST_TIME="09:30"
ALERT_REPEAT_MIN="10"             # the same alert again only after this many minutes
ALERT_IGNORE_UNITS=""             # services that never alert, e.g. "some-flaky.service"

# ---- Project hosting (step 70): one Incus box per project, ZFS pool on its own disk ----
BOX_DISK_SERIAL=""                # serial of the disk that becomes the ZFS pool "boxes" ("" = hosting off)
                                  # The WHOLE disk is used. Not in DISKS. Needs smartctl -H = PASSED + --format.
INCUS_SOURCE="ubuntu"             # ubuntu = archive 6.0 LTS (default) | zabbly = Incus 7.0 LTS repo. No way back from 7.0
BOX_SUBNET="10.99.0.1/24"         # box network (incusbr0)
BOX_MEMORY_BUDGET="4GiB"          # sum of all box memory caps. try 1 GiB, mvp 2 GiB, long 4 GiB. RAM budget: docs/HOSTING.md
BOX_EGRESS_REJECT="10.0.0.0/8 192.168.0.0/16 172.16.0.0/12 100.64.0.0/10 169.254.0.0/16"   # boxes cannot reach these
                                  # (BOX_SUBNET is cut out of a range that holds it, so 10.0.0.0/8 is fine)
ZFS_ARC_MAX_MB="1536"             # ZFS cache cap, so it leaves RAM for Postgres
PROJ_IMAGE="images:ubuntu/26.04"  # image for new boxes
PROJ_BACKUP_TIME="07:15"          # nightly export of long boxes to BACKUP_DIR/boxes (before the mirror)
PROJ_BACKUP_KEEP="7"              # exports kept per box
PROJ_EXPIRE_TIME="09:00"          # daily: warn, stop, delete expired try boxes
WORK_ROOT="/srv/proj/work"        # workspaces: the code of box X is WORK_ROOT/X here = /srv/app in the box
                                  # Owner MAIN_USER (must be uid 1000), group SHARED_GROUP. Not a backup: commit
# Projects that run on the HOST, not in a box. proj lists and checks them and never changes them.
# One line each: "name|tier|systemd unit to check (optional)|notes"
# A box can never take one of these names. Put the unit name in once the service exists.
HOST_PROJECTS=(
    "md999|long|md999-crawler.service|999.md crawler on the host"
)
# Agents (MAIN_USER sessions and AGENT_USER) may run ONE root command without a password:
# /usr/local/sbin/proj-agent (new try/mvp box, list, snapshot, doctor, logs, status, restart in a box,
# exec / ports / url in a box).
AGENT_SUDO_ALLOW="proj-agent"     # proj-agent (default, owner decision 2026-11-11) | "" = no agent sudo at all

# ---- Optional second user (step 55) ----
AGENT_USER=""                     # e.g. "agent": no docker, shares WORK_DIR and the box workspaces ("" = skip)
AGENT_SUDO="none"                 # none (default, owner decision: agents get no sudo) | full
                                  # Risk of full: passwordless sudo = root; one tricked prompt owns the whole server.
SHARED_GROUP="devs"               # MAIN_USER + AGENT_USER; group of WORK_DIR and the workspaces (step 70 makes it)
