#!/usr/bin/env python3
"""claude-notify: tell the owner that an agent waits for input or finished.

Called by hooks (Claude Notification + Stop, Codex Stop) with the hook JSON on stdin.
Also linked as ~/.dotfiles/bin/claude-notify and ~/.local/bin/claude-notify (owner hooks.json, SPEC A.2).

macOS: a desktop notification (osascript, text passed as arguments, never as script source).
Linux: one line to the owner's info channel. Order:
  1. root helper: sudo -n /usr/local/sbin/ai-webhook-post (the webhook URL stays root-only, 600;
     agents running as this user cannot read or leak it). Installed by install.sh from
     ai/hooks/root/ai-webhook-post (copied as root, never linked).
  2. a user copy at ~/.config/ai/webhooks/info.url (mode 600) if the helper is missing.
  3. nothing configured: silent no-op.
Duplicate calls for the same event within 5 s are dropped (the owner's settings.json hook and the
ai-core plugin hook can both fire).
"""
import json
import os
import subprocess
import sys
import time

HELPER = "/usr/local/sbin/ai-webhook-post"
USER_COPY = os.path.expanduser("~/.config/ai/webhooks/info.url")
DEDUPE_S = 5


def main():
    payload = read_payload()
    event = payload.get("hook_event_name") or ("Notification" if payload.get("message") else "Stop")
    agent = os.environ.get("AI_NOTIFY_AGENT") or ("codex" if "codex" in str(payload.get("transcript_path", "")) else "claude")
    where = short_dir(payload.get("cwd") or os.getcwd())
    if event == "Notification":
        text = payload.get("message") or "needs your input"
    else:
        text = "finished"
    title = "%s: %s" % (agent, where)
    if duplicate("%s|%s|%s" % (event, payload.get("session_id", ""), text)):
        return 0
    if os.environ.get("AI_NOTIFY_DRY"):     # tests: record instead of sending
        line = "notify: %s - %s" % (title, text)
        print(line)
        with open(os.path.join(state_dir(), "notify.dry"), "a") as fh:
            fh.write(line + "\n")
        return 0
    if sys.platform == "darwin":
        mac_notify(title, text)
    else:
        linux_notify("%s - %s" % (title, text))
    return 0


def read_payload():
    if sys.stdin is None or sys.stdin.isatty():
        return {}
    try:
        raw = sys.stdin.read()
        data = json.loads(raw) if raw.strip() else {}
        return data if isinstance(data, dict) else {}
    except ValueError:
        return {}


def short_dir(path):
    home = os.path.expanduser("~")
    if path == home or path.startswith(home + os.sep):
        path = "~" + path[len(home):]
    return path


def state_dir():
    return os.environ.get("AI_STATE_DIR") or os.path.expanduser("~/.local/state/ai")


def duplicate(key):
    state = os.path.join(state_dir(), "notify.last")
    now = time.time()
    try:
        with open(state) as fh:
            ts, last = fh.read().split(" ", 1)
        if last == key and now - float(ts) < DEDUPE_S:
            return True
    except (OSError, ValueError):
        pass
    try:
        os.makedirs(os.path.dirname(state), exist_ok=True)
        with open(state, "w") as fh:
            fh.write("%f %s" % (now, key))
    except OSError:
        pass
    return False


def mac_notify(title, text):
    script = ["-e", "on run argv", "-e", "display notification (item 2 of argv) with title (item 1 of argv)",
              "-e", "end run"]
    try:
        subprocess.run(["osascript"] + script + [title, text[:200]], timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def linux_notify(line):
    line = line[:1500]
    if os.path.isfile(HELPER) and os.access(HELPER, os.X_OK):
        try:
            res = subprocess.run(["sudo", "-n", HELPER], input=line.encode("utf-8"), timeout=10,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return
        except (OSError, subprocess.SubprocessError):
            pass
    url = user_copy_url()
    if url:
        post(url, line)


def user_copy_url():
    try:
        st = os.stat(USER_COPY)
        if st.st_mode & 0o077:          # readable by others: refuse, do not leak it further
            return None
        with open(USER_COPY) as fh:
            url = fh.read().strip()
        return url if url.startswith("https://") else None
    except OSError:
        return None


def post(url, line):
    import urllib.request
    if "hooks.slack.com" in url:
        body = {"text": line}
    else:
        body = {"content": line, "allowed_mentions": {"parse": []}}
    req = urllib.request.Request(url, data=json.dumps(body).encode("utf-8"),
                                 headers={"Content-Type": "application/json", "User-Agent": "ai-notify"})
    try:
        urllib.request.urlopen(req, timeout=5).read()
    except Exception:
        pass


if __name__ == "__main__":
    sys.exit(main())
