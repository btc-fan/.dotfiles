#!/usr/bin/env python3
"""Claude PreToolUse Bash hook: RTK's rewrite, but not in auto mode.

Usage (hook command): /usr/bin/python3 <this file> <absolute rtk program>

In auto mode the classifier reviews the command. A command that RTK rewrote gets a "no verdict" denial there
(owner 2026-11-16), so in auto mode this hook does nothing. In every other mode it runs `rtk hook claude` with
the same input and passes its output and exit code on. RTK is a vendor program, so we wrap it, not patch it.
"""
import json
import subprocess
import sys


def main(argv):
    raw = sys.stdin.buffer.read()
    if permission_mode(raw) == "auto":
        return 0
    rtk = argv[1] if len(argv) > 1 else "rtk"
    try:
        res = subprocess.run([rtk, "hook", "claude"], input=raw, stdout=subprocess.PIPE)
    except OSError:
        return 0        # rtk is gone: the command runs without the rewrite
    sys.stdout.buffer.write(res.stdout)
    return res.returncode


def permission_mode(raw):
    try:
        data = json.loads(raw.decode("utf-8"))
    except ValueError:
        return None
    return data.get("permission_mode") if isinstance(data, dict) else None


if __name__ == "__main__":
    sys.exit(main(sys.argv))
