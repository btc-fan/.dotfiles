{
 "rule": "seo-not-enabled",
 "cases": [
  {
   "name": "Claude in a project without opt-in",
   "expect": "fire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site"
   },
   "project": {
    "git": true,
    "files": {
     "README.md": "x\n"
    }
   }
  },
  {
   "name": "project opted in",
   "expect": "nofire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site"
   },
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "seo\n"
    }
   }
  },
  {
   "name": "Codex never gets it (reads the skill files)",
   "expect": "nofire",
   "agent": "codex",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site",
    "turn_id": "t"
   },
   "project": {
    "git": true,
    "files": {
     "README.md": "x\n"
    }
   }
  }
 ]
}
