  {
   "name": "deny: incident: enable a user unit",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "systemctl --user enable herdr-core-boot.service"
    }
   },
   "contains": [
    "[ai gate ask-first]",
    "plan",
    "risk",
    "undo"
   ]
  },
