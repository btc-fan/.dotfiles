{
 "rule": "audit-before-install",
 "cases": [
  {
   "name": "npm install without audit",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "npm install left-pad@1.3.0"
    }
   },
   "project": {
    "git": true
   },
   "contains": "agent-audit npm left-pad 1.3.0"
  },
  {
   "name": "npm install with fresh PASS",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "npm install left-pad@1.3.0"
    }
   },
   "project": {
    "git": true
   },
   "audit_log": [
    "{{NOW}} npm left-pad 1.3.0 PASS"
   ]
  },
  {
   "name": "PASS older than 24 h",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "npm install left-pad@1.3.0"
    }
   },
   "project": {
    "git": true
   },
   "audit_log": [
    "{{OLD}} npm left-pad 1.3.0 PASS"
   ]
  },
  {
   "name": "last audit FAILED",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "pip install requests==2.32.3"
    }
   },
   "project": {
    "git": true
   },
   "audit_log": [
    "{{NOW}} pypi requests 2.32.3 FAIL"
   ],
   "contains": "FAILED"
  },
  {
   "name": "uv add with PASS (name only)",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "uv add httpx"
    }
   },
   "project": {
    "git": true
   },
   "audit_log": [
    "{{NOW}} pypi httpx - PASS"
   ]
  },
  {
   "name": "chained install",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "cd web && npm ci && npm i -D vitest@2.1.8"
    }
   },
   "project": {
    "git": true
   }
  },
  {
   "name": "lockfile install needs a dir audit",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "npm install"
    }
   },
   "project": {
    "git": true
   },
   "contains": "agent-audit dir"
  },
  {
   "name": "lockfile install with dir PASS",
