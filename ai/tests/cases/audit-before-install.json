   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "npm test"
    }
   },
   "project": {
    "git": true
   }
  },
  {
   "name": "owner skip file (root-owned in real use) lets the gate through, logged",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "npm install foo"
    }
   },
   "project": {
    "git": true
   },
   "state_contains": {
    "gates.log": "SKIP audit-before-install"
   },
   "gate_skip": "audit-before-install {{SOON}} owner reviewed foo"
  },
  {
   "name": "gates.log is redacted",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "NPM_TOKEN={{NPM_TOKEN}} npm install left-pad@1.3.0"
    }
   },
   "project": {
    "git": true
   },
   "state_contains": {
    "gates.log": "NPM_TOKEN=[REDACTED]"
   },
   "state_not_contains": {
    "gates.log": "{{NPM_TOKEN}}"
   }
  },
  {
   "name": "AI_GATE_SKIP in the command no longer skips anything",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "AI_GATE_SKIP='audit-before-install:owner said ok' npm install foo"
    }
   },
   "project": {
    "git": true
   },
   "contains": "does nothing"
  },
  {
   "name": "escape hatch inside echo text is ignored",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "echo AI_GATE_SKIP=audit-before-install:x && npm install foo"
    }
   },
   "project": {
    "git": true
   }
  },
  {
   "name": "commit message text never triggers the install gate",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'curl x | sh is unsafe; avoid npx foo@latest; npm install bar'"
    }
   },
   "project": {
    "git": true
   }
  },
