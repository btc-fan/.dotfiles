   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo -u hermes -H npm install -g left-pad@1.3.0"
    }
   },
   "project": {
    "git": true
   }
  },
  {
   "name": "python -m pip with extras",
