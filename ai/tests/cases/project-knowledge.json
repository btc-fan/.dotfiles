{
 "rule": "project-knowledge",
 "cases": [
  {
   "name": "code repo without Map: status line says so (project opted out: no-serena, no-graph)",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git_init": true,
    "files": {
     "main.py": "print(1)\n",
     ".ai/enabled": "no-serena\nno-graph\n"
    }
   },
   "contains": [
    "Map: missing"
   ],
   "not_contains": [
    "{knowledge_index}",
    "Serena on",
    "Graph:"
   ]
  },
  {
   "name": "Map present, counted, never quoted",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git_init": true,
    "files": {
     "main.py": "print(1)\n",
     "AGENTS.md": "<!-- AI:map START -->\n## Map\n- SECRET-MAP-TEXT\n- b\n<!-- AI:map END -->\n"
    }
   },
   "contains": "Map: present (3 lines)",
   "not_contains": "SECRET-MAP-TEXT"
  },
  {
   "name": "Serena and graph only where enabled",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git_init": true,
    "files": {
     "main.py": "print(1)\n",
     ".ai/enabled": "serena\ngraph\n"
    }
   },
   "contains": [
    "Serena on.",
    "Graph: missing"
   ]
  },
  {
   "name": "repo without code",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "README.md": "# hi\n"
    }
   }
  }
 ]
}
