{
 "rule": "seo",
 "cases": [
  {
   "name": "seo audit",
   "expect": "fire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of example.com"
   },
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "seo\nblog\n"
    }
   }
  },
  {
   "name": "db audit is not seo",
   "expect": "nofire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "audit the database indexes"
   },
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "seo\nblog\n"
    }
   }
  },
  {
   "name": "miss logged when no seo skill ran",
   "expect": "miss",
   "steps": [
    {
     "event": "UserPromptSubmit",
     "payload": {
      "prompt": "check the meta description of our homepage"
     }
    },
    {
     "event": "Stop",
     "payload": {},
     "transcript_append": [
      {
       "type": "assistant",
       "message": {
        "role": "assistant",
        "content": [
         {
          "type": "text",
          "text": "Done, I edited the HTML."
         }
        ]
       }
      },
      {
       "type": "assistant",
       "message": {
        "role": "assistant",
        "content": [
         {
          "type": "tool_use",
          "name": "Edit",
          "input": {
           "file_path": "index.html"
          }
         }
        ]
       }
      }
     ]
    }
   ],
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "seo\nblog\n"
    }
   }
  },
  {
   "name": "no miss when the skill ran",
   "expect": "nomiss",
   "steps": [
    {
     "event": "UserPromptSubmit",
     "payload": {
      "prompt": "check the meta description of our homepage"
     }
    },
    {
     "event": "Stop",
     "payload": {},
     "transcript_append": [
      {
       "type": "assistant",
       "message": {
        "role": "assistant",
        "content": [
         {
          "type": "tool_use",
          "name": "Skill",
          "input": {
           "skill": "claude-seo:seo-page"
          }
         }
        ]
       }
      }
     ]
    }
   ],
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "seo\nblog\n"
    }
   }
  },
  {
   "name": "no miss when the owner typed /seo",
   "expect": "nomiss",
   "steps": [
    {
     "event": "UserPromptSubmit",
     "payload": {
      "prompt": "/seo page https://example.com"
     }
    },
    {
     "event": "UserPromptExpansion",
     "payload": {
      "command_name": "claude-seo:seo"
     }
    },
    {
     "event": "Stop",
     "payload": {}
    }
   ],
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "seo\nblog\n"
    }
   }
  },
  {
   "name": "on through project enabledPlugins",
   "expect": "fire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site"
   },
   "project": {
    "git": true,
    "files": {
     ".claude/settings.json": "{\"enabledPlugins\": {\"claude-seo@agricidaniel-claude-seo\": true}}"
    }
   }
  },
  {
   "name": "off in a project without opt-in (Claude)",
   "expect": "nofire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site"
   },
   "project": {
    "git": true,
    "files": {
     "README.md": "x\n"
    }
   }
  },
  {
   "name": "local settings false wins over project true",
   "expect": "nofire",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site"
   },
   "project": {
    "git": true,
    "files": {
     ".claude/settings.json": "{\"enabledPlugins\": {\"claude-seo@agricidaniel-claude-seo\": true}}",
     ".claude/settings.local.json": "{\"enabledPlugins\": {\"claude-seo@agricidaniel-claude-seo\": false}}"
    }
   }
  },
  {
   "name": "Codex outside a project: skill files",
   "expect": "fire",
   "agent": "codex",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "run an seo audit of the site",
    "turn_id": "t"
   },
   "contains": "Follow the skill files yourself"
  }
 ]
}
