{
 "rule": "graph",
 "cases": [
  {
   "name": "code repo with graph enabled",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n",
     ".ai/base-version": "4\n",
     ".ai/enabled": "graph\n"
    }
   },
   "contains": [
    "graphify is on here"
   ]
  },
  {
   "name": "code repo without graph enabled (project opted out: no-serena, no-graph)",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n",
     ".ai/base-version": "4\n",
     ".ai/enabled": "no-serena\nno-graph\n"
    }
   }
  },
  {
   "name": "graph enabled but no code",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "README.md": "# x\n",
     ".ai/enabled": "graph\n"
    }
   }
  },
  {
   "name": "code repo, nothing in .ai/enabled: graphify is on by default",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n",
     ".ai/base-version": "4\n"
    }
   }
  }
 ]
}
