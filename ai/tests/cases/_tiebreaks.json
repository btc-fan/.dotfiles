{
 "rule": "_tiebreaks",
 "cases": [
  {
   "name": "post beats URL (mirror row dropped)",
   "expect": "allow",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "write a blog post that links to https://example.com"
   },
   "contains": "use claude-blog:blog-*",
   "not_contains": "use claude-seo:seo-*"
  },
  {
   "name": "URL row",
   "expect": "allow",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "audit https://example.com"
   },
   "contains": "use claude-seo:seo-*"
  },
  {
   "name": "no rule and no tie-break: no output",
   "expect": "allow",
   "event": "UserPromptSubmit",
   "payload": {
    "prompt": "hello there"
   },
   "not_contains": "ai router"
  }
 ]
}
