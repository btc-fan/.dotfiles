{
 "rule": "upgrade-review",
 "cases": [
  {
   "name": "pending upgrades: the session start says so",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "project": {"git": true, "files": {"app.py": "x = 1\n"}},
   "state_files": {"upgrades.json": "{\"pending\": [{\"tool\": \"graphify\", \"old\": \"0.9.111\", \"new\": \"0.9.120\"}]}"},
   "contains": ["graphify 0.9.111 -> 0.9.120", "upgrade-review skill"]
  },
  {
   "name": "outside a repo too",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "state_files": {"upgrades.json": "{\"pending\": [{\"tool\": \"codex\", \"old\": \"0.165.0\", \"new\": \"0.170.0\"}]}"}
  },
  {
   "name": "nothing pending: quiet",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "project": {"git": true, "files": {"app.py": "x = 1\n"}},
   "state_files": {"upgrades.json": "{\"pending\": []}"}
  },
  {
   "name": "broken file: quiet, no error",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "state_files": {"upgrades.json": "{not json"}
  }
 ]
}
