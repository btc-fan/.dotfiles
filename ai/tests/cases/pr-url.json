{
 "rule": "pr-url",
 "cases": [
  {
   "name": "PR numbers without URLs: blocked, every number named",
   "expect": "block",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Open: PRs #21, #22 and #23. Merge PR 7 next."
     }
    }
   ],
   "contains": [
    "[ai router: pr-url]",
    "PR 7, 21, 22, 23"
   ]
  },
  {
   "name": "every PR has its URL: allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Merge PR #7: https://github.com/o/r/pull/7"
     }
    }
   ]
  },
  {
   "name": "one PR linked, one not: blocked for the bare one only",
   "expect": "block",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Merge pull request 12 and PR #7: https://github.com/o/r/pull/7"
     }
    }
   ],
   "contains": [
    "names PR 12 without"
   ]
  },
  {
   "name": "a continuation stop passes (no loop)",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": true,
      "last_assistant_message": "Merge PR #7 next."
     }
    }
   ]
  },
  {
   "name": "no PR named (a gh command, a step number): allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Run gh pr view 7 and step 2 of 5."
     }
    }
   ]
  },
  {
   "name": "no reply text: allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": ""
     }
    }
   ]
  },
  {
   "name": "codex Stop: blocked",
   "expect": "block",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Merge PR #7 next."
     }
    }
   ],
   "agent": "codex"
  },
  {
   "name": "PR#7 and PR-7 forms: blocked",
   "expect": "block",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "PR#7 is merged. See PR-7."
     }
    }
   ],
   "contains": [
    "names PR 7 without"
   ]
  },
  {
   "name": "list with a colon and an Oxford comma: every number named",
   "expect": "block",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Open PRs: #21, #22, and #23."
     }
    }
   ],
   "contains": [
    "PR 21, 22, 23"
   ]
  },
  {
   "name": "a range: blocked",
   "expect": "block",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Open PRs 21-23."
     }
    }
   ],
   "contains": [
    "PR 21, 23"
   ]
  },
  {
   "name": "a PR named in a code fence (pasted git log): allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "```\nMerge pull request #12 from x/y\n```\nDone."
     }
    }
   ]
  },
  {
   "name": "a PR named in inline code: allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Run `PR 7 check`."
     }
    }
   ]
  },
  {
   "name": "leading zeros match the link number: allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "Merged PR 007: https://github.com/o/r/pull/7"
     }
    }
   ]
  },
  {
   "name": "PR 7/8 and PR on its own line: allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "Stop",
     "payload": {
      "stop_hook_active": false,
      "last_assistant_message": "PR 7/8 of the plan.\nPR\n7 rules"
     }
    }
   ]
  }
 ]
}
