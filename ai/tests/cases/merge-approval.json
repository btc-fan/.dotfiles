{
 "rule": "merge-approval",
 "cases": [
  {
   "name": "gh pr merge without the owner's OK",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "gh pr merge 12 --squash --delete-branch"
    }
   },
   "project": {
    "git": true
   },
   "contains": "needs the owner's OK"
  },
  {
   "name": "owner said merge it: allowed",
   "expect": "allow",
   "steps": [
    {
     "event": "UserPromptSubmit",
