{
 "rule": "no-memories",
 "cases": [
  {
   "name": "code repo without core memory",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n"
    }
   }
  },
  {
   "name": "code repo with core memory",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {
    "source": "startup"
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n",
     ".serena/memories/core.md": "x\n"
    }
   }
  }
 ]
}
