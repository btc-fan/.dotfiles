{
 "rule": "nav-first",
 "cases": [
  {
   "name": "first Grep in a code repo with a fresh graph is denied once",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "def handler", "path": "."}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".serena/project.yml": "name: x\n"}},
   "contains": ["run graphify query first", "graphify query", "find_symbol", "rg only for text"]
  },
  {
   "name": "rg in Bash (also behind rtk) is denied once",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "rtk rg -n 'send_mail' src"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}},
   "contains": "run graphify query first"
  },
  {
   "name": "grep -rn counts as a broad search",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "grep -rn TODO ."}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "second search passes",
   "expect": "allow",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "b"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "once per session",
   "expect": "nofire",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "b"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "no graph, Serena on: a nudge, not a deny",
   "expect": "fire",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", ".serena/project.yml": "name: x\n"}},
   "contains": "find_symbol",
   "not_contains": "run graphify query first"
  },
  {
   "name": "no graph passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n"}}
  },
  {
   "name": "no-graph flag passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".ai/enabled": "no-graph\n"}}
  },
  {
   "name": "repo without code passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"README.md": "# x\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "session that already ran graphify passes",
   "expect": "allow",
   "steps": [
    {"event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "graphify query \"where is the handler\" --budget 1500"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "session that already used a Serena tool passes",
   "expect": "allow",
   "steps": [
    {"event": "PostToolUse", "payload": {"tool_name": "mcp__plugin_ai-serena_serena__find_symbol", "tool_input": {"name_path": "handler"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "no graph and Serena off: quiet",
   "expect": "nofire",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", ".ai/enabled": "tier: long\nno-serena\n"}}
  },
  {
   "name": "plain grep on one file is not a code search",
   "expect": "nofire",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "grep -n TODO app.py"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "codex: rg in a shell call is denied once",
   "agent": "codex",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "turn_id": "t1", "tool_input": {"command": "rg -n handler"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}},
   "contains": "run graphify query first"
  }
 ]
}
