{
 "rule": "nav-first",
 "cases": [
  {
   "name": "first Grep in a code repo with a fresh graph is denied once",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "def handler", "path": "."}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".serena/project.yml": "name: x\n"}},
   "contains": ["run graphify query first", "graphify query", "find_symbol", "rg only for text"]
  },
  {
   "name": "rg in Bash (also behind rtk) is denied once",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "rtk rg -n 'send_mail' src"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}},
   "contains": "run graphify query first"
  },
  {
   "name": "grep -rn counts as a broad search",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "grep -rn TODO ."}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "second search passes",
   "expect": "allow",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "b"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "once per session",
   "expect": "nofire",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "b"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "no graph, Serena on: a nudge, not a deny",
   "expect": "fire",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", ".serena/project.yml": "name: x\n"}},
   "contains": "find_symbol",
   "not_contains": "run graphify query first"
  },
  {
   "name": "no graph passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n"}}
  },
  {
   "name": "no-graph flag passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".ai/enabled": "no-graph\n"}}
  },
  {
   "name": "repo without code passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"README.md": "# x\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "session that already ran graphify passes",
   "expect": "allow",
   "steps": [
    {"event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "graphify query \"where is the handler\" --budget 1500"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "session that already used a Serena tool passes",
   "expect": "allow",
   "steps": [
    {"event": "PostToolUse", "payload": {"tool_name": "mcp__plugin_ai-serena_serena__find_symbol", "tool_input": {"name_path": "handler"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "no graph and Serena off: quiet",
   "expect": "nofire",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", ".ai/enabled": "tier: long\nno-serena\n"}}
  },
  {
   "name": "plain grep on one file is not a code search",
   "expect": "nofire",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "grep -n TODO app.py"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}}
  },
  {
   "name": "codex: rg in a shell call is denied once",
   "agent": "codex",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "turn_id": "t1", "tool_input": {"command": "rg -n handler"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}},
   "contains": "run graphify query first"
  },
  {
   "name": "stale graph (code committed after the graph): denied once, update first",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "def handler"}},
   "project": {"git_init": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}, "commit": "init",
               "age_days": {"graphify-out/graph.json": 2}},
   "contains": "run graphify update, then graphify query"
  },
  {
   "name": "a later search for code symbols of the graph is denied once, with the symbols and the tool",
   "expect": "deny",
   "steps": [
    {"event": "PostToolUse", "payload": {"tool_name": "mcp__plugin_ai-serena_serena__find_symbol", "tool_input": {"name_path": "handler"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "rtk rg -n 'send_mail|MailQueue' src"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", ".serena/project.yml": "name: x\n",
               "graphify-out/graph.json": "{\"nodes\": [{\"label\": \"send_mail()\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L3\"}, {\"label\": \"MailQueue\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L9\"}]}"}},
   "contains": ["send_mail (src/mail.py:L3)", "MailQueue (src/mail.py:L9)", "find_symbol", "the next search passes"]
  },
  {
   "name": "the same symbol search passes the second time",
   "expect": "allow",
   "steps": [
    {"event": "PostToolUse", "payload": {"tool_name": "mcp__plugin_ai-serena_serena__find_symbol", "tool_input": {"name_path": "handler"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "MailQueue"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "MailQueue"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n",
               "graphify-out/graph.json": "{\"nodes\": [{\"label\": \"MailQueue\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L9\"}]}"}}
  },
  {
   "name": "the first search is denied once only, also when it names a symbol",
   "expect": "allow",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "MailQueue"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "MailQueue"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n",
               "graphify-out/graph.json": "{\"nodes\": [{\"label\": \"MailQueue\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L9\"}]}"}}
  },
  {
   "name": "a text search passes: a phrase, a one-word lowercase name, a symbol name in a file path, a document title",
   "expect": "nofire",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "rg -n -i 'could not send|batch|Setup' docs src/MailQueue.tsx"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n",
               "graphify-out/graph.json": "{\"nodes\": [{\"label\": \"MailQueue\", \"file_type\": \"code\", \"source_file\": \"src/MailQueue.tsx\", \"source_location\": \"L9\"}, {\"label\": \"batch()\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L20\"}, {\"label\": \"Setup\", \"file_type\": \"document\", \"source_file\": \"docs/setup.md\", \"source_location\": \"L1\"}]}"}}
  },
  {
   "name": "a search that filters the output of a pipe is not a symbol search",
   "expect": "nofire",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "git log --oneline | rg MailQueue"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n",
               "graphify-out/graph.json": "{\"nodes\": [{\"label\": \"MailQueue\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L9\"}]}"}}
  },
  {
   "name": "no-graph flag: a symbol search passes",
   "expect": "allow",
   "steps": [
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}},
    {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "MailQueue"}}}
   ],
   "project": {"git": true, "files": {"app.py": "x = 1\n", ".ai/enabled": "tier: long\nno-graph\n",
               "graphify-out/graph.json": "{\"nodes\": [{\"label\": \"MailQueue\", \"file_type\": \"code\", \"source_file\": \"src/mail.py\", \"source_location\": \"L9\"}]}"}}
  },
  {
   "name": "owner skip (sudo ai-gate-skip nav-first): the search passes with the nudge",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {"tool_name": "Grep", "tool_input": {"pattern": "def handler"}},
   "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}"}},
   "gate_skip": "nav-first {{SOON}} graph is broken today",
   "contains": ["skipped by the owner", "graphify query"],
   "state_contains": {"gates.log": "SKIP nav-first"}
  },
  {"name": "Serena initial_instructions is not navigation: the first Grep is still denied", "expect": "deny", "steps": [{"event": "PostToolUse", "payload": {"tool_name": "mcp__plugin_ai-serena_serena__initial_instructions", "tool_input": {}}}, {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}], "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".serena/project.yml": "name: x\n"}}},
  {"name": "graphify update is not navigation: the first Grep is still denied", "expect": "deny", "steps": [{"event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "graphify update ."}}}, {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}], "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".serena/project.yml": "name: x\n"}}},
  {"name": "graphify affected and Serena get_symbols_overview count as navigation", "expect": "allow", "steps": [{"event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "graphify affected \"app.py::x\""}}}, {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}], "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".serena/project.yml": "name: x\n"}}},
  {"name": "Serena get_symbols_overview counts as navigation", "expect": "allow", "steps": [{"event": "PostToolUse", "payload": {"tool_name": "mcp__plugin_ai-serena_serena__get_symbols_overview", "tool_input": {"relative_path": "app.py"}}}, {"event": "PreToolUse", "payload": {"tool_name": "Grep", "tool_input": {"pattern": "a"}}}], "project": {"git": true, "files": {"app.py": "x = 1\n", "graphify-out/graph.json": "{}", ".serena/project.yml": "name: x\n"}}}
 ]
}
