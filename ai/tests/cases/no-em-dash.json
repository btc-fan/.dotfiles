{
 "rule": "no-em-dash",
 "cases": [
  {
   "name": "em dash written",
   "expect": "fire",
   "event": "PostToolUse",
   "payload": {
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{{PROJ}}/notes.md",
     "content": "one \u2014 two\n"
    }
   },
   "project": {
    "git": true
   }
  },
  {
   "name": "em dash in edit",
   "expect": "fire",
   "event": "PostToolUse",
   "payload": {
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{{PROJ}}/notes.md",
     "old_string": "a",
     "new_string": "x \u2014 y"
    }
   },
   "project": {
    "git": true
   }
  },
  {
   "name": "plain dash",
   "expect": "nofire",
   "event": "PostToolUse",
   "payload": {
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{{PROJ}}/notes.md",
     "content": "one - two\n"
    }
   },
   "project": {
    "git": true
   }
  },
  {"name": "Bash wrote an em dash into a new file", "expect": "fire", "event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "printf 'one x two' > notes.md"}}, "project": {"git": true, "files": {"notes.md": "one \u2014 two\n"}}},
  {"name": "python heredoc wrote an em dash into a tracked file", "expect": "fire", "event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "python3 - <<'EOF'\nopen('notes.md', 'a').write('x')\nEOF"}}, "project": {"git_init": true, "files": {"notes.md": "old\n"}, "commit": "init", "dirty": {"notes.md": "old\nnew \u2014 line\n"}}},
  {"name": "Bash write of a tracked file whose old text has an em dash: quiet", "expect": "nofire", "event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo ok >> notes.md"}}, "project": {"git_init": true, "files": {"notes.md": "old \u2014 text\n"}, "commit": "init"}},
  {"name": "Bash write without an em dash: quiet", "expect": "nofire", "event": "PostToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "printf 'x' > notes.md"}}, "project": {"git": true, "files": {"notes.md": "one - two\n"}}}
 ]
}
