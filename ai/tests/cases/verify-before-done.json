{
 "rule": "verify-before-done",
 "cases": [
  {
   "name": "code edit in a project with a verify skill",
   "expect": "fire",
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "tier: mvp\n",
     ".agents/skills/verify-shop/SKILL.md": "---\nname: verify-shop\n---\n",
     ".agents/skills/verify-shop/features/cart.md": "x\n"
    }
   },
   "steps": [
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Edit",
      "tool_input": {
       "file_path": "{{PROJ}}/src/cart.py",
       "new_string": "x"
      },
      "tool_response": {}
     }
    }
   ],
   "contains": [
    "verify-shop on the changed feature",
    "e2e tests"
   ]
  },
  {
   "name": "once per session",
   "expect": "nofire",
   "project": {
    "git": true,
    "files": {
     ".ai/enabled": "tier: mvp\n",
     ".agents/skills/verify-shop/SKILL.md": "---\nname: verify-shop\n---\n",
     ".agents/skills/verify-shop/features/cart.md": "x\n"
    }
   },
   "steps": [
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Edit",
      "tool_input": {
       "file_path": "{{PROJ}}/src/cart.py",
       "new_string": "x"
      },
      "tool_response": {}
     }
    },
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Write",
      "tool_input": {
       "file_path": "{{PROJ}}/src/pay.py",
       "new_string": "x"
      },
      "tool_response": {}
     }
    }
   ]
  },
