   "project": {"git": true}},
  {"name": "rtk form of a write asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "rtk gh pr comment 3 --body x"}}, "project": {"git": true}},
  {"name": "codex: a write is denied with block", "agent": "codex", "expect": "deny", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "turn_id": "t1", "tool_input": {"command": "gh issue create --title x --body y"}},
   "project": {"git": true}, "contains": "Codex cannot ask the owner"},
  {"name": "codex: a read passes", "agent": "codex", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "turn_id": "t1", "tool_input": {"command": "gh pr view 3"}}, "project": {"git": true}}
 ]
}
