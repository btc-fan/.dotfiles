{
 "rule": "gh-write",
 "cases": [
  {"name": "gh pr view is a read", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr view 12 --json state"}}, "project": {"git": true}},
  {"name": "gh pr list, diff, checks, status are reads", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr list && gh pr diff 3 && gh pr checks 3 && gh pr status"}},
   "project": {"git": true}},
  {"name": "gh issue view and list, repo view, run view and list are reads", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh issue view 4; gh issue list; gh repo view; gh run list; gh run view 9 --log"}},
   "project": {"git": true}},
  {"name": "rtk form of a read", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "rtk gh run view 9"}}, "project": {"git": true}},
  {"name": "gh api GET is a read", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh api repos/o/r/pulls/3/comments --jq '.[].body'"}},
   "project": {"git": true}},
  {"name": "gh api -X GET with fields is a read", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh api -X GET search/issues -f q=bug"}},
   "project": {"git": true}},
  {"name": "gh pr create goes to the pr-rules gate, not here", "expect": "nofire", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr create --title x --body y"}}, "project": {"git": true}},
  {"name": "gh pr ready is not asked here: the ship gate decides (deny without a ship proof)", "expect": "deny",
   "event": "PreToolUse", "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr ready 3"}},
   "project": {"git": true}, "contains": "ship"},
  {"name": "gh in a commit message is text", "expect": "allow", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m 'gh issue create later'"}}, "project": {"git": true}},
  {"name": "gh issue create asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh issue create --title x --body y"}}, "project": {"git": true},
   "contains": "gh issue create"},
  {"name": "gh issue comment asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh issue comment 4 --body ok"}}, "project": {"git": true}},
  {"name": "gh issue close asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh issue close 4"}}, "project": {"git": true}},
  {"name": "gh pr comment asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr comment 3 --body done"}}, "project": {"git": true}},
  {"name": "gh pr review asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr review 3 --approve"}}, "project": {"git": true}},
  {"name": "gh pr close asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh pr close 3"}}, "project": {"git": true}},
  {"name": "gh repo create asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh repo create o/new --private"}}, "project": {"git": true}},
  {"name": "gh repo delete asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh repo delete o/r --yes"}}, "project": {"git": true}},
  {"name": "gh release create asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh release create v1.0 --notes x"}}, "project": {"git": true}},
  {"name": "gh label create asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh label create bug"}}, "project": {"git": true}},
  {"name": "gh api -X POST asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh api -X POST repos/o/r/issues/4/comments"}},
   "project": {"git": true}},
  {"name": "gh api --method=DELETE asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh api --method=DELETE repos/o/r/labels/x"}},
   "project": {"git": true}},
  {"name": "gh api with -f fields (implied POST) asks", "expect": "ask", "event": "PreToolUse",
   "payload": {"tool_name": "Bash", "tool_input": {"command": "gh api repos/o/r/issues -f title=x"}},
   "project": {"git": true}},
  {"name": "gh write inside bash -c asks", "expect": "ask", "event": "PreToolUse",
