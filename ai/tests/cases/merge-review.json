{
 "rule": "merge-review",
 "cases": [
  {
   "name": "main moved since the last review",
   "expect": "fire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "project": {"git_init": true, "files": {"app.py": "x = 1\n", ".ai/enabled": "tier: long\n", ".ai/last-review": "0123abc\n"}, "commit": "init"},
   "contains": ["/improve-codebase-architecture", "/retro", ".ai/last-review"]
  },
  {
   "name": "first session: the mark is set quietly",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "project": {"git_init": true, "files": {"app.py": "x = 1\n", ".ai/enabled": "tier: long\n"}, "commit": "init"}
  },
  {
   "name": "not adopted (no .ai): nothing",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "project": {"git_init": true, "files": {"app.py": "x = 1\n", "README.md": "x\n"}, "commit": "init"}
  },
  {
   "name": "no code: nothing",
   "expect": "nofire",
   "event": "SessionStart",
   "payload": {"source": "startup"},
   "project": {"git_init": true, "files": {"notes.txt": "x\n", ".ai/last-review": "0123abc\n"}, "commit": "init"}
  }
 ]
}
