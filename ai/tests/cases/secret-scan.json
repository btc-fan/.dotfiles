{
 "rule": "secret-scan",
 "cases": [
  {
   "name": "token in staged diff",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'add config'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "config.py": "TOKEN = '{{GH_TOKEN}}'\n"
    }
   },
   "contains": "github-token"
  },
  {
   "name": "clean staged diff",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'add code'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "app.py": "print('hello')\n"
    }
   }
  },
  {
   "name": "allowlisted context7 key",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'mcp'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "mcp.json": "{\"key\": \"{{CTX7_KEY}}\"}\n"
    }
   },
   "ai_mcp": "{\"CONTEXT7_API_KEY\": \"{{CTX7_KEY}}\"}"
  },
  {
   "name": "a second context7 key is not allowlisted",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'mcp'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "mcp.json": "{\"key\": \"{{CTX7_OTHER}}\"}\n"
    }
   },
   "ai_mcp": "{\"CONTEXT7_API_KEY\": \"{{CTX7_KEY}}\"}"
  },
  {
   "name": "placeholder value is not a secret",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "env.example": "API_KEY = \"your-api-key-goes-here-xxxxxxxx\"\n"
    }
   }
  },
  {
   "name": "git status is not gated",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git status"
    }
   },
   "project": {
    "git_init": true
   }
  },
  {
   "name": "scan timeout denies (never passes unscanned)",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "a.txt": "hello\n"
    },
    "files": {
     "bin/gitleaks": "#!/bin/sh\nsleep 5\n"
    }
   },
   "env": {
    "PATH": "{{PROJ}}/bin:/usr/bin:/bin",
    "AI_SCAN_BUDGET_S": "1.5"
   },
   "contains": "timed out"
  },
  {
   "name": "fast gitleaks without findings passes",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "a.txt": "hello\n"
    },
    "files": {
     "bin/gitleaks": "#!/bin/sh\nfor a; do [ \"$p\" = 1 ] && echo '[]' > \"$a\"; p=0; [ \"$a\" = --report-path ] && p=1; done\nexit 0\n"
    }
   },
   "env": {
    "PATH": "{{PROJ}}/bin:/usr/bin:/bin"
   }
  },
  {
   "name": "gates.log never holds the token",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'key {{GH_TOKEN}}'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "k.py": "T = '{{GH_TOKEN}}'\n"
    }
   },
   "state_contains": {
    "gates.log": "DENY secret-scan"
   },
   "state_not_contains": {
    "gates.log": "{{GH_TOKEN}}"
   }
  },
  {
   "name": "key only in the working tree is not allowlisted",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'mcp'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "mcp.json": "{\"key\": \"{{CTX7_KEY}}\"}\n"
    }
   },
   "ai_mcp": "{\"CONTEXT7_API_KEY\": \"{{CTX7_KEY}}\"}",
   "ai_mcp_commit": false
  },
  {
   "name": "key from secrets.env is allowlisted",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'mcp'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "mcp.json": "{\"key\": \"{{CTX7_KEY}}\"}\n"
    }
   },
   "secrets_env": "CONTEXT7_API_KEY={{CTX7_KEY}}\n"
  },
  {
   "name": "allowlist is exact, not substring",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'mcp'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "mcp.json": "{\"key\": \"{{CTX7_KEY}}x9extra\"}\n"
    }
   },
   "secrets_env": "CONTEXT7_API_KEY={{CTX7_KEY}}\n"
  },
  {
   "name": "git add + commit scans untracked files",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git add -A && git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "files": {
     "config.py": "TOKEN = '{{GH_TOKEN}}'\n"
    }
   }
  },
  {
   "name": "commit -a scans unstaged tracked changes",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -am x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "a.txt": "one\n"
    },
    "files": {
     "a.txt": "TOKEN = '{{GH_TOKEN}}'\n"
    }
   }
  },
  {
   "name": "git global options",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git -c user.name=x --no-pager commit -m y"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "k.py": "T = '{{GH_TOKEN}}'\n"
    }
   }
  },
  {
   "name": "cd before commit",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "cd sub && git commit -m y"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "sub/k.py": "T = '{{GH_TOKEN}}'\n"
    }
   }
  },
  {
   "name": "message text is not scanned",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'remove the ghp token mention'"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "a.txt": "hello\n"
    }
   }
  },
  {
   "name": "DB_PASSWORD quoted",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "s.py": "DB_PASSWORD = '{{PW}}'\n"
    }
   },
   "contains": "assigned-secret"
  },
  {
   "name": "unquoted .env token",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     ".env": "GITHUB_TOKEN={{ENVTOK}}\n"
    }
   }
  },
  {
   "name": "YAML api_key",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "c.yml": "api_key: {{ENVTOK}}\n"
    }
   }
  },
  {
   "name": "npm token",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     ".npmrc": "//registry.npmjs.org/:_authToken={{NPM_TOKEN}}\n"
    }
   },
   "contains": "npm-token"
  },
  {
   "name": "hf token",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "h.py": "login('{{HF_TOKEN}}')\n"
    }
   },
   "contains": "huggingface-token"
  },
  {
   "name": "DB URL with password",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "d.env": "DATABASE_URL={{DBURL}}\n"
    }
   },
   "contains": "url-with-password"
  },
  {
   "name": "env lookups and placeholders are fine",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m x"
    }
   },
   "project": {
    "git_init": true,
    "stage": {
     "ok.py": "password = os.environ[\"DB_PASSWORD\"]\ntoken = settings.API_TOKEN_FROM_ENVIRONMENT\nurl = 'postgres://user:password@localhost/db'\nAPI_KEY=${API_KEY}\n"
    }
   }
  }
 ]
}
