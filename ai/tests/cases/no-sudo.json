{
 "rule": "no-sudo",
 "cases": [
  {
   "name": "sudo apt install",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo apt install -y jq"
    }
   },
   "contains": "No sudo for agents"
  },
  {
   "name": "sudo behind env and a shell -c",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "FOO=1 env bash -c 'sudo python3 -c 1'"
    }
   }
  },
  {
   "name": "root shell after &&",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "ls && sudo -i"
    }
   }
  },
  {
   "name": "su and doas behind timeout",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "timeout 5 doas ls; su -"
    }
   }
  },
  {
   "name": "Codex gets a block too",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo systemctl restart x"
    },
    "turn_id": "t"
   },
   "agent": "codex"
  },
  {
   "name": "sudo only as quoted text",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'never use sudo here' --dry-run"
    }
   }
  },
  {
   "name": "echo of the word",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "echo sudo"
    }
   }
  },
  {
   "name": "plain command",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "ls -la"
    }
   }
  },
  {
   "name": "Linux: sudo proj-agent is denied; Claude is told to use the box MCP tools",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo -n proj-agent exec web -- ls"
    }
   },
   "project": {
    "git": true,
    "files": {}
   },
   "env": {
    "AI_GATE_PLATFORM": "linux"
   },
   "contains": [
    "box MCP tools",
    "No sudo for proj-agent"
   ]
  },
  {
   "name": "Linux: chained sudo proj-agent is denied too",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo proj-agent list && ls"
    }
   },
   "project": {
    "git": true,
    "files": {}
   },
   "env": {
    "AI_GATE_PLATFORM": "linux"
   },
   "contains": "box MCP tools"
  },
  {
   "name": "Linux: other sudo still blocked",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo -n bash"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux"
   }
  },
  {
   "name": "plain proj-agent is not sudo",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "proj-agent new try web"
    }
   }
  },
  {
   "name": "Linux: bare proj-agent is not rewritten (box work goes through the MCP tools)",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "proj-agent list"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "not_contains": "updatedInput"
  },
  {
   "name": "Linux: git push becomes the absolute root-owned git and still asks",
   "expect": "ask",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git push origin feat/x"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "contains": "/bin/git push origin feat/x\""
  },
  {
   "name": "Linux: read-only gh form becomes absolute and runs",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "gh pr view 12"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "contains": "/bin/gh pr view 12\""
  },
  {
   "name": "Linux: a gate still wins over the absolute rewrite (gh pr create without the PR body)",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "gh pr create --fill"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "not_contains": "updatedInput"
  },
  {
   "name": "Linux: chained git push is not rewritten (stays sandboxed)",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git push && rm -rf x"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "not_contains": "updatedInput"
  },
  {
   "name": "Linux: a bare excluded entry is ignored (never trusted from PATH)",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "gh issue list"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "not_contains": "updatedInput"
  },
  {
   "name": "Linux, Codex: sudo proj-agent denied; plain proj-agent or the box tools",
   "agent": "codex",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "sudo proj-agent list"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux"
   },
   "contains": "plain `proj-agent <subcommand>` without sudo"
  },
  {
   "name": "rtk proxy sudo",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "rtk proxy sudo -n true"
    }
   }
  },
  {
   "name": "rtk sudo",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "rtk sudo -n true"
    }
   }
  },
  {
   "name": "stdbuf with options before sudo",
   "expect": "deny",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "stdbuf -oL sudo -n true"
    }
   }
  },
  {
   "name": "Linux: rtk git push (RTK's form) becomes the absolute git and asks",
   "expect": "ask",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "rtk git push origin feat/x"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "contains": "/bin/git push origin feat/x\""
  },
  {
   "name": "Linux: rtk proxy gh pr view becomes the absolute gh",
   "expect": "allow",
   "event": "PreToolUse",
   "payload": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "rtk proxy gh pr view 12"
    }
   },
   "project": {
    "git": true,
    "files": {
     "bin/git": "#!/bin/sh\n",
     "bin/gh": "#!/bin/sh\n",
     "managed.json": "{\"sandbox\": {\"excludedCommands\": [\"{{PROJ}}/bin/git push *\", \"{{PROJ}}/bin/gh pr view *\", \"{{PROJ}}/bin/gh pr create *\", \"gh issue list *\"]}}"
    }
   },
   "env": {
    "AI_GATE_PLATFORM": "linux",
    "AI_CLAUDE_MANAGED_SETTINGS": "{{PROJ}}/managed.json"
   },
   "contains": "/bin/gh pr view 12\""
  }
 ]
}
