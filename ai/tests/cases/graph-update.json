{
 "rule": "graph-update",
 "cases": [
  {
   "name": "code edit",
   "expect": "fire",
   "event": "PostToolUse",
   "payload": {
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{{PROJ}}/main.py",
     "old_string": "a",
     "new_string": "b"
    }
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n"
    }
   }
  },
  {
   "name": "doc edit",
   "expect": "nofire",
   "event": "PostToolUse",
   "payload": {
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{{PROJ}}/README.md",
     "old_string": "a",
     "new_string": "b"
    }
   },
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n"
    }
   }
  },
  {
   "name": "fires again after graphify update ran",
   "expect": "fire",
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n"
    }
   },
   "steps": [
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Write",
      "tool_input": {
       "file_path": "{{PROJ}}/a.py",
       "content": "x"
      }
     }
    },
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Bash",
      "tool_input": {
       "command": "graphify update ."
      }
     }
    },
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Write",
      "tool_input": {
       "file_path": "{{PROJ}}/b.py",
       "content": "y"
      }
     }
    }
   ]
  },
  {
   "name": "once until graphify update",
   "expect": "nofire",
   "project": {
    "git": true,
    "files": {
     "main.py": "print(1)\n"
    }
   },
   "steps": [
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Write",
      "tool_input": {
       "file_path": "{{PROJ}}/a.py",
       "content": "x"
      }
     }
    },
    {
     "event": "PostToolUse",
     "payload": {
      "tool_name": "Write",
      "tool_input": {
       "file_path": "{{PROJ}}/b.py",
       "content": "y"
      }
     }
    }
   ]
  }
 ]
}
