#!/usr/bin/env python3
"""ai-check: run one gate of the agent hook on one input, with no agent session.

Usage: ai-check <gate> --command "<cmd>" | --staged | --pr-body <file>  [--dir PATH]
       ai-check --list

The gate function is the one the agent hook runs (hooklib.GATES); ai-precommit and CI call the same code.
The input is data: a command line is parsed, never run.
  secret-scan   --command, --staged          the secret patterns, and gitleaks when it is on PATH
  pr-rules      --pr-body, --command         the PR body fields, and the diff of the branch against its base
  text          --staged, --pr-body, --command   the em dash character on added lines
--dir sets the folder (default: the current folder). The repo root comes from git rev-parse --show-toplevel.
Exit 0 = pass, 1 = fail (the gate id, the reason and how to fix it), 2 = wrong usage.
"""
import os
import subprocess
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "marketplace", "plugins", "ai-core", "hooks"))
from hooklib import CHECK_INPUTS, CHECK_NOT_OFFERED, run_check  # noqa: E402

MODES = ("--command", "--staged", "--pr-body")


def main(argv):
    if argv[:1] == ["--list"]:
        print_list()
        return 0

    gate, mode, value, where, problem = parse(argv)
    if problem:
        print("ai-check: %s\n%s" % (problem, __doc__.split("\n\n")[1]), file=sys.stderr)
        return 2

    root = toplevel(where)
    if mode == "--staged" and not root:
        print("ai-check %s: not a git repo: %s. Run it inside a git repo, or pass --dir PATH." % (gate, where),
              file=sys.stderr)
        return 2
    if mode == "--pr-body" and not os.path.isfile(value):
        print("ai-check %s: the body file %s does not exist. Write the PR body to a file first." % (gate, value))
        return 1

    cwd = root if mode == "--staged" else where
    found, notes = run_check(gate, cwd, cmd=value if mode == "--command" else None, staged=mode == "--staged",
                             body=value if mode == "--pr-body" else None)
    for note in notes:
        print("ai-check %s: note: %s" % (gate, note), file=sys.stderr)
    if found:
        print("[ai-check %s] fail: %s" % (gate, found))
        return 1
    print("ai-check %s: pass" % gate)
    return 0


def parse(argv):
    """(gate, mode, value, dir, problem). A problem means wrong usage."""
    args, where = list(argv), os.getcwd()
    if "--dir" in args:
        i = args.index("--dir")
        if i + 1 >= len(args):
            return None, None, None, where, "--dir needs a path"
        where = os.path.abspath(args[i + 1])
        del args[i:i + 2]

    gate = args.pop(0) if args else ""
    if gate in CHECK_NOT_OFFERED:
        return gate, None, None, where, "%s is not offered: %s." % (gate, CHECK_NOT_OFFERED[gate])
    if gate not in CHECK_INPUTS:
        return gate, None, None, where, "unknown gate %r. Run ai-check --list." % gate

    if len(args) not in (1, 2) or args[0] not in MODES:
        return gate, None, None, where, "give one input: %s" % " | ".join(MODES)
    mode = args[0]
    if (mode == "--staged") != (len(args) == 1):
        return gate, None, None, where, "%s %s" % (mode, "takes no value" if mode == "--staged" else "needs a value")
    if mode.lstrip("-") not in CHECK_INPUTS[gate]:
        return gate, None, None, where, "%s does not take %s" % (gate, mode)
    return gate, mode, args[1] if len(args) == 2 else None, where, None


def print_list():
    print("Offered gates and their inputs:")
    for gate, inputs in sorted(CHECK_INPUTS.items()):
        print("  %-22s --%s" % (gate, ", --".join(inputs)))
    print("Not offered, with the reason:")
    for gate, why in sorted(CHECK_NOT_OFFERED.items()):
        print("  %-22s %s" % (gate, why))


def toplevel(where):
    try:
        res = subprocess.run(["git", "-C", where, "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return res.stdout.decode().strip() if res.returncode == 0 else None


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:      # fail closed: a check that crashed did not pass
        print("ai-check: the check could not run (%s: %s). Fix the cause and run it again." % (
            type(exc).__name__, exc), file=sys.stderr)
        sys.exit(1)
