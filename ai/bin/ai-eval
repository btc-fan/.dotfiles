#!/usr/bin/env python3
"""ai-eval: fixture repos and the install and behaviour levels of the AI setup tests.

  ai-eval fixtures DIR                  make the fixture repos in DIR
  ai-eval install [--keep] [--out DIR]  ai-adopt twice on each fixture in a throwaway HOME (no-git: refused, then
                                        --init), then ai-doctor --project-only and uninstall.sh --user (it has
                                        nothing recorded there: install.sh never runs at this level). A pass:
                                        both runs rc 0, the second changes no file git sees, doctor and
                                        uninstall rc 0. Exit 0 unless the harness itself breaks.
  ai-eval behaviour [--agent claude|codex|both] [--runs N] [--dry] [--out DIR]
                                        one fresh headless session per case and run, on a fresh copy of the
                                        adopted fixture; cases are ai/evals/cases/*.json. --dry only lists the runs.
  ai-eval scenario [--agent claude|codex|both] [--runs N] [--only ID] [--dry] [--out DIR]
                                        multi-session runs on ONE repo copy (ai/evals/scenarios/*.json): each step
                                        is a session (scored like a case), a harness git or write step, or a state
                                        check. --only runs the scenarios whose id starts with ID (gate-: the gate
                                        set). The summary has one row per scenario: a gate- scenario passes only
                                        when every run passes ("flaky" when some do); the others print a rate.

Fixtures: empty-git (git init only), docs-only (README.md, docs/*.md), no-git (a plain folder), app (Python package,
pytest test, Makefile with check, .claude/skills/verify-app/SKILL.md, AGENTS.md with a Libraries block for
pytest), project-copy (a clone of $AI_EVAL_PROJECT
without its remotes; skipped when the variable is not set).
Case file: {"id", "fixture", "prompt", "expect": {"skills": [...], "tools": [regex, ...], "rules": [rule id, ...],
"not_skills": [...], "not_rules": [...], "not_tools": [regex, ...]}}. A run is a hit when every expected item is
seen and no not_* item is seen. A should-not-fire case has only not_* items.
Seen: Skill tool calls, a Read or shell command on a skills/<name>/SKILL.md, tool calls ("Name {input json}"), and
the rules and skills in fired.jsonl of the run.
Child sessions: HC_TERMINAL_ID and HERDR_* are unset (the herdr PermissionRequest hook waits up to 30 minutes
otherwise). AI_STATE_DIR points to a folder of the run, so the router writes fired.jsonl and misses.jsonl there,
not into the owner's stats.
Scenario file: {"id", "fixture", "steps": [{"session": prompt, "expect": {...}} | {"git": [[arg, ...], ...]} |
{"check": {"map_contains": text, "branch": name, "graph": "fresh"}}]}. Git steps run with the repo's own hooks (a
merge refreshes the graph as on a real machine). A run passes when every session is a hit and every check holds.
Scenario options: "agents" (only these agents); "plugin": "checkout" (the sessions load this checkout's ai-core, as
verify-ai-setup drives them: Claude --plugin-dir, Codex a temp CODEX_HOME with its hooks; AI_HOME and routing from
this checkout; the pre-commit hook runs this checkout's ai-precommit; a fake gh logs to <run>/gh.log); "skills"
(this checkout's ai/skills/<name> copied into the repo's .claude/skills and .agents/skills, git-excluded: a skill
under test that is not installed); "allow" (more Claude allowed tools). Session options: "max_turns"; expect
"says": [regex, ...] on the raw transcript. Write step: {"write": {path: text}} inside the repo. Checks with a
checkout plugin: "hook": {"event", "payload", "where": "repo"|"worktree", "decision"} replays this checkout's
router on the end state, with the turn start of the last session (no loop counts); "git_out": {"args", "match"};
"gh_log": regex; "no_call": regex (absent from gh.log and calls.log); "no_skill": name (no skill proof in the
router state of the last session); "reply": {"max_words", "first_line_not"} on the last reply; "cmd": [arg, ...]
must exit 0 in the repo; "count": {"tools": regex} (a number, not a pass: tool calls that match, turns, tokens).
Session expect "walls": [gate id, ...]: the deny (or Claude ask) of each gate is seen. Claude: a hook_response in
the stream (--include-hook-events). Codex: a row in walls.jsonl of the run's AI_STATE_DIR (codex exec --json has
no hook events). With a checkout plugin, a session whose hooks never ran (no router session state) is an error.
More scenario options with a checkout plugin: "profile" (the ai-render profile, default dev-mac); "fakes" (fake
programs on the session PATH that log to <run>/calls.log, for example sudo, npm, systemctl); "drop_rules" (rule
ids left out of routing.json, to compare a session with and without a rule).
Reports: a table on stdout and <level>.json in --out (default: a new temp folder; never inside this repo).
"""
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time

BIN = os.path.dirname(os.path.realpath(__file__))
AI_DIR = os.path.dirname(BIN)
AI_HOME = os.path.dirname(AI_DIR)
CASES = os.path.join(AI_DIR, "evals", "cases")
SCENARIOS = os.path.join(AI_DIR, "evals", "scenarios")
ADOPT = os.path.join(BIN, "ai-adopt")
DOCTOR = os.path.join(BIN, "ai-doctor")
UNINSTALL = os.path.join(AI_HOME, "uninstall.sh")
FIXTURES = ("empty-git", "docs-only", "no-git", "app", "owner-rules", "project-copy")
ADOPT_TIMEOUT = 1800
RUN_TIMEOUT = 900
SKILL_FILE_RX = re.compile(r"([^\s\"']*)/skills/([\w.:-]+)/SKILL\.md")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    cmd, args = argv[0], argv[1:]

    if cmd == "fixtures" and len(args) == 1:
        for name, note in make_fixtures(args[0], os.environ.get("AI_EVAL_PROJECT")).items():
            print("%-13s %s" % (name, note or "made"))
        return 0

    opts = parse(args)
    if cmd == "install":
        return install(opts)
    if cmd == "behaviour":
        return behaviour(opts)
    if cmd == "scenario":
        return scenario(opts)
    print(__doc__)
    return 2


def parse(args):
    opts = {"keep": False, "dry": False, "agent": "both", "runs": 3, "out": None, "only": None}
    args = list(args)
    while args:
        a = args.pop(0)
        if a in ("--keep", "--dry"):
            opts[a[2:]] = True
        elif a == "--agent" and args and args[0] in ("claude", "codex", "both"):
            opts["agent"] = args.pop(0)
        elif a == "--runs" and args and args[0].isdigit() and int(args[0]) > 0:
            opts["runs"] = int(args.pop(0))
        elif a in ("--out", "--only") and args:
            opts[a[2:]] = args.pop(0)
        else:
            sys.exit("ai-eval: bad argument: %s (see ai-eval --help)" % a)
    return opts


# ---------------------------------------------------------------- install level

def install(opts):
    out = out_dir(opts)
    work = tempfile.mkdtemp(prefix="ai-eval-install-")
    rows = []
    try:
        notes = make_fixtures(os.path.join(work, "fixtures"), os.environ.get("AI_EVAL_PROJECT"))
        for name in FIXTURES:
            if notes[name]:
                rows.append({"fixture": name, "adopt_rc": None, "second_rc": None, "second_run_changed": None,
                             "changed": [], "pass": None, "notes": notes[name]})
                continue
            rows.append(install_row(name, os.path.join(work, "fixtures", name), os.path.join(work, "home-" + name)))
    finally:
        if opts["keep"]:
            print("kept: " + work)
        else:
            shutil.rmtree(work, ignore_errors=True)

    print_table(["fixture", "adopt rc", "second-run diff", "pass", "notes"],
                [[r["fixture"], r["adopt_rc"], yes_no(r["second_run_changed"]), yes_no(r["pass"]), r["notes"]]
                 for r in rows])
    write_report(out, "install", rows)
    return 0


def install_row(name, repo, home):
    env = adopt_env(home)
    refused_rc = None
    extra = []
    if name == "no-git":
        # A folder without git is refused (spec story 31); with --init it is set up like the others.
        refused_rc, _out = adopt(repo, env)
        extra = ["--init"]
    first_rc, first_out = adopt(repo, env, extra)
    kept = owner_text_kept(repo)
    before = snapshot(repo)
    second_rc, second_out = adopt(repo, env)
    kept = kept and owner_text_kept(repo) if name == "owner-rules" else None
    after = snapshot(repo)
    changed = sorted(p for p in set(before) | set(after) if before.get(p) != after.get(p))
    doctor_rc, doctor_out = call([sys.executable, DOCTOR, "--project-only", repo], env, repo, 300)
    uninstall_rc, uninstall_out = call(["bash", UNINSTALL, "--user", "--yes"], env, home, 300)

    notes = [last_line(first_out)]
    if refused_rc is not None and refused_rc != 1:
        notes.append("without --init: rc %s, not refused" % refused_rc)
    if second_rc != first_rc:
        notes.append("second run rc %s: %s" % (second_rc, last_line(second_out)))
    if changed:
        notes.append("changed: " + ", ".join(changed[:3]) + (" (+%d)" % (len(changed) - 3) if len(changed) > 3 else ""))
    if doctor_rc != 0:
        notes.append("ai-doctor rc %s: %s" % (doctor_rc, last_line(doctor_out)))
    if uninstall_rc != 0:
        notes.append("uninstall rc %s: %s" % (uninstall_rc, last_line(uninstall_out)))
    if kept is False:
        notes.append("owner text changed in AGENTS.md")
    ok = kept is not False and first_rc == 0 and second_rc == 0 and not changed and doctor_rc == 0 and uninstall_rc == 0 \
        and refused_rc in (None, 1)
    return {"fixture": name, "refused_rc": refused_rc, "adopt_rc": first_rc, "second_rc": second_rc,
            "second_run_changed": bool(changed), "changed": changed, "owner_text_kept": kept, "doctor_rc": doctor_rc,
            "uninstall_rc": uninstall_rc, "pass": ok, "notes": "; ".join(n for n in notes if n),
            "output": first_out[-4000:], "second_output": second_out[-4000:], "doctor_output": doctor_out[-4000:]}


def adopt(repo, env, extra=()):
    # --no-onboard: the onboard step is a headless claude session, and this level runs no agent.
    return call([sys.executable, ADOPT, "--dir", repo, "--yes", "--no-onboard"] + list(extra), env, repo,
                ADOPT_TIMEOUT)


def adopt_env(home):
    """The owner's env without the session variables, with a throwaway HOME, config dirs and router state."""
    os.makedirs(home, exist_ok=True)
    env = child_env(os.path.join(home, "state"))
    real_plugins = os.path.expanduser("~/.local/share/ai/plugins")
    if not env.get("AI_PLUGIN_SRC") and os.path.isdir(real_plugins):
        env["AI_PLUGIN_SRC"] = real_plugins      # skill links point to this machine's copies (read only)
    env.update(PYTHONUNBUFFERED="1", HOME=home, XDG_CONFIG_HOME=os.path.join(home, ".config"),
               CLAUDE_CONFIG_DIR=os.path.join(home, ".claude"), CODEX_HOME=os.path.join(home, ".codex"),
               GIT_AUTHOR_NAME="ai-eval", GIT_AUTHOR_EMAIL="ai-eval@example.invalid",
               GIT_COMMITTER_NAME="ai-eval", GIT_COMMITTER_EMAIL="ai-eval@example.invalid")
    return env


def snapshot(root):
    """path -> content hash of every file outside .git that git does not ignore, plus the HEAD commit.
    Ignored files (graphify-out caches, .serena caches) are local state: a change there is not a second-run diff."""
    rc, head = call(["git", "-C", root, "rev-parse", "-q", "--verify", "HEAD"], None, root, 60)
    snap = {"HEAD": head.strip() if rc == 0 else ""}
    rc, out = call(["git", "-C", root, "ls-files", "-z", "--others", "--ignored", "--exclude-standard"], None, root, 60)
    ignored = set(out.split("\0")) if rc == 0 else set()
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d != ".git"]
        for f in files + [d for d in dirs if os.path.islink(os.path.join(dirpath, d))]:
            path = os.path.join(dirpath, f)
            rel = os.path.relpath(path, root)
            if rel in ignored:
                continue
            if os.path.islink(path):
                snap[rel] = "link:" + os.readlink(path)
            elif os.path.isfile(path):
                with open(path, "rb") as fh:
                    snap[rel] = hashlib.sha1(fh.read()).hexdigest()
    return snap


# ---------------------------------------------------------------- behaviour level

def behaviour(opts):
    agents = ["claude", "codex"] if opts["agent"] == "both" else [opts["agent"]]
    cases = load_cases()
    plan = [(agent, case, n) for agent in agents for case in cases for n in range(1, opts["runs"] + 1)]

    if opts["dry"]:
        for agent, case, n in plan:
            print("%-6s %-20s run %d  fixture %-12s %s" % (agent, case["id"], n, case["fixture"],
                                                          " ".join(shlex.quote(c) for c in agent_cmd(agent, case["prompt"]))))
        print("%d runs planned, none started (--dry)" % len(plan))
        return 0

    out = out_dir(opts)
    notes = prepare(out, sorted({c["fixture"] for c in cases}))
    results = [run_case(out, notes, agent, case, n) for agent, case, n in plan]

    summary = []
    for agent in agents:
        rows = []
        for case in cases:
            mine = [r for r in results if r["agent"] == agent and r["case"] == case["id"]]
            hits = sum(1 for r in mine if r.get("hit"))
            errors = sum(1 for r in mine if r.get("hit") is None and "error" in r)
            scored = len(mine) - errors
            summary.append({"agent": agent, "case": case["id"], "expected": expected_text(case), "hits": hits,
                            "runs": scored, "errors": errors})
            rows.append([case["id"], expected_text(case), "%d/%d" % (hits, scored), errors or ""])
        print("\n%s" % agent)
        print_table(["case", "expected", "hits/runs", "errors"], rows)
        first = next((r["error"] for r in results if r["agent"] == agent and r.get("error")), "")
        if first:
            print("first error: " + first)
    write_report(out, "behaviour", {"summary": summary, "runs": results})
    return 0


def scenario(opts):
    agents = ["claude", "codex"] if opts["agent"] == "both" else [opts["agent"]]
    scs = [sc for sc in load_scenarios() if sc["id"].startswith(opts["only"] or "")]
    if not scs:
        sys.exit("ai-eval: no scenario %s" % opts["only"])
    plan = [(agent, sc, n) for agent in agents for sc in scs for n in range(1, opts["runs"] + 1)
            if agent in sc.get("agents", [agent])]

    if opts["dry"]:
        for agent, sc, n in plan:
            sessions = sum(1 for st in sc["steps"] if "session" in st)
            print("%-6s %-12s run %d  fixture %-10s %d steps, %d sessions" % (agent, sc["id"], n, sc["fixture"],
                                                                           len(sc["steps"]), sessions))
        print("%d runs planned, none started (--dry)" % len(plan))
        return 0

    out = out_dir(opts)
    notes = prepare(out, sorted({sc["fixture"] for sc in scs}))
    results = [run_scenario(out, notes, agent, sc, n) for agent, sc, n in plan]

    rows = []
    for agent in agents:
        for sc in scs:
            mine = [r for r in results if r["agent"] == agent and r["scenario"] == sc["id"]]
            if not mine:
                continue
            for i, step in enumerate(sc["steps"]):
                kind = next(iter(step))
                if kind in ("git", "write"):
                    continue
                oks = [r["steps"][i].get("ok") for r in mine if len(r["steps"]) > i]
                errors = sum(1 for ok in oks if ok is None)
                rows.append([agent, sc["id"], i + 1, step_text(step), "%d/%d" % (sum(1 for ok in oks if ok),
                                                                               len(oks) - errors), errors or ""])
            rows.append([agent, sc["id"], "all", "run passes", "%d/%d" % (sum(1 for r in mine if r["pass"]),
                                                                         len(mine)), ""])
    print_table(["agent", "scenario", "step", "expected", "ok/runs", "errors"], rows)
    print()
    print_table(["agent", "scenario", "result", "errors", "refusals", "seconds/run", "tokens/run", "numbers"],
                [summary_row(agent, sc["id"], [r for r in results if r["agent"] == agent and r["scenario"] == sc["id"]])
                 for agent in agents for sc in scs if any(r["agent"] == agent and r["scenario"] == sc["id"]
                                                          for r in results)])
    write_report(out, "scenario", {"runs": results})
    return 0


def summary_row(agent, sid, runs):
    """One row per scenario. A gate holds only when every scored run passes; a run with an error is not scored."""
    errors = sum(1 for r in runs if any(st.get("ok") is None for st in r["steps"]))
    scored = [r for r in runs if not any(st.get("ok") is None for st in r["steps"])]
    passes = sum(1 for r in scored if r["pass"])
    if not sid.startswith("gate-"):
        result = "rate %d/%d" % (passes, len(scored))
    elif not scored:
        result = "no scored run"
    else:
        result = "pass" if passes == len(scored) else ("flaky %d/%d" % (passes, len(scored)) if passes else "fail")
    sessions = [st for r in runs for st in r["steps"] if st.get("kind") == "session"]
    refusals = sum(1 for st in sessions if st.get("refusal"))
    counts = [st["got"]["count"] for r in scored for st in r["steps"] if "count" in st.get("got", {})]
    numbers = ""
    if counts:
        numbers = "matches %.1f, turns %.1f, tokens %d" % tuple(
            sum(c[k] for c in counts) / len(counts) for k in ("count", "turns", "tokens"))
    return [agent, sid, result, errors or "", refusals or "",
            "%d" % (sum(st.get("seconds", 0) for st in sessions) / max(len(runs), 1)),
            "%d" % (sum(st.get("tokens", 0) for st in sessions) / max(len(runs), 1)), numbers]


def load_scenarios():
    scs = []
    for name in sorted(os.listdir(SCENARIOS)) if os.path.isdir(SCENARIOS) else []:
        if name.endswith(".json"):
            with open(os.path.join(SCENARIOS, name), encoding="utf-8") as fh:
                scs.append(json.load(fh))
    return scs


def run_scenario(out, notes, agent, sc, n):
    """One run: the steps in order on one copy of the adopted fixture. A git step that fails stops the run."""
    result = {"agent": agent, "scenario": sc["id"], "run": n, "steps": [], "pass": False}
    if sc["fixture"] not in notes or notes[sc["fixture"]]:
        return dict(result, note=notes.get(sc["fixture"]) or "unknown fixture")

    base = os.path.join(out, "scenarios", agent, "%s-%d" % (sc["id"], n))
    repo = os.path.join(base, "repo")
    copy_fixture(os.path.join(out, "fixtures", sc["fixture"]), repo)
    checkout = checkout_setup(out, base, repo, sc) if sc.get("plugin") == "checkout" else None
    last = {}       # the last session: start time and session id, for a hook replay
    for i, step in enumerate(sc["steps"], 1):
        if "git" in step:
            rc, text = git_step(repo, step["git"])
            result["steps"].append({"kind": "git", "ok": rc == 0, "out": last_line(text)})
            if rc != 0:
                return result
        elif "write" in step:
            result["steps"].append(dict(write_step(repo, step["write"]), kind="write"))
        elif "session" in step:
            last = {"ts": time.time()}
            result["steps"].append(dict(session_step(base, repo, agent, step, i, checkout, last), kind="session"))
        else:
            result["steps"].append(dict(check_step(repo, step["check"], checkout, last), kind="check"))
    result["pass"] = all(st["ok"] for st in result["steps"])
    return result


def session_step(base, repo, agent, step, i, checkout=None, last=None):
    state = os.path.join(base, "state-%d" % i)
    cmd, env = agent_cmd(agent, step["session"], repo, step.get("max_turns")), child_env(state)
    if checkout:
        cmd, env = checkout_session(agent, cmd, env, repo, checkout)
    turns = int(step.get("max_turns") or 40)
    t0 = time.time()
    rc, text = call(cmd, env, repo, max(RUN_TIMEOUT, 20 * turns))
    write(os.path.join(base, "stream-%d.jsonl" % i), text)
    seen = score_stream(text)
    router = router_seen(state)
    seen["skills"] += router["skills"]
    seen["rules"] = router["rules"]
    seen["said"] = [rx for rx in step["expect"].get("says", []) if re.search(rx, text)]
    seen["walls"] = walls_seen(agent, text, state)
    if last is not None:
        last.update(state=state, text=text, session_id=next(
            (e.get("session_id") or e.get("thread_id") for e in json_lines(text)
             if e.get("subtype") == "init" or e.get("type") == "thread.started"), None))
    res = dict(usage(text), rc=rc, seen=seen, seconds=int(time.time() - t0))
    if (rc != 0 or '"terminal_reason": "api_error"' in text.replace('":"', '": "')) and not seen["tools"]:
        return dict(res, ok=None, error=run_error(text))
    if checkout and not os.path.isdir(os.path.join(state, "sessions")):
        # Codex: an untrusted hook never runs (edge case 6); Claude: the plugin did not load.
        return dict(res, ok=None, error="the router hooks did not run in this session")
    ok = hit(step["expect"], seen)
    return dict(res, ok=ok, refusal=agent == "claude" and not ok and not seen["tools"])


def write_step(repo, files):
    """Harness files (a fixture tool, a PR body): each path must stay inside the repo."""
    top = os.path.realpath(repo)
    for rel, text in files.items():
        path = os.path.realpath(os.path.join(repo, rel))
        if not path.startswith(top + os.sep):
            return {"ok": False, "error": "outside the repo: %s" % rel}
        write(path, text)
        if text.startswith("#!"):
            os.chmod(path, 0o755)
    return {"ok": True, "files": sorted(files)}


def git_step(repo, commands):
    """Harness git commands with the repo's own hooks (unlike git(), which turns hooks off for fixtures)."""
    text = ""
    for args in commands:
        rc, out = call(["git", "-c", "user.name=ai-eval", "-c", "user.email=ai-eval@example.invalid",
                        "-c", "commit.gpgsign=false", "-C", repo] + list(args), dict(os.environ), repo, 300)
        text += out
        if rc != 0:
            return rc, text
    return 0, text


def check_step(repo, check, checkout=None, last=None):
    """State checks between sessions: the Map names a module, the current branch, the graph freshness; with a
    checkout plugin also a hook replay, a git command's output and the fake gh log."""
    got = {}
    if "hook" in check:
        got["hook"] = replay_hook(repo, check["hook"], checkout, last or {})
    if "git_out" in check:
        text = call(["git", "-C", repo] + list(check["git_out"]["args"]), dict(os.environ), repo, 60)[1]
        got["git_out"] = bool(re.search(check["git_out"]["match"], text))
    if "gh_log" in check:
        got["gh_log"] = bool(re.search(check["gh_log"], read_file(os.path.join(checkout["base"], "gh.log"))))
    if "no_call" in check:
        calls = read_file(os.path.join(checkout["base"], "gh.log")) + read_file(os.path.join(checkout["base"], "calls.log"))
        got["no_call"] = not re.search(check["no_call"], calls, re.M)
    if "no_skill" in check:
        got["no_skill"] = check["no_skill"] not in router_seen((last or {}).get("state", ""))["skills"]
    if "cmd" in check:
        got["cmd"] = call(list(check["cmd"]), dict(os.environ), repo, 600)[0] == 0
    if "reply" in check:
        got["reply"] = reply_ok(final_reply((last or {}).get("text", "")), check["reply"])
    if "count" in check:
        got["count"] = dict(usage((last or {}).get("text", "")), count=sum(
            1 for t in score_stream((last or {}).get("text", ""))["tools"] if re.search(check["count"]["tools"], t)))
    if "map_contains" in check:
        got["map_contains"] = check["map_contains"] in map_section(repo)
    if "branch" in check:
        got["branch"] = (call(["git", "-C", repo, "branch", "--show-current"], dict(os.environ), repo, 30)[1]
                         .strip() == check["branch"])
    if "graph" in check:
        sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
        import hooklib
        got["graph"] = hooklib.graph_status(repo, hooklib.git_history(repo)) == check["graph"]
    ok = all(v is True or (k == "hook" and v == check["hook"]["decision"]) or k == "count" for k, v in got.items())
    return {"ok": ok, "got": got}


def map_section(repo):
    try:
        with open(os.path.join(repo, "AGENTS.md"), encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return ""
    m = re.search(r"^## Map\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    return m.group(1) if m else ""


def walls_seen(agent, text, state):
    """Gate ids whose deny (or Claude ask) this session saw: Claude hook_response events, Codex walls.jsonl rows."""
    if agent == "codex":
        return [row["wall"] for row in json_lines(read_file(os.path.join(state, "walls.jsonl"))) if row.get("wall")]
    walls = []
    for event in json_lines(text):
        if event.get("subtype") != "hook_response":
            continue
        out = str(event.get("output") or event.get("stdout") or "")
        if re.search(r'"permissionDecision":\s*"(deny|ask)"', out):
            walls += re.findall(r"\[ai (?:gate |router: )([\w.-]+)\]", out)
    return walls


def usage(text):
    """Turns and tokens of one session: the Claude result event, or the Codex turn.completed events."""
    turns = tokens = 0
    for event in json_lines(text):
        if event.get("type") == "result":
            turns = event.get("num_turns") or 0
            tokens = sum(v for k, v in (event.get("usage") or {}).items() if k.endswith("tokens") and isinstance(v, int))
        elif event.get("type") == "turn.completed":
            tokens += sum(v for k, v in (event.get("usage") or {}).items() if k.endswith("tokens") and isinstance(v, int))
    if not turns:   # shortcut: Codex has no turn count in --json; its tool calls stand in until it reports one
        turns = len(score_stream(text)["tools"])
    return {"turns": turns, "tokens": tokens}


def final_reply(text):
    """The last reply text: the Claude result, else the last Codex agent_message."""
    reply = ""
    for event in json_lines(text):
        item = event.get("item") or {}
        if event.get("type") == "result" and isinstance(event.get("result"), str):
            reply = event["result"]
        elif event.get("type") == "item.completed" and item.get("type") == "agent_message":
            reply = item.get("text") or ""
    return reply


def reply_ok(reply, spec):
    lines = [ln for ln in reply.splitlines() if ln.strip()]
    words = len(re.findall(r"\S+", re.sub(r"```.*?```", "", reply, flags=re.S)))   # code blocks do not count
    return (bool(lines) and words <= spec.get("max_words", words)
            and not (spec.get("first_line_not") and re.search(spec["first_line_not"], lines[0])))


def step_text(step):
    if "session" in step:
        return "session: " + expected_text(step)
    return "check: " + ", ".join("%s=%s" % kv for kv in sorted(step["check"].items()))


def load_cases():
    cases = []
    for name in sorted(os.listdir(CASES)):
        if name.endswith(".json"):
            with open(os.path.join(CASES, name), encoding="utf-8") as fh:
                cases.append(json.load(fh))
    return cases


# Scenario sessions write code and commit in the throwaway repo copy: edits plus these commands, nothing wider.
WRITE_TOOLS = ["Edit", "Write", "Bash(git *)", "Bash(uv *)", "Bash(python3 *)", "Bash(pytest *)", "Bash(make *)",
               "Bash(graphify *)", "Bash(rtk *)", "Bash(mkdir *)"]


def agent_cmd(agent, prompt, repo=None, turns=None):
    """The headless command. With repo (scenario sessions): write access inside that repo only."""
    if agent == "claude":
        # 15 turns: a Stop gate (diagnosing-bugs) blocks the first stop, and the agent needs turns after it.
        # 40 for a scenario session: it builds code, runs the tests and commits.
        cmd = ["claude", "-p", prompt, "--output-format", "stream-json", "--verbose", "--max-turns",
               str(turns or (40 if repo else 15))]
        if repo:
            cmd += ["--permission-mode", "acceptEdits", "--allowedTools"] + WRITE_TOOLS
        return cmd
    if repo:    # workspace-write keeps .git read-only: name it, so a branch and a commit work
        return ["codex", "exec", "--json", "-s", "workspace-write",
                "-c", 'sandbox_workspace_write.writable_roots=["%s"]' % os.path.join(repo, ".git"), prompt]
    return ["codex", "exec", "--json", prompt]


def prepare(out, names):
    """Make the fixtures once and adopt the ones the cases use (throwaway HOME); each run copies one."""
    notes = make_fixtures(os.path.join(out, "fixtures"), os.environ.get("AI_EVAL_PROJECT"))
    for name in names:
        if not notes.get(name):
            rc, text = adopt(os.path.join(out, "fixtures", name), adopt_env(os.path.join(out, "adopt-home")))
            print("adopt %s: rc %s, %s" % (name, rc, last_line(text)))
    return notes


def run_case(out, notes, agent, case, n):
    result = {"agent": agent, "case": case["id"], "run": n}
    if case["fixture"] not in notes or notes[case["fixture"]]:
        return dict(result, hit=False, note=notes.get(case["fixture"]) or "unknown fixture")

    base = os.path.join(out, "runs", agent, "%s-%d" % (case["id"], n))
    repo = os.path.join(base, "repo")
    state = os.path.join(base, "state")
    copy_fixture(os.path.join(out, "fixtures", case["fixture"]), repo)
    rc, text = call(agent_cmd(agent, case["prompt"]), child_env(state), repo, RUN_TIMEOUT)
    write(os.path.join(base, "stream.jsonl"), text)

    seen = score_stream(text)
    router = router_seen(state)
    seen["skills"] += router["skills"]
    seen["rules"] = router["rules"]
    if rc != 0 and not seen["tools"]:
        # The agent never acted (usage limit, auth, crash): an error, not a miss. hit None keeps it out of the score.
        return dict(result, rc=rc, hit=None, error=run_error(text), seen=seen)
    return dict(result, rc=rc, hit=hit(case["expect"], seen), seen=seen)


def run_error(text):
    """The error message of a failed run: a Codex error event, else the last output line."""
    for event in reversed(json_lines(text)):
        if event.get("type") == "error" and event.get("message"):
            return event["message"][:200]
        if event.get("type") == "result" and event.get("is_error") and isinstance(event.get("result"), str):
            return event["result"][:200]
    return last_line(text)


def child_env(state):
    env = {k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID" and not k.startswith("HERDR_")}
    env["AI_STATE_DIR"] = state
    return env


def score_stream(text):
    """Skills and tool calls in a Claude stream-json or Codex --json transcript (one JSON event per line)."""
    seen = {"skills": [], "tools": []}
    for event in json_lines(text):
        for name, args in tool_calls(event):
            seen["tools"].append("%s %s" % (name, json.dumps(args, sort_keys=True)))
            if name == "Skill" and args.get("skill"):
                seen["skills"].append(args["skill"])
            if name in ("Read", "Bash"):
                seen["skills"] += skill_files(json.dumps(args))
    return seen


def tool_calls(event):
    """(name, input) of each tool call in one event: Claude tool_use blocks, Codex completed items."""
    msg = event.get("message")
    if event.get("type") == "assistant" and isinstance(msg, dict):
        return [(b.get("name"), b.get("input") or {}) for b in msg.get("content") or []
                if isinstance(b, dict) and b.get("type") == "tool_use"]
    # shortcut: Codex item shapes (command_execution, mcp_tool_call) as documented for codex exec --json;
    # check them against a recorded Codex transcript when the first real baseline runs.
    item = event.get("item")
    if event.get("type") == "item.completed" and isinstance(item, dict):
        if item.get("type") == "command_execution":
            return [("Bash", {"command": item.get("command") or ""})]
        if item.get("type") == "mcp_tool_call":
            return [("mcp__%s__%s" % (item.get("server"), item.get("tool")), item.get("arguments") or {})]
    return []


def skill_files(text):
    """Skill names from SKILL.md paths; a Claude plugin cache path gives <plugin>:<skill>."""
    names = []
    for prefix, skill in SKILL_FILE_RX.findall(text):
        cache = prefix.split("/plugins/cache/", 1)
        parts = cache[1].split("/") if len(cache) == 2 else []
        names.append("%s:%s" % (parts[1], skill) if len(parts) > 1 else skill)
    return names


def router_seen(state):
    """Rules and skills the router logged in this run's state folder."""
    seen = {"rules": [], "skills": []}
    try:
        with open(os.path.join(state, "fired.jsonl"), encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return seen
    for row in json_lines(text):
        if row.get("kind") == "rule" and row.get("rule") and row["rule"] not in seen["rules"]:
            seen["rules"].append(row["rule"])
        if row.get("kind") == "skill" and row.get("skill"):
            seen["skills"].append(row["skill"])
    return seen


def json_lines(text):
    """The JSON objects of a JSONL text; a line that is not a JSON object is skipped."""
    rows = []
    for line in text.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def hit(expect, seen):
    return (all(s in seen["skills"] for s in expect.get("skills", []))
            and all(any(re.search(rx, t) for t in seen["tools"]) for rx in expect.get("tools", []))
            and all(r in seen.get("rules", []) for r in expect.get("rules", []))
            and all(rx in seen.get("said", []) for rx in expect.get("says", []))
            and all(w in seen.get("walls", []) for w in expect.get("walls", []))
            and not any(s in seen["skills"] for s in expect.get("not_skills", []))
            and not any(r in seen.get("rules", []) for r in expect.get("not_rules", []))
            and not any(re.search(rx, t) for rx in expect.get("not_tools", []) for t in seen["tools"]))


def expected_text(case):
    exp = case["expect"]
    parts = ["skill " + s for s in exp.get("skills", [])] + ["tool /%s/" % t for t in exp.get("tools", [])]
    parts += ["rule " + r for r in exp.get("rules", [])] + ["says /%s/" % t for t in exp.get("says", [])]
    parts += ["deny " + w for w in exp.get("walls", [])]
    parts += ["not " + s for s in exp.get("not_skills", [])]
    parts += ["not rule " + r for r in exp.get("not_rules", [])] + ["not tool /%s/" % t for t in exp.get("not_tools", [])]
    return ", ".join(parts)


# ---------------------------------------------------------------- checkout plugin (scenario "plugin": "checkout")

PLUGIN = os.path.join(AI_DIR, "marketplace", "plugins", "ai-core")
ROUTER = os.path.join(PLUGIN, "hooks", "router.py")
NO_INSTALLED_CORE = {"ai-core@ai": False}       # the installed copy stays off in a session
FAKE_GH = """#!/bin/sh
# fake gh (ai-eval, verify-ai-setup): logs the call, never reaches GitHub
echo "gh $*" >> '%s'
case "$1 $2" in
  "pr list"|"pr view"|"api "*) echo '[]' ;;
  "auth status") echo 'Logged in to github.com (fake)' ;;
esac
exit 0
"""
FAKE_CALL = """#!/bin/sh
# fake program (ai-eval scenario "fakes"): logs the call, changes nothing
echo "%s $*" >> '%s'
exit 0
"""


def checkout_setup(out, base, repo, sc):
    """This checkout in one scenario run: the pinned pre-commit hook, the stand-in skills, the fake gh, routing."""
    hook = os.path.join(repo, ".git", "hooks", "pre-commit")
    if os.path.isfile(hook):    # a session shell reads the owner profile: PATH would find the installed copy
        write(hook, "#!/bin/sh\nexec %s\n" % shlex.quote(os.path.join(BIN, "ai-precommit")))
        os.chmod(hook, 0o755)
    exclude = []
    for name in sc.get("skills", []):
        for d in (".claude", ".agents"):
            shutil.copytree(os.path.join(AI_DIR, "skills", name), os.path.join(repo, d, "skills", name))
            exclude.append("/%s/skills/%s" % (d, name))
    if exclude:
        with open(os.path.join(repo, ".git", "info", "exclude"), "a", encoding="utf-8") as fh:
            fh.write("\n".join(exclude) + "\n")
    write(os.path.join(base, "bin", "gh"), FAKE_GH % os.path.join(base, "gh.log"))
    os.chmod(os.path.join(base, "bin", "gh"), 0o755)
    for name in sc.get("fakes", []):
        write(os.path.join(base, "bin", name), FAKE_CALL % (name, os.path.join(base, "calls.log")))
        os.chmod(os.path.join(base, "bin", name), 0o755)
    routing = render_routing(out, sc.get("profile", "dev-mac"))
    if sc.get("drop_rules"):
        data = json.loads(read_file(routing))
        data["rules"] = [r for r in data["rules"] if r.get("id") not in sc["drop_rules"]]
        routing = os.path.join(base, "routing.json")
        write(routing, json.dumps(data))
    env = {"PATH": os.pathsep.join([os.path.join(base, "bin"), BIN, os.environ.get("PATH", "")]),
           "AI_HOME": AI_HOME, "AI_ROUTING_JSON": routing, "AI_NOTIFY_DRY": "1"}
    return {"base": base, "env": env, "allow": sc.get("allow", [])}


def checkout_session(agent, cmd, env, repo, checkout):
    """The session command and env with this checkout's ai-core instead of the installed one."""
    env = dict(env, **checkout["env"])
    if agent == "claude":
        i = cmd.index("--allowedTools") + 1
        cmd[i:i] = ["Bash(gh *)"] + list(checkout["allow"])
        settings = {"enabledPlugins": NO_INSTALLED_CORE, "env": env_list()}
        return cmd + ["--plugin-dir", PLUGIN, "--settings", json.dumps(settings), "--strict-mcp-config",
                      "--include-hook-events"], env
    env.update(env_list(), CODEX_HOME=codex_home(os.path.join(checkout["base"], "codex-home")))
    # the run folder is writable too: the fake gh and fakes log there, and a bare remote there takes a push,
    # so the end state shows the hook, not the sandbox
    i = cmd.index("-c") + 1
    cmd[i] = 'sandbox_workspace_write.writable_roots=["%s", "%s"]' % (os.path.join(repo, ".git"), checkout["base"])
    return cmd, env


def replay_hook(repo, spec, checkout, last):
    """This checkout's router on the end state: a fresh state folder whose session has only the turn start of the
    last session, so the decision is the hook's own and no loop limit counts. "allow", "block", "deny" or a note."""
    root = repo
    if spec.get("where") == "worktree":
        trees = sorted(glob.glob(os.path.join(repo, ".claude", "worktrees", "*")), key=os.path.getmtime)
        if not trees:
            return "no worktree under .claude/worktrees"
        root = trees[-1]
    sid = last.get("session_id") or "ai-eval-replay"
    state = tempfile.mkdtemp(prefix="ai-eval-replay-")
    try:
        write(os.path.join(state, "sessions", re.sub(r"[^A-Za-z0-9_.-]", "_", sid)[:120] + ".json"),
              json.dumps({"turn": {"ts": last.get("ts") or time.time(), "roots": {}}}))
        payload = dict({"session_id": sid, "cwd": root, "hook_event_name": spec["event"], "stop_hook_active": False},
                       **spec.get("payload", {}))
        env = dict(child_env(state), **checkout["env"])
        res = subprocess.run([sys.executable, ROUTER, "--agent", spec.get("agent", "claude"), spec["event"]],
                             input=json.dumps(payload).encode(), env=env, cwd=root, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, timeout=60)
    finally:
        shutil.rmtree(state, ignore_errors=True)
    for event in json_lines(res.stdout.decode("utf-8", "replace")):
        if event.get("decision") == "block":
            return "block"
        if (event.get("hookSpecificOutput") or {}).get("permissionDecision") in ("deny", "ask"):
            return event["hookSpecificOutput"]["permissionDecision"]
    return "allow"


def render_routing(out, profile="dev-mac"):
    """routing.json of this checkout (ai-render --profile PROFILE), once per out folder and profile."""
    build = os.path.join(out, "build" if profile == "dev-mac" else "build-" + profile)
    if not os.path.isfile(os.path.join(build, "routing.json")):
        call([sys.executable, os.path.join(BIN, "ai-render"), "--profile", profile, "--out", build],
             dict(os.environ), AI_HOME, 120)
    return os.path.join(build, "routing.json")


def env_list():
    """This checkout's ai/adapters/env.list (KEY=VALUE lines), the env install.sh gives every agent."""
    pairs = (line.partition("=") for line in read_file(os.path.join(AI_DIR, "adapters", "env.list")).splitlines()
             if re.match(r"[A-Z0-9_]+=", line))
    return {k: v for k, _eq, v in pairs}


def codex_home(home):
    """A temp CODEX_HOME: the login by link, this checkout's hooks as user hooks, trust from aiconf."""
    if not os.path.isdir(home):
        os.makedirs(home)
        os.symlink(os.path.expanduser("~/.codex/auth.json"), os.path.join(home, "auth.json"))
        hooks = os.path.join(home, "hooks.json")
        write(hooks, read_file(os.path.join(PLUGIN, "hooks", "codex-hooks.json")).replace("${PLUGIN_ROOT}", PLUGIN))
        write(os.path.join(home, "config.toml"), "[features]\nhooks = true\n")
        call([sys.executable, os.path.join(AI_DIR, "lib", "aiconf.py"), "codex-trust-hooks",
              os.path.join(home, "config.toml"), "--source", "%s=%s" % (hooks, hooks)], None, home, 60)
    return home


# ---------------------------------------------------------------- fixtures

def make_fixtures(root, project=None):
    """Make each fixture in root. Returns fixture -> None (made) or a note why it was skipped."""
    notes = {}
    for name in FIXTURES:
        os.makedirs(os.path.join(root, name))

    git_init(os.path.join(root, "empty-git"))
    notes["empty-git"] = None

    docs = os.path.join(root, "docs-only")
    write(os.path.join(docs, "README.md"), "# docs-only\n\nA repo with Markdown only.\n")
    write(os.path.join(docs, "docs", "guide.md"), "# Guide\n\nStep 1. Read the README.\n")
    write(os.path.join(docs, "docs", "faq.md"), "# FAQ\n\nNo questions yet.\n")
    git_commit(docs)
    notes["docs-only"] = None

    write(os.path.join(root, "no-git", "notes.txt"), "a folder without git\n")
    notes["no-git"] = None

    for rel, text in APP_FILES.items():
        write(os.path.join(root, "app", rel), text)
    git_commit(os.path.join(root, "app"))
    notes["app"] = None

    for rel, text in dict(APP_FILES, **{"AGENTS.md": OWNER_AGENTS}).items():
        write(os.path.join(root, "owner-rules", rel), text)
    git_commit(os.path.join(root, "owner-rules"))
    notes["owner-rules"] = None

    notes["project-copy"] = copy_project(project, os.path.join(root, "project-copy"))
    return notes


# The block ai-libs --sync writes (no lockfile: lock none, version "?"), so the docs-lookup case has a context7 ID.
# test_eval.py checks that it matches ai-libs render() byte for byte.
APP_LIBRARIES = ("<!-- AI:libraries START lock: none -->\n## Libraries\n"
                 'Docs: context7 query-docs with the ID below; skip resolve-library-id. "?" = not looked up yet, '
                 '"-" = no match or not sent. Generated by ai-libs --sync; edit only the note column.\n\n'
                 "| lib | version | context7 | note |\n|---|---|---|---|\n"
                 "| pytest | ? | /pytest-dev/pytest |  |\n<!-- AI:libraries END -->\n")

APP_FILES = {
    "README.md": "# app\n\nA small calculator.\n",
    "pyproject.toml": "[project]\nname = \"app\"\nversion = \"0.1.0\"\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\n",
    "app/__init__.py": "",
    "app/calc.py": "def add(a, b):\n    return a + b\n",
    "app/cli.py": "import sys\n\nfrom app.calc import add\n\n\ndef main():\n    print(add(int(sys.argv[1]), int(sys.argv[2])))\n",
    "tests/test_calc.py": "from app.calc import add\n\n\ndef test_add():\n    assert add(2, 3) == 5\n",
    "Makefile": "check:\n\tpython3 -m pytest -q\n",
    ".claude/skills/verify-app/SKILL.md": "---\nname: verify-app\ndescription: Use to verify the app: run "
                                          "python3 -m app.cli 2 3 and expect 5.\n---\n\n1. Run `python3 -m app.cli 2 3`.\n"
                                          "2. The output must be 5.\n",
    "AGENTS.md": "# app\n\n" + APP_LIBRARIES,
}


# owner-rules (owner 2026-11-17): project rules outside the AI blocks and an owner line inside one. Two ai-adopt
# runs must keep both byte for byte.
OWNER_SECTION = ("## Rules (mandatory for this repo)\n- Never edit the migrations folder by hand.\n\n"
                 "Done means: the owner saw it on staging.\n")
OWNER_INSIDE = "- Ask the owner before a schema change.\n"
OWNER_AGENTS = ("# owner-rules\n\n" + OWNER_SECTION + "\n<!-- AI:done START (ai-adopt; 6 lines, a rerun replaces it) -->\n"
                "## Done\n" + OWNER_INSIDE + "<!-- AI:done END -->\n")


def owner_text_kept(repo):
    try:
        with open(os.path.join(repo, "AGENTS.md"), encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return False
    return OWNER_SECTION in text and OWNER_INSIDE in text


def copy_project(project, dest):
    """A clone (committed files only) without remotes: an ai-adopt run in it can never push."""
    if not project:
        return "skipped: AI_EVAL_PROJECT not set"
    os.rmdir(dest)
    rc, text = call(["git", "clone", "-q", "--no-hardlinks", project, dest], None, None, 600)
    if rc != 0:
        return "skipped: git clone failed: " + last_line(text)
    for remote in git(dest, "remote").split():
        git(dest, "remote", "remove", remote)
    return None


def git_init(repo):
    git(repo, "init", "-q")
    git(repo, "config", "maintenance.auto", "false")     # later commits (ai-adopt, scenario steps) too


def git_commit(repo):
    git_init(repo)
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "-m", "init")


def git(repo, *args):
    cmd = ["git", "-c", "init.defaultBranch=main", "-c", "user.name=ai-eval", "-c", "user.email=ai-eval@example.invalid",
           "-c", "commit.gpgsign=false", "-c", "core.hooksPath=" + os.devnull,
           # a detached maintenance takes .git/objects/maintenance.lock, which vanishes while copy_fixture copies
           "-c", "maintenance.auto=false",
           "-c", "core.excludesFile=" + os.devnull, "-C", repo] + list(args)    # a global ignore may hide .claude/
    return subprocess.run(cmd, check=True, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, text=True).stdout


# ---------------------------------------------------------------- helpers

def copy_fixture(src, dst):
    """Copy a fixture repo; skip sockets (git fsmonitor leaves .git/fsmonitor--daemon.ipc, which cannot be copied)."""
    def sockets(folder, names):
        return [n for n in names if stat.S_ISSOCK(os.lstat(os.path.join(folder, n)).st_mode)]
    shutil.copytree(src, dst, symlinks=True, ignore=sockets)


def out_dir(opts):
    out = os.path.realpath(opts["out"] or tempfile.mkdtemp(prefix="ai-eval-"))
    if out == AI_HOME or out.startswith(AI_HOME + os.sep):
        sys.exit("ai-eval: --out must be outside the repo (%s)" % AI_HOME)
    os.makedirs(out, exist_ok=True)
    return out


def call(cmd, env, cwd, timeout):
    """(exit code, stdout + stderr). A missing command or a timeout is a result, not a crash."""
    try:
        res = subprocess.run(cmd, env=env, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        return "timeout", (exc.output or b"").decode("utf-8", "replace")
    except OSError as exc:
        return "error", str(exc)
    return res.returncode, res.stdout.decode("utf-8", "replace")


def write_report(out, name, data):
    path = os.path.join(out, name + ".json")
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
    print("report: " + path)


def print_table(headers, rows):
    rows = [["" if c is None else str(c) for c in r] for r in rows]
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(headers)]
    print("  ".join(h.ljust(w) for h, w in zip(headers, widths)).rstrip())
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())


def yes_no(value):
    return "-" if value is None else ("yes" if value else "no")


def last_line(text):
    lines = [ln.strip() for ln in (text or "").splitlines() if ln.strip()]
    return lines[-1][:160] if lines else ""


def read_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
