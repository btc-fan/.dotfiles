#!/usr/bin/env bash
# ai-playwright-mcp: start the Playwright MCP that ai-start installed on this machine: the highest
# ~/.local/share/ai/npm/playwright-mcp-<version> folder (ai-start installs the newest stable release).
# Project .mcp.json and .codex/config.toml run this command, so no npx and no download happen at runtime.
set -euo pipefail

base="$HOME/.local/share/ai/npm"
bin=""
for ver in $({ ls -1 "$base" 2>/dev/null || true; } | sed -n 's/^playwright-mcp-\([0-9][0-9.]*\)$/\1/p' \
        | sort -t. -k1,1nr -k2,2nr -k3,3nr); do
    if [ -x "$base/playwright-mcp-$ver/node_modules/.bin/mcp-server-playwright" ]; then
        bin="$base/playwright-mcp-$ver/node_modules/.bin/mcp-server-playwright"
        break
    fi
done

if [ -z "$bin" ]; then
    echo "ai-playwright-mcp: @playwright/mcp is not installed on this machine." >&2
    echo "Run ai-start in the project (it installs the newest stable, audited release once)." >&2
    exit 1
fi
exec "$bin" "$@"
