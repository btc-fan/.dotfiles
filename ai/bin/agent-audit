#!/usr/bin/env bash
# agent-audit: check a package, folder, skill or plugin BEFORE use. Port of the server wrapper.
# Exit 0 = nothing found (PASS), 1 = findings (FAIL, read them before use), 2 = usage error,
# 3 = a scanner could not run (ERROR: not a finding, but no PASS either; fix the scanner, run again),
# 4 = skill-scanner found a HIGH or CRITICAL problem (REJECT, owner rule 2026-11-14, every profile): the
# source is never installed or updated, and no line in ai/audit-accepted.txt lets it through,
# 5 = skill-scanner was required (a skill or plugin: SKILL.md, .claude-plugin/, .codex-plugin/ or skills/) but
# could not run or gave no readable result (final too: no accept line lets an unscanned skill through).
# A plain tool source tree (none of those) is not a skill: skill-scanner is skipped there, with an info line.
# Package forms: `agent-audit pypi httpx 0.28.1`, `agent-audit pypi httpx==0.28.1`, `agent-audit npm left-pad@1.3.0`.
# Every run appends one line to ~/.local/state/ai/audit.log:
#   <iso-time> <ecosystem> <name> <version|-> PASS|PASS-SKILL|FAIL|ERROR|REJECT|SKIPPED
#   (PASS-SKILL: skill-scanner only, profile dev-mac; SKIPPED: profile dev-mac, npm/pypi). The gate needs PASS.
# The audit-before-install gate (ai-core router) allows an install only with a PASS for that
# package in the last 24 h.
# Network: downloads the package from npm/PyPI, and osv-scanner looks up package names + versions
# on osv.dev. No LLM judge, no VirusTotal, no Socket (sfw is not used: forced telemetry).
# A missing or failing scanner is an ERROR (fail closed: no PASS is recorded), shown apart from findings.
# No `set -e`: the script collects every scanner result in rc and reports them all.
set -uo pipefail
export SEMGREP_SEND_METRICS=off
export GUARDDOG_TELEMETRY=0

# Profile (ai/lib/profile.sh): dev-mac runs skill-scanner only (no guarddog, no osv-scanner); npm and pypi
# audits are skipped there, and said. An unknown or unreadable profile runs every scanner.
aa_src=$0
while [ -L "$aa_src" ]; do
    aa_l=$(readlink "$aa_src"); case "$aa_l" in /*) aa_src=$aa_l ;; *) aa_src=$(dirname "$aa_src")/$aa_l ;; esac
done
AA_AI_DIR=$(cd "$(dirname "$aa_src")/.." && pwd -P)
case "$(uname -s)" in Darwin) aa_os=macos ;; *) aa_os=linux ;; esac
aa_want=${AI_PROFILE:-}      # install.sh exports AI_PROFILE for what it runs
PROFILE_SCANNERS="guarddog skill-scanner osv-scanner"; AI_PROFILE=server
if [ -f "$AA_AI_DIR/lib/profile.sh" ]; then
    . "$AA_AI_DIR/lib/profile.sh"
    ai_profile_resolve "$AA_AI_DIR" "${AI_OS_FORCE:-$aa_os}" "$aa_want" 2>/dev/null \
        || { PROFILE_SCANNERS="guarddog skill-scanner osv-scanner"; AI_PROFILE=unknown; }
else
    profile_has_scanner() { return 0; }
fi

usage() {
    cat <<'EOF'
usage:
  agent-audit npm   <name> [version]   guarddog: malicious-package checks on an npm package (also name@version)
  agent-audit pypi  <name> [version]   guarddog: same for a PyPI package (also name==version)
  agent-audit dir   <path>             osv-scanner (known CVEs) + guarddog + skill-scanner on a folder
  agent-audit skill <path>             cisco skill-scanner on every SKILL.md under <path>
skill-scanner HIGH or CRITICAL = exit 4 (REJECT, no override); skill-scanner required but not run = exit 5
(no override); INFO, LOW and MEDIUM are shown only.
EOF
    exit 2
}

# split_spec ECO SPEC: "name version" from name==version (pypi) or name@version (npm, also @scope/name@1.2).
split_spec() {
    local eco=$1 spec=$2
    case "$spec" in
        *==*) printf '%s %s\n' "${spec%%==*}" "${spec#*==}"; return ;;
    esac
    if [ "$eco" = npm ] || [ "$eco" = pypi ]; then
        local body=${spec#@}
        case "$body" in
            *@*) printf '%s %s\n' "${spec%@*}" "${spec##*@}"; return ;;
        esac
    fi
    printf '%s \n' "$spec"
}

main() {
    rc=0
    err=0
    reject=0
    skipped=0
    sserr=0
    partial=0
    case "${1:-}" in
        npm|pypi)
            [ $# -ge 2 ] || usage
            name=$2; ver=${3:-}
            if [ -z "$ver" ]; then read -r name ver < <(split_spec "$1" "$2"); fi
            [ -n "$name" ] || usage
            if ! profile_has_scanner guarddog; then
                echo "agent-audit: audit skipped: profile $AI_PROFILE ($1 $name${ver:+ $ver}; no guarddog on this profile). Not a blocker: profile $AI_PROFILE installs packages without an audit (owner decision 2026-11-14); go on with the install."
                rc=0; err=0; skipped=1; record "$1" "$name" "${ver:--}"; exit 0
            fi
            args=("$1" scan "$name")
            if [ -n "$ver" ]; then args+=(--version "$ver"); fi
            guard "${args[@]}"
            record "$1" "$name" "${ver:--}"
            ;;
        dir)
            [ -d "${2:-}" ] || usage
            target=$(cd "$2" && pwd -P)
            if ! profile_has_scanner osv-scanner; then
                partial=1
                echo "-- osv-scanner and guarddog: not used by profile $AI_PROFILE (skill-scanner only)"
            elif command -v osv-scanner >/dev/null 2>&1; then
                osv-scanner scan source -r "$target"; s=$?
                # 128 = no lockfiles or manifests found: nothing to check, not a finding.
                [ "$s" -eq 0 ] || [ "$s" -eq 128 ] || rc=1
            else
                echo "ERROR: osv-scanner not installed"; err=1
            fi
            profile_has_scanner guarddog || partial=1
            if profile_has_scanner guarddog; then
                if [ -f "$target/package.json" ]; then guard npm scan "$target"; fi
                if [ -f "$target/pyproject.toml" ] || [ -f "$target/setup.py" ]; then guard pypi scan "$target"; fi
            fi
            if skill_tree "$target"; then
                scan_skills "$target"
            else
                echo "-- skill-scanner: not applicable (no SKILL.md, .claude-plugin/, .codex-plugin/ or skills/ under $target)"
            fi
            record dir "$target" "$(git -C "$target" rev-parse --short HEAD 2>/dev/null || echo -)"
            ;;
        skill)
            [ -d "${2:-}" ] || usage
            target=$(cd "$2" && pwd -P)
            scan_skills "$target"
            record skill "$target" -
            ;;
        *) usage ;;
    esac

    if [ "$reject" -ne 0 ]; then
        echo "agent-audit: REJECTED: skill-scanner found a HIGH or CRITICAL problem (REJECT lines above)." \
             "Never installed or updated; no accept line can let it through."
        exit 4
    fi
    if [ "$sserr" -ne 0 ]; then
        echo "agent-audit: ERROR: skill-scanner was required (a skill or plugin) but gave no result (ERROR lines" \
             "above). Never installed until it scans; no accept line can let it through."
        exit 5
    fi
    if [ "$err" -ne 0 ]; then
        echo "agent-audit: ERROR: a scanner could not run (see ERROR lines above). This is not a finding," \
             "but nothing was passed either: fix the scanner or the arguments, then run again."
        exit 3
    fi
    if [ "$rc" -eq 0 ]; then echo "agent-audit: nothing found"; else echo "agent-audit: FINDINGS above, read them before use"; fi
    exit "$rc"
}

# guarddog 3.x also reports "capability-*" markers (the code CAN spawn, CAN use the
# network). Every package has some, so they are printed but do not fail the audit;
# any other rule (download-and-execute, credential access, ...) does.
guard() {
    local out threats errf
    if ! command -v guarddog >/dev/null 2>&1; then
        echo "ERROR: guarddog not installed"; err=1; return
    fi
    errf=$(mktemp "${TMPDIR:-/tmp}/agent-audit.XXXXXX")
    out=$(guarddog "$@" --output-format json 2>"$errf") || true
    if ! printf '%s' "$out" | jq -e .results >/dev/null 2>&1; then
        echo "ERROR: guarddog could not scan: $*"
        tail -n 15 "$errf" | sed 's/^/   guarddog: /'
        rm -f "$errf"; err=1; return
    fi
    rm -f "$errf"
    echo "-- guarddog $*"
    printf '%s' "$out" | jq -r '.results | to_entries[]
        | select(.value != null and .value != {} and .value != [])
        | .key as $k | (.value | if type=="array" then .[] else . end)
        | "  \($k): \(.location? // "") \(.message? // . | tostring | .[0:160])"'
    threats=$(printf '%s' "$out" | jq '[.results | to_entries[]
        | select(.value != null and .value != {} and .value != [])
        | select(.key | startswith("capability-") | not)] | length')
    echo "   threat rules hit: $threats"
    [ "$threats" -eq 0 ] || rc=1
}

# skill-scanner, machine-readable (--format json). Every object with a "severity" is a finding; HIGH or
# CRITICAL sets reject (exit 4), the rest is printed only. A folder without SKILL.md (a plugin's hooks, a
# tool's source tree) is still scanned: --lenient reads its .md files.
SS_FINDINGS='[.. | objects | select((.severity? | type) == "string")
    | {sev: (.severity | ascii_upcase | sub("^SEVERITY\\."; "")),
       rule: ((.rule_id // .rule // .id // .category // "-") | tostring),
       where: ((.file_path // .file // .location // "") | tostring),
       msg: ((.title // .description // .message // "") | tostring | .[0:160])}]'

# skill_tree <dir>: true when the tree is a skill or plugin (skill-scanner required there).
skill_tree() {
    [ -n "$(find "$1" \( -name SKILL.md -o -name .claude-plugin -o -name .codex-plugin -o \( -type d -name skills \) \) \
        -not -path '*/node_modules/*' -not -path '*/.git/*' -print -quit 2>/dev/null)" ]
}

scan_skills() {
    local f found=0
    if ! command -v skill-scanner >/dev/null 2>&1; then echo "ERROR: skill-scanner not installed"; err=1; sserr=1; return; fi
    while IFS= read -r f; do
        found=1
        skill_scan "$(dirname "$f")"
    done < <(find "$1" -name SKILL.md -not -path '*/node_modules/*' -not -path '*/.git/*')
    [ "$found" -eq 1 ] || skill_scan "$1" --lenient
}

skill_scan() {
    local d=$1 out errf high n src=0; shift
    errf=$(mktemp "${TMPDIR:-/tmp}/agent-audit.XXXXXX")
    out=$(skill-scanner scan "$d" --format json "$@" 2>"$errf") || src=$?
    n=$(printf '%s' "$out" | jq "$SS_FINDINGS | length" 2>/dev/null) || n=""
    # Fail closed: no readable JSON, or a non-zero exit with no finding in it, is a scanner error.
    case "$n" in ''|*[!0-9]*) n="" ;; esac
    if [ -z "$n" ] || { [ "$src" -ne 0 ] && [ "$n" -eq 0 ]; }; then
        echo "ERROR: skill-scanner could not scan: $d (exit $src)"
        tail -n 15 "$errf" | sed 's/^/   skill-scanner: /'
        rm -f "$errf"; err=1; sserr=1; return
    fi
    rm -f "$errf"
    echo "-- skill-scanner $d"
    printf '%s' "$out" | jq -r "$SS_FINDINGS | .[] | \"  \\(.sev): \\(.rule) \\(.where) \\(.msg)\""
    high=$(printf '%s' "$out" | jq "($SS_FINDINGS | map(select(.sev == \"HIGH\" or .sev == \"CRITICAL\")) | length) as \$n
        | if \$n > 0 then \$n
          elif [.. | objects | .max_severity? // empty | tostring | ascii_upcase | select(test(\"HIGH|CRITICAL\"))] | length > 0 then 1
          else 0 end" 2>/dev/null) || high=""
    case "$high" in ''|*[!0-9]*) echo "ERROR: skill-scanner result not readable: $d"; err=1; sserr=1; return ;; esac
    echo "   HIGH/CRITICAL: $high"
    if [ "$high" -gt 0 ]; then
        reject=1
        printf '%s' "$out" | jq -r "$SS_FINDINGS | .[] | select(.sev == \"HIGH\" or .sev == \"CRITICAL\")
            | \"REJECT skill-scanner \\(.sev): \\(.rule) \\(.where)\""
    fi
}

# One line per run; names never contain spaces (paths with spaces are refused by the gate anyway).
record() {
    local eco="$1" name="$2" ver="$3" result=PASS dir
    [ "$rc" -eq 0 ] || result=FAIL
    [ "$err" -eq 0 ] || result=ERROR
    [ "$reject" -eq 0 ] || result=REJECT
    [ "$skipped" -eq 0 ] || result=SKIPPED
    # Profile dev-mac ran skill-scanner only: never a full PASS (the server gate accepts only PASS).
    [ "$result" != PASS ] || [ "$partial" -eq 0 ] || result=PASS-SKILL
    dir="${AI_STATE_DIR:-$HOME/.local/state/ai}"
    mkdir -p "$dir"
    printf '%s %s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$eco" "${name// /_}" "${ver:--}" "$result" >> "$dir/audit.log"
    # A refusal is a wall fire (ticket 17): one line in walls.jsonl, the format of the router (hooklib.log_wall).
    case "$result" in
        FAIL|ERROR|REJECT)
            python3 -B -c 'import sys; sys.path.insert(0, sys.argv[1]); import hooklib; hooklib.log_wall("agent-audit", sys.argv[2], sys.argv[3])' \
                "$AA_AI_DIR/marketplace/plugins/ai-core/hooks" "$eco ${name// /_} ${ver:--} $result" \
                "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || true ;;
    esac
}

main "$@"
