#!/usr/bin/env python3
"""ai-check-detect: find the one check command of a repo from its files, then probe each tool.

  ai-check-detect [--dir PATH]               print the stack and the check-fast / check commands
  ai-check-detect [--dir PATH] --json        the same as JSON
  ai-check-detect [--dir PATH] --no-probe    from the files only (nothing runs)
  ai-check-detect [--dir PATH] --plan [--tier try|mvp|long] --json
                                             also the Makefile or justfile text with the missing targets
                                             (ai-adopt writes it; existing targets are never changed)

check-fast: lint + unit tests, no network, no services, target under 60 s (the Stop hook runs it).
check:      everything (full tests, type check where configured; long tier: ledger and ratchet too).

Detection (stack from lockfiles and manifests, the nixpacks ladder; the test and lint part is ours):
  Python  pyproject.toml / requirements*.txt / setup.py / Pipfile, or no manifest and a tests/ (or test/) folder
          with test_*.py files; runner uv.lock > poetry.lock > pdm.lock > plain python3 -m; pytest only with a
          tests folder, conftest.py or pytest config; with no manifest, `unittest discover -s tests` unless the
          test files name pytest; ruff only when configured or listed; mypy (check only) when configured.
  Node    package.json; package manager pnpm-lock.yaml > yarn.lock > bun.lock(b) > npm; scripts lint,
          typecheck (or type-check), test (the npm placeholder test script does not count).
  Go      go.mod: go vet + go test -short (check: go test, golangci-lint when configured).
  Rust    Cargo.toml: cargo clippy -D warnings + cargo test.
  None    (docs-only or empty repo) ai-docs-check --md: Markdown placement, no em dash, relative links resolve.
Probe: each lint, type and test tool must really run here (`uv run ruff --version`, `.venv/bin/python -m pytest
--version`, `python3 -m unittest --help`, `golangci-lint --version`, `cargo clippy --version`). A tool that fails
its probe is left out of the commands and printed as a suggestion (install it, then run ai-adopt again). Node
scripts are not probed.
Exit 2 when --dir is not a folder.
Refused (exit 2, nothing written): monorepos (pnpm/npm/yarn workspaces, lerna, nx, turbo, rush, go.work, or
two or more package manifests below the root): write one target per package by hand.
Exit 1 when a stack has no test or lint command.
"""
import json
import os
import re
import subprocess
import sys

SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "dist", "build", "target", "__pycache__", ".tox",
             "vendor", ".next", "graphify-out", ".serena", ".omc", ".ai", ".claude", ".codex", "site-packages"}
MANIFESTS = ("pyproject.toml", "package.json", "go.mod", "Cargo.toml")
WORKSPACE_FILES = ("pnpm-workspace.yaml", "lerna.json", "nx.json", "turbo.json", "rush.json", "go.work")
NPM_PLACEHOLDER = "no test specified"
BLOCK_START = "# >>> ai checks (ai-adopt; edit freely inside, a rerun replaces this block) >>>"
BLOCK_END = "# <<< ai checks <<<"
RATCHET_LINE = ('@if command -v ai-ratchet >/dev/null 2>&1; then ai-ratchet; '
                'else echo "ai-ratchet not on PATH: ratchet skipped"; fi')
LEDGER_LINE = ('@if command -v ai-ledger >/dev/null 2>&1; then ai-ledger --check; '
               'else echo "ai-ledger not on PATH: ledger check skipped"; fi')
DOCS_LINE = ('@if command -v ai-docs-check >/dev/null 2>&1; then ai-docs-check; '
             'else echo "ai-docs-check not on PATH: Markdown placement check skipped"; fi')
MD_LINE = ('@if command -v ai-docs-check >/dev/null 2>&1; then ai-docs-check --md; '
           'else echo "ai-docs-check not on PATH: Markdown checks skipped"; fi')


def main(argv):
    root = os.path.abspath(arg(argv, "--dir") or ".")
    if not os.path.isdir(root):
        print("ai-check-detect: not a folder: %s" % root, file=sys.stderr)
        return 2
    tier = arg(argv, "--tier") or "long"      # no tiers since 2026-11-15: every project is long
    if tier not in ("try", "mvp", "long"):
        sys.exit("ai-check-detect: --tier must be try, mvp or long")
    info = detect(root, probe="--no-probe" not in argv)
    if "--plan" in argv and info.get("ok"):
        info["plan"] = plan(root, info, tier)
    if "--json" in argv:
        print(json.dumps(info, indent=1))
    elif not info.get("ok"):
        print("ai-check-detect: %s" % info["refuse"])
        for n in info.get("notes", []):
            print("note: " + n)
    else:
        print("stack: %s" % ", ".join(info["stacks"]))
        print("check-fast: %s" % " && ".join(info["fast"]))
        print("check:      %s" % " && ".join(info["full"]))
        for n in info["notes"]:
            print("note: " + n)
    if not info.get("ok"):
        return 2 if info.get("monorepo") else 1
    return 0


def arg(argv, name):
    if name in argv and argv.index(name) + 1 < len(argv):
        return argv[argv.index(name) + 1]
    return None


# ---------------------------------------------------------------- detection

def detect(root, probe=False):
    """probe: run `<tool> --version` for each lint, type and test tool and leave out the ones that fail."""
    mono = monorepo(root)
    if mono:
        return {"ok": False, "monorepo": True,
                "refuse": "monorepo (%s): write check-fast and check per package by hand, then one root target "
                          "that calls them" % mono}
    stacks, fast, full, notes = [], [], [], []
    for fn in (python, node, golang, rust):
        got = fn(root)
        if got:
            name, f, c, n = got
            if probe:
                f, c, n = probed(root, f, c, n)
            stacks.append(name)
            fast += f
            full += c
            notes += n
    nested = sub_manifests(root)
    if nested:
        notes.append("%s below the root is not covered: add its checks by hand" % ", ".join(nested))
    if not stacks:
        # Docs-only or empty repo (spec story 25): make check still exists, so ship works everywhere.
        return {"ok": True, "stacks": ["markdown"], "fast": [MD_LINE], "full": [MD_LINE], "runner": "make",
                "notes": ["no code stack (no pyproject.toml, package.json, go.mod or Cargo.toml): Markdown checks only"]}
    if not fast:
        return {"ok": False, "notes": notes,
                "refuse": "%s found, but no test or lint command could be told from the files" % ", ".join(stacks)}
    runner = "just" if any(os.path.isfile(os.path.join(root, n)) for n in ("justfile", "Justfile")) \
        and not os.path.isfile(os.path.join(root, "Makefile")) else "make"
    return {"ok": True, "stacks": stacks, "fast": fast, "full": full or list(fast), "notes": notes,
            "runner": runner}


def monorepo(root):
    for name in WORKSPACE_FILES:
        if os.path.isfile(os.path.join(root, name)):
            return name
    pkg = load_json(os.path.join(root, "package.json"))
    if isinstance(pkg, dict) and pkg.get("workspaces"):
        return "package.json workspaces"
    if len(sub_manifests(root)) >= 2:
        return "%d package manifests below the root" % len(sub_manifests(root))
    return None


def sub_manifests(root, depth=3):
    out = []
    for dirpath, dirnames, files in os.walk(root):
        rel = os.path.relpath(dirpath, root)
        level = 0 if rel == "." else rel.count(os.sep) + 1
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")) if level < depth else []
        if level == 0:
            continue
        if re.search(r"(^|/)(tests?|fixtures?|examples?|docs?|testdata)(/|$)", rel.replace(os.sep, "/")):
            continue
        out += [os.path.join(rel, f).replace(os.sep, "/") for f in files if f in MANIFESTS]
    return out


def python(root):
    pyproject = read(os.path.join(root, "pyproject.toml")) or ""
    reqs = "".join(read(os.path.join(root, f)) or "" for f in sorted(os.listdir(root))
                   if re.match(r"^requirements.*\.txt$", f))
    manifest = bool(pyproject or reqs or exists(root, "setup.py") or exists(root, "Pipfile"))
    tests_dir = py_tests_dir(root)
    if not (manifest or tests_dir):
        return None
    deps = pyproject + reqs + (read(os.path.join(root, "Pipfile")) or "")
    if exists(root, "uv.lock"):
        run, label = "uv run ", "uv"
    elif exists(root, "poetry.lock"):
        run, label = "poetry run ", "poetry"
    elif exists(root, "pdm.lock"):
        run, label = "pdm run ", "pdm"
    elif os.path.isfile(os.path.join(root, ".venv", "bin", "python")):
        run, label = ".venv/bin/python -m ", "pip, .venv"     # the project's venv, not the system python
    else:
        run, label = "python3 -m ", "pip"
    tools, fast, full, notes = [label], [], [], []
    ruff = "[tool.ruff" in pyproject or exists(root, "ruff.toml") or exists(root, ".ruff.toml") or \
        re.search(r"(?im)^[\s\"']*ruff\b", deps) is not None
    if ruff:
        tools.append("ruff")
        fast.append(run + "ruff check .")
        full.append(run + "ruff check .")
    if "[tool.mypy" in pyproject or exists(root, "mypy.ini"):
        tools.append("mypy")
        full.append(run + "mypy .")
    pytest = any(os.path.isdir(os.path.join(root, d)) for d in ("tests", "test")) or exists(root, "conftest.py") \
        or exists(root, "pytest.ini") or "[tool.pytest" in pyproject or "pytest" in deps
    if not manifest and not uses_pytest(os.path.join(root, tests_dir)):
        # No manifest, plain unittest files (milu, ticket 16): the standard library runner.
        tools.append("unittest")
        fast.append(run + "unittest discover -s " + tests_dir)
        full.append(run + "unittest discover -s " + tests_dir)
    elif pytest:
        tools.append("pytest")
        fast.append(run + "pytest -x -q")
        full.append(run + "pytest -q")
    else:
        notes.append("python: no tests folder or pytest config, so no test command")
    if not ruff:
        notes.append("python: no ruff config, so no lint command")
    return "python (%s)" % ", ".join(tools), fast, full, notes


def py_tests_dir(root):
    """tests or test, when it holds a test_*.py file (any depth); else None."""
    for name in ("tests", "test"):
        for _, dirnames, files in os.walk(os.path.join(root, name)):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            if any(f.startswith("test_") and f.endswith(".py") for f in files):
                return name
    return None


def uses_pytest(tests):
    """A conftest.py, or a test file that names pytest."""
    for dirpath, dirnames, files in os.walk(tests):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for f in files:
            if f == "conftest.py" or (f.startswith("test_") and f.endswith(".py")
                                      and "pytest" in (read(os.path.join(dirpath, f)) or "")):
                return True
    return False


def node(root):
    pkg = load_json(os.path.join(root, "package.json"))
    if not isinstance(pkg, dict):
        return None
    if exists(root, "pnpm-lock.yaml"):
        pm = "pnpm"
    elif exists(root, "yarn.lock"):
        pm = "yarn"
    elif exists(root, "bun.lock") or exists(root, "bun.lockb"):
        pm = "bun"
    else:
        pm = "npm"
    scripts = pkg.get("scripts") or {}

    def script(name):
        return ("yarn %s" if pm == "yarn" else "%s run %%s" % pm) % name

    fast, full, notes = [], [], []
    if "lint" in scripts:
        fast.append(script("lint"))
        full.append(script("lint"))
    tc = next((n for n in ("typecheck", "type-check", "tsc") if n in scripts), None)
    if tc:
        full.append(script(tc))
    test = scripts.get("test")
    if test and NPM_PLACEHOLDER not in test:
        fast.append(script("test"))
        full.append(script("test"))
    else:
        notes.append("node: no test script in package.json")
    return "node (%s)" % pm, fast, full, notes


def golang(root):
    if not exists(root, "go.mod"):
        return None
    full = ["go vet ./...", "go test ./..."]
    if any(exists(root, n) for n in (".golangci.yml", ".golangci.yaml", ".golangci.toml")):
        full.insert(1, "golangci-lint run")
    return "go", ["go vet ./...", "go test -short ./..."], full, []


def rust(root):
    if not exists(root, "Cargo.toml"):
        return None
    lint = "cargo clippy -q --all-targets -- -D warnings"
    return "rust", [lint, "cargo test -q"], [lint, "cargo test -q"], []


# ---------------------------------------------------------------- probe: does the tool run here?

PROBES = [   # (regex on a command, the tool name, how to make the probe command from the regex match)
    (re.compile(r"^(.*?\b)(ruff|pytest|mypy)\b"), lambda m: m.group(1) + m.group(2) + " --version"),
    (re.compile(r"^(.*?\b)unittest\b"), lambda m: m.group(1) + "unittest --help"),
    (re.compile(r"^golangci-lint\b"), lambda m: "golangci-lint --version"),
    (re.compile(r"^cargo clippy\b"), lambda m: "cargo clippy --version"),
]
INSTALL_HINT = {"uv run ": "uv add --dev %s", "poetry run ": "poetry add --group dev %s",
                "pdm run ": "pdm add -dG dev %s", ".venv/bin/python -m ": ".venv/bin/python -m pip install %s",
                "python3 -m ": "python3 -m pip install %s"}


def probed(root, fast, full, notes):
    """fast, full, notes without the commands whose tool does not run in this repo."""
    cache = {}
    for cmd in list(dict.fromkeys(fast + full)):
        probe_cmd = probe_for(cmd)
        if probe_cmd is None:
            continue
        if probe_cmd not in cache:
            cache[probe_cmd] = runs(root, probe_cmd)
        if not cache[probe_cmd]:
            fast = [c for c in fast if c != cmd]
            full = [c for c in full if c != cmd]
            if not any(("`%s`" % probe_cmd) in n for n in notes):
                notes = notes + ["`%s` fails here, so `%s` is left out. Suggestion: %s, then run ai-adopt again"
                                 % (probe_cmd, cmd, install_hint(cmd))]
    return fast, full, notes


def probe_for(cmd):
    for rx, make in PROBES:
        m = rx.match(cmd)
        if m:
            return make(m)
    return None


def install_hint(cmd):
    for prefix, hint in INSTALL_HINT.items():
        m = re.match(re.escape(prefix) + r"(\w+)", cmd)
        if m:
            return "install it (`%s`)" % (hint % m.group(1))
    return "install `%s`" % cmd.split()[0]


def runs(root, cmd, timeout=120):
    try:
        res = subprocess.run(cmd.split(), cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return False
    return res.returncode == 0


# ---------------------------------------------------------------- the Makefile / justfile block

def plan(root, info, tier):
    """{"file", "text" (new file text or None), "kept": [targets that exist and stay], "fast_cmd", "full_cmd"}."""
    runner = info["runner"]
    name = "Makefile" if runner == "make" else ("justfile" if exists(root, "justfile") else
                                                "Justfile" if exists(root, "Justfile") else "justfile")
    path = os.path.join(root, name)
    old = read(path)
    rest = strip_block(old or "")
    have = targets(rest, runner)
    kept = [t for t in ("check-fast", "check") if t in have]
    full = list(info["full"])
    if tier == "long":
        full += [LEDGER_LINE, RATCHET_LINE] + ([] if MD_LINE in full else [DOCS_LINE])
    want = [t for t in ("check-fast", "check") if t not in have]
    text = None
    if want:
        block = keep_owner_flags(render_block(runner, want, info["fast"], full), old or "")
        new = rest.rstrip("\n")
        new = (new + "\n\n" if new else "") + block
        text = None if new == old else new
    elif old is not None and rest != old:
        text = rest          # both targets are the owner's now: drop our old block
    tool = "make" if runner == "make" else "just"
    return {"file": name, "text": text, "kept": kept, "fast_cmd": "%s check-fast" % tool,
            "full_cmd": "%s check" % tool}


def render_block(runner, want, fast, full):
    tab = "\t" if runner == "make" else "    "
    lines = [BLOCK_START]
    if runner == "make":
        lines.append(".PHONY: %s" % " ".join(want))
    if "check-fast" in want:
        lines.append("# check-fast: lint + unit tests, no network, target under 60 s (the agent Stop hook runs it)")
        lines.append("check-fast:")
        lines += [tab + recipe(c, runner) for c in fast]
    if "check" in want:
        lines.append("# check: everything; run it before a PR and in CI")
        lines.append("check:")
        lines += [tab + recipe(c, runner) for c in full]
    lines.append(BLOCK_END)
    return "\n".join(lines) + "\n"


def keep_owner_flags(block, old):
    """A command line the owner extended inside our old block (`uv run pytest -q --durations=50`) stays as the owner
    wrote it, when it starts with the line we would write; a line the owner added stays too (add-only, 2026-11-17)."""
    m = re.search(r"^%s\n.*?^%s$" % (re.escape(BLOCK_START), re.escape(BLOCK_END)), old, re.M | re.S)
    if not m:
        return block
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
    import ownertext
    mine, new = m.group(0).splitlines(), block.splitlines()
    # The "# check-fast:" / "# check:" comment already in the block stays (it may hold a measured time, 2026-11-19).
    kept = {ln.split(":", 1)[0]: ln for ln in mine if TARGET_COMMENT.match(ln)}
    new = [kept.get(ln.split(":", 1)[0], ln) if TARGET_COMMENT.match(ln) else ln for ln in new]
    return "\n".join([new[0]] + ownertext.merge(mine[1:-1], new[1:-1]) + [new[-1]]) + "\n"


TARGET_COMMENT = re.compile(r"^# check(-fast)?:")


def recipe(cmd, runner):
    return cmd.replace("$", "$$") if runner == "make" else cmd


def strip_block(text):
    rx = re.compile(r"\n*^%s\n.*?^%s\n?" % (re.escape(BLOCK_START), re.escape(BLOCK_END)), re.M | re.S)
    out = rx.sub("\n", text)
    return out if out.strip() else ""


def targets(text, runner):
    if runner == "make":
        rx = r"^([A-Za-z0-9_.-]+(?:\s+[A-Za-z0-9_.-]+)*)\s*::?(?!=)"
        return {t for m in re.findall(rx, text, re.M) for t in m.split()}
    # just: `name:`, `name arg="1" *rest:`, `@name:`; not `name := value` (an assignment)
    return set(re.findall(r"^@?([A-Za-z0-9_-]+)(?:[ \t][^\n]*?)?:(?!=)", text, re.M))


# ---------------------------------------------------------------- helpers

def exists(root, name):
    return os.path.isfile(os.path.join(root, name))


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


def load_json(path):
    try:
        return json.loads(read(path) or "null")
    except ValueError:
        return None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
