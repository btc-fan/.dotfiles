#!/usr/bin/env python3
"""ai-precommit: lint and format check on the staged files (the git pre-commit hook that ai-adopt installs).

Usage: ai-precommit [--dir PATH]     exit 1 when a linter or formatter reports a staged file

It checks only staged files, with the tools the repo already has (nothing is installed, no network):
  Python        ruff check, ruff format --check   (.venv/bin/ruff, else ruff on PATH)
  JS, TS, Vue   eslint, prettier --check          (node_modules/.bin only)
  CSS, SCSS     prettier --check                  (node_modules/.bin only)
  Go            gofmt -l
  Rust          rustfmt --check
  Swift         swiftformat --lint, swiftlint     (when installed)
  Kotlin        ktlint                            (when installed)
  Dart          dart format --set-exit-if-changed
  Shell         shellcheck                        (when installed)
A tool that is not there is skipped and named once. It never changes a file: the message says how to fix.

Verify gate (verify-enforcement 04): in a project with a verify-<app> skill, a commit whose staged diff adds a test
(Python `def test_...(`; `test(` or `it(` in a JS or TS spec file) needs a valid run.log in .verify/evidence/ of
this checkout (a linked worktree: its own) that finished after HEAD's commit time. A refusal names the verify
skill and its steps, and writes a line to walls.jsonl (wall verify-commit). Edits and deletions of tests pass.
Agents never skip it (git commit --no-verify is blocked for agents by the no-verify gate).
"""
import os
import re
import shutil
import subprocess
import sys
import time

BIN = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "marketplace", "plugins", "ai-core", "hooks"))
from hooklib import log_wall, verify_proof, verify_skill, verify_steps  # noqa: E402

GROUPS = [
    # (extensions, [(label, argv builder, fix hint)])
    ((".py", ".pyi"), "python"),
    ((".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".vue", ".svelte"), "js"),
    ((".css", ".scss"), "css"),
    ((".go",), "go"),
    ((".rs",), "rust"),
    ((".swift",), "swift"),
    ((".kt", ".kts"), "kotlin"),
    ((".dart",), "dart"),
    ((".sh", ".bash"), "shell"),
]
TIMEOUT = 180


def main(argv):
    root = os.path.abspath(argv[argv.index("--dir") + 1] if "--dir" in argv else repo_root())
    files = staged(root)
    if not files:
        return 0
    refusal = verify_gate(root)
    failed, skipped = [], []
    for exts, kind in GROUPS:
        group = [f for f in files if f.lower().endswith(exts)]
        if not group:
            continue
        for label, argv_, hint in checks(root, kind, group):
            if argv_ is None:
                skipped.append(label)
                continue
            if not run(root, label, argv_):
                failed.append("%s (fix: %s)" % (label, hint))
    if skipped:
        print("ai-precommit: not installed here, skipped: %s" % ", ".join(sorted(set(skipped))))
    if refusal:
        print(refusal)
        log_wall("verify-commit", refusal.split(": ", 1)[-1], root)
    if failed:
        print("ai-precommit: blocked the commit: %s. Fix the files, git add them, commit again." % "; ".join(failed))
    return 1 if failed or refusal else 0


# ---------------------------------------------------------------- verify gate (hook 3)

PY_TEST = re.compile(r"^\s*(?:async\s+)?def\s+(test_\w*)\s*\(")
JS_TEST = re.compile(r"""^\s*(?:test|it)(?:\.\w+)?\s*\(\s*(['"`])(.*?)\1""")
JS_SPEC = re.compile(r"\.(?:test|spec)\.[cm]?[jt]sx?$|(?:^|/)(?:__tests__|tests?)/.*\.[cm]?[jt]sx?$")


def verify_gate(root):
    """The refusal text when the staged diff adds a test and no valid run is newer than HEAD; else ""."""
    info = verify_skill(root)
    tests = new_tests(root) if info else []
    if not tests:
        return ""
    head_ts = git_text(root, "log", "-1", "--format=%ct", "HEAD").strip()
    since = int(head_ts) + 1 if head_ts.isdigit() else 0
    ok, note = verify_proof(root, since)
    if ok:
        return ""
    after = "after the last commit (%s)" % time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(since - 1)) \
        if since else "yet"
    return ("ai-precommit: blocked the commit: it adds tests (%s) and no valid verify run in %s finished %s. "
            "Drive each new test case through the real app first. %s%s Then commit again."
            % (", ".join(tests[:5]), os.path.join(root, ".verify", "evidence"), after,
               "%s. " % note if note else "", verify_steps(root, info)))


def new_tests(root):
    """["path: name", ...] for test names on added lines that are not on removed lines of the same file."""
    added, removed, path = {}, {}, None
    # explicit prefixes: a diff.mnemonicPrefix or diff.noprefix config changes the b/ of "+++ b/<path>"
    diff = git_text(root, "diff", "--cached", "-U0", "--no-color", "--no-ext-diff", "--src-prefix=a/",
                    "--dst-prefix=b/")
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            path = None
        elif line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
        elif path and line[:1] in "+-" and not line.startswith("--- "):
            name = test_name(path, line[1:])
            if name:
                (added if line[0] == "+" else removed).setdefault(path, set()).add(name)
    return ["%s: %s" % (p, n) for p in sorted(added) for n in sorted(added[p] - removed.get(p, set()))]


def test_name(path, text):
    if path.endswith(".py"):
        m = PY_TEST.match(text)
        return m and m.group(1)
    if JS_SPEC.search(path):
        m = JS_TEST.match(text)
        return m and m.group(2)
    return None


def git_text(root, *args):
    try:
        res = subprocess.run(["git", "-C", root] + list(args), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=30)
    except (OSError, subprocess.SubprocessError):
        return ""
    return res.stdout.decode("utf-8", "replace") if res.returncode == 0 else ""


def checks(root, kind, files):
    if kind == "python":
        ruff = first(os.path.join(root, ".venv", "bin", "ruff"), shutil.which("ruff"))
        return [("ruff check", ruff and [ruff, "check", "--quiet"] + files, "ruff check --fix <file>"),
                ("ruff format", ruff and [ruff, "format", "--check", "--quiet"] + files, "ruff format <file>")]
    bin_ = os.path.join(root, "node_modules", ".bin")
    if kind == "js":
        eslint, prettier = local(bin_, "eslint"), local(bin_, "prettier")
        return [("eslint", eslint and [eslint, "--no-warn-ignored"] + files, "eslint --fix <file>"),
                ("prettier", prettier and [prettier, "--check", "--log-level", "warn"] + files, "prettier --write <file>")]
    if kind == "css":
        prettier = local(bin_, "prettier")
        return [("prettier", prettier and [prettier, "--check", "--log-level", "warn"] + files, "prettier --write <file>")]
    if kind == "go":
        gofmt = shutil.which("gofmt")
        return [("gofmt", gofmt and [gofmt, "-l"] + files, "gofmt -w <file>")]
    if kind == "rust":
        rustfmt = shutil.which("rustfmt")
        return [("rustfmt", rustfmt and [rustfmt, "--check", "--edition", "2021"] + files, "rustfmt <file>")]
    if kind == "swift":
        sf, sl = shutil.which("swiftformat"), shutil.which("swiftlint")
        return [("swiftformat", sf and [sf, "--lint", "--quiet"] + files, "swiftformat <file>"),
                ("swiftlint", sl and [sl, "lint", "--quiet", "--strict"] + files, "swiftlint --fix <file>")]
    if kind == "kotlin":
        kt = shutil.which("ktlint")
        return [("ktlint", kt and [kt] + files, "ktlint -F <file>")]
    if kind == "dart":
        dart = shutil.which("dart")
        return [("dart format", dart and [dart, "format", "--output=none", "--set-exit-if-changed"] + files,
                 "dart format <file>")]
    if kind == "shell":
        sc = shutil.which("shellcheck")
        return [("shellcheck", sc and [sc] + files, "the shellcheck message")]
    return []


def run(root, label, argv):
    try:
        res = subprocess.run(argv, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=TIMEOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        print("ai-precommit: %s did not run (%s): skipped" % (label, exc))
        return True
    out = res.stdout.decode("utf-8", "replace").strip()
    bad = res.returncode != 0 or (label == "gofmt" and out)
    if bad and out:
        print("\n".join(out.splitlines()[:40]))
    return not bad


def staged(root):
    try:
        res = subprocess.run(["git", "-C", root, "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return []
    return [f for f in res.stdout.decode("utf-8", "replace").split("\0")
            if f and os.path.isfile(os.path.join(root, f))]


def repo_root():
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=10).stdout.decode().strip()
    except (OSError, subprocess.SubprocessError):
        out = ""
    return out or "."


def first(*paths):
    for p in paths:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def local(bin_dir, name):
    return first(os.path.join(bin_dir, name))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
