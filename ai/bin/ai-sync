#!/usr/bin/env bash
# ai-sync: refresh the COPIED rules after a pull. Fast: no package installs, no network.
#
#   ai-sync                       ai-render, then refresh the copies below
#   ai-sync --check               exit 1 when a copy differs from the current ai/AGENTS.md (ai-doctor)
#   ai-sync --install-hook [dir]  git post-merge + post-rewrite hooks in the repo of [dir] (default
#                                 $AI_HOME), so `git -C ~/.dotfiles-ai pull` runs ai-sync
#   ai-sync --uninstall-hook [dir]
#   ai-sync --dry-run             print what would change
#   ai-sync --upgrade-review      also run the upgrade-review skill once after tool upgrades (or AI_UPGRADE_REVIEW=1)
#
# Only the installed copy changes the machine: ~/.dotfiles-ai (install.sh links it) or a root-owned admin
# copy (/opt/ai-setup). From any other checkout (a dev worktree) ai-sync prints one line and exits 0.
#
# Copies (agents that cannot @import ~/.config/ai/AGENTS.md):
#   Codex   ~/.codex/AGENTS.md block AI:core          (same block-upsert as install.sh, base_rules), and
#           the hook trust hashes in ~/.codex/config.toml (codex_trust)
#   Hermes  ~hermes/.hermes/SOUL.md block AI:core     (hermes_rules) and the Hermes plugin copy
#           ~hermes/.hermes/plugins/ai-core (hermes_hooks: routing.json, router code). Needs sudo -n.
#   Linux   /etc/claude-code/CLAUDE.md (+ /etc/opencode) admin layer: base_admin_layer after sudo_ready
#           (repo gate: clean tree, HEAD == origin/ai, or AI_ALLOW_DIRTY=1; passwordless sudo).
# Skills  ~/.claude/skills and ~/.agents/skills: a link for each new ai/skills/<name> (sync_skill_links).
# Claude and opencode read ~/.config/ai/AGENTS.md (a link), so ai-render alone updates them. One Claude case:
#   macOS   ~/.claude/CLAUDE-omc.md (omc launch reads only that file): the AI:core import block is added
#           when OMC created the file after install (claude_omc_companion_block, base.sh).
# Hooks   ~/.claude/plugins/cache/ai/ai-core/<version>: the hook code that Claude runs is a copy, and a pull
#           does not change it (sync_claude_plugin_copy, R-018).
set -euo pipefail

SELF=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")
AI_HOME=${AI_HOME:-$(cd "$(dirname "$SELF")/../.." && pwd -P)}
export AI_HOME
HOOK_MARK="ai-sync-hook v2"
HOOK_ANY="ai-sync-hook v"     # v1 hooks are ours too: --install-hook replaces them

main() {
    case "${1:-}" in
        --install-hook) install_hooks "${2:-$AI_HOME}"; return ;;
        --uninstall-hook) uninstall_hooks "${2:-$AI_HOME}"; return ;;
        --check) check_copies; return ;;
        --dry-run) export AI_DRY_RUN=1 ;;
        --upgrade-review) export AI_UPGRADE_REVIEW=1 ;;
        --quiet|"") ;;
        -h|--help) sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'; return 0 ;;
        *) echo "unknown option: $1" >&2; return 2 ;;
    esac
    if [ "${AI_DRY_RUN:-0}" != 1 ] && ! installed_copy; then
        echo "ai-sync: $AI_HOME is not the installed copy ($HOME/.dotfiles-ai): no live link or cache changed (--dry-run shows the plan)"
        return 0
    fi
    load_libs
    python3 "$AI_HOME/ai/bin/ai-render" >/dev/null || die "ai-render failed: copies not refreshed"
    [ -f "$AI_HOME/ai/AGENTS.md" ] || die "ai/AGENTS.md missing after ai-render"

    claude_omc_companion_block
    sync_skill_links
    sync_claude_plugin_copy
    record_versions
    if [ -d "$CODEX_DIR" ]; then
        local tmp; tmp=$(rules_text_file)
        aiconf block-upsert "$CODEX_DIR/AGENTS.md" core 1 "$tmp"
        rm -f "$tmp"
        codex_trust     # hook trust hashes follow the current hooks and plugin files
    fi
    # Hermes copies and the Linux admin layer (/etc/claude-code/CLAUDE.md, /etc/opencode) are other users'
    # and root's files: they are refreshed only from a tree no agent can change (root-owned, e.g.
    # /opt/ai-setup, or root-guard passed). From a user's own work tree they are left to the admin.
    if ! tree_trusted; then
        if hermes_exists || root_layer; then
            info "Hermes copies and /etc rules are not refreshed from $AI_HOME (owned by $(tree_owner))."
            info "Admin: sudo /opt/ai-setup/install.sh --update --for-user $(id -un)"
        fi
        return 0
    fi
    if hermes_exists; then
        if [ "${AI_DRY_RUN:-0}" = 1 ] || sudo -n -u "$HERMES_USER" true 2>/dev/null; then
            hermes_rules
            hermes_hooks
        else
            warn "Hermes copies not refreshed: needs sudo -n to user $HERMES_USER."
        fi
    fi
    if root_layer; then
        if sudo_ready noninteractive; then
            base_admin_layer
        else
            warn "admin layer not refreshed (repo not exactly origin/ai, or no passwordless sudo)."
        fi
    fi
    return 0
}

# R-018: the hook code that Claude runs is a copy in its plugin cache. Only install.sh refreshed it, so a
# gate that came with a pull stayed off. No copy yet: install.sh makes it, ai-sync makes none.
# Tool versions since the last install or sync: ai-versions prints each change (and runs the review on request).
record_versions() {
    [ "${AI_DRY_RUN:-0}" = 1 ] && return 0
    local review=()
    [ "${AI_UPGRADE_REVIEW:-0}" = 1 ] && review=(--upgrade-review)
    "$AI_HOME/ai/bin/ai-versions" --record ${review[@]+"${review[@]}"} || warn "ai-versions --record failed (no upgrade-review note)"
}

sync_claude_plugin_copy() {
    local p hash cache
    cache=$(claude_ai_core_cache)
    [ -n "$cache" ] || return 0
    p=$(PLUGIN_DIR)
    hash=$(aiconf tree-hash "$p")
    [ "$(aiconf tree-hash "$cache")" != "$hash" ] || return 0

    if [ "$AI_DRY_RUN" = 1 ]; then
        info "would refresh the Claude copy of ai-core"
    elif claude_ai_core_cache_sync "$p" "$hash"; then
        ok "Claude copy of ai-core refreshed: the next hook call runs the code of this pull"
    else
        warn "Claude copy of ai-core not refreshed: the new router does not answer, or the copy failed (ai-doctor)"
    fi
}

# A skill added to ai/skills after install gets its links here (R-007), in the folders install made.
# Only changes are printed: a pull shows no line for a link that is already current.
sync_skill_links() {
    {
        # The install.sh order: a newer audited pstack copy wins over the repo copy (R-008).
        if [ -d "$CLAUDE_DIR/skills" ]; then
            link_skills "$CLAUDE_DIR/skills" "$(PLUGIN_DIR)/skills"
            pstack_link "$CLAUDE_DIR/skills"
        fi
        if [ -d "$HOME/.agents/skills" ]; then
            link_skills "$HOME/.agents/skills"
            pstack_link "$HOME/.agents/skills"
        fi
        true
    } 2>&1 | { grep -v '^ *same ' || true; } \
        || warn "skill links not refreshed: run install.sh"   # the rules refresh goes on
}

# Ticket 19: git hooks are shared by every worktree, so a merge in a dev worktree ran its own ai-sync and
# pointed the live skill links and the Codex copies at unmerged code.
installed_copy() {
    [ "$(cd "$AI_HOME" && pwd -P)" = "$(cd "$HOME/.dotfiles-ai" 2>/dev/null && pwd -P)" ] && return 0
    [ "$(tree_owner)" = root ]      # the admin copy: no agent can change it
}

tree_owner() { stat -c %U "$AI_HOME" 2>/dev/null || stat -f %Su "$AI_HOME" 2>/dev/null || echo unknown; }

# Root-owned tree: trusted (root-guard checks it further when ai-sync runs as root). macOS keeps the old
# one-user behaviour (no other users, no admin layer).
tree_trusted() {
    root_layer || return 0
    [ "$(tree_owner)" = root ] || return 1
    if [ "$(id -u)" -eq 0 ]; then
        . "$AI_HOME/ai/lib/root-guard.sh"
        ai_root_guard "$AI_HOME" "" "${AI_ALLOW_DIRTY:-0}" ai/bin/ai-sync
    fi
    return 0
}

load_libs() {
    # shellcheck disable=SC1090
    . "$AI_HOME/ai/lib/common.sh"
    for f in base tools claude codex hermes; do . "$AI_HOME/ai/adapters/$f.sh"; done
    detect_os
    # The profile decides the root layer (Hermes, /etc rules): a light Linux has none (owner 2026-11-15).
    . "$AI_HOME/ai/lib/profile.sh"
    ai_profile_resolve "$AI_HOME/ai" "$AI_OS" "" 2>/dev/null || true
    load_pins       # sources and SCANNER_PYTHON etc. for the adapters (set -u)
}

# ---------------------------------------------------------------- check (ai-doctor)

check_copies() {
    load_libs >/dev/null
    local rc=0 soul="" cache
    cache=$(claude_ai_core_cache)
    if [ -n "$cache" ] && installed_copy; then      # a dev worktree is not the source of the copy
        if [ "$(aiconf tree-hash "$cache")" = "$(aiconf tree-hash "$(PLUGIN_DIR)")" ]; then
            echo "PASS Claude plugin copy of ai-core is current"
        else
            echo "FAIL Claude plugin copy of ai-core differs from the repo (run ai-sync)"; rc=1
        fi
    fi
    if [ -f "$CODEX_DIR/AGENTS.md" ]; then
        block_matches "$CODEX_DIR/AGENTS.md" "Codex ~/.codex/AGENTS.md" || rc=1
    fi
    if [ -f /etc/claude-code/CLAUDE.md ]; then
        file_matches /etc/claude-code/CLAUDE.md "admin layer /etc/claude-code/CLAUDE.md" || rc=1
    fi
    if hermes_exists; then
        soul=$(sudo -n -u "$HERMES_USER" -H sh -c 'cat ~/.hermes/SOUL.md' 2>/dev/null || true)
        if [ -z "$soul" ]; then
            echo "SKIP Hermes SOUL.md and plugin copy (needs root: sudo ai-doctor --for-user <user>)"
        else
            printf '%s' "$soul" | block_matches - "Hermes SOUL.md" || rc=1
            plugin_matches || rc=1
        fi
    fi
    return "$rc"
}

# The copied block must start with the current ai/AGENTS.md (Hermes appends the i-have-adhd rules,
# and servers append the hosting doc, after it).
block_matches() {
    python3 - "$1" "$2" "$AI_HOME/ai/AGENTS.md" <<'EOF'
import re, sys
src, label, agents = sys.argv[1:4]
text = sys.stdin.read() if src == "-" else open(src, encoding="utf-8").read()
want = open(agents, encoding="utf-8").read().rstrip("\n")
m = re.search(r"<!-- AI:core v\d+ START -->\n(.*?)\n<!-- AI:core v\d+ END -->", text, re.S)
if not m:
    print("FAIL %s: no AI:core block (run ai-sync)" % label); sys.exit(1)
if not m.group(1).startswith(want):
    print("FAIL %s: AI:core block differs from ai/AGENTS.md (run ai-sync)" % label); sys.exit(1)
print("PASS %s: AI:core block is current" % label)
EOF
}

# A whole-file copy (admin layer) must start with the current ai/AGENTS.md (hosting doc may follow).
file_matches() {
    python3 - "$1" "$2" "$AI_HOME/ai/AGENTS.md" <<'EOF'
import sys
path, label, agents = sys.argv[1:4]
want = open(agents, encoding="utf-8").read().rstrip("\n")
if open(path, encoding="utf-8").read().startswith(want):
    print("PASS %s is current" % label)
else:
    print("FAIL %s differs from ai/AGENTS.md (run ai-sync)" % label); sys.exit(1)
EOF
}

plugin_matches() {
    local want got
    want=$(cksum < "$AI_HOME/ai/build/routing.json")
    got=$(sudo -n -u "$HERMES_USER" -H sh -c 'cksum < ~/.hermes/plugins/ai-core/routing.json' 2>/dev/null || true)
    if [ "$want" = "$got" ]; then echo "PASS Hermes plugin routing.json is current"; return 0; fi
    echo "FAIL Hermes plugin routing.json differs or is missing (run ai-sync)"
    return 1
}

# ---------------------------------------------------------------- git hooks

install_hooks() {
    local repo=$1 dir name path
    dir=$(git -C "$repo" rev-parse --git-path hooks) || { echo "not a git repo: $repo" >&2; return 1; }
    case "$dir" in /*) ;; *) dir="$repo/$dir" ;; esac
    mkdir -p "$dir"
    for name in post-merge post-rewrite; do
        path="$dir/$name"
        if [ -f "$path" ] && ! grep -q "$HOOK_ANY" "$path"; then
            echo "skip $path: a hook that is not ours exists. Add this line to it: ai/bin/ai-sync --quiet" >&2
            continue
        fi
        hook_text > "$path.tmp"
        chmod 755 "$path.tmp"
        mv "$path.tmp" "$path"
        echo "hook: $path"
    done
}

uninstall_hooks() {
    local repo=$1 dir name
    dir=$(git -C "$repo" rev-parse --git-path hooks) || return 0
    case "$dir" in /*) ;; *) dir="$repo/$dir" ;; esac
    for name in post-merge post-rewrite; do
        if [ -f "$dir/$name" ] && grep -q "$HOOK_ANY" "$dir/$name"; then rm -f "$dir/$name"; echo "removed $dir/$name"; fi
    done
}

# Shared by all worktrees of the repo: only the installed copy ~/.dotfiles-ai runs ai-sync (ticket 19).
hook_text() {
    cat <<EOF
#!/bin/sh
# $HOOK_MARK: refresh copied AI rules after pull (installed by ai-sync --install-hook).
# Every worktree shares this hook: a dev worktree never syncs the machine.
top=\$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "\$top/ai/bin/ai-sync" ] || exit 0
[ "\$(cd "\$top" && pwd -P)" = "\$(cd "\$HOME/.dotfiles-ai" 2>/dev/null && pwd -P)" ] || exit 0
"\$top/ai/bin/ai-sync" --quiet || echo "ai-sync failed: run \$top/ai/bin/ai-sync by hand" >&2
exit 0
EOF
}

[ "${AI_SYNC_NO_MAIN:-0}" = 1 ] || main "$@"   # tests source the functions only
