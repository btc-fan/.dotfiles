#!/usr/bin/env python3
"""ai-docs-check: Markdown files only in their places (owner 2026-11-16: "no MD files everywhere").

Usage:
  ai-docs-check [--dir PATH]          exit 1 when a Markdown file sits outside the allowed places
  ai-docs-check [--dir PATH] --md     also fail on an em dash (U+2014) or a relative link to a missing file in a
                                      Markdown file (make check of a docs-only or empty repo)
  ai-docs-check [--dir PATH] --init   write .ai/docs-allow with the files that are outside today (the baseline of an
                                      adopted repo: they pass, a new one fails). ai-adopt runs this once.

Allowed places:
  root            README.md AGENTS.md CLAUDE.md GLOSSARY.md CODING_STANDARDS.md CHANGELOG.md CONTRIBUTING.md
                  SECURITY.md LICENSE.md CODE_OF_CONDUCT.md
  any folder      README.md, AGENTS.md, CLAUDE.md (per-folder rules), CHANGELOG.md
  docs/           everything (adr, specs, tickets, research, maps, agents, releases, security, REGRESSIONS.md)
  design-system/  ui-ux-pro-max MASTER.md and page overrides
  tool folders    .claude/ .agents/ .codex/ .github/ .omc/skills/ (skills, commands, templates)
  extra           one glob per line in .ai/docs-allow (committed; add a line only with the owner's OK)
Only files git sees are checked (tracked, or new and not ignored).

Map paths (every mode but --init): each code span in the Map of each AGENTS.md (between the AI:map markers, else
under "## Map") that holds a "/" or a file extension and no space must name a file or folder git sees, below the
folder of that AGENTS.md. A span with * or ? is a glob and must match at least one file. Commands, placeholders
(<app>), imports (@AGENTS.md), home paths (~/...) and versions (v2.1) are skipped. No Map: "no Map: skipped".

Also (a warning, never a failure): a docs/research/*.md file without the lines Date:, Sources: and Status: in
its first 20 lines. Status is current, superseded (by what) or decided (ADR NNNN).
"""
import fnmatch
import glob
import os
import re
import subprocess
import sys

ROOT_OK = {"README.md", "AGENTS.md", "CLAUDE.md", "GLOSSARY.md", "CODING_STANDARDS.md", "CHANGELOG.md",
           "CONTRIBUTING.md", "SECURITY.md", "LICENSE.md", "CODE_OF_CONDUCT.md"}
ANY_DIR_OK = {"README.md", "AGENTS.md", "CLAUDE.md", "CHANGELOG.md"}
TREES_OK = ("docs/", "design-system/", ".claude/", ".agents/", ".codex/", ".github/", ".omc/skills/")
SKIP_TREES = ("node_modules/", "vendor/", ".venv/", "venv/", "dist/", "build/", "graphify-out/", ".serena/")
ALLOW_REL = os.path.join(".ai", "docs-allow")
RESEARCH_KEYS = ("date:", "sources:", "status:")
MD_EXT = (".md", ".mdx", ".markdown")


def main(argv):
    root = os.path.abspath(argv[argv.index("--dir") + 1] if "--dir" in argv else ".")
    files = git_files(root)
    if files is None:
        print("ai-docs-check: %s is not a git repo" % root, file=sys.stderr)
        return 2
    allow = read_allow(root)
    stray = [f for f in files if is_md(f) and not allowed(f, allow)]
    if "--init" in argv:
        return write_baseline(root, stray)
    for f in research_without_header(root, files):
        print("ai-docs-check: WARN %s: add Date:, Sources: and Status: lines at the top" % f)
    problems = md_problems(root, [f for f in files if is_md(f)]) if "--md" in argv else []
    problems += map_problems(root, files)
    for p in problems:
        print("ai-docs-check: " + p)
    if not stray:
        print("ai-docs-check: Markdown placement ok (%d files)" % sum(1 for f in files if is_md(f)))
        return 1 if problems else 0
    for f in stray:
        print("ai-docs-check: stray Markdown %s" % f)
    print("ai-docs-check: %d file(s) outside the allowed places. Move each under docs/<kind>/ (adr, specs, tickets, "
          "research, maps, releases, security), merge it into an existing doc, or delete it. Only with the owner's "
          "OK: add its path to .ai/docs-allow." % len(stray))
    return 1


def git_files(root):
    try:
        res = subprocess.run(["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0:
        return None
    out = []
    for f in res.stdout.decode("utf-8", "replace").split("\0"):
        if f and not f.startswith(SKIP_TREES) and os.path.exists(os.path.join(root, f)):
            out.append(f)
    return sorted(set(out))


def is_md(path):
    return path.lower().endswith(MD_EXT)


def allowed(path, allow):
    base = os.path.basename(path)
    if "/" not in path and base in ROOT_OK:
        return True
    if base in ANY_DIR_OK:
        return True
    if path.startswith(TREES_OK):
        return True
    return any(fnmatch.fnmatch(path, g) or path == g for g in allow)


def read_allow(root):
    try:
        with open(os.path.join(root, ALLOW_REL)) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return []
    return [ln.split("#", 1)[0].strip() for ln in lines if ln.split("#", 1)[0].strip()]


def write_baseline(root, stray):
    path = os.path.join(root, ALLOW_REL)
    old = read_allow(root)
    new = [f for f in stray if f not in old]
    if not new and os.path.exists(path):
        print("ai-docs-check: baseline unchanged (%d entries)" % len(old))
        return 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    header = ("# Markdown files allowed outside docs/ (ai-docs-check). The adopt baseline lists the files that were\n"
              "# already there; a new entry needs the owner's OK. Move a file under docs/ and delete its line here.\n")
    body = "\n".join(old + new)
    with open(path, "w") as fh:
        fh.write(header + body + ("\n" if body else ""))
    print("ai-docs-check: baseline %s: %d file(s)" % (ALLOW_REL, len(old) + len(new)))
    return 0


EM_DASH = chr(0x2014)
LINK_RX = re.compile(r"!?\[[^\]]*\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)")
CODE_SPAN_RX = re.compile(r"`[^`]*`")


def md_problems(root, files):
    """file:line findings: an em dash, or a relative link whose file does not exist. Code is skipped."""
    out = []
    for f in files:
        try:
            with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError:
            continue
        fenced = False
        for n, line in enumerate(lines, 1):
            if line.lstrip().startswith(("```", "~~~")):
                fenced = not fenced
                continue
            if fenced:
                continue
            if EM_DASH in line:
                out.append("%s:%d: em dash (U+2014): use '-', ':' or a new sentence" % (f, n))
            for target in LINK_RX.findall(CODE_SPAN_RX.sub("", line)):
                if not link_ok(root, f, target):
                    out.append("%s:%d: broken link %s" % (f, n, target))
    return out


def link_ok(root, md_file, target):
    """External links, mail and in-page anchors are not checked; a relative path must exist."""
    if re.match(r"^[a-zA-Z][\w+.-]*:", target) or target.startswith(("#", "//")):
        return True
    path = target.split("#", 1)[0].split("?", 1)[0]
    if not path:
        return True
    base = root if path.startswith("/") else os.path.join(root, os.path.dirname(md_file))
    return os.path.exists(os.path.normpath(os.path.join(base, path.lstrip("/"))))


MAP_MARK_RX = re.compile(r"<!-- AI:map START[^>]*-->")
MAP_END = "<!-- AI:map END -->"
EXT_RX = re.compile(r"\.[A-Za-z][A-Za-z0-9]{0,7}$")
NOT_PATH_START = ("@", "~", "$", "/", "-")
NOT_PATH_CHARS = set("<>:={}()|&;'\"")


def map_problems(root, files):
    """file:line findings: a Map code span names a path that a clean clone does not have. Each AGENTS.md is read
    against its own folder (a monorepo package has its own Map)."""
    seen = set(files)
    for f in files:
        parts = f.split("/")
        seen.update("/".join(parts[:i]) for i in range(1, len(parts)))
    names = {os.path.basename(f) for f in seen}
    out = []
    agents = [f for f in files if os.path.basename(f) == "AGENTS.md"]
    if not agents:
        print("ai-docs-check: git sees no AGENTS.md: Map check skipped (track AGENTS.md to check its Map)")
    for f in agents:
        lines = map_lines(read_text(os.path.join(root, f)))
        if lines is None:
            print("ai-docs-check: %s: no Map: skipped" % f)
            continue
        base = os.path.dirname(f)
        for n, line in lines:
            for span in CODE_SPAN_RX.findall(line):
                path = map_path(span.strip("`").strip())
                if path and not map_path_ok(root, base, path, seen, names):
                    what = "glob %s matches no file" % path if "*" in path or "?" in path else \
                        "%s does not exist in a clean clone" % path
                    out.append("%s:%d: Map %s. Fix the path in the Map or drop the line." % (f, n, what))
    return out


def map_lines(text):
    """(line number, text) of the Map section: between the AI:map markers, else under "## Map"; None when absent."""
    lines = text.splitlines()
    start = next((i for i, ln in enumerate(lines) if MAP_MARK_RX.search(ln)), None)
    if start is None:
        start = next((i for i, ln in enumerate(lines) if ln.strip() == "## Map"), None)
        if start is None:
            return None
        end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith(("# ", "## "))), len(lines))
    else:
        end = next((i for i in range(start + 1, len(lines)) if MAP_END in lines[i]), len(lines))
    return [(i + 1, lines[i]) for i in range(start + 1, end)]


def map_path(span):
    """The span as a repo path, or None when it is a command, placeholder, import, home path, URL or version."""
    if not span or any(c.isspace() for c in span) or span.startswith(NOT_PATH_START) or NOT_PATH_CHARS & set(span):
        return None
    span = span[2:] if span.startswith("./") else span
    if "/" in span or EXT_RX.search(span):
        return span.rstrip("/")
    return None


def map_path_ok(root, base, path, seen, names):
    rel = os.path.normpath(os.path.join(base, path)) if base else os.path.normpath(path)
    if "*" in path or "?" in path:
        hits = glob.glob(os.path.join(root, rel), recursive=True)
        return any(os.path.relpath(h, root) in seen for h in hits)
    if rel in seen:
        return True
    # shortcut: a bare name (`router.py` or `done/` after its parent folder) passes when any file or folder has that
    # name; upgrade to a folder-aware lookup when two files of one name hide a stale Map line.
    return "/" not in path and path in names


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def research_without_header(root, files):
    out = []
    for f in files:
        if not (f.startswith("docs/research/") and is_md(f)):
            continue
        try:
            with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                head = [next(fh, "") for _ in range(20)]
        except OSError:
            continue
        text = "".join(head).lower()
        if not all(k in text for k in RESEARCH_KEYS):
            out.append(f)
    return out


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
