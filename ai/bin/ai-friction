#!/usr/bin/env python3
"""ai-friction: how often the ask-first gate would stop real agent work.

It replays the Bash commands of recent Claude Code transcripts through this checkout's ask-first gate and
counts the stops and the owner turns with a stop. Run it before a PR that changes the gate: a new stop group
must be a real high-impact class, and the owner turns a day must stay near the owner's agreed level.

Usage:
  ai-friction [--days N] [--projects DIR] [--json] [--max-turns-per-day X]

  --days N               transcripts changed in the last N days (default 14)
  --projects DIR         Claude Code transcript folder (default ~/.claude/projects)
  --json                 machine output
  --max-turns-per-day X  exit 1 when the owner turns with a stop a day are over X
"""
import argparse
import collections
import glob
import json
import os
import sys
import time

HOOKS = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                     "marketplace", "plugins", "ai-core", "hooks")
sys.path.insert(0, HOOKS)
import hooklib  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description="Replay transcript commands through the ask-first gate.")
    ap.add_argument("--days", type=float, default=14)
    ap.add_argument("--projects", default=os.path.expanduser("~/.claude/projects"))
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max-turns-per-day", type=float)
    a = ap.parse_args()

    report = replay(a.projects, a.days)
    print(json.dumps(report, indent=1) if a.json else text(report))
    if a.max_turns_per_day is not None and report["turns_per_day"] > a.max_turns_per_day:
        print("over the limit: %.1f owner turns a day with a stop (limit %.1f)"
              % (report["turns_per_day"], a.max_turns_per_day))
        return 1
    return 0


def replay(projects, days):
    cut = time.time() - days * 86400
    commands, stops, turns = 0, 0, set()
    groups = collections.defaultdict(list)
    for path in glob.glob(os.path.join(projects, "*", "*.jsonl")):
        if os.path.getmtime(path) < cut:
            continue
        for turn, cmd, cwd in bash_calls(path):
            commands += 1
            why = gate_reason(cmd, cwd)
            if why:
                stops += 1
                turns.add((path, turn))
                groups[group_of(why)].append(why)
    return {"days": days, "commands": commands, "stops": stops, "turns_with_stop": len(turns),
            "stops_per_day": round(stops / days, 1), "turns_per_day": round(len(turns) / days, 1),
            "groups": [{"reason": g, "count": len(w), "examples": w[:2]}
                       for g, w in sorted(groups.items(), key=lambda kv: -len(kv[1]))]}


def bash_calls(path):
    """(owner turn number, command, cwd) for each Bash call. A turn starts at an owner prompt, not at a
    notification or a tool result."""
    turn = 0
    for line in open(path, errors="ignore"):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        msg = d.get("message") or {}
        content = msg.get("content")
        if d.get("type") == "user" and isinstance(content, str) and not content.lstrip().startswith("<"):
            turn += 1
        for item in content if isinstance(content, list) else []:
            if isinstance(item, dict) and item.get("type") == "tool_use" and item.get("name") == "Bash":
                yield turn, (item.get("input") or {}).get("command") or "", d.get("cwd") or "."


def gate_reason(cmd, cwd):
    try:
        return hooklib.ask_first_reason(hooklib.parse_command(cmd), cmd, cwd)
    except Exception:          # one bad transcript line must not stop the replay
        return None


def group_of(why):
    """The class in the reason's last parentheses, plus "over ssh": "a service change over ssh"."""
    inner = why.rsplit("(", 1)[-1].split(")")[0] if "(" in why else why
    return inner + (" over ssh" if "over ssh" in why else "")


def text(r):
    out = ["commands %d; stops %d (%.1f a day); owner turns with a stop %d = %.1f owner turns a day"
           % (r["commands"], r["stops"], r["stops_per_day"], r["turns_with_stop"], r["turns_per_day"])]
    for g in r["groups"]:
        out.append("%5d  %s" % (g["count"], g["reason"]))
        out += ["         " + e[:100] for e in g["examples"]]
    return "\n".join(out)


if __name__ == "__main__":
    sys.exit(main())
