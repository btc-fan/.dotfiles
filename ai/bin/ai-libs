#!/usr/bin/env python3
"""ai-libs: the library docs map of a repo, `.ai/libs.md`. Agents read it to skip docs lookups.

  ai-libs [--dir PATH]                 show the map status (exit 0)
  ai-libs [--dir PATH] --check         exit 1 when the map is missing, stale, or misses a direct dependency
  ai-libs [--dir PATH] --sync          write or update .ai/libs.md
          [--offline]                  no network: keep the IDs already known, new libraries get "?"
          [--refresh]                  also look up again the libraries marked "-" (looked up, not found)

What --sync does:
  1. Reads the direct dependencies from the manifests (pyproject.toml, requirements*.txt, package.json,
     go.mod, Cargo.toml) and their locked versions from the lockfiles (uv.lock, poetry.lock,
     package-lock.json, pnpm-lock.yaml, yarn.lock, go.mod/go.sum, Cargo.lock). At most 40 rows.
  2. context7 ID per library, first hit wins: the existing row, the router log of IDs agents already
     used (~/.local/state/ai/docs-ids.jsonl), then one HTTP lookup per library at the context7 API
     (GET /api/v2/libs/search, key from CONTEXT7_API_KEY, ~/.config/ai/secrets.env, or the plugin
     default). Only public package names are sent, once per library (the ID is cached in .ai/libs.md).
     Never sent: local, path, git and workspace packages. If ANY non-public index is configured for an
     ecosystem, no name of that ecosystem is sent at all (python: requirements.txt, pip.conf, PIP_*/UV_*
     env, [tool.uv] index, [[tool.poetry.source]], uv.toml, uv.lock/poetry.lock sources; node: .npmrc
     registry= and @scope:registry=, npm_config_registry, .yarnrc(.yml), package-lock/yarn.lock/pnpm-lock
     tarball URLs; go: GOPRIVATE, GONOPROXY, GONOSUMDB, a non-default GOPROXY, also from `go env`;
     rust: Cargo.lock sources, .cargo/config.toml registries or source replacement). Public = exact
     hostname on an allow list. Never code.
  3. Grounded Docs name: `list_libraries` on the docs server (AI_DOCS_MCP_URL). Not indexed = "?".
  4. Writes the table, keeps the note column, and prints the libraries that are not indexed (the
     owner's to-do list for the docs server).
Offline-safe: when a lookup fails, the existing rows stay as they are and the output says so.
No npx, no package install, no write outside .ai/libs.md.
Env for tests: AI_CONTEXT7_URL (default https://context7.com), AI_DOCS_MCP_URL, AI_STATE_DIR.
"""
import datetime
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

try:
    import tomllib
except ImportError:          # python < 3.11
    tomllib = None

BIN = os.path.dirname(os.path.realpath(__file__))
AI_DIR = os.path.dirname(BIN)
PLUGIN = os.path.join(AI_DIR, "marketplace", "plugins", "ai-core")

LIBS_FILE = os.path.join(".ai", "libs.md")
HEADER = "# Library docs map. Generated by ai-libs --sync. Edit only the note column."
COLUMNS = ["lib", "version", "context7", "grounded-docs", "note"]
# Lockfiles at the repo root. The router and ai-doctor use the same list for the stale test.
LOCKFILES = ["uv.lock", "poetry.lock", "requirements.txt", "package-lock.json", "pnpm-lock.yaml", "yarn.lock",
             "go.sum", "Cargo.lock"]
MAX_ROWS = 40
TIMEOUT = 6
LOCAL, PRIVATE = "local package", "private registry"   # note values; such names are never sent out
# Public registries: exact hostname (and path prefix where the host is shared). Anything else is private.
PUBLIC_REGISTRIES = {"pypi.org": "/", "files.pythonhosted.org": "/", "registry.npmjs.org": "/",
                     "registry.yarnpkg.com": "/", "index.crates.io": "/", "static.crates.io": "/",
                     "github.com": "/rust-lang/crates.io-index", "proxy.golang.org": "/"}
UNKNOWN = "?"      # not looked up yet (offline, error): looked up again on the next sync
NOT_FOUND = "-"    # looked up, no exact match: looked up again only with --refresh


def main(argv):
    opts = parse(argv)
    root = git_root(opts["dir"]) or os.path.abspath(opts["dir"])
    deps, private = read_dependencies(root)
    for eco, why in sorted(private.items()):
        print("ai-libs: %s: non-public index configured (%s): no %s package name is sent" % (eco, why, eco))
    current = read_map(root)
    if opts["sync"]:
        return sync(root, deps, current, opts)
    problems = status(root, deps, current)
    for line in problems:
        print("ai-libs: " + line)
    if not problems:
        print("ai-libs: .ai/libs.md matches the lockfiles (%d libraries)" % len(current["rows"]))
    return 1 if (problems and opts["check"]) else 0


def parse(argv):
    opts = {"dir": ".", "sync": False, "check": False, "offline": False, "refresh": False}
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--dir" and args:
            opts["dir"] = args.pop(0)
        elif a in ("--sync", "--check", "--offline", "--refresh"):
            opts[a[2:]] = True
        elif a in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            sys.exit("ai-libs: unknown argument: " + a)
    if opts["check"] and (opts["sync"] or opts["refresh"] or opts["offline"]):
        sys.exit("ai-libs: --check is read-only and cannot be combined with --sync, --refresh or --offline")
    return opts


# ---------------------------------------------------------------- sync and status

def sync(root, deps, current, opts):
    if not deps:
        print("ai-libs: no manifest with dependencies found in %s: nothing to write" % root)
        return 0
    old = {r["lib"]: r for r in current["rows"]}
    cache = logged_ids(root)
    resolver = Context7(offline=opts["offline"])
    docs = GroundedDocs(offline=opts["offline"])
    indexed = docs.libraries()
    rows, resolved_now = [], []
    for dep in deps[:MAX_ROWS]:
        lib, version = dep["name"], dep["version"] or UNKNOWN
        prev = old.get(lib, {})
        ctx = prev.get("context7") or ""
        note = prev.get("note", "")
        if ctx in ("", UNKNOWN) or (ctx == NOT_FOUND and opts["refresh"]):
            ctx = cache.get(norm(lib)) or ""
        if not ctx:
            if dep["local"]:
                ctx, note = NOT_FOUND, note or (dep["local"] if isinstance(dep["local"], str) else LOCAL)
            else:
                found = resolver.lookup(lib, version, dep["eco"])
                if found:
                    resolved_now.append(lib)
                ctx = found or (UNKNOWN if resolver.failed else NOT_FOUND)
        gd = prev.get("grounded-docs") or UNKNOWN
        if indexed is not None:
            match = indexed.get(norm(lib))
            gd = ("%s@%s" % (match, minor_x(version))) if match and version != UNKNOWN else (match or UNKNOWN)
        rows.append({"lib": lib, "version": version, "context7": ctx, "grounded-docs": gd, "note": note})
    rows.sort(key=lambda r: r["lib"].lower())
    text = render(root, rows)
    path = os.path.join(root, LIBS_FILE)
    if read(path) != text:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
        print("ai-libs: wrote %s (%d libraries)" % (LIBS_FILE, len(rows)))
    else:
        print("ai-libs: %s already up to date (%d libraries)" % (LIBS_FILE, len(rows)))
    if len(deps) > MAX_ROWS:
        print("ai-libs: %d direct dependencies, kept the first %d" % (len(deps), MAX_ROWS))
    if resolved_now:
        print("ai-libs: context7 IDs looked up now: %s" % ", ".join(resolved_now))
    if resolver.failed:
        print("ai-libs: context7 not reachable (%s): kept existing IDs, new ones are \"?\". Run again online."
              % resolver.failed)
    pending = [r["lib"] for r in rows if r["context7"] == UNKNOWN]
    if pending:
        print("ai-libs: not looked up yet (\"?\"): %s" % ", ".join(pending))
    none = [r["lib"] for r in rows if r["context7"] == NOT_FOUND and r["note"] not in (LOCAL, PRIVATE)]
    if none:
        print("ai-libs: no exact context7 match (\"-\", --refresh to retry): %s" % ", ".join(none))
    if indexed is None:
        print("ai-libs: Grounded Docs not reachable (%s): kept existing names" % docs.failed)
    else:
        todo = [r["lib"] for r in rows if r["grounded-docs"] == UNKNOWN and r["note"] not in (LOCAL, PRIVATE)]
        if todo:
            print("ai-libs: not indexed on the docs server (owner to-do): %s" % ", ".join(todo))
    return 0


def status(root, deps, current):
    out = []
    if not current["exists"]:
        return ["no %s. Run: ai-libs --sync" % LIBS_FILE] if deps else []
    now = lock_hashes(root)
    changed = sorted(k for k in set(now) | set(current["locks"]) if now.get(k) != current["locks"].get(k))
    if changed:
        out.append("stale: %s changed since the last sync. Run: ai-libs --sync" % ", ".join(changed))
    have = {r["lib"] for r in current["rows"]}
    gone = [d["name"] for d in deps[:MAX_ROWS] if d["name"] not in have]
    if gone:
        out.append("missing rows for direct dependencies: %s" % ", ".join(gone))
    return out


def render(root, rows):
    locks = lock_hashes(root)
    lock_line = "lock: %s  synced: %s" % (
        " ".join("%s sha256:%s" % (k, locks[k]) for k in sorted(locks)) or "none",
        datetime.date.today().isoformat())
    lines = [HEADER, lock_line, "", "| " + " | ".join(COLUMNS) + " |", "|" + "---|" * len(COLUMNS)]
    for r in rows:
        lines.append("| " + " | ".join(cell(r.get(c, "")) for c in COLUMNS) + " |")
    return "\n".join(lines) + "\n"


def cell(v):
    return str(v).replace("|", "/").replace("\n", " ").strip()


def read_map(root):
    text = read(os.path.join(root, LIBS_FILE))
    out = {"exists": text is not None, "locks": {}, "rows": []}
    if not text:
        return out
    for line in text.splitlines():
        if line.startswith("lock:"):
            for name, h in re.findall(r"(\S+) sha256:([0-9a-f]+)", line):
                out["locks"][name] = h
        elif line.startswith("|") and not line.startswith("|---"):
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if cells[:2] == ["lib", "version"] or len(cells) < len(COLUMNS):
                continue
            out["rows"].append(dict(zip(COLUMNS, cells)))
    return out


def lock_hashes(root):
    out = {}
    for name in LOCKFILES:
        p = os.path.join(root, name)
        if os.path.isfile(p):
            with open(p, "rb") as fh:
                out[name] = hashlib.sha256(fh.read()).hexdigest()[:12]
    return out


# ---------------------------------------------------------------- dependencies

def read_dependencies(root):
    """Direct dependencies in manifest order: ([{name, version, eco, local}], {eco: why private}).
    Production deps first. Every dep of an ecosystem with a non-public index is marked PRIVATE."""
    deps, seen = [], set()

    def add(name, eco, version=None, local=False):
        key = (eco, norm(name))
        if name and key not in seen:
            seen.add(key)
            deps.append({"name": name, "eco": eco, "version": version, "local": local})

    py_locked = python_locked(root)
    for name, local in python_deps(root):
        lv = py_locked.get(norm(name), (None, False))
        add(norm(name), "python", lv[0], local or lv[1])
    pkg = load_json(os.path.join(root, "package.json")) or {}
    node_locked = node_versions(root)
    for section in ("dependencies", "devDependencies"):
        for name, spec in (pkg.get(section) or {}).items():
            local = LOCAL if re.match(r"(file|link|workspace|git|github|portal):|\.{0,2}/", str(spec)) else False
            add(name, "node", node_locked.get(name), local)
    for name, version in go_deps(root):
        add(name, "go", version)
    cargo_locked = toml_packages(os.path.join(root, "Cargo.lock"))
    for name, local in cargo_deps(root):
        lv = cargo_locked.get(norm(name), (None, False))
        add(name, "rust", lv[0], local or lv[1])

    present = {d["eco"] for d in deps}
    private = {eco: why for eco, why in private_ecosystems(root, present).items() if why}
    for d in deps:
        if d["local"] is True:
            d["local"] = LOCAL
        if d["local"] == PRIVATE:
            private.setdefault(d["eco"], "a lockfile source")
    for d in deps:
        if d["eco"] in private and d["local"] != LOCAL:
            d["local"] = PRIVATE
    return deps, private


def python_deps(root):
    data = load_toml(os.path.join(root, "pyproject.toml")) or {}
    out = []
    for spec in (data.get("project") or {}).get("dependencies") or []:
        name = req_name(spec)
        if name:
            out.append((name, "@" in spec and "://" in spec))
    poetry = ((data.get("tool") or {}).get("poetry") or {}).get("dependencies") or {}
    for name, spec in poetry.items():
        if name.lower() != "python":
            out.append((name, isinstance(spec, dict) and bool(spec.get("path") or spec.get("git"))))
    if not out:
        for line in (read(os.path.join(root, "requirements.txt")) or "").splitlines():
            line = line.split("#", 1)[0].strip()
            if line and not line.startswith("-"):
                name = req_name(line)
                if name:
                    out.append((name, "://" in line or line.startswith(".")))
    return out


def python_locked(root):
    out = {}
    for name in ("uv.lock", "poetry.lock"):
        out.update(toml_packages(os.path.join(root, name)))
    for line in (read(os.path.join(root, "requirements.txt")) or "").splitlines():
        m = re.match(r"^\s*([A-Za-z0-9][A-Za-z0-9._-]*)(?:\[[^\]]*\])?\s*==\s*([^\s;#]+)", line)
        if m and norm(m.group(1)) not in out:
            out[norm(m.group(1))] = (m.group(2), False)
    return out


def toml_packages(path):
    """[[package]] name/version from uv.lock, poetry.lock, Cargo.lock: {norm name: (version, local)}."""
    text = read(path)
    if not text:
        return {}
    out = {}
    if tomllib is not None:
        try:
            for p in tomllib.loads(text).get("package") or []:
                out.setdefault(norm(p.get("name", "")), (p.get("version"), source_kind(p.get("source"))))
            return out
        except (ValueError, TypeError):
            pass
    for block in re.split(r"^\[\[package\]\]\s*$", text, flags=re.M)[1:]:
        n = re.search(r'^name\s*=\s*"([^"]+)"', block, re.M)
        v = re.search(r'^version\s*=\s*"([^"]+)"', block, re.M)
        if n:
            m = re.search(r'^source\s*=\s*(\{[^\n]*\}|"[^"]*")', block, re.M)
            src = m.group(1) if m else None
            if src and src.startswith("{"):
                src = dict(re.findall(r'(\w+)\s*=\s*"([^"]*)"', src)) or {k: True for k in re.findall(r"(\w+)\s*=", src)}
            elif src:
                src = src.strip('"')
            out.setdefault(norm(n.group(1)), (v.group(1) if v else None, source_kind(src)))
    return out


def source_kind(src):
    """Lockfile source -> False (public registry), LOCAL or PRIVATE. Covers uv.lock, poetry.lock, Cargo.lock."""
    if not src:
        return False
    if isinstance(src, dict):
        if {"editable", "path", "directory", "virtual", "git"} & set(src):
            return LOCAL
        url = str(src.get("registry") or src.get("url") or "")
        if src.get("type") in ("directory", "file", "git"):
            return LOCAL
        return PRIVATE if url and not is_public(url) else False
    src = str(src)
    if src.startswith(("git+", "path+")):
        return LOCAL
    return PRIVATE if not is_public(src) else False


def is_public(url):
    """Exact hostname (and path prefix) on the allow list. Lockfile prefixes like registry+ / sparse+ are cut."""
    from urllib.parse import urlparse
    url = re.sub(r"^(registry|sparse)\+", "", str(url).strip().strip("\"'"))
    if "://" not in url:
        url = "https://" + url
    try:
        u = urlparse(url)
        host = (u.hostname or "").lower().rstrip(".")
    except ValueError:
        return False
    prefix = PUBLIC_REGISTRIES.get(host)
    return prefix is not None and (u.path or "/").startswith(prefix)


def private_ecosystems(root, ecos):
    """{eco: reason or ""}: a reason when any non-public index is configured anywhere for that ecosystem."""
    out = {}
    if "python" in ecos:
        out["python"] = first_private(python_indexes(root))
    if "node" in ecos:
        out["node"] = first_private(node_indexes(root))
    if "go" in ecos:
        out["go"] = go_private(root)
    if "rust" in ecos:
        out["rust"] = first_private(rust_indexes(root))
    return out


def first_private(found):
    """found: [(where, url)]. The first non-public one as a reason, else ""."""
    for where, url in found:
        if url and not is_public(url):
            return where
    return ""


def python_indexes(root):
    found = []
    for line in (read(os.path.join(root, "requirements.txt")) or "").splitlines():
        m = re.match(r"^\s*(?:-i|--index-url|--extra-index-url|-f|--find-links)[\s=]+(\S+)", line)
        if m:
            found.append(("requirements.txt", m.group(1)))
    for var in ("PIP_INDEX_URL", "PIP_EXTRA_INDEX_URL", "PIP_FIND_LINKS", "UV_INDEX_URL", "UV_EXTRA_INDEX_URL",
                "UV_INDEX", "UV_DEFAULT_INDEX", "UV_FIND_LINKS"):
        for token in re.split(r"[\s,]+", os.environ.get(var, "")):
            if token:
                found.append((var, token.split("=", 1)[1] if re.match(r"^[\w.-]+=", token) else token))
    confs = [os.environ.get("PIP_CONFIG_FILE", ""), os.path.expanduser("~/.pip/pip.conf"),
             os.path.expanduser("~/.config/pip/pip.conf"), "/etc/pip.conf", "/etc/xdg/pip/pip.conf"]
    for conf in [c for c in confs if c]:
        for key, url in re.findall(r"^\s*(index-url|extra-index-url|find-links)\s*=\s*(\S+)", read(conf) or "", re.M):
            found.append((conf.replace(os.path.expanduser("~"), "~"), url))
    data = load_toml(os.path.join(root, "pyproject.toml")) or {}
    uv = (data.get("tool") or {}).get("uv") or {}
    found += uv_index_urls("pyproject.toml [tool.uv]", uv)
    for src in ((data.get("tool") or {}).get("poetry") or {}).get("source") or []:
        found.append(("pyproject.toml [[tool.poetry.source]]", src.get("url", "") if isinstance(src, dict) else ""))
    for conf in (os.path.join(root, "uv.toml"), os.path.expanduser("~/.config/uv/uv.toml"), "/etc/uv/uv.toml"):
        found += uv_index_urls(conf.replace(os.path.expanduser("~"), "~"), load_toml(conf) or {})
    for lock in ("uv.lock", "poetry.lock"):
        found += lock_urls(os.path.join(root, lock), lock)
    return found


def uv_index_urls(where, uv):
    out = []
    for key in ("index-url", "extra-index-url", "find-links"):
        val = uv.get(key)
        for url in (val if isinstance(val, list) else [val] if val else []):
            out.append((where, str(url)))
    for idx in uv.get("index") or []:
        if isinstance(idx, dict) and idx.get("url"):
            out.append((where, str(idx["url"])))
    return out


def lock_urls(path, where):
    """Registry URLs named in a TOML lockfile (uv.lock, poetry.lock, Cargo.lock)."""
    text = read(path) or ""
    urls = re.findall(r'registry\s*=\s*"([^"]+)"', text)
    urls += re.findall(r'^source\s*=\s*"((?:registry|sparse)\+[^"]+)"', text, re.M)
    urls += re.findall(r'^url\s*=\s*"(https?://[^"]+)"', text, re.M)   # poetry.lock [package.source] url
    return [(where, u) for u in urls]


def node_indexes(root):
    found = []
    rcs = [os.path.join(root, ".npmrc"), os.environ.get("NPM_CONFIG_USERCONFIG", ""), os.path.expanduser("~/.npmrc"),
           os.environ.get("NPM_CONFIG_GLOBALCONFIG", "")]
    for rc in [r for r in rcs if r]:
        for url in re.findall(r"^\s*(?:@[\w.-]+:)?registry\s*=\s*(\S+)", read(rc) or "", re.M):
            found.append((rc.replace(os.path.expanduser("~"), "~"), url))
    for var in ("npm_config_registry", "NPM_CONFIG_REGISTRY", "YARN_REGISTRY", "YARN_NPM_REGISTRY_SERVER"):
        if os.environ.get(var):
            found.append((var, os.environ[var]))
    for rc in (os.path.join(root, ".yarnrc.yml"), os.path.expanduser("~/.yarnrc.yml")):
        for url in re.findall(r"npmRegistryServer:\s*[\"']?([^\s\"']+)", read(rc) or ""):
            found.append((rc.replace(os.path.expanduser("~"), "~"), url))
    for rc in (os.path.join(root, ".yarnrc"), os.path.expanduser("~/.yarnrc")):
        for url in re.findall(r'^\s*"?registry"?\s+"?([^\s"]+)', read(rc) or "", re.M):
            found.append((rc.replace(os.path.expanduser("~"), "~"), url))
    lock = load_json(os.path.join(root, "package-lock.json")) or {}
    for key, val in list((lock.get("packages") or {}).items()) + list((lock.get("dependencies") or {}).items()):
        res = str(val.get("resolved") or "") if isinstance(val, dict) else ""
        if res.startswith("http"):
            found.append(("package-lock.json", res))
    for url in re.findall(r'^\s+resolved\s+"?(https?://[^"#\s]+)', read(os.path.join(root, "yarn.lock")) or "", re.M):
        found.append(("yarn.lock", url))
    for url in re.findall(r"tarball:\s*'?(https?://[^\s',}]+)", read(os.path.join(root, "pnpm-lock.yaml")) or ""):
        found.append(("pnpm-lock.yaml", url))
    return found


def go_private(root):
    vals = {k: os.environ.get(k, "") for k in ("GOPRIVATE", "GONOPROXY", "GONOSUMDB", "GOPROXY", "GOFLAGS")}
    from shutil import which as _which
    if _which("go"):
        import subprocess
        try:
            res = subprocess.run(["go", "env", "GOPRIVATE", "GONOPROXY", "GONOSUMDB", "GOPROXY", "GOFLAGS"],
                                 cwd=root, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
            lines = res.stdout.decode().splitlines()
            for k, v in zip(("GOPRIVATE", "GONOPROXY", "GONOSUMDB", "GOPROXY", "GOFLAGS"), lines):
                vals[k] = vals[k] or v.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    for k in ("GOPRIVATE", "GONOPROXY", "GONOSUMDB"):
        if vals[k].strip():
            return k
    for part in re.split(r"[,|]", vals["GOPROXY"]):
        part = part.strip()
        if part and part not in ("direct", "off") and not is_public(part):
            return "GOPROXY"
    if re.search(r"-insecure|GOPRIVATE|GONOPROXY", vals["GOFLAGS"]):
        return "GOFLAGS"
    return ""


def rust_indexes(root):
    found = lock_urls(os.path.join(root, "Cargo.lock"), "Cargo.lock")
    for conf in (os.path.join(root, ".cargo", "config.toml"), os.path.join(root, ".cargo", "config"),
                 os.path.expanduser("~/.cargo/config.toml"), os.path.expanduser("~/.cargo/config")):
        data = load_toml(conf) or {}
        where = conf.replace(os.path.expanduser("~"), "~")
        for reg in (data.get("registries") or {}).values():
            if isinstance(reg, dict):
                found.append((where, str(reg.get("index") or "private-registry")))
        for name, src in (data.get("source") or {}).items():
            if isinstance(src, dict) and (src.get("replace-with") or src.get("registry") or src.get("local-registry")):
                found.append((where, str(src.get("registry") or "source-replacement")))
    return found


def node_versions(root):
    out = {}
    lock = load_json(os.path.join(root, "package-lock.json"))
    if lock:
        for key, val in (lock.get("packages") or {}).items():
            if key.startswith("node_modules/") and "/node_modules/" not in key[13:] and isinstance(val, dict):
                out.setdefault(key[13:], val.get("version"))
        for key, val in (lock.get("dependencies") or {}).items():
            if isinstance(val, dict):
                out.setdefault(key, val.get("version"))
    text = read(os.path.join(root, "pnpm-lock.yaml"))
    if text:
        m = re.search(r"^importers:\s*\n\s+\.:\s*\n(.*?)(?=^\S|\Z)", text, re.M | re.S)
        body = m.group(1) if m else text
        for name, ver in re.findall(r"^\s+'?(@?[\w./-]+)'?:\s*\n\s+specifier:[^\n]*\n\s+version:\s*'?([^\s'(]+)", body, re.M):
            out.setdefault(name, ver)
    text = read(os.path.join(root, "yarn.lock"))
    if text:
        for names, ver in re.findall(r'^"?((?:@?[^@\s",]+@[^,\n]+,?\s*)+)"?:\s*\n\s+version:?\s+"?([^"\s]+)', text, re.M):
            for part in names.split(","):
                n = part.strip().strip('"')
                n = n[:n.rfind("@")] if n.rfind("@") > 0 else n
                out.setdefault(n, ver)
    return out


def go_deps(root):
    text = read(os.path.join(root, "go.mod")) or ""
    out = []
    blocks = re.findall(r"^require\s*\((.*?)^\)", text, re.M | re.S)
    lines = [ln for b in blocks for ln in b.splitlines()]
    lines += [m for m in re.findall(r"^require\s+([^\s(].*)$", text, re.M)]
    for ln in lines:
        if "// indirect" in ln:
            continue
        m = re.match(r"^\s*(\S+)\s+(v\S+)", ln)
        if m:
            out.append((m.group(1), m.group(2)))
    return out


def cargo_deps(root):
    data = load_toml(os.path.join(root, "Cargo.toml")) or {}
    out = []
    for name, spec in (data.get("dependencies") or {}).items():
        out.append((name, isinstance(spec, dict) and bool(spec.get("path") or spec.get("git"))))
    return out


def req_name(spec):
    m = re.match(r"^\s*([A-Za-z0-9][A-Za-z0-9._-]*)", spec)
    return m.group(1) if m else None


def norm(name):
    return re.sub(r"[-_.]+", "-", (name or "").strip().lower())


def minor_x(version):
    m = re.match(r"^v?(\d+)\.(\d+)", version or "")
    return "%s.%s.x" % (m.group(1), m.group(2)) if m else version


# ---------------------------------------------------------------- lookups

def logged_ids(root):
    """context7 IDs agents already used, from the router log. This repo first, then any repo."""
    path = os.path.join(state_dir(), "docs-ids.jsonl")
    mine, other = {}, {}
    for line in (read(path) or "").splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        cid = str(row.get("context7") or row.get("id") or "")
        if not cid.startswith("/"):
            continue
        parts = cid.strip("/").split("/")
        target = mine if row.get("repo") == root else other
        for lib in {row.get("lib"), parts[1] if len(parts) > 1 else None}:
            if lib and not re.match(r"^v?\d+([._]\d+)*$", lib):    # a version tail is not a library name
                target[norm(lib)] = cid
    other.update(mine)
    return other


class Context7:
    def __init__(self, offline=False):
        self.base = os.environ.get("AI_CONTEXT7_URL", "https://context7.com").rstrip("/")
        self.failed = "offline mode" if offline else None
        self.key = None if offline else context7_key()

    def lookup(self, lib, version, eco):
        if self.failed:
            return None
        q = urllib.parse.urlencode({"libraryName": lib, "query": "%s %s library documentation" % (lib, eco)})
        headers = {"Accept": "application/json", "User-Agent": "ai-libs"}
        if self.key:
            headers["Authorization"] = "Bearer " + self.key
        try:
            req = urllib.request.Request("%s/api/v2/libs/search?%s" % (self.base, q), headers=headers)
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            if exc.code in (401, 403, 429) or exc.code >= 500:
                self.failed = "HTTP %d" % exc.code
            return None
        except (OSError, ValueError) as exc:
            self.failed = type(exc).__name__
            return None
        results = data.get("results") or data.get("libraries") or []
        return pick(lib, version, results)


def pick(lib, version, results):
    """Exact name match on the ID tail or the title only. No match = no ID (a wrong ID is worse than "?")."""
    want = {norm(lib), norm(lib.split("/")[-1]), norm(lib.lstrip("@").replace("/", "-"))}
    for r in results:
        rid = str(r.get("id") or "")
        if not rid.startswith("/"):
            continue
        names = {norm(rid.rstrip("/").split("/")[-1]), norm(str(r.get("title") or ""))}
        if want & names:
            return rid + version_suffix(r.get("versions") or [], version)
    return None


def version_suffix(versions, version):
    m = re.match(r"^v?(\d+)\.(\d+)", version or "")
    if not m:
        return ""
    exact = [v for v in versions if str(v).lstrip("v") == version.lstrip("v")]
    if exact:
        return "/" + str(exact[0])
    for v in versions:
        mv = re.match(r"^v?(\d+)[._](\d+)", str(v))
        if mv and mv.groups() == m.groups():
            return "/" + str(v)
    return ""


def context7_key():
    key = os.environ.get("CONTEXT7_API_KEY")
    if key:
        return key
    secrets = os.environ.get("AI_SECRETS_FILE", os.path.expanduser("~/.config/ai/secrets.env"))
    for line in (read(secrets) or "").splitlines():
        m = re.match(r"^\s*(?:export\s+)?CONTEXT7_API_KEY=(.*)$", line)
        if m and m.group(1).strip().strip("\"'"):
            key = m.group(1).strip().strip("\"'")
    if key:
        return key
    m = re.search(r'CONTEXT7_API_KEY:=([^}"\s]+)', read(os.path.join(PLUGIN, "mcp", "context7.sh")) or "")
    return m.group(1) if m else None


class GroundedDocs:
    """Read-only `list_libraries` call over MCP streamable HTTP. Returns {norm name: name} or None."""

    def __init__(self, offline=False):
        self.url = os.environ.get("AI_DOCS_MCP_URL") or config_value("AI_DOCS_MCP_URL") or "http://127.0.0.1:6280/mcp"
        self.failed = "offline mode" if offline else None
        self.session = None
        self.next_id = 1

    def libraries(self):
        if self.failed:
            return None
        try:
            self.rpc("initialize", {"protocolVersion": "2025-03-26", "capabilities": {},
                                    "clientInfo": {"name": "ai-libs", "version": "1"}})
            self.rpc("notifications/initialized", None, notify=True)
            res = self.rpc("tools/call", {"name": "list_libraries", "arguments": {}})
        except (OSError, ValueError, KeyError) as exc:
            self.failed = type(exc).__name__
            return None
        text = "\n".join(c.get("text", "") for c in (res or {}).get("content", []) if isinstance(c, dict))
        names = re.findall(r"^\s*-\s+(\S+)", text, re.M)
        return {norm(n): n for n in names}

    def rpc(self, method, params, notify=False):
        body = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            body["params"] = params
        if not notify:
            body["id"] = self.next_id
            self.next_id += 1
        headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
                   "User-Agent": "ai-libs"}
        if self.session:
            headers["Mcp-Session-Id"] = self.session
        req = urllib.request.Request(self.url, data=json.dumps(body).encode(), headers=headers, method="POST")
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            self.session = resp.headers.get("Mcp-Session-Id") or self.session
            raw = resp.read().decode("utf-8")
        if notify:
            return None
        if "data:" in raw and not raw.lstrip().startswith("{"):
            raw = "\n".join(ln[5:].strip() for ln in raw.splitlines() if ln.startswith("data:"))
            raw = raw.splitlines()[-1] if raw else "{}"
        doc = json.loads(raw or "{}")
        if "error" in doc:
            raise ValueError(str(doc["error"]))
        return doc["result"]


# ---------------------------------------------------------------- helpers

def state_dir():
    return os.environ.get("AI_STATE_DIR") or os.path.expanduser("~/.local/state/ai")


def config_value(name):
    for line in (read(os.path.expanduser("~/.config/ai/config.env")) or "").splitlines():
        m = re.match(r"^\s*(?:export\s+)?%s=\"?([^\"]*)\"?\s*$" % re.escape(name), line)
        if m:
            return m.group(1)
    return None


def git_root(d):
    import subprocess
    try:
        res = subprocess.run(["git", "-C", os.path.abspath(d), "rev-parse", "--show-toplevel"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    out = res.stdout.decode().strip()
    return out if res.returncode == 0 and out else None


def load_toml(path):
    text = read(path)
    if not text:
        return None
    if tomllib is None:
        return toml_fallback(text)
    try:
        return tomllib.loads(text)
    except ValueError:
        return None


def toml_fallback(text):
    """Enough of TOML for [project] dependencies and [dependencies] keys when tomllib is missing."""
    out = {}
    m = re.search(r"^\[project\].*?^dependencies\s*=\s*\[(.*?)\]", text, re.M | re.S)
    if m:
        out["project"] = {"dependencies": re.findall(r"[\"']([^\"']+)[\"']", m.group(1))}
    m = re.search(r"^\[dependencies\]\s*\n(.*?)(?=^\[|\Z)", text, re.M | re.S)
    if m:
        out["dependencies"] = {k: ({"path": 1} if "path" in v or "git" in v else v)
                               for k, v in re.findall(r"^([A-Za-z0-9_-]+)\s*=\s*(.+)$", m.group(1), re.M)}
    return out


def load_json(path):
    text = read(path)
    if not text:
        return None
    try:
        return json.loads(text)
    except ValueError:
        return None


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
