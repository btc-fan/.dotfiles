#!/usr/bin/env python3
"""ai-doctor: check that the AI setup on this machine is complete and current.

  ai-doctor           all checks (plugin validate, router tests, evals when present)
  ai-doctor --quick   fast checks only (install.sh runs this at the end)
  ai-doctor --offline full checks, but tool versions only against resolved.json (no registry calls)
  ai-doctor --live    also one headless claude -p call that runs a sandboxed Bash command (costs one small call)
  ai-doctor --project PATH   also the project knowledge checks for PATH (default: the cwd when it is a
                      git repo with code): Serena memories, sizes, staleness, secrets, graph, .ai/libs.md
  ai-doctor --project-only PATH   only those project checks (no machine checks; ai-eval install runs it)

Exit 1 when any check FAILs. WARN does not fail.
Profile (ai/profiles, owner decision 2026-11-14): shown first. dev-mac FAILs when guarddog or osv-scanner from
this setup is still installed, the audit gate row is rendered, or the box server is registered (Claude ai-box
plugin, Codex box entry); their absence is never a failure there.
Checks: rendered routing up to date; AGENTS.md size (30 KB cap) and no em dash; plugin files and hooks
JSON; router smoke run; plugin installed in Claude/Codex; a usage contract (ai/rules/<tool>.md with
the five sections and a verify command) for every MCP server of ai-core; copied rule blocks (Codex
AGENTS.md, Hermes SOUL.md, Hermes plugin) equal the current ai/AGENTS.md (ai-sync --check); secrets.env mode 600;
gate skips and misses of the last 7 days; per-skill use and gated skill misses of the last 30 days (router logs
only, never transcripts); setup checks (each catches a bug seen on a real server):
Codex hook trust, Claude permissions, claude.ai connectors off on Linux, Grounded Docs service active,
rule files per user, Hermes MCP state, OMC exa off, env switches for non-login processes, the
secret-scan of commit messages, Claude hand-off readiness, the owner's drop and off lists (ai/pins.env: no caveman
or byterover left, off-by-default plugins off, one Serena, one rtk on PATH, OMX hooks not on a Cellar node,
last30days installed and on with contract and evals); full mode: claude plugin validate, router tests,
manual-eval report for ai/evals (markdown prompt lists, run by hand), omx doctor, mise ls.
ai/rules/vendor/ holds byte copies of vendor templates and is not checked as contracts.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

BIN = os.path.dirname(os.path.realpath(__file__))
AI_DIR = os.path.dirname(BIN)
PLUGIN = os.path.join(AI_DIR, "marketplace", "plugins", "ai-core")
sys.path.insert(0, os.path.join(AI_DIR, "lib"))
import ai_profile  # noqa: E402
PROFILE, PROFILE_FROM = ai_profile.resolve()
try:
    PROFILE_KEYS = ai_profile.load(PROFILE)
except ValueError:
    PROFILE_KEYS = {}


def rejected_tools():
    """skill-scanner rejections recorded in resolved.json (agent-audit exit 4, owner rule 2026-11-14)."""
    tools = (load_json_file(os.path.join(STATE, "resolved.json")) or {}).get("tools") or {}
    return {t: v["rejected"] for t, v in tools.items() if isinstance(v, dict) and v.get("rejected")}
STATE = os.environ.get("AI_STATE_DIR") or os.path.expanduser("~/.local/state/ai")
CAP = 30 * 1024
SECTIONS = ["vendor rules", "when", "enforcement", "proof", "setup checklist"]
RESULTS = {"PASS": 0, "WARN": 0, "FAIL": 0, "SKIP": 0}
SKIP_HERMES = "run as admin for the Hermes checks: sudo /usr/local/lib/ai/repo/ai/bin/ai-doctor --for-user <user>"
MODE = "all"        # all | no-hermes (the user part of an admin run) | hermes-only (the root part)


def main(argv):
    global MODE
    if "--for-user" in argv:
        return admin_run(argv)
    if os.environ.get("AI_DOCTOR_MODE") in ("no-hermes", "hermes-only"):
        MODE = os.environ["AI_DOCTOR_MODE"]
    if MODE == "hermes-only":
        check_rule_files()
        check_hermes()
        check_handoff()
        check_copies()
        return finish()
    if "--project-only" in argv:
        i = argv.index("--project-only")
        check_project(argv[i + 1] if i + 1 < len(argv) else os.getcwd(), explicit=True)
        return finish()
    quick = "--quick" in argv
    check_profile()
    check_render()
    check_agents_md()
    check_plugin_files()
    check_router_smoke()
    check_installed()
    check_versions(network=not quick and "--offline" not in argv)
    check_contracts()
    check_copies()
    check_secrets()
    check_rule_files()
    check_codex_trust()
    check_claude_permissions()
    check_claudeai_connectors()
    check_env_delivery()
    check_dropped()
    check_drops_and_defaults()
    check_claude_policy()
    check_hooks_absolute()
    check_hook_paths()
    check_serena_config()
    check_serena_plugin()
    check_no_duplicate_layers()
    check_skill_dups()
    check_rules_2026_11_16(live=not quick)
    check_uv_links()
    check_codex_policy()
    check_hermes()
    check_omc()
    check_claude_cleanup()
    check_handoff()
    check_gate_smoke()
    proj = argv[argv.index("--project") + 1] if "--project" in argv and argv.index("--project") + 1 < len(argv) \
        else os.getcwd()
    check_project(proj, explicit="--project" in argv)
    report_logs()
    if not quick:
        check_validate()
        check_tests()
        check_evals()
        check_optional("omx", ["omx", "doctor"])
        check_optional("mise", ["mise", "ls"])
    return finish()


def finish():
    print("\nai-doctor%s: %d pass, %d warn, %d fail, %d skip" % (
        " (Hermes, as root)" if MODE == "hermes-only" else "", RESULTS["PASS"], RESULTS["WARN"], RESULTS["FAIL"],
        RESULTS["SKIP"]))
    return 1 if RESULTS["FAIL"] else 0


def admin_run(argv):
    """sudo ai-doctor --for-user <user>: every user check runs AS that user (no root-owned files appear in
    the user's home), then the Hermes checks run here as root (hermes' home is closed to the user)."""
    i = argv.index("--for-user")
    user = argv[i + 1] if i + 1 < len(argv) else ""
    rest = argv[:i] + argv[i + 2:]
    if os.geteuid() != 0:
        print("ai-doctor --for-user needs root: sudo %s --for-user %s" % (os.path.realpath(__file__), user))
        return 2
    import pwd
    try:
        pwd.getpwnam(user)
    except KeyError:
        print("ai-doctor: no such user: %s" % user)
        return 2
    me = os.path.realpath(__file__)
    code_user = subprocess.call(["sudo", "-u", user, "-H", "env", "AI_DOCTOR_MODE=no-hermes", "python3", me] + rest,
                                cwd="/")
    print("")
    code_root = subprocess.call(["python3", me] + rest, env=dict(os.environ, AI_DOCTOR_MODE="hermes-only"), cwd="/")
    return 1 if (code_user or code_root) else 0


# ---------------------------------------------------------------- checks

def check_profile():
    """The profile this machine runs; dev-mac: no scanner but skill-scanner, no audit gate, no box."""
    where = {"env": "AI_PROFILE", "file": ai_profile.profile_file(), "default": "OS default"}[PROFILE_FROM]
    if PROFILE not in ai_profile.names():
        say("FAIL", "profile %r (%s) is not one of %s" % (PROFILE, where, ", ".join(ai_profile.names())),
            "install.sh --profile server|dev-mac")
        return
    say("PASS", "profile %s (%s)" % (PROFILE, where))
    if PROFILE != "dev-mac":
        return
    keys = {e.get("key") for e in (load_json_file(os.path.join(STATE, "managed-keys.json")) or {}).get("entries") or []}
    installed = {t: (v.get("installed") or {}).get("version")
                 for t, v in ((load_json_file(os.path.join(STATE, "resolved.json")) or {}).get("tools") or {}).items()}
    code, out = run(["uv", "tool", "dir"]) if shutil.which("uv") else (1, "")
    uv_dir = out.strip().splitlines()[-1] if code == 0 and out.strip() else ""
    ours = {
        "guarddog": keys & {"cmd:uv:guarddog", "cmd:uv-root:guarddog"}
                    or (installed.get("guarddog") and uv_dir and os.path.isdir(os.path.join(uv_dir, "guarddog"))),
        "osv-scanner": "cmd:bin:osv-scanner" in keys
                       or (installed.get("osv-scanner") and os.path.exists(os.path.expanduser("~/.local/bin/osv-scanner"))),
    }
    for tool, here in sorted(ours.items()):
        say("FAIL" if here else "PASS", "dev-mac: no %s from this setup" % tool,
            "re-run install.sh (profile dev-mac removes it: recorded undo)" if here else "")
    rules = (load_json_file(os.environ.get("AI_ROUTING_JSON") or os.path.join(AI_DIR, "build", "routing.json"))
             or {}).get("rules") or []
    gate = any(r.get("id") == "audit-before-install" for r in rules)
    say("FAIL" if gate else "PASS", "dev-mac: no audit-before-install gate row in the rendered routing",
        "run ai-render (it renders for the profile in ~/.config/ai/profile)" if gate else "")
    plugins = ((load_json_file(os.path.expanduser("~/.claude/plugins/installed_plugins.json")) or {}).get("plugins") or {})
    codex_cfg = read_text_file(os.path.join(os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), "config.toml")) or ""
    where_box = [w for w, hit in (("Claude plugin ai-box@ai", "ai-box@ai" in plugins),
                                  ("Codex mcp_servers.box", re.search(r"^\[mcp_servers\.box\]", codex_cfg, re.M)))
                 if hit]
    say("FAIL" if where_box else "PASS", "dev-mac: box MCP server not registered", ", ".join(where_box)
        + ("; re-run install.sh (claude plugin uninstall ai-box@ai, codex mcp remove box)" if where_box else ""))


def check_render():
    code, out = run([os.path.join(BIN, "ai-render"), "--check"])
    say("PASS" if code == 0 else "FAIL", "routing.json, L0.md, AGENTS.md rendered and current", out if code else "")


def check_agents_md():
    path = os.path.join(AI_DIR, "AGENTS.md")
    if not os.path.isfile(path):
        say("FAIL", "ai/AGENTS.md exists", "run ai-render")
        return
    data = open(path, "rb").read()
    say("PASS" if len(data) <= CAP else "FAIL", "AGENTS.md size %d of %d bytes" % (len(data), CAP))
    say("PASS" if chr(0x2014).encode() not in data else "FAIL", "AGENTS.md has no em dash")
    link = os.path.expanduser("~/.config/ai/AGENTS.md")
    say("PASS" if os.path.exists(link) else "WARN", "~/.config/ai/AGENTS.md present")


def check_plugin_files():
    for rel in (".claude-plugin/plugin.json", ".codex-plugin/plugin.json", "hooks/hooks.json",
                "hooks/codex-hooks.json", ".mcp.json"):
        p = os.path.join(PLUGIN, rel)
        try:
            with open(p) as fh:
                json.load(fh)
            say("PASS", "ai-core %s valid JSON" % rel)
        except (OSError, ValueError) as exc:
            say("FAIL", "ai-core %s valid JSON" % rel, str(exc))
    for rel in ("hooks/router.py", "hooks/claude-notify"):
        p = os.path.join(PLUGIN, rel)
        say("PASS" if os.access(p, os.X_OK) else "FAIL", "ai-core %s executable" % rel)


def check_router_smoke():
    router = os.path.join(PLUGIN, "hooks", "router.py")
    payload = json.dumps({"hook_event_name": "UserPromptSubmit", "session_id": "ai-doctor",
                          "cwd": os.path.expanduser("~"), "prompt": "run an seo audit of the site"})
    env = dict(os.environ, AI_STATE_DIR=os.path.join(STATE, "doctor"))
    t0 = time.time()
    try:
        res = subprocess.run(["python3", router, "UserPromptSubmit"], input=payload.encode(), env=env,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
        ok = res.returncode == 0 and "claude-seo" in res.stdout.decode()
    except (OSError, subprocess.SubprocessError):
        ok = False
    ms = int((time.time() - t0) * 1000)
    say("PASS" if ok and ms < 1000 else "FAIL", "router answers a prompt in %d ms (limit 1000)" % ms)


def check_installed():
    if shutil.which("claude"):
        code, out = run(["claude", "plugin", "list"])
        say("PASS" if "ai-core" in out else "FAIL", "Claude: plugin ai-core installed")
    else:
        say("WARN", "Claude Code not found")
    if shutil.which("codex"):
        code, out = run(["codex", "plugin", "list"])
        say("PASS" if "ai-core" in out else "WARN", "Codex: plugin ai-core installed",
            "" if code == 0 else "codex plugin list failed")


def check_versions(network=False):
    """Owner decision 2026-11-14: each tool follows the newest stable release. Per tool found on this machine:
    installed version (or commit) against the newest stable. --quick uses the last resolved value in
    resolved.json (no network); the full run asks the registries (short timeouts). Unknown = SKIP."""
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "lib"))
    try:
        import resolve
        rows = resolve.status(network=network)
    except Exception as exc:          # a broken resolver must not stop the other checks
        say("WARN", "tool versions not checked: resolver failed", str(exc))
        return
    for r in rows:
        have = r["installed"] or r["installed_sha"][:12]
        new = r["newest"] if r["installed"] else (r["newest_sha"][:12] or r["newest"])
        if r["state"] == "unknown":
            say("SKIP", "%s %s: newest stable unknown (%s)" % (r["tool"], have,
                "offline" if network else "not resolved yet: run install.sh or ai-doctor without --quick"))
        elif r["state"] == "update":
            say("WARN", "update available: %s %s -> %s" % (r["tool"], have, new),
                "re-run install.sh (it moves the tool after agent-audit)%s" % (
                    "; held by %s_HOLD in ai/pins.env" % r["tool"].upper().replace("-", "_") if r["hold"] else ""))
        else:
            say("PASS", "%s %s is the %s" % (r["tool"], have,
                "held version (ai/pins.env)" if r["state"] == "hold" else "newest stable"))


def check_contracts():
    try:
        with open(os.path.join(PLUGIN, ".mcp.json")) as fh:
            servers = sorted(json.load(fh).get("mcpServers", {}))
    except (OSError, ValueError):
        servers = []
    rules_dir = os.path.join(AI_DIR, "rules")
    files = {f[:-3].lower(): os.path.join(rules_dir, f) for f in os.listdir(rules_dir)
             if f.endswith(".md")} if os.path.isdir(rules_dir) else {}
    for name in servers:
        n = name.lower()
        key = next((k for k in files if k in (n, n + "-mcp", "mcp-" + n) or k.replace("-", "") == n.replace("-", "")),
                   None)
        say("PASS" if key else "FAIL", "contract ai/rules/<tool>.md for MCP server %s" % name)
    for key, path in sorted(files.items()):
        text = open(path, encoding="utf-8").read()
        heads = [h.lower() for h in re.findall(r"^##+\s*(.+)$", text, re.M)]
        missing = [s for s in SECTIONS if not any(h.startswith(s) for h in heads)]
        verify = re.search(r"(?i)verify", text) is not None
        if missing or not verify:
            say("FAIL", "contract %s complete" % key,
                "missing: " + ", ".join(missing + ([] if verify else ["verify command"])))
        else:
            say("PASS", "contract %s complete" % key)


def check_copies():
    """Copied rule blocks (Codex AGENTS.md, Hermes SOUL.md, Hermes plugin) must match ai/AGENTS.md: ai-sync --check."""
    code, out = run(["bash", os.path.join(BIN, "ai-sync"), "--check"])
    lines = [ln for ln in out.splitlines() if ln[:4] in ("PASS", "FAIL", "WARN", "SKIP")]
    for ln in lines:
        level, _sp, what = ln.partition(" ")
        is_hermes = "Hermes" in what
        if (MODE == "hermes-only" and not is_hermes) or (MODE == "no-hermes" and is_hermes):
            continue
        say(level, what, SKIP_HERMES if level == "SKIP" else "")
    if code != 0 and not any(ln.startswith("FAIL") for ln in lines):
        say("FAIL", "ai-sync --check failed", out[-300:])
    if not lines and code == 0:
        say("PASS", "no copied rule blocks on this machine (no ~/.codex, no hermes user)")


def check_secrets():
    p = os.path.expanduser("~/.config/ai/secrets.env")
    if not os.path.exists(p):
        say("WARN", "~/.config/ai/secrets.env present")
        return
    mode = os.stat(p).st_mode & 0o777
    say("PASS" if mode == 0o600 else "FAIL", "secrets.env mode %o (want 600)" % mode)


def report_logs():
    since = time.time() - 7 * 86400
    misses = count_jsonl(os.path.join(STATE, "misses.jsonl"), "rule", since)
    fired = count_jsonl(os.path.join(STATE, "fired.jsonl"), "rule", since)
    skills = count_jsonl(os.path.join(STATE, "fired.jsonl"), "skill", since)
    print("\nlast 7 days: rules fired %s" % fmt(fired))
    print("last 7 days: skills used %s" % fmt(skills))
    print("last 7 days: misses %s" % fmt(misses))
    report_skill_stats(time.time() - 30 * 86400)
    skips =[ln for ln in read_lines(os.path.join(STATE, "gates.log")) if " SKIP " in ln]
    if skips:
        say("WARN", "%d gate skip(s) logged (last: %s)" % (len(skips), skips[-1][:120]))
    errors = read_lines(os.path.join(STATE, "router-errors.log"))
    if errors:
        say("WARN", "%d router error(s) logged (last: %s)" % (len(errors), errors[-1][:120]))


def report_skill_stats(since):
    """Per-skill use and the misses of gated skills (require_skill rules). Router logs only, never transcripts."""
    used = {}
    for name, n in count_jsonl(os.path.join(STATE, "fired.jsonl"), "skill", since).items():
        short = name.split(":")[-1]         # ai-core:ship and a read of ship/SKILL.md are the same skill
        used[short] = used.get(short, 0) + n
    print("last 30 days: skills used %s" % fmt(used))
    rules = (load_json_file(os.environ.get("AI_ROUTING_JSON") or os.path.join(AI_DIR, "build", "routing.json"))
             or {}).get("rules") or []
    gated = {r["id"]: r["require_skill"] for r in rules if r.get("require_skill")}
    misses = count_jsonl(os.path.join(STATE, "misses.jsonl"), "rule", since)
    print("last 30 days: gated skill misses %s" % fmt({"%s (%s)" % (rid, gated[rid]): n
                                                      for rid, n in misses.items() if rid in gated}))


def check_validate():
    if not shutil.which("claude"):
        return
    code, out = run(["claude", "plugin", "validate", PLUGIN])
    say("PASS" if code == 0 else "FAIL", "claude plugin validate ai-core", out[-400:] if code else "")


def check_tests():
    """The router cases only (about 400, under a minute). The whole suite (bash ai/tests/run.sh: installer, resolver,
    tier 1) runs over 20 minutes and timed out here on both Macs (owner QA 2026-11-15): run it by hand."""
    runner = os.path.join(AI_DIR, "tests", "test_router.py")
    if os.path.isfile(runner):
        code, out = run([sys.executable, runner], timeout=600)
        say("PASS" if code == 0 else "FAIL", "router tests (ai/tests/test_router.py; whole suite: bash ai/tests/run.sh)",
            out[-600:] if code else "")


def check_evals():
    """ai/evals/*.md are prompt lists for people (HOWTO.md Appendix 5), not machine-readable: report them
    as manual evals with their size. Automatic proof comes from the router tests and the fired/misses logs."""
    evals = os.path.join(AI_DIR, "evals")
    files = sorted(f for f in os.listdir(evals) if f.endswith(".md") and f != "HOWTO.md") if os.path.isdir(evals) else []
    if not files:
        say("WARN", "no evals in ai/evals")
        return
    prompts = 0
    for f in files:
        prompts += sum(1 for ln in read_lines(os.path.join(evals, f)) if re.match(r"^\s*(?:[-*]|\d+\.|\|)\s*\S", ln))
    say("WARN", "manual evals: %d files, about %d prompt lines in ai/evals (run them per ai/evals/HOWTO.md)"
        % (len(files), prompts))


def check_optional(name, cmd):
    if shutil.which(cmd[0]):
        code, out = run(cmd, timeout=120)
        say("PASS" if code == 0 else "WARN", " ".join(cmd), out[-300:] if code else "")


# ---------------------------------------------------------------- setup checks (fix round 2026-11-12)

HOME = os.path.expanduser("~")
# LINUX = a Linux server with the root layer (profile server: sandbox, /etc, managed settings, Hermes, /opt).
# Profile dev-mac on Linux (owner 2026-11-15) is checked like the Mac: everything in the user's home.
LINUX = sys.platform.startswith("linux") and PROFILE_KEYS.get("PROFILE_ROOT_LAYER", "1") == "1"
CODEX_HOME = os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
MANAGED = "/etc/claude-code/managed-settings.json"
HERMES_USER = os.environ.get("HERMES_USER", "hermes")


def load_json_file(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def aiconf_module():
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "lib"))
    import aiconf
    return aiconf


def check_rule_files():
    """CLAUDE.md, Codex and Hermes point agents at ~/.config/ai/{rules/,TOOLBOX.md}: they must exist."""
    if MODE != "hermes-only":
        check_rule_files_user()
    if hermes_present() and MODE != "no-hermes":
        code, out = as_hermes("ls ~/.config/ai/rules/serena.md ~/.config/ai/rules/claude-seo.md ~/.config/ai/TOOLBOX.md")
        if code is None:
            say("SKIP", "Hermes ~/.config/ai/{rules,TOOLBOX.md}", SKIP_HERMES)
        else:
            say("PASS" if code == 0 else "FAIL", "Hermes ~/.config/ai/{rules,TOOLBOX.md} present",
                "" if code == 0 else "admin: run sudo /opt/ai-setup/install.sh --update --for-user (copies them for hermes)")


def check_rule_files_user():
    base = os.path.join(HOME, ".config", "ai")
    rules = os.path.join(base, "rules")
    n = len([f for f in os.listdir(rules) if f.endswith(".md")]) if os.path.isdir(rules) else 0
    src = len([f for f in os.listdir(os.path.join(AI_DIR, "rules")) if f.endswith(".md")])
    say("PASS" if n and n >= src else "FAIL", "~/.config/ai/rules has the tool contracts (%d of %d)" % (n, src),
        "" if n else "re-run install.sh (links ~/.config/ai/rules)")
    say("PASS" if os.path.isfile(os.path.join(base, "TOOLBOX.md")) else "FAIL", "~/.config/ai/TOOLBOX.md present")


def check_codex_trust():
    """Codex runs a non-managed hook only when config.toml trusts its exact hashes (fired.jsonl showed 0 sessions).
    Linux admin installs put our hooks in /etc/codex/hooks.json (managed, no trust); elsewhere trust hashes."""
    if not shutil.which("codex") or not os.path.isdir(CODEX_HOME):
        return
    managed = "/etc/codex/hooks.json"
    have_managed = LINUX and os.path.isfile(managed)
    if have_managed:
        data = load_json_file(managed)
        text = json.dumps(data) if data else ""
        scripts = sorted(set(re.findall(r'(/[^\s"\\]+/hooks/(?:router\.py|serena-hook|stop-check\.py))', text)))
        bad = [x for x in scripts if not os.path.isfile(x) or os.access(x, os.W_OK)]
        aiconf = aiconf_module()
        for groups in ((data or {}).get("hooks") or {}).values():
            for g in groups:
                for h in g.get("hooks") or []:
                    cmd = h.get("command", "")
                    fixed, why = aiconf.absolute_command(cmd, "/nonexistent")
                    if why or fixed != cmd:
                        bad.append("program not absolute or not root-owned: %s" % (why or cmd[:60]))
        ok = bool(data) and "router.py" in text and scripts and not bad
        say("PASS" if ok else "FAIL", "Codex: ai-core hooks in %s (managed layer, no trust needed)" % managed,
            "" if ok else "missing or user-writable: %s; admin: sudo /opt/ai-setup/install.sh --update --for-user <user>" % (bad or "router.py"))
        sys.dont_write_bytecode = True
        aiconf = aiconf_module()
        root = aiconf.codex_active_plugin_root(CODEX_HOME, "ai-core", "ai")
        if root:
            rels = [r for r, _p in aiconf.codex_plugin_hook_files(root)]
            dup = any(r != "hooks/codex-hooks.managed.json" for r in rels)
            say("FAIL" if dup else "PASS", "Codex: the ai-core plugin copy ships no second (untrusted) set of hooks",
                "plugin cache %s still lists %s: re-run install.sh (refreshes the plugin)" % (root, rels) if dup else "")
    cmd = ["python3", os.path.join(AI_DIR, "lib", "aiconf.py"), "--state", os.devnull, "codex-trust-hooks",
           os.path.join(CODEX_HOME, "config.toml"), "--auto", "--check"]
    mtext = (read_text_file(managed) or "") if have_managed else ""
    cmd += ["--verify-source", "ai-core@ai=" + PLUGIN]
    for pid in ("ponytail@ponytail", "i-have-adhd@i-have-adhd"):
        if "agent-plugins/" + pid.split("@")[0] in mtext:
            cmd += ["--disable", pid, "--verify-source", "%s=/opt/agent-plugins/%s" % (pid, pid.split("@")[0])]
        elif os.path.isdir(plugin_src(pid.split("@")[0])):
            cmd += ["--verify-source", "%s=%s" % (pid, plugin_src(pid.split("@")[0]))]
    code, out = run(cmd)
    rows = [ln for ln in out.splitlines() if ln[:4] in ("PASS", "FAIL")]
    bad = [ln.split(": ", 1)[-1] for ln in rows if ln.startswith("FAIL")]
    if have_managed and not bad:
        if rows:
            say("PASS", "Codex: %d user-level hook entr(y/ies) current (plugin copies off, graphify trusted)" % len(rows))
        return
    say("PASS" if code == 0 and rows else "FAIL", "Codex: %d of %d of our hooks trusted (ai-core, rtk, graphify)"
        % (len(rows) - len(bad), len(rows)), "" if code == 0 else
        "untrusted: %s\nfix: ai-sync (or re-run install.sh) writes the trust hashes; if Codex still lists them as "
        "untrusted in /hooks, trust them there once" % "; ".join(bad[:4]) if rows else out[-300:])


def plugin_src(name):
    """Audited vendor plugin source (adapters/tools.sh plugin_src_dir)."""
    return os.path.join("/opt/agent-plugins" if LINUX else os.path.join(HOME, ".local", "share", "ai", "plugins"), name)


def claude_settings():
    return load_json_file(os.path.join(CLAUDE_DIR, "settings.json")) or {}


def root_owned_chain(path):
    """The file (symlinks followed) and every folder up to / are owned by root and not group/other writable."""
    if not path.startswith("/") or not os.path.isfile(path):
        return False
    for p in {os.path.abspath(path), os.path.realpath(path)}:
        while True:
            st = os.stat(p)
            if st.st_uid != 0 or st.st_mode & 0o022:
                return False
            if p == "/":
                break
            p = os.path.dirname(p)
    return True


PROJ_AGENT = "/usr/local/sbin/proj-agent"
PROJ_AGENT_SOCK = "/run/proj-agent.sock"
# Never writable by a sandboxed command (managed sandbox.filesystem.denyWrite; claude.sh SANDBOX_DENY_WRITE).
SANDBOX_DENY_WRITE_MIN = ("~/.local/bin", "~/.local/share/uv/tools", "~/.bashrc", "~/.profile", "~/.zshenv",
                          "~/.zshrc", "~/.gitconfig", "~/.config", "~/.codex", "~/.claude", "~/.hermes", "~/.serena")


def box_present():
    return LINUX and (os.path.exists(PROJ_AGENT_SOCK) or os.path.exists(PROJ_AGENT))


def check_claude_permissions():
    if not shutil.which("claude"):
        return
    perms = claude_settings().get("permissions") or {}
    allow, deny = perms.get("allow") or [], perms.get("deny") or []
    if LINUX:
        deny = deny + ((load_json_file(MANAGED) or {}).get("permissions") or {}).get("deny", [])
    need_allow = ["mcp__plugin_ai-core_context7__*", "Bash(gh pr view *)",
                  "Bash(ai-doctor*)", "WebFetch"]
    need_deny = ["Edit(~/.claude/settings.json)", "Edit(//etc/claude-code/**)", "Edit(~/.codex/config.toml)",
                 "Edit(~/.hermes/config.yaml)", "Read(~/.config/ai/secrets.env)"]
    miss_a = [r for r in need_allow if r not in allow]
    miss_d = [r for r in need_deny if r not in deny]
    say("PASS" if not miss_a else "FAIL", "Claude permissions.allow has the read-only tools (%d rules)" % len(allow),
        ("missing: " + ", ".join(miss_a)) if miss_a else "")
    if PROFILE_KEYS.get("PROFILE_GUARDS", "1") == "0":
        # Full agent autonomy (owner 2026-11-15, dev-mac): no ask/deny rules on purpose.
        say("PASS", "Claude permissions.deny: off on this profile (full autonomy; gates: secret-scan, pr-rules, merge-approval, no-verify)")
        miss_d = None
    if miss_d is not None:
        say("PASS" if not miss_d else "FAIL", "Claude permissions.deny protects rule and config files",
            ("missing: " + ", ".join(miss_d)) if miss_d else "")
    bad = [r for r in allow if r in ("Bash", "Bash(*)", "Edit", "Write", "Bash(graphify *)", "Bash(rtk *)")
           or r.startswith(("Bash(git push", "Bash(sudo"))]
    # rtk forms that pass arguments to a program that can run others: their exec forms must be denied.
    for allow_rule, deny_rule in (("Bash(rtk find *)", "Bash(rtk find *-exec*)"), ("Bash(rtk grep *)", "Bash(rtk grep *--pre*)"),
                                  ("Bash(rtk rg *)", "Bash(rtk rg *--pre*)"), ("Bash(rtk tree*)", "Bash(rtk tree* -o*)"),
                                  ("Bash(rtk git diff*)", "Bash(rtk git * --ext-diff*)")):
        if allow_rule in allow and deny_rule not in deny:
            bad.append("%s without the deny %s" % (allow_rule, deny_rule))
    if bad and miss_d is not None:      # full autonomy profile: broad allow rules are intended
        say("FAIL", "Claude allow list has write or push rules", ", ".join(bad))


