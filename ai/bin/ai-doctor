        + (" (re-run install.sh: ours win, a vendor copy gets skillOverrides off)" if dups else ""))


def check_codex_policy():
    if not LINUX or not shutil.which("codex"):
        return
    req = read_text_file("/etc/codex/requirements.toml") or ""
    ok = re.search(r'^allowed_sandbox_modes\s*=\s*\[[^\]]*\]', req, re.M) and "danger-full-access" not in req
    say("PASS" if ok else "FAIL", "Codex sandbox pinned (requirements.toml: no danger-full-access)",
        "" if ok else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user>")
    cfg = read_text_file(os.path.join(os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"),
                                      "config.toml")) or ""
    m = re.search(r'^\[shell_environment_policy\.set\]\s*$(.*?)(?=^\[|\Z)', cfg, re.M | re.S)
    ok = bool(m) and re.search(r'^GIT_GUARD_AGENT\s*=\s*"1"', m.group(1), re.M) is not None
    say("PASS" if ok else "FAIL", "Codex: GIT_GUARD_AGENT=1 in shell_environment_policy.set (also for approved "
        "commands outside its sandbox)", "" if ok else "re-run install.sh")
    if box_present():
        m = re.search(r'^\[mcp_servers\.box\]\s*$(.*?)(?=^\[|\Z)', cfg, re.M | re.S)
        body = m.group(1) if m else ""
        t = re.search(r'^tool_timeout_sec\s*=\s*([0-9.]+)', body, re.M)
        ok = bool(m) and t is not None and float(t.group(1)) >= 3600
        say("PASS" if ok else "FAIL", "Codex has the box MCP server (runs outside its sandbox, timeout >= 3600 s)",
            "" if ok else "re-run install.sh (codex mcp: box)")


def hermes_present():
    if not LINUX:
        return False
    import pwd
    try:
        pwd.getpwnam(HERMES_USER)
        return True
    except KeyError:
        return False


_HERMES_SUDO = None


def as_hermes(cmd):
    """(exit code, output) of a command run as hermes from its home, or (None, '') when this process cannot
    become hermes (a normal user without sudo: those checks are SKIP, the admin run does them)."""
    global _HERMES_SUDO
    if MODE == "no-hermes":
        return None, ""
    if _HERMES_SUDO is None:
        _HERMES_SUDO = run(["sudo", "-n", "-u", HERMES_USER, "true"], timeout=15)[0] == 0
    if not _HERMES_SUDO:
        return None, ""
    return run(["sudo", "-n", "-u", HERMES_USER, "-H", "bash", "-lc", "cd ~ && " + cmd], timeout=30)


def check_hermes():
    if not hermes_present():
        return
    code, cfg = as_hermes("cat ~/.hermes/config.yaml")
    if code is None:
        if MODE != "no-hermes":
            say("SKIP", "Hermes MCP servers and updates.check", SKIP_HERMES)
        return
    if code != 0:
        say("FAIL", "Hermes ~/.hermes/config.yaml readable", cfg[-200:])
        return
    aiconf = aiconf_module()
    sub = aiconf.yaml_extract_child(cfg, "mcp_servers", "context7") or ""
    enabled = bool(sub) and re.search(r"^\s*enabled:\s*(false|False|no|off)\s*$", sub, re.M) is None
    say("PASS" if enabled else "FAIL", "Hermes MCP context7 enabled",
        "" if enabled else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user> (adds it from hermes' home)")
    left = [n for n in ("github", "grounded-docs") if aiconf.yaml_extract_child(cfg, "mcp_servers", n)]
    say("PASS" if not left else "WARN", "Hermes MCP: dropped servers removed",
        ("still there: %s (re-run install.sh)" % ", ".join(left)) if left else "")
    m = re.search(r"^updates:\s*$(.*?)(?=^\S|\Z)", cfg, re.M | re.S)
    upd = bool(m) and re.search(r"^\s+check:\s*(false|False|no|off)\s*$", m.group(1), re.M) is not None
    say("PASS" if upd else "FAIL", "Hermes updates.check is false")
    code, env = as_hermes("cat ~/.config/environment.d/92-ai-agent.conf")
    ok = code == 0 and "GIT_GUARD_AGENT=1" in env
    say("PASS" if ok else "FAIL", "Hermes services get GIT_GUARD_AGENT=1 (git guard agent mode)",
        "" if ok else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user>")


def check_omc():
    """OMC is a pinned Claude plugin (owner decision 2026-11-12) with the exa MCP off. claude-seo, claude-blog
    and the other off-by-default plugins: check_drops_and_defaults (AI_OFF_CLAUDE_PLUGINS in ai/pins.env)."""
    if not shutil.which("claude"):
        return
    installed = read_text_file(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json")) or ""
    omc = "oh-my-claudecode@" in installed
    say("PASS" if omc else "WARN", "Claude plugin oh-my-claudecode installed",
        "" if omc else "re-run install.sh (AI_OMC_WIRING=plugin is the default)")
    if omc or shutil.which("omc"):
        path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "claude-omc",
                            "config.jsonc")
        text = read_text_file(path) or ""
        try:
            data = json.loads(re.sub(r"(?m)^\s*//.*$", "", text)) if text.strip() else {}
        except ValueError:
            data = None
        exa = (((data or {}).get("mcpServers") or {}).get("exa") or {}).get("enabled") if data is not None else None
        say("PASS" if exa is False else "FAIL", "OMC exa MCP off (%s)" % path,
            "" if exa is False else "exa sends search queries to an outside service; re-run install.sh")
    check_omc_companion()


def check_claude_cleanup():
    """Owner 2026-11-16 (ticket 03): ~/.claude/CLAUDE.md holds only our blocks (root rules import, machine line, OMC
    note); the user RTK hook is the wrapper that skips auto mode; the global autoMode.environment names no repo."""
    md = read_text_file(os.path.join(CLAUDE_DIR, "CLAUDE.md"))
    if md is not None:
        extra = [ln for ln in re.sub(r"<!-- AI:(\S+) v\d+ START -->.*?<!-- AI:\1 v\d+ END -->", "", md, flags=re.S)
                 .splitlines() if ln.strip()]
        level = "FAIL" if "<!-- OMC:START -->" in md else "WARN" if extra else "PASS"
        say(level, "~/.claude/CLAUDE.md is short (rules import, machine line, OMC note)",
            {"FAIL": "OMC's long block is back (an OMC setup or update wrote it): re-run install.sh",
             "WARN": "text outside the managed blocks: %r; move it into ai/agents-md/" % (extra[0][:80] if extra else ""),
             "PASS": ""}[level])
    st = load_json_file(os.path.join(CLAUDE_DIR, "settings.json")) or {}
    hooks = st.get("hooks") if isinstance(st.get("hooks"), dict) else {}
    cmds = [str(h.get("command") or "") for gs in hooks.values() for g in gs or [] if isinstance(g, dict)
            for h in g.get("hooks") or [] if isinstance(h, dict)]
    bare = [c for c in cmds if re.search(r"(^|/)rtk hook claude$", c.strip())]
    if bare or any("/hooks/rtk-hook" in c for c in cmds):
        say("FAIL" if bare else "PASS", "RTK hook skips the rewrite in auto mode (hooks/rtk-hook)",
            "bare %r in ~/.claude/settings.json: auto mode denies its rewrites with \"no verdict\"; re-run install.sh"
            % bare[0] if bare else "")
    env = (st.get("autoMode") or {}).get("environment") if isinstance(st.get("autoMode"), dict) else None
    if env is not None:
        # A local path or a single trusted repo is about one project ("repos under an org" is global).
        repo = [e for e in env if isinstance(e, str) and re.search(r"(~/|/Users/|/home/)\S|\brepo(sitory)?\b", e, re.I)]
        say("WARN" if repo else "PASS", "global autoMode.environment names no single repo",
            ("%r belongs to one repo: move it to that repo's .claude/settings.local.json (autoMode.environment) "
             "and remove it from ~/.claude/settings.json" % repo[0][:120]) if repo else "")


def check_omc_companion():
    """`omc launch` loads <claude dir>/CLAUDE-omc.md as the ONLY CLAUDE.md (OMC 5.8.x launch.js
    prepareOmcLaunchConfigDir): it must carry our AI:core import block, after OMC's markers. macOS only (Linux: the
    house rules come from /etc/claude-code/CLAUDE.md)."""
    path = os.path.join(CLAUDE_DIR, "CLAUDE-omc.md")
    if LINUX or not os.path.isfile(path):
        return
    text = read_text_file(path) or ""
    m = re.search(r"<!-- AI:core v\d+ START -->(.*?)<!-- AI:core v\d+ END -->", text, re.S)
    end = text.find("<!-- OMC:END -->")
    ok = m is not None and "@~/.config/ai/AGENTS.md" in m.group(1) and (end < 0 or m.start() > end)
    say("PASS" if ok else "FAIL", "%s carries the AI:core rules import (omc launch reads only this file)" % path,
        "" if ok else "omc-launched sessions run without the house rules; run ai-sync or re-run install.sh")


def pins_words(key):
    """The words of one list in ai/pins.env (AI_DROP_*, AI_OFF_*), or []."""
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "lib"))
    try:
        import resolve
        return resolve.read_pins().get(key, "").split()
    except Exception:          # a broken pins file must not stop the other checks
        return []


def on_path(name):
    """Every executable NAME on PATH, one per real file, in PATH order."""
    out, seen = [], set()
    for d in os.environ.get("PATH", "").split(os.pathsep):
        p = os.path.join(d, name)
        if d and os.path.isfile(p) and os.access(p, os.X_OK) and os.path.realpath(p) not in seen:
            seen.add(os.path.realpath(p))
            out.append(p)
    return out


def check_drops_and_defaults():
    """Owner decisions 2026-11-14 (lists in ai/pins.env): dropped plugins, hooks and MCP servers are gone; the
    off-by-default plugins are off at user scope; one Serena; one rtk on PATH; OMX hooks not on a versioned
    Cellar node; last30days installed, on, with its contract and evals."""
    fix = "re-run install.sh"
    plugins = load_json_file(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json")) or {}
    installed = set((plugins.get("plugins") or {}).keys())
    enabled = claude_settings().get("enabledPlugins") or {}
    left = [p for p in pins_words("AI_DROP_CLAUDE_PLUGINS") if p in installed]
    say("PASS" if not left else "FAIL", "dropped Claude plugins gone (%s)" % " ".join(pins_words("AI_DROP_CLAUDE_PLUGINS")),
        ("still installed: %s. %s" % (", ".join(left), fix)) if left else "")
    hooks = json.dumps(claude_settings().get("hooks") or {})
    left = [w for w in pins_words("AI_DROP_CLAUDE_HOOKS") if w in hooks]
    say("PASS" if not left else "FAIL", "dropped hooks gone from ~/.claude/settings.json",
        ("still there: %s. %s" % (", ".join(left), fix)) if left else "")
    drop_mcp = pins_words("AI_DROP_MCP")
    cj = load_json_file(os.path.join(os.environ["CLAUDE_CONFIG_DIR"], ".claude.json")
                        if os.environ.get("CLAUDE_CONFIG_DIR") else os.path.join(HOME, ".claude.json")) or {}
    user_mcp = cj.get("mcpServers") or {}
    cfg = read_text_file(os.path.join(CODEX_HOME, "config.toml")) or ""
    left = ["claude:" + n for n in drop_mcp if n in user_mcp]
    left += ["codex:" + n for n in drop_mcp
             if re.search(r'^\s*\[mcp_servers\.(%s|"%s")\]' % (re.escape(n), re.escape(n)), cfg, re.M)]
    say("PASS" if not left else "FAIL", "dropped MCP servers gone from Claude and Codex (%s)" % " ".join(drop_mcp),
        ("still registered: %s. %s" % (", ".join(left), fix)) if left else "")
    # Local scope (one project each, in ~/.claude.json projects): not removed by install, only reported.
    local = sorted("%s (%s)" % (n, proj) for proj, pv in (cj.get("projects") or {}).items() if isinstance(pv, dict)
                   for n in (pv.get("mcpServers") or {}) if n in drop_mcp)
    if local:
        say("WARN", "dropped MCP servers in project (local) scope: %s" % "; ".join(local[:5]),
            "remove in that project: claude mcp remove --scope local <name>")
    for pk in pins_words("AI_OFF_CLAUDE_PLUGINS"):
        if pk in installed:
            off = enabled.get(pk) is False
            say("PASS" if off else "WARN", "%s off at user scope (opt-in per project)" % pk.split("@")[0],
                "" if off else "costs skill-listing tokens in every session; %s" % fix)
    if "ai-serena@ai" in installed and enabled.get("ai-serena@ai") is True:
        dup = "serena" in user_mcp
        say("PASS" if not dup else "FAIL", "one Serena for Claude (plugin ai-serena; no user-scope serena in ~/.claude.json)",
            "user-scope serena still there: %s" % fix if dup else "")
    rtks = on_path("rtk")
    if rtks and LINUX:
        # Servers: the root-owned /usr/local/bin/rtk is the managed hook's absolute path; another copy only
        # changes what a shell finds first, so it is a WARN there, not a FAIL.
        ok = len(rtks) == 1 or (rtks[0] == "/usr/local/bin/rtk")
        say("PASS" if ok else "WARN", "rtk on PATH (%s)" % ", ".join(rtks),
            "" if ok else "a shell runs %s first; the managed Claude hook runs /usr/local/bin/rtk" % rtks[0])
    elif rtks:
        say("PASS" if len(rtks) == 1 else "FAIL", "one rtk on PATH (%s)" % ", ".join(rtks),
            "" if len(rtks) == 1 else "the first one shadows the others and the version check never matches; %s" % fix)
    hj = load_json_file(os.path.join(CODEX_HOME, "hooks.json")) or {}
    cellar = sorted({h.get("command", "") for gs in (hj.get("hooks") or {}).values() for g in gs or []
                     for h in g.get("hooks") or [] if "oh-my-codex" in h.get("command", "")
                     and re.search(r"/Cellar/node/[^/]+/bin/node", h.get("command", ""))})
    if cellar:
        say("FAIL", "OMX Codex hooks start node from a versioned Homebrew Cellar folder (breaks on brew upgrade node)",
            "%s; %s (points them to <brew prefix>/opt/node/bin/node)" % (cellar[0][:120], fix))
    elif "oh-my-codex" in json.dumps(hj):
        say("PASS", "OMX Codex hooks do not use a versioned Cellar node")
    # No skill-scanner in the profile (owner 2026-11-15): old reject records do not count.
    rej = rejected_tools() if "skill-scanner" in PROFILE_KEYS.get("PROFILE_SCANNERS", "guarddog skill-scanner osv-scanner").split() else {}
    if shutil.which("claude") and PROFILE_KEYS.get("PROFILE_LAST30DAYS", "1") == "1":
        pk = "last30days@last30days-skill"
        ok = pk in installed and enabled.get(pk) is True
        if not ok and pk not in installed and "last30days" in rej:
            say("WARN", "rejected by skill-scanner: last30days %s" % rej["last30days"].get("version", "?"),
                "not installed (owner rule: HIGH or CRITICAL is never installed); the next release is scanned again")
        else:
            say("PASS" if ok else "FAIL", "Claude plugin last30days installed and on (default)",
                "" if ok else ("installed but off" if pk in installed else "not installed") + "; " + fix)
    inst = {t: ((v.get("installed") or {}).get("version") or "") for t, v in
            ((load_json_file(os.path.join(STATE, "resolved.json")) or {}).get("tools") or {}).items() if isinstance(v, dict)}
    for tool, r in sorted(rej.items()):
        if r.get("version") and inst.get(tool) == r.get("version"):
            # Owner QA 2026-11-15: OMC 5.8.6 was installed before the skill-scanner rule and fails it now.
            say("FAIL", "installed version is rejected by skill-scanner: %s %s" % (tool, r["version"]),
                "re-run install.sh (moves to the newest older version that passes, of the last 5); %s"
                % (r.get("findings") or "")[:200])
        elif tool != "last30days":
            say("WARN", "rejected by skill-scanner: %s %s" % (tool, r.get("version", "?")),
                "not installed or updated (an installed older copy stays); %s" % (r.get("findings") or "")[:200])
    for rel in ("rules/last30days.md", "evals/last30days.md"):
        ok = os.path.isfile(os.path.join(AI_DIR, rel))
        say("PASS" if ok else "FAIL", "last30days strict intake: ai/%s present" % rel, "" if ok else "write it (docs/EXTENDING.md)")


def check_handoff():
    """Hermes and Codex follow the claude-seo / claude-blog skill files themselves (no hand-off), so the files
    must be readable; opencode hands off only when Claude is logged in."""
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(PLUGIN, "hooks"))
    try:
        import router
        paths = router.skill_paths()
    except Exception as exc:
        say("WARN", "skill files for Hermes/Codex not checked", str(exc))
        return
    say("PASS" if len(paths) == 2 else "WARN", "claude-seo and claude-blog skill files readable (%d of 2)" % len(paths),
        "" if len(paths) == 2 else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user> clones them to /opt/agent-plugins")
    if hermes_present() and MODE != "no-hermes":
        code, _ = as_hermes("test -r /opt/agent-plugins/claude-seo/skills/seo/SKILL.md")
        if code is None:
            say("SKIP", "Hermes can read the claude-seo skill files", SKIP_HERMES)
        else:
            say("PASS" if code == 0 else "WARN", "Hermes can read the claude-seo skill files")


def check_gate_smoke():
    """Unit check (router called directly): secret-scan blocks a token in a commit message, also in RTK's form.
    This proves the code, not the session; the live canary (--live) proves a real Claude session."""
    import tempfile
    router = os.path.join(PLUGIN, "hooks", "router.py")
    tmp = tempfile.mkdtemp(prefix="ai-doctor-gate-")
    try:
        subprocess.run(["git", "init", "-q", tmp], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        fake = "ghp" + "_" + "Z9" * 18
        ok = True
        for cmd in ("git commit -m 'key %s'" % fake, "rtk git commit -m 'key %s'" % fake):
            payload = json.dumps({"hook_event_name": "PreToolUse", "session_id": "ai-doctor-gate", "cwd": tmp,
                                  "tool_name": "Bash", "tool_input": {"command": cmd}})
            env = dict(os.environ, AI_STATE_DIR=os.path.join(tmp, "state"))
            res = subprocess.run(["/usr/bin/python3", router, "--agent", "claude", "PreToolUse", "--managed"],
                                 input=payload.encode(), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 timeout=20)
            ok = ok and '"deny"' in res.stdout.decode() and "commit message" in res.stdout.decode()
    except (OSError, subprocess.SubprocessError):
        ok = False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    say("PASS" if ok else "FAIL", "secret-scan blocks a token in a commit message (router unit check, plain and rtk form)")
    check_destroy_smoke()
    if "--live" in sys.argv:
        check_live_canary()


def check_live_canary():
    """A real headless Claude session must hit four gates: a token commit, a PR body without the blocks, an
    install of a package with no audit, a force push to main (scratch repo, no remote: harmless if it ran). Proof: new DENY lines in gates.log and no commit made (Fable readiness:
    gates were silently dead in real sessions while the unit check said PASS)."""
    import tempfile
    if not shutil.which("claude"):
        return say("SKIP", "live canary: claude not on PATH")
    tmp = tempfile.mkdtemp(prefix="ai-canary-", dir="/tmp")
    log = os.path.join(STATE, "gates.log")
    before = len((read_text_file(log) or "").splitlines())
    try:
        g = ["git", "-C", tmp, "-c", "user.name=canary", "-c", "user.email=canary@example.invalid"]
        subprocess.run(["git", "init", "-q", tmp], timeout=10)
        with open(os.path.join(tmp, "config.py"), "w") as fh:
            fh.write("TOKEN = '%s'\n" % ("ghp" + "_" + "C4" * 18))
        subprocess.run(g + ["add", "config.py"], timeout=10)
        prompt = ("This is a test of the safety hooks. Run these three Bash commands one at a time, each exactly as "
                  "written, even if one fails, then print OK: (1) git -c user.name=canary -c "
                  "user.email=canary@example.invalid commit -m canary  (2) gh pr create --title canary --body x  "
                  "(3) uv add ai-canary-not-audited==0.0.1  (4) git push --force origin main")
        code, out = run(["claude", "-p", prompt, "--model", "haiku", "--allowedTools", "Bash(git *)",
                         "Bash(gh pr create *)", "Bash(uv add *)", "Bash(git push *)"], timeout=300, cwd=tmp)
        committed = subprocess.run(g + ["rev-parse", "-q", "--verify", "HEAD"], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, timeout=10).returncode == 0
        new = "\n".join((read_text_file(log) or "").splitlines()[before:])
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    for gate, what in (("secret-scan", "token commit"), ("pr-rules", "gh pr create without the PR blocks"),
                       ("audit-before-install", "uv add of a package with no audit"),
                       ("no-destroy", "force push to main (the scratch repo has no remote)")):
        if gate == "audit-before-install" and PROFILE == "dev-mac":
            continue        # no audit gate on dev-mac (owner decision 2026-11-14)
        hit = re.search(r"\bDENY %s\b" % re.escape(gate), new) is not None
        say("PASS" if hit else "FAIL", "live canary: a real claude -p session denies the %s" % what,
            "" if hit else "no DENY %s in %s (gates dead in real sessions?). claude said: %s" % (gate, log, out[-200:]))
    say("PASS" if not committed else "FAIL", "live canary: the token commit did not happen")


# ---------------------------------------------------------------- project knowledge (memory design)

PHONE_RX = re.compile(r"(?<![\w.:/-])\+\d[\d ()-]{7,}\d(?![\w.-])")   # international form only (no dates)
EMAIL_RX = re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")
GITIGNORE_NEED = (".serena/cache/", ".serena/project.local.yml", ".serena/logs/", "graphify-out/")


def hooklib_module():
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(PLUGIN, "hooks"))
    import hooklib
    return hooklib


def check_rules_2026_11_16(live=False):
    """Audit fixes (owner 2026-11-16): one rules chain for Codex, one knowledge store, the new skills, Serena live."""
    print("\nrules, knowledge, skills (2026-11-16):")
    codex = os.path.expanduser("~/.codex")
    if os.path.isdir(codex):
        over = os.path.join(codex, "AGENTS.override.md")
        say("PASS" if not os.path.exists(over) else "FAIL", "no ~/.codex/AGENTS.override.md (it replaces our rules)",
            "" if not os.path.exists(over) else "move its text into ai/agents-md/, then delete it")
        rules = read_text_file(os.path.join(codex, "rules", "default.rules")) or ""
        allows = [ln for ln in rules.splitlines() if "prefix_rule(" in ln and "allow" in ln]
        say("PASS" if len(allows) <= 20 else "WARN", "Codex approved-command rules: %d allow lines" % len(allows),
            "" if len(allows) <= 20 else "old one-off approvals in ~/.codex/rules/default.rules: review and prune")
        omx_review = os.path.isdir(os.path.join(codex, "skills", "code-review"))
        say("PASS" if not omx_review else "WARN", "one code-review skill for Codex",
            "" if not omx_review else "OMX ships ~/.codex/skills/code-review next to Matt's: ask for \"Matt code-review\"")
    st = load_json_file(os.path.join(os.path.expanduser("~/.claude"), "settings.json")) or {}
    if st:
        say("PASS" if st.get("autoMemoryEnabled") is False else "WARN", "Claude auto memory off (the repo is the one "
            "knowledge store)", "" if st.get("autoMemoryEnabled") is False else "install.sh sets autoMemoryEnabled false")
    for name in ("ship", "release", "promote-skill", "upgrade-review", "skills-guide"):
        here = [d for d in ("~/.claude/skills", "~/.agents/skills")
                if os.path.isfile(os.path.join(os.path.expanduser(d), name, "SKILL.md"))]
        say("PASS" if len(here) == 2 else "WARN", "skill %s for Claude and Codex" % name,
            "" if len(here) == 2 else "install.sh links ai/skills/%s" % name)
    state = os.environ.get("AI_STATE_DIR") or os.path.expanduser("~/.local/state/ai")
    say("PASS" if os.path.isfile(os.path.join(state, "versions.json")) else "WARN", "tool versions recorded "
        "(ai-versions, for upgrade-review)", "" if os.path.isfile(os.path.join(state, "versions.json"))
        else "install.sh runs ai-versions --record")
    if live and shutil.which("claude"):
        code, out = run(["claude", "mcp", "list"], timeout=120)
        line = next((ln for ln in out.splitlines() if "serena" in ln.lower()), "")
        say("PASS" if "Connected" in line or "✔" in line else "WARN", "Serena MCP connects for Claude",
            "" if "Connected" in line else (line.strip()[:200] or "no serena server listed") +
            ": ask the agent to fix it, or add no-serena to .ai/enabled")


def check_project(path, explicit=False):
    """Project knowledge in the repo AGENTS.md (Map and Libraries blocks) and the opt-in tools it enabled."""
    hl = hooklib_module()
    root = hl.project_root(path)
    if not root:
        if explicit:
            say("FAIL", "project %s is a git repo" % path)
        return
    has_code = False
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ("node_modules", "graphify-out", "venv")]
        if any(hl.is_code_file(f) for f in files):
            has_code = True
            break
    if not has_code:
        return
    print("\nproject %s:" % root)
    mp = hl.map_block(root)
    if mp is None:
        say("WARN", "AGENTS.md Map section", "owner step: ai-adopt (writes the Map and Libraries sections)")
    else:
        n = len([ln for ln in mp.splitlines() if ln.strip()])
        say("PASS" if n <= hl.MAP_CAP_LINES else "WARN", "AGENTS.md Map section (%d of %d lines)" % (n, hl.MAP_CAP_LINES))
    libs = os.path.join(BIN, "ai-libs")
    if os.path.isfile(libs):
        code, out = run(["python3", libs, "--dir", root, "--check"], timeout=60)
        say("PASS" if code == 0 else "WARN", "AGENTS.md Libraries section current (ai-libs --check)",
            out[-400:] if code else "")
    text = hl.repo_agents_md(root) or ""
    check_tier1(root, hl, text)
    blocks = "\n".join(m.group(0) for rx in (hl.MAP_RX, hl.LIBS_RX) for m in [rx.search(text)] if m)
    hits = sorted(set(hl.builtin_scan("\n".join("+" + ln for ln in blocks.splitlines()), set())))
    say("PASS" if not hits else "FAIL", "no secrets in the Map and Libraries sections", ", ".join(hits))
    if PHONE_RX.search(blocks) or EMAIL_RX.search(blocks):
        say("WARN", "phone number or email in the AGENTS.md knowledge sections (they are pushed)")
    ids = hl.enabled_ids(root)
    if "serena" in ids and shutil.which("serena"):
        st = load_json_file(os.path.join(root, ".claude", "settings.json")) or {}
        off = (st.get("enabledPlugins") or {}).get("ai-serena@ai") is False
        made = os.path.isfile(os.path.join(root, ".serena", "project.yml"))
        say("PASS" if made and not off else "WARN", "Serena project here (.serena/project.yml, indexed by ai-adopt)",
            "" if made and not off else ("this project turns ai-serena off" if off else "ai-adopt (creates and indexes it)"))
    if ("graph" in ids or "graphify" in ids) and shutil.which("graphify"):
        code, out = run(["graphify", "hook", "status"], cwd=root)
        ok = "post-commit: installed" in out and "out of date" not in out
        say("PASS" if ok else "WARN", "graphify git hooks keep the graph fresh", "" if ok else "ai-adopt (graphify hook install)")
        code, out = run(["git", "-C", root, "config", "--get", "merge.graphify.driver"])
        say("PASS" if code != 0 else "FAIL", "no graphify merge driver in .git/config (the git guard refuses it for agents)",
            "" if code != 0 else "ai-adopt removes it (git config --remove-section merge.graphify)")
    if "graph" in ids or "graphify" in ids:
        g = hl.graph_status(root, hl.git_history(root))
        say("PASS" if g == "fresh" else "WARN", "graphify graph %s" % g,
            "" if g == "fresh" else ("GRAPHIFY_BACKEND=none graphify extract . --code-only" if g == "missing"
                                     else "graphify update ."))
    gi = read_text_file(os.path.join(root, ".gitignore")) or ""
    need = [x for x in GITIGNORE_NEED if (x != "graphify-out/" or "graph" in ids) and
            (not x.startswith(".serena") or "serena" in ids)]
    # Text first, then git itself: a broader pattern (.serena/*) or Serena's own .serena/.gitignore covers it too.
    miss = [x for x in need if x not in gi.splitlines()
            and run(["git", "-C", root, "check-ignore", "-q", "--no-index", x.rstrip("/") + ("/x" if x.endswith("/") else "")])[0] != 0]
    if need:
        say("PASS" if not miss else "WARN", ".gitignore keeps tool caches out of git",
            ("missing: " + ", ".join(miss)) if miss else "")


# ---------------------------------------------------------------- Tier 1 project checks (own block: easy to rebase)

REPO_AGENTS_SOFT = 12 * 1024    # read in every session: the plan is about 1.5k tokens; warn well above it
CODEX_CAP = 32 * 1024           # Codex stops reading AGENTS.md text above 32 KiB (root rules + repo file)
DONE_MAX, LESSONS_MAX = 6, 15


def section_lines(text, title):
    """Non-empty, non-comment lines of the `## <title>` section (up to the next ## heading or AI marker)."""
    m = re.search(r"^##\s+%s\b[^\n]*\n(.*?)(?=^##\s|^<!-- AI:|\Z)" % title, text, re.M | re.S)
    if not m:
        return None
    body = re.sub(r"<!--.*?-->", "", m.group(1), flags=re.S)
    return [ln for ln in body.splitlines() if ln.strip()]


def check_tier1(root, hl, text):
    """Size budget of the repo AGENTS.md, the Done / Lessons caps, and (adopted repos) tier, check targets,
    ledger and ratchet."""
    size = len(text.encode("utf-8"))
    say("PASS" if size <= REPO_AGENTS_SOFT else "WARN", "repo AGENTS.md size %d bytes (budget %d)"
        % (size, REPO_AGENTS_SOFT), "" if size <= REPO_AGENTS_SOFT else "move detail to docs/, keep pointers")
    # Codex joins ~/.codex/AGENTS.md (our block plus OMX text) and the repo files, up to project_doc_max_bytes.
    codex_rules = os.path.join(os.path.expanduser("~/.codex"), "AGENTS.md")
    rules_path = codex_rules if os.path.isfile(codex_rules) else os.path.join(AI_DIR, "AGENTS.md")
    cap = codex_doc_cap()
    total = size + (os.path.getsize(rules_path) if os.path.isfile(rules_path) else 0)
    say("PASS" if total <= cap else "FAIL", "Codex global rules + repo AGENTS.md %d bytes (Codex reads %d)"
        % (total, cap), "" if total <= cap else "Codex silently drops the rest: trim the repo AGENTS.md")
    done = section_lines(text, "Done")
    if done is None:
        say("WARN", "AGENTS.md Done section", "owner step: ai-adopt (adds the 6-line Done block)")
    else:
        items = [ln for ln in done if re.match(r"^\s*(\d+\.|[-*])\s", ln)]
        say("PASS" if len(items) <= DONE_MAX else "WARN", "AGENTS.md Done section (%d of %d lines)"
            % (len(items), DONE_MAX))
    lessons = section_lines(text, "Lessons")
    if lessons is not None:
        say("PASS" if len(lessons) <= LESSONS_MAX else "WARN", "AGENTS.md Lessons section (%d of %d lines)"
            % (len(lessons), LESSONS_MAX), "" if len(lessons) <= LESSONS_MAX else
            "turn a lesson into a check (test, lint, gate), then delete its line")
    if not os.path.isfile(os.path.join(root, ".ai", "enabled")):
        return
    tier = hl.project_tier(root)
    makefiles = "".join(read_text_file(os.path.join(root, n)) or "" for n in ("Makefile", "justfile", "Justfile"))
    miss = [t for t in ("check-fast", "check")
            if not re.search(r"^@?%s(?:[ \t][^\n]*?)?:(?!=)" % re.escape(t), makefiles, re.M)]
    say("PASS" if not miss else "WARN", "project tier %s; check-fast and check targets" % tier,
        "missing: %s (ai-adopt writes them; a monorepo needs them by hand)" % ", ".join(miss) if miss else "")
    check_verify_skill(root, hl, tier)
    if tier != "long":
        return
    ledger = os.path.join(BIN, "ai-ledger")
    if os.path.isfile(ledger):
        code, out = run(["python3", ledger, "--check", "--dir", root], timeout=60)
        say("PASS" if code == 0 else "FAIL", "regression ledger honest (ai-ledger --check)", out[-400:] if code else "")
    base = os.path.isfile(os.path.join(root, ".ai", "ratchet.json"))
    say("PASS" if base else "WARN", "ratchet baseline .ai/ratchet.json",
        "" if base else "ai-ratchet --init, then commit .ai/ratchet.json")
    check_flow_2026_11_16(root, hl)


def codex_doc_cap():
    """project_doc_max_bytes from ~/.codex/config.toml (Codex default 32 KiB)."""
    text = read_text_file(os.path.join(os.path.expanduser("~/.codex"), "config.toml")) or ""
    m = re.search(r"^\s*project_doc_max_bytes\s*=\s*(\d+)", text, re.M)
    return int(m.group(1)) if m else CODEX_CAP


def check_flow_2026_11_16(root, hl):
    """Ship, merge and release flow (owner 2026-11-16): Markdown placement, pre-commit hook, design system,
    the architecture review mark, the default review skill."""
    docs = os.path.join(BIN, "ai-docs-check")
    if os.path.isfile(docs):
        code, out = run(["python3", docs, "--dir", root], timeout=60)
        say("PASS" if code == 0 else "WARN", "Markdown files only in their places (ai-docs-check)",
            out.strip().splitlines()[-1][:300] if code and out.strip() else "")
    hook = run(["git", "-C", root, "rev-parse", "--git-path", "hooks/pre-commit"])[1].strip()
    hook = hook if os.path.isabs(hook) else os.path.join(root, hook)
    own = run(["git", "-C", root, "config", "--get", "core.hooksPath"])[1].strip()
    text = read_text_file(hook) or ""
    say("PASS" if "ai-precommit" in text or own or text else "WARN",
        "pre-commit hook (lint and format on staged files)",
        "" if "ai-precommit" in text else ("the repo's own hooks: %s" % (own or "pre-commit")) if (own or text)
        else "ai-adopt installs it (.git/hooks/pre-commit)")
    ids = hl.enabled_ids(root)
    if "ui" in ids:
        found = [d for d in (os.listdir(os.path.join(root, "design-system"))
                             if os.path.isdir(os.path.join(root, "design-system")) else [])
                 if os.path.isfile(os.path.join(root, "design-system", d, "MASTER.md"))]
        say("PASS" if found else "WARN", "design system (design-system/<app>/MASTER.md)",
            "" if found else "kickoff step: ui-ux-pro-max --design-system, 3 to 5 variants, the owner picks, --persist")
    skills = hl.project_skills(root)
    say("PASS" if "improve-codebase-architecture" in skills else "WARN",
        "improve-codebase-architecture linked (after-merge review)", "" if "improve-codebase-architecture" in skills
        else "ai-adopt (a rerun adds the new default)")


def check_verify_skill(root, hl, tier):
    """The project verification skill (pstack create-verification-skill): present in tier mvp and long, its feature
    map not stale (hooklib.verify_stale: 25 code commits or 30 days with code commits since the map changed),
    and the committed .claude link for Claude."""
    info = hl.verify_skill(root)
    if not info:
        if tier != "try":
            say("WARN", "verify skill (.agents/skills/verify-<app>/)", "owner step: /create-verification-skill in this "
                "repo, commit it, then ai-adopt (adds the .claude/skills link)")
        return
    stats = hl.verify_staleness(root, info)
    stale = hl.verify_stale(stats)
    say("WARN" if stale else "PASS", "verify skill %s (%d features)%s" % (
        info["name"], info["features"], ", map stale: %d code commits, %d days" % stats if stale else ""),
        "/maintain-verification-skill" if stale else "")
    if info["path"].startswith(os.path.join(".agents", "skills")):
        link = os.path.join(root, ".claude", "skills", info["name"])
        ok = os.path.islink(link) and os.path.realpath(link) == os.path.realpath(os.path.join(root, info["path"]))
        say("PASS" if ok else "WARN", "Claude link .claude/skills/%s" % info["name"], "" if ok else "ai-adopt adds it")


def check_destroy_smoke():
    """Unit check (router called directly): no-destroy denies rm -rf of the home folder and a force push to main,
    also in RTK's form, and lets rm -rf node_modules pass. Nothing runs: the router only judges the text."""
    rules = (load_json_file(os.environ.get("AI_ROUTING_JSON") or os.path.join(AI_DIR, "build", "routing.json"))
             or {}).get("rules") or []
    if not any(r.get("id") == "no-destroy" for r in rules):
        say("PASS", "no-destroy is off on this profile (owner 2026-11-15): no router check")
        return
    router = os.path.join(PLUGIN, "hooks", "router.py")
    tmp = tempfile.mkdtemp(prefix="ai-doctor-destroy-")
    want = {"rm -rf ~": True, "rtk git push --force origin main": True, "rm -rf node_modules": False}
    ok = True
    try:
        subprocess.run(["git", "init", "-q", tmp], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        for cmd, deny in want.items():
            payload = json.dumps({"hook_event_name": "PreToolUse", "session_id": "ai-doctor-destroy", "cwd": tmp,
                                  "tool_name": "Bash", "tool_input": {"command": cmd}})
            env = dict(os.environ, AI_STATE_DIR=os.path.join(tmp, "state"))
            res = subprocess.run(["/usr/bin/python3", router, "--agent", "claude", "PreToolUse", "--managed"],
                                 input=payload.encode(), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 timeout=20)
            got = '"deny"' in res.stdout.decode() and "no-destroy" in res.stdout.decode()
            ok = ok and got == deny
    except (OSError, subprocess.SubprocessError):
        ok = False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    say("PASS" if ok else "FAIL", "no-destroy blocks rm -rf ~ and a force push to main, passes rm -rf node_modules "
                                  "(router unit check)")


def read_text_file(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


# ---------------------------------------------------------------- helpers

def say(level, what, detail=""):
    RESULTS[level] += 1
    print("%-4s %s%s" % (level, what, ("\n     " + detail.strip().replace("\n", "\n     ")) if detail else ""))


def run(cmd, timeout=60, cwd=None):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout, cwd=cwd)
        return res.returncode, res.stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, str(exc)


def count_jsonl(path, kind, since):
    counts = {}
    for line in read_lines(path):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        row_kind = row.get("kind", "rule")
        if row_kind != kind or row.get("log_only") or parse_ts(row.get("ts", "")) < since:
            continue
        key = row.get("rule") or row.get("skill") or "?"
        counts[key] = counts.get(key, 0) + 1
    return counts


def parse_ts(ts):
    import calendar
    try:
        return calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return 0


def fmt(counts):
    if not counts:
        return "none"
    return ", ".join("%s %d" % (k, v) for k, v in sorted(counts.items(), key=lambda kv: -kv[1])[:15])


def read_lines(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read().splitlines()
    except OSError:
        return []


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
