                    "" if ok else "re-run install.sh")


def check_claude_policy():
    """Linux: the managed Bash sandbox and the planted-config lock (escape tests in config form)."""
    if not LINUX or not shutil.which("claude"):
        return
    ms = load_json_file(MANAGED) or {}
    sb = ms.get("sandbox") or {}
    on = sb.get("enabled") is True and sb.get("failIfUnavailable") is True and sb.get("allowUnsandboxedCommands") is False
    say("PASS" if on else "FAIL", "Claude Bash sandbox required (enabled, failIfUnavailable, no unsandboxed retry)",
        "" if on else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user> (managed-settings sandbox)")
    want = ["~/.ssh", "~/.config/gh", "~/.claude/.credentials.json", "~/.codex/auth.json", "~/.config/ai/secrets.env",
            "~/.hermes/.env"]
    denied = set((sb.get("filesystem") or {}).get("denyRead") or []) | {
        f.get("path") for f in ((sb.get("credentials") or {}).get("files") or []) if f.get("mode") == "deny"}
    miss = [p for p in want if p not in denied]
    say("PASS" if not miss else "FAIL", "sandbox denies reading the credential files", ", ".join(miss))
    for tool in ("bwrap", "socat", "rg"):
        if not shutil.which(tool):
            say("FAIL", "sandbox dependency %s installed" % tool, "admin: apt-get install bubblewrap socat ripgrep")
    bw = sb.get("bwrapPath") or shutil.which("bwrap")
    if bw and bw == sb.get("bwrapPath") and LINUX and not os.access(bw, os.X_OK):
        import grp
        import pwd
        user = pwd.getpwuid(os.getuid()).pw_name
        try:
            members = grp.getgrnam("ai-sandbox").gr_mem
            in_session = grp.getgrnam("ai-sandbox").gr_gid in os.getgroups()
        except KeyError:
            members, in_session = [], False
        if user in members and not in_session:
            say("WARN", "Claude sandbox: %s is in group ai-sandbox, this session is not yet" % user,
                "log in again (new ssh session), then start Claude")
        else:
            say("FAIL" if os.getuid() != 0 else "SKIP", "Claude sandbox: %s may not run %s (group ai-sandbox)" % (user, bw),
                "admin: sudo /opt/ai-setup/install.sh --update --for-user <user> (adds the agent user)")
        bw = None
    if bw:
        # What the Claude sandbox really does: bubblewrap with user, pid and net namespaces, and inside it a
        # NESTED user namespace with a root map (apply-seccomp writes /proc/self/setgroups there). Ubuntu's
        # bwrap-userns-restrict (unpriv_bwrap) lets the outer step pass and fails exactly this inner one.
        code, out = run([bw, "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--unshare-user",
                         "--unshare-pid", "--unshare-net", "--", "unshare", "--user", "--map-root-user", "true"],
                        timeout=20)
        say("PASS" if code == 0 else "FAIL", "Claude sandbox can start here (bubblewrap %s, nested user namespace)" % bw,
            "" if code == 0 else (out.strip()[-240:] + "\nUbuntu AppArmor (bwrap-userns-restrict): admin runs "
                                  "sudo /opt/ai-setup/install.sh --update --for-user <user> (bwrap copy + profile)"))
        if LINUX and read_text_file("/proc/sys/kernel/apparmor_restrict_unprivileged_userns") == "1\n":
            st = os.stat("/usr/local/lib/ai/bwrap") if os.path.exists("/usr/local/lib/ai/bwrap") else None
            ok = sb.get("bwrapPath") == "/usr/local/lib/ai/bwrap" and os.path.exists("/etc/apparmor.d/ai-claude-bwrap") \
                and st is not None and st.st_uid == 0 and (st.st_mode & 0o777) == 0o750
            say("PASS" if ok else "FAIL", "userns restricted: Claude uses the profiled bubblewrap copy",
                "" if ok else "managed sandbox.bwrapPath /usr/local/lib/ai/bwrap (root:ai-sandbox 0750) with /etc/apparmor.d/ai-claude-bwrap")
    if "--live" in sys.argv and shutil.which("claude"):
        # Optional end-to-end proof (one small model call): a headless Bash command through the sandbox.
        # In a scratch folder: the home-folder gate blocks every command of a session started in ~.
        scratch = tempfile.mkdtemp(prefix="ai-doctor-live-")
        code, out = run(["claude", "-p", "Run exactly this Bash command and print its output: echo AI_SANDBOX_OK",
                         "--allowedTools", "Bash(echo *)"], timeout=180, cwd=scratch)
        ok = code == 0 and "AI_SANDBOX_OK" in out
        say("PASS" if ok else "FAIL", "live: claude -p runs a sandboxed Bash command", "" if ok else out[-300:])
        if box_present():
            # The box tool: the box MCP server (outside the sandbox) talks to the root socket service.
            code, out = run(["claude", "-p", "List the boxes using the box tool (its list tool). Print its full output, "
                             "starting with the exit code line.", "--allowedTools", "mcp__plugin_ai-box_box__list"],
                            timeout=240, cwd=scratch)
            ok = code == 0 and "exit code 0" in out
            say("PASS" if ok else "FAIL", "live: claude -p lists the boxes through the box MCP tool",
                "" if ok else out[-300:])
        shutil.rmtree(scratch, ignore_errors=True)
    lock = ms.get("strictPluginOnlyCustomization")
    locked = lock is True or (isinstance(lock, list) and {"hooks", "mcp"} <= set(lock))
    say("PASS" if locked else "FAIL", "planted .claude/settings.json hooks and .mcp.json servers do not load "
        "(strictPluginOnlyCustomization hooks+mcp)", "" if locked else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user>")
    forced = (ms.get("enabledPlugins") or {}).get("ai-core@ai") is True
    say("PASS" if forced else "FAIL", "ai-core force-enabled in managed settings (router and gates cannot be switched off)",
        "" if forced else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user>")
    hooks = json.dumps(ms.get("hooks") or {})
    # The gates run from the root-owned copy (managed hooks); the user-writable plugin copy steps aside.
    m = re.search(r'(/[^"\\ ]+/hooks/router\.py)\\?" --agent claude PreToolUse --managed', hooks)
    ok = m is not None and root_owned_chain(m.group(1))
    say("PASS" if ok else "FAIL", "Claude runs the ai-core router (gates) from the root-owned copy (managed hooks)",
        "" if ok else "admin: sudo /opt/ai-setup/install.sh --update --for-user <user>")
    if shutil.which("rtk") and locked:
        say("PASS" if "/hooks/rtk-hook" in hooks else "WARN", "RTK hook runs as a managed hook through hooks/rtk-hook "
            "(user hooks are locked; no rewrite in auto mode)")
    if (claude_settings().get("enabledPlugins") or {}).get("ai-serena@ai") is not True and shutil.which("serena"):
        say("FAIL", "Serena on at user scope (enabledPlugins ai-serena@ai true; on by default)", "re-run install.sh")
    for n in ("claude-seo@agricidaniel-claude-seo", "claude-blog@agricidaniel-blog", "oh-my-claudecode@omc"):
        val = (claude_settings().get("enabledPlugins") or {}).get(n)
        if val is not None:
            say("PASS" if val is False else "WARN", "%s off at user scope (opt-in per project)" % n.split("@")[0])
    # Commands that leave the sandbox: absolute, root-owned, not writable (a bare name is found on PATH, and
    # ~/.local/bin comes first and is writable by Claude's Write tool).
    exc = sb.get("excludedCommands") or []
    loose = [c for c in exc if not root_owned_chain(str(c).split()[0] if str(c).split() else "")]
    say("PASS" if not loose else "FAIL", "sandbox exclusions use absolute root-owned programs only (%d)" % len(exc),
        "" if not loose else "not safe: %s. admin: sudo /opt/ai-setup/install.sh --update --for-user <user>" % loose)
    fix = "admin: sudo /opt/ai-setup/install.sh --update --for-user <user>"
    ok = (ms.get("env") or {}).get("GIT_GUARD_AGENT") == "1"
    say("PASS" if ok else "FAIL", "Claude: GIT_GUARD_AGENT=1 in managed env (git guard agent mode for every repo)",
        "" if ok else fix)
    deny = (ms.get("permissions") or {}).get("deny") or []
    ok = "Edit(~/.local/bin/**)" in deny and "Edit(~/.bashrc)" in deny
    say("PASS" if ok else "FAIL", "agents cannot write PATH folders or shell start-up files (managed Edit denies)",
        "" if ok else fix)
    fs = sb.get("filesystem") or {}
    miss = [p for p in SANDBOX_DENY_WRITE_MIN if p not in (fs.get("denyWrite") or [])]
    say("PASS" if not miss else "FAIL", "sandboxed commands cannot write PATH folders, uv tools, dotfiles, agent config "
        "(denyWrite)", ("missing: %s. %s" % (", ".join(miss), fix)) if miss else "")
    bad_w = [p for p in (fs.get("allowWrite") or []) if p in ("~/.cache/uv", "~", "~/")]
    say("PASS" if not bad_w else "FAIL", "the sandbox does not write the uv cache that tool installs use",
        ("allowWrite has %s. %s" % (", ".join(bad_w), fix)) if bad_w else "")
    net = sb.get("network") or {}
    ok = net.get("allowAllUnixSockets") is not True and not net.get("allowUnixSockets")
    say("PASS" if ok else "FAIL", "unix sockets stay blocked in the sandbox (box work goes through the box MCP tool)",
        "" if ok else fix)
    if sb.get("allowGitConfig") is True or fs.get("disabled") is True:
        say("FAIL", "the sandbox keeps its built-in .git/hooks and .git/config protection", fix)
    if box_present():
        if os.path.exists(PROJ_AGENT):
            ok = root_owned_chain(PROJ_AGENT)
            say("PASS" if ok else "FAIL", "%s and its folders are root-owned, not writable" % PROJ_AGENT,
                "" if ok else "fix on the server (ubuntu-server branch installs it root:root 0755)")
        if os.path.exists(PROJ_AGENT_SOCK):
            can = os.access(PROJ_AGENT_SOCK, os.R_OK | os.W_OK)
            say("PASS" if can else "FAIL", "%s reachable by this user (the box MCP tool runs as this user)" % PROJ_AGENT_SOCK,
                "" if can else "add the user to the agents' group (ubuntu-server branch), then log in again")
        allow = claude_settings().get("permissions", {}).get("allow") or []
        ok = "mcp__plugin_ai-box_box__*" in allow
        say("PASS" if ok else "FAIL", "Claude may use the box MCP tools without a prompt", "" if ok else fix)
    work = "/srv/proj/work"
    if os.path.isdir(work):
        code, out = run(["findmnt", "-n", "-o", "OPTIONS", "--target", work])
        opts = out.strip().split(",")
        ok = "nosuid" in opts and "nodev" in opts
        say("PASS" if ok else "FAIL", "%s is mounted nosuid,nodev (a setuid file from a box cannot run on the host)"
            % work, "" if ok else "options: %s (ubuntu-server branch: own filesystem with nosuid,nodev)" % out.strip())


def check_hooks_absolute():
    """Hooks run outside every sandbox: they must name their programs by absolute path (a bare name is found on
    PATH, and ~/.local/bin comes first)."""
    root = os.path.join(PLUGIN, "hooks")
    bare = []
    for name in ("hooks.json", "codex-hooks.json"):
        data = load_json_file(os.path.join(root, name)) or {}
        for groups in (data.get("hooks") or {}).values():
            for g in groups:
                for h in g.get("hooks") or []:
                    cmd = (h.get("command") or "").strip()
                    first = cmd.split()[0] if cmd.split() else ""
                    if cmd and not first.startswith(("/", "[")):
                        bare.append("%s: %s" % (name, first))
    say("PASS" if not bare else "FAIL", "ai-core hook commands use absolute programs (/usr/bin/python3, /bin/sh)",
        ", ".join(sorted(set(bare))))
    mcp = load_json_file(os.path.join(AI_DIR, "marketplace", "plugins", "ai-box", ".mcp.json")) or {}
    box = (mcp.get("mcpServers") or {}).get("box") or {}
    ok = box.get("command") == "/usr/bin/python3" and int(box.get("timeout") or 0) >= 3600 * 1000
    say("PASS" if ok else "FAIL", "box MCP server: absolute python, tool timeout covers a 3600 s exec")


def check_hook_paths():
    """Owner QA 2026-11-15 (old Mac): every OMX Codex hook named a node script in an nvm version folder that an
    nvm update removed, so each hook failed. FAIL a user hook (Claude settings.json, Codex hooks.json) whose
    interpreter or script path (the first two words) is absolute and does not exist."""
    bad = []
    for label, path in (("~/.claude/settings.json", os.path.join(CLAUDE_DIR, "settings.json")),
                        ("~/.codex/hooks.json", os.path.join(CODEX_HOME, "hooks.json"))):
        data = load_json_file(path) or {}
        for groups in (data.get("hooks") or {}).values() if isinstance(data.get("hooks"), dict) else []:
            for g in groups or []:
                for h in (g.get("hooks") or []) if isinstance(g, dict) else []:
                    try:
                        words = shlex.split(h.get("command") or "")[:2]
                    except ValueError:
                        continue
                    gone = [w for w in words if w.startswith("/") and not os.path.exists(w)]
                    if gone:
                        bad.append("%s: %s" % (label, gone[0]))
    say("PASS" if not bad else "FAIL", "hook interpreter or script path missing" if bad else
        "hook interpreters and scripts exist (Claude settings.json, Codex hooks.json)",
        ("; ".join(sorted(set(bad))[:5]) + " (re-run install.sh: OMX hooks get the current node)") if bad else "")


def check_uv_links():
    """uv tools must not share inodes with a cache (UV_LINK_MODE=copy): nlink 1 for every installed file."""
    code, out = run(["uv", "tool", "dir"]) if shutil.which("uv") else (1, "")
    tools = out.strip().splitlines()[-1] if code == 0 and out.strip() else ""
    if not tools or not os.path.isdir(tools):
        return
    for tool in ("graphifyy", "serena-agent"):
        d = os.path.join(tools, tool)
        if not os.path.isdir(d):
            continue
        linked = 0
        for base, _dirs, files in os.walk(d):
            for f in files:
                try:
                    st = os.lstat(os.path.join(base, f))
                except OSError:
                    continue
                if st.st_nlink > 1 and not os.path.islink(os.path.join(base, f)):
                    linked += 1
        say("PASS" if not linked else "FAIL", "uv tool %s: files are copies, not hard links to a cache" % tool,
            "" if not linked else "%d linked files: re-run install.sh (reinstalls with UV_LINK_MODE=copy)" % linked)


def check_serena_config():
    """Serena 2.1.0 global config: tools interface, no dashboard, answers capped, no memories/onboarding."""
    if not shutil.which("serena"):
        return
    cfg = read_text_file(os.path.join(os.environ.get("SERENA_HOME") or os.path.join(HOME, ".serena"),
                                      "serena_config.yml")) or ""
    want = {"agent_interface": "tools", "web_dashboard": "false", "default_max_tool_answer_chars": "40000",
            "default_modes": "[no-memories]", "excluded_tools": "[execute_shell_command, serena_repl]"}
    miss = [k for k, v in want.items() if not re.search(r"^%s:\s*%s\s*$" % (k, re.escape(v)), cfg, re.M | re.I)]
    say("PASS" if not miss else "FAIL", "Serena config: tools interface, no shell tool, no dashboard, answers cut at 40k, "
        "no memories (no overlap with built-ins and the AGENTS.md Map)",
        ("not set: %s (re-run install.sh)" % ", ".join(miss)) if miss else "")


