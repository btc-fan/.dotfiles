def check_no_duplicate_layers():
    """Overlaps removed (docs/TOOLS.md section 8): graphify's global instruction section and hooks are not in
    the Claude or Codex user files; Serena's system-prompt override is not added."""
    hits = []
    for f in (os.path.join(HOME, ".claude", "CLAUDE.md"), os.path.join(HOME, ".codex", "AGENTS.md")):
        text = read_text_file(f) or ""
        if re.search(r"^## graphify\b", text, re.M):
            hits.append("%s: graphify section" % f)
        if "print-cc-system-prompt-override" in text or "Serena Instructions Manual" in text:
            hits.append("%s: Serena prompt override" % f)
    hooks = json.dumps((claude_settings().get("hooks") or {}))
    if re.search(r"graphify (hook-guard|hook-check)|serena-hooks remind", hooks):
        hits.append("~/.claude/settings.json: graphify or serena remind hook")
    say("PASS" if not hits else "WARN", "no duplicate instruction or hook layers (graphify, Serena)", "; ".join(hits))


def check_skill_dups():
