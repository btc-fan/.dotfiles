#!/usr/bin/env python3
"""ai-start / ai-adopt: write the project layer of the AI setup into a git repo.

  ai-start [--dir PATH] [--tools id,id] [--yes] [--dry-run]   new project: pick opt-in tools, commit
  ai-adopt [--dir PATH] [--tools id,id] [--yes] [--dry-run]   existing repo: same layer, show diff,
                                                              one y/N, commit, push (owner repos only)
  Extra flags: --no-knowledge (skip Map and Libraries), --refresh-map (write the Map section again),
               --no-onboard (no headless claude pass for the Map conventions),
               --no-measure (do not run check-fast once to time it),
               --skills a,b|none (mattpocock skills linked into this project; replaces the default list),
               --init (a folder without git: git init first; never in $HOME or /).
  On main or master the commit goes on a new branch ai-adopt for the owner to merge (also on an unborn main). On main
  with an ai-adopt branch that exists (local or on origin), `gh pr view ai-adopt` decides: PR merged, the old branch
  is deleted (local and remote) and a new one starts; PR open, the commit goes on that branch; else (no gh, no PR,
  no remote) exit 1 before any write. No remote: a warning, no push.
  No tiers (owner 2026-11-15): every project gets the full setup (`tier: long`). An old --tier flag is ignored.
ai-adopt is a link to this file; the mode comes from the command name. Rerun = upgrade (blocks are
replaced by marker, project text outside the blocks is never touched).

What it writes (project root):
  .ai/base-version   routing.yaml version (the base version vN; local, gitignored)
  .ai/enabled        `tier: long` (always), the `skills:` line, then opt-in tool ids and opt-outs (no-serena, no-graph,
                     no-stop-check), one per line (the router and the stop check read it; committed, always written)
  Makefile/justfile  `check-fast` (lint + unit, under 60 s) and `check` (everything) from ai-check-detect, in one
                     marked block; targets that exist are never changed; monorepos are refused (by hand). Run
                     once and timed (--no-measure skips it); the commands go into the Map ("- Check:" line).
  AGENTS.md          also "## Done" (6 lines, managed block; a file with its own Done section keeps it and gets
                     one managed AI:verify line at its end: verify first, then automate the tests) and
                     "## Lessons" (agents add lines; 15-line cap, ai-doctor counts)
  .claude/skills/<name>, .agents/skills/<name>   links to this machine's audited mattpocock opt-in copies for the
                     names on the `skills:` line (default: grill-with-docs, domain-modeling, to-spec, to-tickets,
                     tdd, pr, diagnosing-bugs, implement, research, handoff, wayfinder, prototype, plus their
                     callees codebase-design, code-review; a rerun adds new defaults). Local, gitignored.
  docs/agents/issue-tracker.md, docs/agents/domain.md   (with to-spec / to-tickets / grill-with-docs, when missing):
                     tickets stay in docs/tickets/<feature>/ in the repo; GLOSSARY.md and docs/adr/ at the root
  CODING_STANDARDS.md  (when missing; with code-review) judgement-call rules the reviewer enforces; retro adds to it
  always             docs/REGRESSIONS.md (the regression ledger, format inside) and .ai/ratchet.json (ai-ratchet
                     --init: test, skip and lint counts that may only improve)
  AGENTS.md          project knowledge every agent reads with no tool call (owner decision 2026-11-12):
                     "## Map" between <!-- AI:map START/END --> (entry points, where things live, how to
                     run and test, non-obvious conventions; <= 60 lines; written when missing or with
                     --refresh-map; edit freely inside the markers) and "## Libraries" between
                     <!-- AI:libraries START/END --> (ai-libs --sync: library, version, context7 ID).
                     Plus one short managed block per enabled opt-in tool:
                     <!-- AI:<id> v<N> START --> <routing action> <!-- AI:<id> v<N> END -->
  CLAUDE.md          a line "@AGENTS.md" (created when missing)
  .claude/settings.json   enabledPlugins for claude-seo / claude-blog / ui-ux-pro-max / oh-my-claudecode when
                     "seo" / "blog" / "ui" / "omc" is enabled (omc is off by default on servers, always on on
                     macOS; ui-ux-pro-max only takes effect where the plugin is installed)
  .claude/settings.json   also enabledPlugins "ai-serena@ai" ("serena") and "ai-playwright@ai" ("browser"): each
                     plugin holds only its MCP entry; managed settings block project .mcp.json servers
  .codex/config.toml Codex entries for Playwright ("browser": ai-playwright-mcp, the pinned @playwright/mcp
                     installed once per machine, no npx at runtime) (local, gitignored)
  .gitignore         one managed block between "# >>> AI tools" and "# <<< AI tools" markers, written on every
                     run (other lines are kept; an older unmarked ai-adopt block is replaced): .omc/* (but
                     .omc/skills/), .codex/, .claude/* (but settings.json, and commands/ or agents/ if the
                     repo already tracks them), .serena/* (but project.yml), graphify-out/, .ai/* (but enabled).
                     So after ai-adopt only AGENTS.md, CLAUDE.md, .gitignore, .claude/settings.json,
                     .ai/enabled and .serena/project.yml are new; files it ignores are not committed.
  Serena (default on, `no-serena` opts out): serena project create --index (.serena/project.yml committed)
  graphify (default on, `no-graph` opts out): GRAPHIFY_BACKEND=none graphify extract . --code-only and
                     graphify hook install (local, no key, gitignored)
Map conventions: with --yes (or after a y/N), one headless `claude -p` pass with read-only tools (Read,
Grep, Glob, rg, git ls-files) proposes the conventions lines; nothing else is written by it.
An old .ai/libs.md is removed (its IDs move into the Libraries section).
Owner repos: AI_GITHUB_OWNERS (env or ~/.config/ai/config.env, comma list), else the owner of the
origin remote of $AI_HOME. Third-party repos are refused.
"""
import json
import os
import re
import shutil
import subprocess
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
AI_DIR = os.path.dirname(BIN)
AI_HOME = os.path.dirname(AI_DIR)
sys.path.insert(0, os.path.join(AI_DIR, "lib"))
sys.dont_write_bytecode = True
import ai_profile  # noqa: E402
import ownertext  # noqa: E402


def ignore_global_excludes():
    """A personal global ignore (core.excludesFile, e.g. one that hides AGENTS.md, CLAUDE.md, .claude/ on the M3)
    must not drop our shared files from the adopt commit: every git call here reads only the repo's .gitignore.
    Appended after any GIT_CONFIG_* pairs that are already set."""
    n = int(os.environ.get("GIT_CONFIG_COUNT") or 0)
    os.environ["GIT_CONFIG_KEY_%d" % n] = "core.excludesFile"
    os.environ["GIT_CONFIG_VALUE_%d" % n] = os.devnull
    os.environ["GIT_CONFIG_COUNT"] = str(n + 1)


def main(argv):
    mode = "adopt" if os.path.basename(sys.argv[0]).startswith("ai-adopt") else "start"
    opts = parse(argv)
    ignore_global_excludes()
    root = git_root(opts["dir"])
    if root is None and opts["init"]:
        folder = os.path.realpath(opts["dir"])
        if folder in (os.path.realpath(os.path.expanduser("~")), os.path.realpath(os.sep)):
            print("ai-%s: refused: --init never runs git init in $HOME or /" % mode, file=sys.stderr)
            return wall(folder, "--init in $HOME or /")
        if subprocess.call(["git", "init", "-q", folder]) == 0:
            root = git_root(folder)
    if root is None:
        print("ai-%s: %s is not a git repo (git init first, or run again with --init)" % (mode, opts["dir"]),
              file=sys.stderr)
        return 1
    if not owner_repo(root):
        print("ai-%s: refused, the origin remote is not one of the owner's repos" % mode, file=sys.stderr)
        return wall(root, "origin is not an owner repo")
    # Never on main or master (owner 2026-11-16): the commit goes on a branch ai-adopt, the owner merges it.
    # An unborn main (no commit yet) counts too. Check before any write, so main stays clean.
    on_main = (git(root, "branch", "--show-current") or "") in ("main", "master")
    if on_main:
        if not old_adopt_branch(root, mode, opts["dry_run"]):
            return wall(root, "on main and the branch %s exists, its PR state is unknown" % ADOPT_BRANCH)
        on_main = (git(root, "branch", "--show-current") or "") in ("main", "master")   # an open PR: on its branch
    routing = load_routing()
    version = str(routing.get("version") or 1)
    link_worktree_venv(root, opts["dry_run"])
    optin = [r for r in routing.get("rules", []) if r.get("scope") == "opt-in"]
    current_all = read_lines(os.path.join(root, ".ai", "enabled"))
    current = [i for i in current_all if not TIER_RX.match(i) and not SKILLS_RX.match(i)]
    tier = TIER
    skills = choose_skills(current_all, opts)
    chosen = choose(optin, current, opts)
    # Every project has a UI (web, web view or mobile; owner 2026-11-16): ui-ux-pro-max is on unless no-ui.
    if "no-ui" not in current and "ui" not in current and "ui" not in chosen and any(r["id"] == "ui" for r in optin):
        chosen.append("ui")

    plan = []
    plan.append(write_plan(os.path.join(root, ".ai", "base-version"), version + "\n"))
    enabled = sorted(set(current) | set(chosen))
    new_enabled = enabled_text(enabled, tier, skills)
    # Same entries: keep the file. A rerun must not drop a comment (no-stop-check has one) or reorder the lines.
    if sorted(current_all) != sorted(entries(new_enabled)):
        plan.append(write_plan(os.path.join(root, ".ai", "enabled"),
                               enabled_update(read(os.path.join(root, ".ai", "enabled")), enabled, tier, skills)))
    agents_path = os.path.join(root, "AGENTS.md")
    agents = read(agents_path) or "# %s\n" % project_name(root)
    for rule in optin:
        if rule["id"] in chosen or rule["id"] in current:
            agents, note = upsert_block(agents, rule, version)
            if note:
                print(note)
    knowledge = opts["knowledge"]
    if knowledge and (opts["refresh_map"] or not MAP_RX.search(agents)):
        agents = upsert_map(agents, build_map(root))
    checks = check_plan(root, tier, probe=not opts["dry_run"])
    if checks and checks.get("text") is not None:
        plan.append((os.path.join(root, checks["file"]), checks["text"]))
    if checks:
        agents = upsert_check_line(agents, checks)
    agents = upsert_done(agents, tier, checks, root)
    agents = upsert_project_rules(agents)
    if "ui" in enabled:
        agents = upsert_design_line(agents, root)
    plan.append(write_plan(agents_path, agents))
    plan.append(write_plan(os.path.join(root, "docs", "REGRESSIONS.md"),
                           read(os.path.join(root, "docs", "REGRESSIONS.md")) or LEDGER_TEMPLATE))
    plan.append(write_plan(os.path.join(root, "CLAUDE.md"), claude_md(read(os.path.join(root, "CLAUDE.md")))))
    plan.extend(project_mcp_plan(root, enabled, opts["dry_run"]))
    plan.append(claude_plugins_plan(root, enabled, skill_closure(skills)))
    plan.append(write_plan(os.path.join(root, ".gitignore"), gitignore_text(read(os.path.join(root, ".gitignore")),
                                                                            with_defaults(enabled), root,
                                                                            skill_closure(skills))))
    plan.extend(tracker_docs_plan(root, skill_closure(skills)))
    if "code-review" in skill_closure(skills):
        standards = read(os.path.join(root, "CODING_STANDARDS.md"))
        new_standards = coding_standards_text(standards, "ui" in enabled)
        if new_standards != standards:
            plan.append((os.path.join(root, "CODING_STANDARDS.md"), new_standards))
    plan = [p for p in plan if p]
    # Add-only (owner 2026-11-17): an update that would change the owner's text writes nothing at all.
    refused = owner_text_refusals(root, plan)
    if refused:
        print("".join(refused).rstrip("\n"))
        print("ai-%s: owner text would change: nothing written" % mode)
        return wall(root, "owner text would change")
    # The docs baseline before the timing run: stray Markdown it accepts must not fail the first check-fast.
    steps = knowledge_steps(root, opts, with_defaults(enabled)) + docs_baseline_steps(root) \
        + check_steps(root, opts, tier, checks, plan) + ratchet_steps(root) \
        + skill_link_steps(root, skill_closure(skills)) \
        + verify_link_steps(root) + precommit_steps(root, checks)

    if not plan and not steps:
        print("ai-%s: nothing to change (base v%s)" % (mode, version))
        return 0
    for path, _text in plan:
        print("%s %s" % ("would write" if opts["dry_run"] else "write", os.path.relpath(path, root)))
    for name, _fn in steps:
        print("%s %s" % ("would run" if opts["dry_run"] else "run", name))
    if checks and checks.get("text") is not None and opts["dry_run"]:
        print("%s would get:\n%s" % (checks["file"], checks["block"]))
    if opts["dry_run"]:
        return 0
    for path, text in plan:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
    for name, fn in steps:
        try:
            fn()
        except (OSError, subprocess.SubprocessError) as exc:
            print("ai-%s: step failed, skipped (%s): %s" % (mode, name, exc))
    drop_libs_pointer(root)
    paths = [os.path.relpath(p, root) for p, _ in plan]
    paths += [rel for rel in CHECK_PATHS if os.path.exists(os.path.join(root, rel)) and rel not in paths]
    paths += [rel for rel in verify_links(root) if os.path.lexists(os.path.join(root, rel)) and rel not in paths]
    paths += [rel for rel in KNOWLEDGE_PATHS if (os.path.exists(os.path.join(root, rel)) or
                                                 git(root, "ls-files", "--", rel)) and rel not in paths]
    paths = committable(root, paths)      # .ai/base-version, .codex/, .serena/.gitignore: local, ignored by the block
    if not paths or not git(root, "status", "--porcelain", "--", *paths):
        print("ai-%s: nothing to commit (generated files are gitignored)" % mode)
        return 0
    new_files = (git(root, "ls-files", "-z", "--others", "--exclude-standard", "--", *paths) or "").split("\0")
    new_files = [f for f in new_files if f]
    subprocess.call(["git", "-C", root, "add", "-N"] + paths, stderr=subprocess.DEVNULL)
    subprocess.call(["git", "-C", root, "--no-pager", "diff", "--"] + paths)
    hits = knowledge_secret_hits(root)
    if hits:
        undo_intent_to_add(root, new_files)
        print("ai-%s: secret scan found %s in AGENTS.md. Remove it, then run again. "
              "Files written, not committed." % (mode, ", ".join(sorted(set(hits)))))
        return wall(root, "secret in AGENTS.md: " + ", ".join(sorted(set(hits))))
    # git var fails exactly where git commit would (no name or email it may use): check before, not after.
    if not (git(root, "var", "GIT_AUTHOR_IDENT") and git(root, "var", "GIT_COMMITTER_IDENT")):
        undo_intent_to_add(root, new_files)
        print("ai-%s: files written, not committed: git does not know who you are here. Set it once, then run "
              "again:\n  git config --global user.name \"Your Name\"\n  git config --global user.email you@example.com"
              % mode)
        return 1
    if not opts["yes"] and not ask("Commit this%s? [y/N] " % (" and push" if mode == "adopt" else "")):
        undo_intent_to_add(root, new_files)
        print("ai-%s: files written, not committed" % mode)
        return 0
    msg = ("chore(ai): adopt base AI setup v%s" if mode == "adopt" else "chore(ai): start project AI setup v%s") % version
    try:
        if on_main:
            subprocess.check_call(["git", "-C", root, "switch", "-q", "-c", ADOPT_BRANCH])
        subprocess.check_call(["git", "-C", root, "add", "-A", "--"] + paths)
        subprocess.check_call(["git", "-C", root, "commit", "-m", msg, "--"] + paths)
    except subprocess.CalledProcessError as exc:
        print("ai-%s: files written, git %s failed (exit %d): see the git message above"
              % (mode, exc.cmd[3] if len(exc.cmd) > 3 else "", exc.returncode))
        return 1
    if on_main:
        print("ai-%s: committed on the branch %s, not on main: merge the %s branch (owner)"
              % (mode, ADOPT_BRANCH, ADOPT_BRANCH))
    if not has_remote(root):
        print("ai-%s: no remote: push and PR are not possible yet" % mode)
        return 0
    if mode == "adopt":
        # A new branch (the owner's flow: adopt on a branch, then a PR) has no upstream yet, or tracks the branch it
        # was made from (git switch -c x origin/main): push it under its own name and set that as the upstream.
        upstream = git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}") or ""
        branch = git(root, "branch", "--show-current") or ""
        own = branch and upstream.split("/", 1)[-1] == branch
        return subprocess.call(["git", "-C", root, "push"] + ([] if own else ["-u", "origin", "HEAD"]))
    return 0


ADOPT_BRANCH = "ai-adopt"


def wall(root, reason):
    """An ai-adopt refusal is a wall fire: one line in walls.jsonl (ticket 17; ai-doctor shows 7 days). Exit 1."""
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    try:
        from hooklib import log_wall
        log_wall("ai-adopt", reason, root)
    except ImportError:
        pass
    return 1
ENABLED_GENERATED = ownertext.GENERATED[".ai/enabled"]


def old_adopt_branch(root, mode, dry_run):
    """On main with an ai-adopt branch left from an earlier run (local or on origin; ticket 16, ScripTube: the
    remote branch of merged PR #22). Its PR merged and every tip of the branch is the PR head (headRefOid): delete
    the branch (local and remote), start fresh. Its PR open: switch to it, the commit goes there. Else (no gh, no PR,
    closed, or a tip with commits the merged PR does not have): stop before any write. False = stop."""
    local = git(root, "rev-parse", "-q", "--verify", "refs/heads/" + ADOPT_BRANCH)
    remote = has_remote(root) and git(root, "ls-remote", "--heads", "origin", ADOPT_BRANCH)
    if not (local or remote):
        return True
    try:
        pr = has_remote(root) and json.loads(cmd_out(["gh", "pr", "view", ADOPT_BRANCH, "--json", "state,headRefOid"],
                                                     cwd=root) or "{}") or {}
    except ValueError:
        pr = {}
    state = str(pr.get("state") or "")
    tips = ([local.strip()] if local else []) + ([remote.split()[0]] if remote else [])
    if state == "MERGED" and any(t != pr.get("headRefOid") for t in tips):     # review S5: never delete new commits
        state = "MERGED, but a branch tip is not the PR head %s" % str(pr.get("headRefOid") or "?")[:12]
    if state == "MERGED":
        print("ai-%s: the PR of the branch %s is merged: the old branch is deleted, a new one starts from main"
              % (mode, ADOPT_BRANCH))
        steps = ([["branch", "-q", "-D", ADOPT_BRANCH]] if local else []) + \
            ([["push", "-q", "origin", "--delete", ADOPT_BRANCH]] if remote else [])
    elif state == "OPEN":
        print("ai-%s: the PR of the branch %s is open: the commit goes on that branch" % (mode, ADOPT_BRANCH))
        track = "origin/" + ADOPT_BRANCH
        fetch = ["fetch", "-q", "origin", "+refs/heads/%s:refs/remotes/%s" % (ADOPT_BRANCH, track)]
        switch = ["switch", "-q", ADOPT_BRANCH] if local else ["switch", "-q", "-c", ADOPT_BRANCH, "--track", track]
        steps = ([fetch] if remote else []) + [switch] + \
            ([["merge", "-q", "--ff-only", track]] if local and remote else [])
    else:
        print("ai-%s: nothing written: you are on main and the branch %s exists (%s), but the state of its PR is "
              "unknown (`gh pr view %s --json state,headRefOid`: %s). If the PR is merged, delete the branch:\n"
              "  git branch -D %s; git push origin --delete %s\n"
              "If the PR is open, switch to it (git switch %s). Then run again."
              % (mode, ADOPT_BRANCH, " and ".join(w for w, ok in (("local", local), ("on origin", remote)) if ok),
                 ADOPT_BRANCH, state or "no answer", ADOPT_BRANCH, ADOPT_BRANCH, ADOPT_BRANCH))
        return False
    for step in steps:
        if dry_run:
            print("would run git %s" % " ".join(step))
        elif subprocess.call(["git", "-C", root] + step) != 0:
            print("ai-%s: nothing written: git %s failed (see the git message above)" % (mode, " ".join(step)))
            return False
    return True


def owner_text_refusals(root, plan):
    """A unified diff per planned file whose owner text would change. The base version stamp is all ours; JSON
    files are merged key by key (no key is removed)."""
    out = []
    for path, text in plan:
        old = read(path)
        rel = os.path.relpath(path, root)
        if old is None or rel.endswith(".json") or rel == os.path.join(".ai", "base-version"):
            continue
        if rel == ".gitignore":
            old = drop_old_block(old)      # the unmarked block of an older ai-adopt run is ours, not the owner's
        out.append(ownertext.lost(old, text, ENABLED_GENERATED if rel == os.path.join(".ai", "enabled") else (), rel))
    return [d for d in out if d]


def merged(old_block, new_block):
    """new_block (marker lines first and last) with the owner's lines inside old_block kept (ownertext.merge)."""
    old, new = old_block.rstrip("\n").split("\n"), new_block.rstrip("\n").split("\n")
    return "\n".join([new[0]] + ownertext.merge(old[1:-1], new[1:-1]) + [new[-1]]) + "\n"


def undo_intent_to_add(root, files):
    """Not committed: drop the `git add -N` entries (shown only for the diff), so git status shows ?? again."""
    if files:
        subprocess.call(["git", "-C", root, "rm", "-q", "--cached", "--ignore-unmatch", "--"] + files,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def parse(argv):
    opts = {"dir": ".", "tools": None, "yes": False, "dry_run": False, "knowledge": True, "onboard": True,
            "refresh_map": False, "measure": True, "skills": None, "init": False}
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--dir" and args:
            opts["dir"] = args.pop(0)
        elif a == "--tools" and args:
            opts["tools"] = [t.strip() for t in args.pop(0).split(",") if t.strip()]
        elif a == "--yes":
            opts["yes"] = True
        elif a == "--dry-run":
            opts["dry_run"] = True
        elif a == "--no-knowledge":
            opts["knowledge"] = False
        elif a == "--no-onboard":
            opts["onboard"] = False
        elif a == "--refresh-map":
            opts["refresh_map"] = True
        elif a == "--tier" and args:
            args.pop(0)
            print("note: --tier is ignored: there are no tiers, every project gets the full setup (tier: long)")
        elif a == "--no-measure":
            opts["measure"] = False
        elif a == "--init":
            opts["init"] = True
        elif a == "--skills" and args:
            opts["skills"] = [t.strip() for t in args.pop(0).split(",") if t.strip()]
        elif a in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            sys.exit("unknown argument: " + a)
    return opts


def choose(optin, current, opts):
    ids = [r["id"] for r in optin]
    if opts["tools"] is not None:
        bad = [t for t in opts["tools"] if t not in ids]
        if bad:
            sys.exit("unknown opt-in tool(s): %s (known: %s)" % (", ".join(bad), ", ".join(ids)))
        return opts["tools"]
    if opts["yes"] or not sys.stdin.isatty():
        return []
    print("Opt-in tools for this project (routing.yaml). Already enabled: %s" % (", ".join(current) or "none"))
    picked = []
    for r in optin:
        if r["id"] in current:
            continue
        if ask("  %s (%s): %s  Enable? [y/N] " % (r["id"], r.get("tool", ""), r["action"])):
            picked.append(r["id"])
    return picked


# ---------------------------------------------------------------- file builders

def write_plan(path, text):
    if not text:
        return None
    return None if read(path) == text else (path, text)


def upsert_block(agents, rule, version):
    rid = rule["id"]
    rx = re.compile(r"<!-- AI:%s v\d+ START -->.*?<!-- AI:%s v\d+ END -->\n?" % (re.escape(rid), re.escape(rid)), re.S)
    outside = rx.sub("", agents)
    tool = str(rule.get("tool", ""))
    if tool and tool.split()[0].lower() in outside.lower():
        return agents, "skip %s: AGENTS.md already has its own text for %s" % (rid, tool)
    block = "<!-- AI:%s v%s START -->\n%s\n<!-- AI:%s v%s END -->\n" % (rid, version, vendor_text(rule), rid, version)
    if rx.search(agents):
        return rx.sub(lambda m: merged(m.group(0), block), agents, count=1), None
    return agents.rstrip("\n") + "\n\n" + block, None


def vendor_text(rule):
    """Short on purpose (context files cost tokens every session): the routing action plus a pointer."""
    action = re.sub(r"\s*\{[a-z_]+\}", "", rule["action"]).strip()
    for name in candidates(rule):
        if os.path.isfile(os.path.join(AI_DIR, "rules", name + ".md")):
            return "%s Details: ~/.config/ai/rules/%s.md" % (action, name)
    return action


def candidates(rule):
    tool = str(rule.get("tool", "")).lower()
    slug = re.sub(r"[^a-z0-9]+", "-", tool).strip("-")
    first = slug.split("-mcp")[0]
    return [n for n in (rule["id"], slug, first, tool.split()[0] if tool else "") if n]


def claude_md(text):
    if text is None:
        return "@AGENTS.md\n"
    if re.search(r"^@AGENTS\.md\s*$", text, re.M):
        return None
    return text.rstrip("\n") + "\n\n@AGENTS.md\n"


# Opt-in Claude plugins (owner 2026-11-12): installed per machine, disabled at user scope, enabled per project.
# Serena too: plugin ai-serena@ai holds only its MCP entry, because managed strictPluginOnlyCustomization
# blocks project .mcp.json files (planted-config defence) while plugin servers still load.
CLAUDE_PLUGINS = {"seo": "claude-seo@agricidaniel-claude-seo", "blog": "claude-blog@agricidaniel-blog",
                  "ui": "ui-ux-pro-max@ui-ux-pro-max-skill",       # off at user scope (owner 2026-11-14)
                  "serena": "ai-serena@ai", "browser": "ai-playwright@ai",
                  "omc": "oh-my-claudecode@omc"}      # server: off at user scope (owner 2026-11-12); Mac: always on


def claude_plugins_plan(root, enabled, skill_links=()):
    """Project .claude/settings.json: enabledPlugins true for each enabled opt-in plugin, and skillOverrides off
    for a vendor plugin's copy of a skill this project links (OMC tdd next to mattpocock tdd; owner QA
    2026-11-15: one copy per session). Merge, keep other keys."""
    want = [CLAUDE_PLUGINS[r] for r in enabled if r in CLAUDE_PLUGINS]
    offs = plugin_skill_offs(skill_links)
    if not want and not offs:
        return None
    path = os.path.join(root, ".claude", "settings.json")
    try:
        data = json.loads(read(path) or "{}")
    except ValueError:
        print("skip .claude/settings.json: not valid JSON (enable %s by hand)" % ", ".join(want + offs))
        return None
    plugins = data.get("enabledPlugins") or {}
    overrides = data.get("skillOverrides") or {}
    if all(plugins.get(w) is True for w in want) and all(overrides.get(k) == "off" for k in offs):
        return None
    for w in want:
        data.setdefault("enabledPlugins", {})[w] = True
    for k in offs:
        data.setdefault("skillOverrides", {})[k] = "off"
    return (path, json.dumps(data, indent=2) + "\n")


def plugin_skill_offs(names):
    """skillOverrides keys ("<plugin>:<name>") of enabled user plugins (not ours) that ship one of these names."""
    if not names:
        return []
    sys.path.insert(0, os.path.join(AI_DIR, "lib"))
    import aiconf
    claude_dir = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    sources = aiconf.claude_skill_sources(claude_dir)
    return sorted(key for n in names for src, key in sources.get(n, [])
                  if src != "~/.claude/skills" and not src.endswith(aiconf.OWN_PLUGINS))


def project_mcp_plan(root, enabled, dry_run=False):
    """Per-project MCP servers in .mcp.json (Claude) and .codex/config.toml (Codex, loaded in trusted projects
    only), merged in one write each.
    Claude gets both servers from plugins (ai-playwright@ai, ai-serena@ai via claude_plugins_plan), because
    managed settings block project .mcp.json servers. So only Codex gets entries here.
    browser: `ai-playwright-mcp` runs the pinned @playwright/mcp installed once per machine (no npx)."""
    want = {}
    if "browser" in enabled and ensure_playwright(dry_run):
        want["playwright"] = (None, ("ai-playwright-mcp", ["--headless", "--isolated"], {}))
    if not want:
        return []
    out = []
    mcp_path = os.path.join(root, ".mcp.json")
    try:
        mcp = json.loads(read(mcp_path) or "{}")
    except ValueError:
        print("skip .mcp.json: not valid JSON")
        mcp = None
    if mcp is not None:
        servers = mcp.setdefault("mcpServers", {})
        added = [n for n in want if n not in servers and want[n][0] is not None]
        for n in added:
            servers[n] = want[n][0]
        if added:
            out.append((mcp_path, json.dumps(mcp, indent=2) + "\n"))
    toml_path = os.path.join(root, ".codex", "config.toml")
    toml = read(toml_path) or ""
    blocks = []
    for n, (_c, (cmd, args, env)) in want.items():
        if "[mcp_servers.%s]" % n in toml:
            continue
        block = '[mcp_servers.%s]\ncommand = "%s"\nargs = [%s]\n' % (n, cmd, ", ".join('"%s"' % a for a in args))
        if env:
            block += "env = { %s }\n" % ", ".join('%s = "%s"' % kv for kv in env.items())
        blocks.append(block)
    if blocks:
        out.append((toml_path, (toml.rstrip("\n") + "\n\n" if toml.strip() else "") + "\n".join(blocks)))
    return out


# ---------------------------------------------------------------- knowledge layer

# On by default in every code project (owner decision 2026-11-12, evening): Serena (symbols) and graphify
# (structure). A project opts out with a line `no-serena` or `no-graph` in .ai/enabled.
DEFAULT_ON = ("serena", "graph")


def with_defaults(enabled):
    ids = set(enabled)
    return ids | {d for d in DEFAULT_ON if "no-" + d not in ids}


KNOWLEDGE_PATHS = [".serena/project.yml", ".serena/.gitignore", ".ai/libs.md"]
GITIGNORE = {"serena": [".serena/cache/", ".serena/project.local.yml"], "graph": ["graphify-out/"]}
MAP_RX = re.compile(r"^<!-- AI:map START[^>]*-->\s*\n.*?^<!-- AI:map END -->\s*\n?", re.M | re.S)
MAP_START = "<!-- AI:map START (ai-adopt; edit freely inside, keep it under 60 lines) -->"
MAP_END = "<!-- AI:map END -->"
MAP_MAX_LINES = 60
SKIP_DIRS = {".git", "node_modules", "vendor", "dist", "build", "target", "graphify-out", ".venv", "venv",
             "__pycache__", ".serena", ".omc", ".ai", ".claude", ".codex", "coverage", ".next", ".cache"}
LANG = {".py": "Python", ".ts": "TypeScript", ".tsx": "TypeScript", ".js": "JavaScript", ".jsx": "JavaScript",
        ".go": "Go", ".rs": "Rust", ".rb": "Ruby", ".java": "Java", ".kt": "Kotlin", ".php": "PHP", ".cs": "C#",
        ".swift": "Swift", ".sh": "Shell", ".sql": "SQL", ".vue": "Vue", ".svelte": "Svelte", ".c": "C",
        ".cpp": "C++", ".ex": "Elixir", ".dart": "Dart", ".lua": "Lua"}
MAP_PROMPT = (
    "You see a repository. Reply with 3 to 10 Markdown bullet lines, nothing else: the non-obvious conventions "
    "an agent must know before it edits code here (naming, layering, where new code goes, test layout, generated "
    "files not to edit, commands that must run before a commit). Only facts you saw in the files. No secrets, "
    "hostnames, emails or personal data. No intro, no outro. Current map:\n\n")
MAP_TOOLS = ["Read", "Grep", "Glob", "Bash(git ls-files:*)", "Bash(rg:*)"]


# One managed .gitignore block for every folder our tools create (owner request 2026-11-12). Shared on purpose:
# .claude/settings.json (project plugin opt-ins), .serena/project.yml (Serena language config), .ai/enabled
# (opt-ins and opt-outs), .omc/skills/ (OMC's own rule). Everything else in those folders is local state.
GI_START = "# >>> AI tools (managed by ai-adopt; edit outside this block) >>>"
GI_END = "# <<< AI tools <<<"
GI_RX = re.compile(r"^%s\n.*?^%s\n?" % (re.escape(GI_START), re.escape(GI_END)), re.M | re.S)
GI_LINES = [".omc/*", "!.omc/skills/", ".omx/", ".codex/", ".claude/*", "!.claude/settings.json", ".serena/*",
            "!.serena/project.yml", "graphify-out/", ".ai/*", "!.ai/enabled", "!.ai/ratchet.json",
            "!.ai/destructive.txt", "!.ai/docs-allow"]
GI_OLD_HEAD = "# AI tools (ai-adopt): caches and generated graph"     # unmarked block of older ai-adopt runs
GI_OLD_LINES = {".serena/cache/", ".serena/project.local.yml", ".serena/logs/", "graphify-out/"}
ENABLED_HEAD = ("# ai-adopt: the project tier (always long), the mattpocock skills linked here (skills: a, b | "
                "none), then opt-in tool ids, one per line; no-serena / no-graph / no-ui / no-stop-check switch a default off")


def gitignore_text(text, enabled=None, root=None, skill_links=()):
    """The .gitignore with the managed block (added or replaced by marker). None when nothing changes.
    A .claude/ subfolder (commands, agents, rules, skills ...) stays ignored unless the repo already tracks
    files there: then new files in it are shared too."""
    lines = list(GI_LINES)
    tracked = (git(root, "ls-files", "--", ".claude") if root else None) or ""
    subs = sorted({p.split("/")[1] for p in tracked.splitlines() if p.count("/") >= 2
                   and not p.startswith(".claude/skills/verify-")})     # our verify link does not open skills/
    at = lines.index("!.claude/settings.json") + 1
    # A project verify skill is shared through a committed link .claude/skills/verify-<app> (to .agents/skills/);
    # other .claude/skills entries stay local unless the repo already tracks that folder.
    shared = ["!.claude/%s/" % sub for sub in subs]
    if "skills" not in subs:
        shared += ["!.claude/skills/", ".claude/skills/*", "!.claude/skills/verify-*"]
    lines[at:at] = shared
    # Project links to this machine's audited mattpocock copies: local, never committed (absolute paths).
    lines += [".claude/skills/%s" % n for n in skill_links] + [".agents/skills/%s" % n for n in skill_links]
    block = "\n".join([GI_START] + lines + [GI_END]) + "\n"
    text = text or ""
    if GI_RX.search(text):
        new = GI_RX.sub(lambda m: merged(m.group(0), block), text, count=1)
    else:
        new = drop_old_block(text).rstrip("\n")
        new = (new + "\n\n" if new else "") + block
    return None if new == text else new


def drop_old_block(text):
    out, skipping = [], False
    for ln in text.split("\n"):
        if ln.strip() == GI_OLD_HEAD:
            skipping = True
            continue
        if skipping and ln.strip() in GI_OLD_LINES:
            continue
        skipping = False
        out.append(ln)
    return "\n".join(out)


def enabled_text(ids, tier="long", skills=()):
    return (ENABLED_HEAD + "\n" + "tier: %s\n" % tier + "skills: %s\n" % (", ".join(skills) or "none")
            + "".join(i + "\n" for i in ids))


def enabled_update(old, ids, tier, skills):
    """Add-only: the owner's lines and comments stay in their order; the generator lines are set again on top and
    missing ids are added at the end."""
    keep = [ln for ln in (old or "").splitlines() if not any(re.match(g, ln) for g in ENABLED_GENERATED)]
    have = set(entries("\n".join(keep)))
    return enabled_text([], tier, skills) + "".join(ln + "\n" for ln in keep) \
        + "".join(i + "\n" for i in ids if i not in have)


def committable(root, paths):
    """Paths git will take: tracked ones, and untracked ones the .gitignore does not ignore."""
    out = []
    for rel in paths:
        tracked = git(root, "ls-files", "--", rel)
        ignored = subprocess.call(["git", "-C", root, "check-ignore", "-q", "--", rel],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
        if tracked or not ignored:
            out.append(rel)
    return out


def upsert_map(agents, body):
    block = "%s\n## Map\n%s\n%s\n" % (MAP_START, body.rstrip("\n"), MAP_END)
    if MAP_RX.search(agents):
        return MAP_RX.sub(lambda m: merged(m.group(0), block), agents, count=1)
    lines = agents.rstrip("\n").split("\n")
    # right after the title line, so the map is the first thing an agent reads
    if lines and lines[0].startswith("# "):
        return "\n".join([lines[0], "", block.rstrip("\n")] + ([""] + lines[1:] if lines[1:] else [])).rstrip("\n") + "\n"
    return block + "\n" + agents


LIBS_POINTER = "- Library versions and docs IDs: the Libraries section below.\n"


def drop_libs_pointer(root):
    """The Map points to the Libraries section; without one (no dependencies found), the line goes."""
    path = os.path.join(root, "AGENTS.md")
    text = read(path) or ""
    if LIBS_POINTER in text and "\n## Libraries" not in text:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text.replace(LIBS_POINTER, "", 1))


def build_map(root):
    """A Map from repo facts only (no LLM): languages, entry points, where things live, run and test."""
    counts, dirs = {}, {}
    seen = 0
    for dirpath, dirnames, files in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith("."))
        rel = os.path.relpath(dirpath, root)
        top = rel.split(os.sep)[0] if rel != "." else "."
        for f in files:
            seen += 1
            ext = os.path.splitext(f)[1].lower()
            if ext in LANG:
                counts[LANG[ext]] = counts.get(LANG[ext], 0) + 1
                dirs[top] = dirs.get(top, 0) + 1
        if seen > 20000:
            break
    langs = ", ".join(l for l, _n in sorted(counts.items(), key=lambda kv: -kv[1])[:3]) or "no code yet"
    lines = ["- What: %s (%s)." % (project_name(root), langs)]
    entries = entry_points(root)
    if entries:
        lines.append("- Entry points: " + "; ".join(entries[:6]) + ".")
    where = ["`%s/` (%d code files)" % (d, n) for d, n in sorted(dirs.items(), key=lambda kv: -kv[1]) if d != "."][:10]
    if dirs.get("."):
        where.append("repo root (%d code files)" % dirs["."])
    if where:
        lines.append("- Where things live: " + ", ".join(where) + ".")
    run, test = commands(root)
    if run:
        lines.append("- Run: " + "; ".join(run[:5]) + ".")
    if test:
        lines.append("- Test: " + "; ".join(test[:3]) + ".")
    lines.append("- Library versions and docs IDs: the Libraries section below.")
    return "\n".join(lines[:MAP_MAX_LINES]) + "\n"


def entry_points(root):
    out = []
    data = load_toml(os.path.join(root, "pyproject.toml")) or {}
    for name, target in ((data.get("project") or {}).get("scripts") or {}).items():
        out.append("`%s` -> `%s`" % (name, target))
    pkg = load_json(os.path.join(root, "package.json")) or {}
    if isinstance(pkg.get("bin"), dict):
        out += ["`%s` -> `%s`" % kv for kv in pkg["bin"].items()]
    if pkg.get("main"):
        out.append("`%s` (package main)" % pkg["main"])
    for rel in ("main.go", "src/main.rs", "manage.py", "app.py", "main.py", "src/main.py", "src/index.ts",
                "src/index.js", "index.js", "server.js"):
        if os.path.isfile(os.path.join(root, rel)):
            out.append("`%s`" % rel)
    cmd_dir = os.path.join(root, "cmd")
    if os.path.isdir(cmd_dir):
        out += ["`cmd/%s/`" % d for d in sorted(os.listdir(cmd_dir)) if os.path.isfile(os.path.join(cmd_dir, d, "main.go"))]
    for rel in ("Dockerfile", "docker-compose.yml", "compose.yaml", "compose.yml"):
        if os.path.isfile(os.path.join(root, rel)):
            out.append("`%s`" % rel)
    return out


def commands(root):
    run, test = [], []
    pkg = load_json(os.path.join(root, "package.json")) or {}
    pm = "pnpm" if os.path.isfile(os.path.join(root, "pnpm-lock.yaml")) else \
        "yarn" if os.path.isfile(os.path.join(root, "yarn.lock")) else "npm run"
    for name in (pkg.get("scripts") or {}):
        cmd = "`%s %s`" % (pm, name)
        if name.startswith("test"):
            test.append(cmd)
        elif name in ("dev", "start", "build", "lint", "serve", "typecheck"):
            run.append(cmd)
    py = os.path.isfile(os.path.join(root, "pyproject.toml"))
    uv = os.path.isfile(os.path.join(root, "uv.lock"))
    if py and (os.path.isdir(os.path.join(root, "tests")) or "pytest" in (read(os.path.join(root, "pyproject.toml")) or "")):
        test.append("`uv run pytest`" if uv else "`pytest`")
    if py and uv:
        run.append("`uv sync`")
    if os.path.isfile(os.path.join(root, "go.mod")):
        test.append("`go test ./...`")
    if os.path.isfile(os.path.join(root, "Cargo.toml")):
        run.append("`cargo build`")
        test.append("`cargo test`")
    for mk in ("Makefile", "justfile", "Justfile"):
        text = read(os.path.join(root, mk)) or ""
        rx = r"^([A-Za-z][\w-]*):(?!=)" if mk == "Makefile" else r"^([A-Za-z][\w-]*)[^\n:=]*:(?!=)"
        targets = [t for t in re.findall(rx, text, re.M) if t not in (".PHONY",)][:8]
        tool = "make" if mk == "Makefile" else "just"
        for t in targets:
            (test if t.startswith("test") else run).append("`%s %s`" % (tool, t))
    return run, test


def knowledge_steps(root, opts, enabled):
    """Steps that change nothing when their result is already there. Each is (label, callable)."""
    steps = []
    code = repo_has_code(root)
    m = MAP_RX.search(read(os.path.join(root, "AGENTS.md")) or "")
    # Add-only: conventions that are there (the owner may have edited them) are kept; the pass only adds them.
    map_new = (opts["refresh_map"] or not m) and not (m and "\n- Conventions:" in m.group(0))
    if opts["knowledge"] and opts["onboard"] and code and map_new:
        if not which("claude"):
            print("skip Map conventions: claude is not on PATH (add them by hand inside the Map markers)")
        elif opts["dry_run"] or opts["yes"] or (sys.stdin.isatty() and ask(
                "Ask a headless claude (read-only tools) for the Map conventions lines? [y/N] ")):
            steps.append(("Map conventions (claude -p, read-only tools)", lambda: map_conventions(root)))
    serena_dir = os.path.join(root, ".serena")
    if "serena" in enabled and code:
        if not which("serena"):
            print("skip Serena: serena is not on PATH (install.sh installs it)")
        elif not os.path.isfile(os.path.join(serena_dir, "project.yml")):
            steps.append(("serena project create --index",
                          lambda: run_step(["serena", "project", "create", "--index", root], root, 1800,
                                           # Serena asks y/N per extra language server it detects (it aborts
                                           # on end of input): No to all, the main language is always on.
                                           answers="n\n" * 50)))
    if "graph" in enabled and code:
        if not which("graphify"):
            print("skip graph: graphify is not on PATH")
        else:
            if not os.path.isfile(os.path.join(root, "graphify-out", "graph.json")):
                steps.append(("GRAPHIFY_BACKEND=none graphify extract . --code-only",
                              lambda: run_step(["graphify", "extract", ".", "--code-only"], root, 1800,
                                               env={"GRAPHIFY_BACKEND": "none"})))
            # Freshness: graphify's own git hooks (post-commit, post-checkout, post-merge, post-rewrite) rebuild
            # the code graph in the background, keyless (GRAPHIFY_BACKEND=none comes from the env switches).
            # On a server the git guard turns hooks off for agent git calls (agent mode): for those the router
            # starts `graphify update <repo>` in the background after a successful commit, merge, pull, checkout.
            status = run_capture(["graphify", "hook", "status"], root) or ""
            if "post-commit: installed" not in status or "out of date" in status:
                steps.append(("graphify hook install (graph rebuilds after commit, checkout, merge, rebase)",
                              lambda: run_step(["graphify", "hook", "install"], root, 120)))
            # `graphify hook install` also registers a merge driver for graphify-out/graph.json: a program in
            # .git/config (merge.graphify.driver) plus a .gitattributes line. graph.json is gitignored, so it never
            # merges; and the server's git guard refuses unknown config keys for agents (agent mode), which would
            # stop every agent git call in this repo. So the driver goes again, right after the install.
            if "post-commit: installed" not in status or "out of date" in status \
                    or git(root, "config", "--get", "merge.graphify.driver") \
                    or "merge=graphify" in (read(os.path.join(root, ".gitattributes")) or ""):
                steps.append(("graphify merge driver off (graph.json is not tracked; the git guard refuses it)",
                              lambda: drop_graphify_merge_driver(root)))
    if opts["knowledge"] and libs_stale(root):
        steps.append(("ai-libs --sync", lambda: run_step([sys.executable, os.path.join(BIN, "ai-libs"), "--sync",
                                                          "--dir", root], root, 600)))
    if os.path.isfile(os.path.join(root, ".ai", "libs.md")):
        steps.append(("remove the old .ai/libs.md (IDs move into the Libraries section)",
                      lambda: os.remove(os.path.join(root, ".ai", "libs.md"))))
    return steps


def drop_graphify_merge_driver(root):
    subprocess.run(["git", "-C", root, "config", "--remove-section", "merge.graphify"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    path = os.path.join(root, ".gitattributes")
    text = read(path)
    if text is None:
        return
    keep = [ln for ln in text.splitlines()
            if not (ln.split() and ln.split()[0].endswith("graph.json") and "merge=graphify" in ln.split()[1:])]
    tracked = bool(git(root, "ls-files", "--", ".gitattributes"))
    if not any(ln.strip() for ln in keep) and not tracked:
        os.remove(path)
    elif len(keep) != len(text.splitlines()):
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(keep) + ("\n" if keep else ""))


def run_capture(cmd, cwd):
    try:
        res = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return res.stdout.decode("utf-8", "replace")


def map_conventions(root):
    """One headless claude pass with read-only tools. Its stdout becomes the Conventions lines of the Map."""
    path = os.path.join(root, "AGENTS.md")
    text = read(path) or ""
    m = MAP_RX.search(text)
    if not m:
        return
    current = m.group(0)
    cmd = ["claude", "-p", MAP_PROMPT + current, "--output-format", "text", "--allowedTools"] + MAP_TOOLS
    print("$ claude -p <map conventions prompt> --allowedTools " + " ".join(MAP_TOOLS))
    res = subprocess.run(cmd, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=900)
    bullets = [ln.rstrip() for ln in res.stdout.decode("utf-8", "replace").splitlines() if ln.strip().startswith("- ")]
    if res.returncode != 0 or not bullets:
        print("Map conventions: no usable answer (exit %s): add them by hand inside the Map markers" % res.returncode)
        return
    body = current.split("\n## Map\n", 1)[1].rsplit(MAP_END, 1)[0].rstrip("\n").split("\n")
    body = [ln for ln in body if not ln.startswith("- Conventions:") and not ln.startswith("  - ")]
    room = MAP_MAX_LINES - len(body) - 1
    body += ["- Conventions:"] + ["  " + b for b in bullets[:max(room, 0)]]
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(upsert_map(text, "\n".join(body)))
    print("Map conventions: %d lines added. Read them in the diff before the commit." % min(len(bullets), room))


def knowledge_secret_hits(root):
    """The secret-scan gate patterns over the managed AGENTS.md blocks (they are committed and pushed)."""
    text = read(os.path.join(root, "AGENTS.md")) or ""
    blocks = [m.group(0) for m in MAP_RX.finditer(text)]
    blocks += re.findall(r"<!-- AI:libraries START.*?<!-- AI:libraries END -->", text, re.S)
    added = "\n".join("+" + ln for b in blocks for ln in b.splitlines())
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    try:
        from hooklib import allowed_secrets, builtin_scan
    except ImportError:
        return []
    return builtin_scan(added, allowed_secrets())


def libs_stale(root):
    res = subprocess.run([sys.executable, os.path.join(BIN, "ai-libs"), "--check", "--dir", root],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return res.returncode != 0


def repo_has_code(root):
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    try:
        from router import has_code_files
    except ImportError:
        return True
    return has_code_files(root)


def run_step(argv, cwd, timeout, env=None, answers=None):
    """answers: text fed to the step's stdin (None: inherit the terminal)."""
    full = dict(os.environ)
    full.update(env or {})
    print("$ " + " ".join(a if len(a) < 80 else a[:77] + "..." for a in argv))
    if answers is None:
        return subprocess.call(argv, cwd=cwd, env=full, timeout=timeout)
    return subprocess.run(argv, cwd=cwd, env=full, timeout=timeout, input=answers.encode()).returncode


def which(name):
    from shutil import which as _which
    return _which(name)


def load_toml(path):
    text = read(path)
    if not text:
        return None
    try:
        try:
            import tomllib
        except ImportError:      # python 3.9: our small reader
            sys.dont_write_bytecode = True
            sys.path.insert(0, os.path.join(AI_DIR, "lib"))
            import minitoml as tomllib
        return tomllib.loads(text)
    except ValueError:
        return None


def load_json(path):
    try:
        return json.loads(read(path) or "null")
    except ValueError:
        return None


# ---------------------------------------------------------------- tier, check targets, Done (Tier 1)

# No tiers (owner 2026-11-15): every project is `long` (full Done, regression ledger, ratchet). TIER_RX only
# drops the old line of an earlier run; the router reads `tier: long`.
TIER = "long"
TIER_RX = re.compile(r"^tier\s*:\s*(\S+)$", re.I)
# Files the steps write (ratchet, docs baseline; ai-libs and the timing edit AGENTS.md; no-stop-check edits
# .ai/enabled): always in the commit, also when the plan did not touch them.
CHECK_PATHS = [".ai/ratchet.json", ".ai/docs-allow", "AGENTS.md", ".ai/enabled"]
CHECK_LINE_RX = re.compile(r"^- Check: .*$", re.M)
DONE_RX = re.compile(r"^<!-- AI:done START[^>]*-->\n.*?^<!-- AI:done END -->\n?", re.M | re.S)
OWN_DONE_RX = re.compile(r"^##\s+(Done|Definition of done)\b", re.M | re.I)
VERIFY_RX = re.compile(r"^<!-- AI:verify START[^>]*-->\n.*?^<!-- AI:verify END -->\n?", re.M | re.S)
SECTION_END_RX = re.compile(r"^(#{1,2}\s|<!-- AI:)", re.M)     # the next section or managed block
LESSONS = ("## Lessons\n<!-- One line per repeated mistake that no check catches yet; name its ledger ID (R-NNN) "
           "when it has one. At most 15 lines: when a check covers a lesson, delete its line. -->\n")
LEDGER_TEMPLATE = """# Regressions

One line per bug that reached the main branch, added in the fix PR together with a test that failed before the
fix. Format (one line, or wrapped with an indent; `area:` is a folder or file path, more than one with commas):

    R-001 | 2026-11-14 | area: src/billing | symptom: ... | cause: ... | test: tests/regressions/test_r001_short_name.py | reopened: 0

Rules: never delete a line; `reopened` only goes up (the same symptom came back); the test is
tests/regressions/test_r<NNN>_*.py and its name says the promise it keeps. `ai-ledger --check` checks this
(`make check` runs it). An edit in an `area:` gets a one-line reminder with the IDs to run.

## Ledger

## Quarantine
Flaky tests, one line each: `- <test id> | since: YYYY-MM-DD | why`. Older than 14 days: fix it or delete it
with the owner's OK.
"""


# mattpocock opt-in skills per project (owner plan section 9). Claude reads <repo>/.claude/skills, Codex reads
# <repo>/.agents/skills: both get a link to the audited copy the installer keeps for this machine.
SKILLS_RX = re.compile(r"^skills\s*:\s*(.*)$", re.I)
# All of Matt's official plugin set (27, owner 2026-11-15) minus the 6 global ones (tools.sh MATTPOCOCK_PICKS).
OPTIN_SKILLS = ("grill-with-docs", "domain-modeling", "to-spec", "to-tickets", "tdd", "codebase-design", "code-review",
                "pr", "diagnosing-bugs", "improve-codebase-architecture", "implement", "implement-spec", "research",
                "handoff", "wayfinder", "prototype", "triage", "wizard", "to-questionnaire", "teach",
                "setup-matt-pocock-skills")
DEFAULT_SKILLS = ("grill-with-docs", "domain-modeling", "to-spec", "to-tickets", "tdd", "pr", "diagnosing-bugs",
                  "improve-codebase-architecture", "implement", "research", "handoff", "wayfinder", "prototype")
# Skills a pick calls with the Skill tool (read from the upstream SKILL.md files); grilling is global.
SKILL_CALLEES = {"grill-with-docs": ("domain-modeling",), "to-spec": ("domain-modeling",),
                 "to-tickets": ("domain-modeling",), "tdd": ("codebase-design", "code-review"),
                 "diagnosing-bugs": ("domain-modeling",), "improve-codebase-architecture": ("codebase-design",
                                                                                            "domain-modeling"),
                 "implement": ("tdd", "code-review", "codebase-design"),
                 "implement-spec": ("tdd", "code-review", "codebase-design"),
                 "wayfinder": ("domain-modeling", "research", "prototype"), "triage": ("domain-modeling",)}
ISSUE_TRACKER_DOC = """# Issue tracker

Local, in this repo. No GitHub issues, labels or remote calls without the owner's OK in this session.

- Specs (to-spec): `docs/specs/<feature-slug>.md`.
- Tickets (to-tickets): `docs/tickets/<feature-slug>/NN-<slice>.md`, one file per vertical slice: title,
  acceptance criteria, blocked by, and the verify-<app> feature the slice must pass (its file in the project's
  verify skill). A ticket is done when check-fast is green, the verify run left evidence, and an e2e test encodes
  the proven journey.
- Close a ticket by moving its file to `docs/tickets/<feature-slug>/done/` in the PR that finishes it.
- Work closes through PRs: one branch per feature (named after the slug), a draft PR after the first ticket,
  the ship skill, then `gh pr ready`. Every PR goes through the owner: the agent merges only after the
  owner says merge.
- Research notes (research): `docs/research/<topic>.md`, each claim with its source. The first lines say
  `Date:`, `Sources:` and `Status:` (current, superseded by <file>, or decided in ADR NNNN).
- Release reports (release skill): `docs/releases/<version>.md`.

## Wayfinding operations

Used by `/wayfinder`. The **map** is a file with one **child** file per ticket.

- **Map**: `docs/maps/<effort>/map.md` (the Destination / Notes / Decisions-so-far / Not yet specified / Out of
  scope body).
- **Child ticket**: `docs/maps/<effort>/issues/NN-<slug>.md`, numbered from `01`, with the question in the body. A
  `Type:` line records the ticket type (`research`/`prototype`/`grilling`/`task`); a `Status:` line records
  `claimed`/`resolved`.
- **Blocking**: a `Blocked by: NN, NN` line near the top. A ticket is unblocked when every file it lists is
  `resolved`.
- **Frontier**: scan `docs/maps/<effort>/issues/` for files that are open, unblocked, and unclaimed; first by
  number wins.
- **Claim**: set `Status: claimed` and save before any work.
- **Resolve**: append the answer under an `## Answer` heading, set `Status: resolved`, then append a context
  pointer (gist + link) to the map's Decisions-so-far in `map.md`.
"""
# Matt Pocock code-review reads this file on its Standards axis; retro adds rules to it (owner 2026-11-15).
CODING_STANDARDS_DOC = """# Coding standards

The reviewer reads this file (Matt Pocock `code-review`, Standards axis), not the implementer. `/retro` adds rules
here after a session where the review missed a mistake.

Only judgement calls go here: cross-file consistency, "matches the surrounding style", design choices no tool can
check. A mechanical rule (a banned API, an import shape, a file location, a naming pattern) becomes a check
instead: a linter rule, a pre-commit hook or a CI job.

One rule per line, with the reason. Example:
- Handlers stay thin: parse the request, call one service function, return. Why: logic in a handler has no unit test.

## Rules
"""
DOMAIN_DOC = """# Domain docs

Single context: `GLOSSARY.md` (terms, one line each) and `docs/adr/NNNN-<title>.md` (decisions that are hard to
reverse) at the repo root. grill-with-docs and domain-modeling update them during the questions.
"""


def plugin_src(name):
    """The installer's audited copy of a plugin source on this machine (tools.sh plugin_src_dir)."""
    # Server (root layer): /opt/agent-plugins. Mac and a light Linux (profile dev-mac, owner 2026-11-15): the home copy.
    home_src = os.path.expanduser("~/.local/share/ai/plugins")
    base = os.environ.get("AI_PLUGIN_SRC") or ("/opt/agent-plugins" if sys.platform.startswith("linux")
                                               and not os.path.isdir(home_src) else home_src)
    return os.path.join(base, name)


def choose_skills(current_all, opts):
    """--skills replaces the list. Else the defaults plus any extra names on the `skills:` line of an earlier run
    (a rerun adds new defaults; opt-in extras stay)."""
    if opts.get("skills") is not None:
        names = [] if opts["skills"] == ["none"] else opts["skills"]
        bad = [n for n in names if n not in OPTIN_SKILLS]
        if bad:
            sys.exit("unknown skill(s): %s (opt-in: %s)" % (", ".join(bad), ", ".join(OPTIN_SKILLS)))
        return [n for n in OPTIN_SKILLS if n in names]
    names = set(DEFAULT_SKILLS)
    for item in current_all:
        m = SKILLS_RX.match(item)
        if m:
            names.update(x.strip() for x in m.group(1).split(",") if x.strip() and x.strip() != "none")
    return [n for n in OPTIN_SKILLS if n in names]


def skill_closure(names):
    out = set(names)
    for n in names:
        out.update(SKILL_CALLEES.get(n, ()))
    return [n for n in OPTIN_SKILLS if n in out]


def tracker_docs_plan(root, names):
    out = []
    tracker = os.path.join(root, "docs", "agents", "issue-tracker.md")
    if {"to-spec", "to-tickets"} & set(names) and not os.path.exists(tracker):
        out.append((tracker, ISSUE_TRACKER_DOC))
    elif "wayfinder" in names and os.path.exists(tracker) and "## Wayfinding operations" not in (read(tracker) or ""):
        # An older tracker doc (before wayfinder, 2026-11-15): add the section, keep the owner's text.
        section = ISSUE_TRACKER_DOC[ISSUE_TRACKER_DOC.index("## Wayfinding operations"):]
        out.append((tracker, (read(tracker) or "").rstrip("\n") + "\n\n" + section))
    if {"grill-with-docs", "domain-modeling"} & set(names) and not os.path.exists(os.path.join(root, "docs", "agents",
                                                                                                 "domain.md")):
        out.append((os.path.join(root, "docs", "agents", "domain.md"), DOMAIN_DOC))
    return out


def skill_link_plan(root, names):
    """[(link path, target or None to remove)] for the project skill links that are missing, wrong or no longer
    wanted. Only links into the mattpocock copy are ever removed (anything else is the project's own)."""
    src = plugin_src("mattpocock-skills")
    out = []
    for base in (os.path.join(root, ".claude", "skills"), os.path.join(root, ".agents", "skills")):
        for n in OPTIN_SKILLS:
            link = os.path.join(base, n)
            want = n in names and os.path.isfile(os.path.join(src, n, "SKILL.md"))
            cur = os.readlink(link) if os.path.islink(link) else None
            if want and cur != os.path.join(src, n):
                if os.path.exists(link) and not os.path.islink(link):
                    print("skip skill link %s: a real folder is there (the project's own)" % os.path.relpath(link, root))
                    continue
                out.append((link, os.path.join(src, n)))
            elif not want and cur is not None and cur.startswith(src + os.sep):
                out.append((link, None))
    missing = [n for n in names if not os.path.isfile(os.path.join(src, n, "SKILL.md"))]
    if missing:
        print("skip skill links %s: not installed on this machine (%s; install.sh copies them)"
              % (", ".join(missing), src))
    return out


def verify_links(root):
    """Repo-relative .claude/skills/verify-<app> links for every .agents/skills/verify-<app>/ (committed)."""
    base = os.path.join(root, ".agents", "skills")
    try:
        names = sorted(n for n in os.listdir(base) if n.startswith("verify-")
                       and os.path.isfile(os.path.join(base, n, "SKILL.md")))
    except OSError:
        names = []
    return [os.path.join(".claude", "skills", n) for n in names]


def verify_link_steps(root):
    """The committed link .claude/skills/verify-<app> -> ../../.agents/skills/verify-<app> (Claude reads
    .claude/skills, Codex reads .agents/skills: one folder, two readers)."""
    todo = []
    for rel in verify_links(root):
        link = os.path.join(root, rel)
        want = os.path.join("..", "..", ".agents", "skills", os.path.basename(rel))
        if os.path.islink(link) and os.readlink(link) == want:
            continue
        if os.path.exists(link) and not os.path.islink(link):
            print("skip %s: a real folder is there (move it to .agents/skills/ and run ai-adopt again)" % rel)
            continue
        todo.append((link, want))
    cursor = os.path.join(root, ".cursor", "skills")
    if os.path.isdir(cursor) and any(n.startswith("verify-") for n in os.listdir(cursor)) and not todo \
            and not verify_links(root):
        print("note: a verify skill sits in .cursor/skills/: move it to .agents/skills/ (git mv), then run ai-adopt")
    if not todo:
        return []

    def apply():
        for link, want in todo:
            if os.path.islink(link):
                os.remove(link)
            os.makedirs(os.path.dirname(link), exist_ok=True)
            os.symlink(want, link)
    return [("link %s for Claude (to .agents/skills/, committed)" % ", ".join(os.path.relpath(l, root) for l, _w in todo),
             apply)]


def skill_link_steps(root, names):
    todo = skill_link_plan(root, names)
    if not todo:
        return []

    def apply():
        for link, target in todo:
            if os.path.islink(link):
                os.remove(link)
            if target:
                os.makedirs(os.path.dirname(link), exist_ok=True)
                os.symlink(target, link)
    added = sorted({os.path.basename(l) for l, t in todo if t})
    gone = sorted({os.path.basename(l) for l, t in todo if not t})
    label = "link project skills for Claude (.claude/skills) and Codex (.agents/skills): %s" % (
        ", ".join(added) or "none") + ("; remove: %s" % ", ".join(gone) if gone else "")
    return [(label, apply)]


def check_detect_module():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("ai_check_detect", os.path.join(BIN, "ai-check-detect"))
    spec = importlib.util.spec_from_loader("ai_check_detect", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True
    loader.exec_module(mod)
    return mod


def check_plan(root, tier, probe=True):
    """The check-fast / check targets for this repo (ai-check-detect), or None (no stack, monorepo: printed).
    probe: leave out a lint or test tool that does not run here (a dry run does not probe: probes can write)."""
    mod = check_detect_module()
    info = mod.detect(root, probe=probe)
    if not info.get("ok"):
        if info.get("monorepo") or "no test or lint" in info.get("refuse", ""):
            print("skip check targets: %s" % info["refuse"])
            for n in info.get("notes", []):
                print("check targets: " + n)
        return None
    out = mod.plan(root, info, tier)
    for t in out["kept"]:
        print("keep: %s already has a %s target (not changed)" % (out["file"], t))
    for n in info["notes"]:
        print("check targets: " + n)
    text = out["text"] or ""
    m = re.search(r"^%s\n.*?^%s\n" % (re.escape(mod.BLOCK_START), re.escape(mod.BLOCK_END)), text, re.M | re.S)
    out["block"] = m.group(0) if m else ""
    return out


def upsert_check_line(agents, checks):
    """One "- Check:" line in the Map (kept when present: the owner may have tuned it)."""
    m = MAP_RX.search(agents)
    if not m or CHECK_LINE_RX.search(m.group(0)):
        return agents
    line = ("- Check: `%s` (lint + unit tests, under 60 s; not measured yet); `%s` (everything, before a PR)."
            % (checks["fast_cmd"], checks["full_cmd"]))
    block = m.group(0)
    if LIBS_POINTER in block:
        new = block.replace(LIBS_POINTER, line + "\n" + LIBS_POINTER, 1)
    else:
        new = block.replace("\n" + MAP_END, "\n" + line + "\n" + MAP_END, 1)
    return agents[:m.start()] + new + agents[m.end():]


def render_done(tier, checks, verify_name="verify-<app>"):
    cmd = "`%s`" % checks["full_cmd"] if checks else "The project check (the Map says which)"
    fast = "`%s`" % checks["fast_cmd"] if checks else "check-fast"
    ledger = " and a line in docs/REGRESSIONS.md"
    first = ("1. In this order: %s green; then %s on the changed feature (launch, doctor, drive every entry point "
             "its feature file lists, evidence kept); only then add e2e tests for the proven journey; %s passes. "
             "The PR Evidence section cites the output, the evidence path and the e2e test." % (fast, verify_name, cmd))
    return "\n".join([
        "<!-- AI:done START (ai-adopt; 6 lines, a rerun replaces it) -->",
        "## Done",
        first,
        "2. New behaviour has a test; a bug fix has a test that failed before the fix%s." % ledger,
        "3. No test is deleted, skipped or weakened unless the owner said so in this session.",
        "4. Docs touched by the change are updated (Map, README), or the PR says \"Docs: none, because ...\".",
        "5. Only what was asked; a refactor goes in its own commit or PR.",
        "6. A PR stays under about 400 changed lines (generated files excluded), else split it or say why.",
        "<!-- AI:done END -->"]) + "\n"


def upsert_done(agents, tier, checks, root=None):
    """The managed Done block (6 lines) and an empty Lessons section. A hand-written Done section wins."""
    vs = verify_links(root) if root else []
    name = os.path.basename(vs[0]) if vs else "verify-<app>"
    outside = DONE_RX.sub("", agents)
    if OWN_DONE_RX.search(outside):
        print("keep: AGENTS.md has its own Done section (no second one added; the AI:verify line goes under it)")
        return upsert_verify(agents, render_verify(name))
    block = render_done(tier, checks, name)
    if DONE_RX.search(agents):
        agents = DONE_RX.sub(lambda m: merged(m.group(0), block), agents, count=1)
    else:
        agents = agents.rstrip("\n") + "\n\n" + block
    if not re.search(r"^##\s+Lessons\b", agents, re.M):
        agents = agents.rstrip("\n") + "\n\n" + LESSONS
    return agents


def render_verify(verify_name):
    """Ticket 06: the Done order (verify first, then automate) for a project that keeps its own Done section."""
    return ("<!-- AI:verify START (ai-adopt; 1 line, a rerun replaces it) -->\n"
            "- Verify: each changed feature is first driven with %s (log in `.verify/evidence/`), then its tests are "
            "automated.\n<!-- AI:verify END -->\n" % verify_name)


def upsert_verify(agents, block):
    """The AI:verify block at the end of the owner's own Done section. Only an insert: the owner text around it
    stays byte for byte. A rerun replaces the block in place."""
    if VERIFY_RX.search(agents):
        return VERIFY_RX.sub(lambda m: merged(m.group(0), block), agents, count=1)
    managed = [(d.start(), d.end()) for d in DONE_RX.finditer(agents)]
    own = next((m for m in OWN_DONE_RX.finditer(agents) if not any(s <= m.start() < e for s, e in managed)), None)
    if own is None:
        return agents
    nxt = SECTION_END_RX.search(agents, own.end())
    end = len(agents[:nxt.start() if nxt else len(agents)].rstrip("\n"))
    if end < len(agents):
        return agents[:end + 1] + block + agents[end + 1:]
    return agents + "\n" + block


def check_steps(root, opts, tier, checks, plan):
    """Time check-fast once when its target was (re)written or the Map line has no time yet."""
    if not checks or not opts["measure"]:
        return []
    written = any(os.path.basename(p) == checks["file"] for p, _t in plan)
    planned = dict(plan).get(os.path.join(root, "AGENTS.md")) or read(os.path.join(root, "AGENTS.md")) or ""
    m = MAP_RX.search(planned)
    line = CHECK_LINE_RX.search(m.group(0)) if m else None
    if not (written or (line and "measured" not in line.group(0))):
        return []
    return [("time %s once (writes the seconds into the Map)" % checks["fast_cmd"],
             lambda: measure_check(root, checks))]


PROJECT_RULES_RX = re.compile(r"^##\s+(Project\s+)?Rules\b", re.M | re.I)
PROJECT_RULES = ("## Project rules\n<!-- Rules for this repo only, one line each. They may add or tighten the global "
                 "rules, never loosen them; on a conflict the agent asks the owner. -->\n")


def upsert_project_rules(agents):
    """An empty "## Project rules" section once. A repo with its own "## Rules" section keeps it (same job)."""
    if PROJECT_RULES_RX.search(agents):
        return agents
    return agents.rstrip("\n") + "\n\n" + PROJECT_RULES


DESIGN_LINE_RX = re.compile(r"^- Design: .*$", re.M)


def upsert_design_line(agents, root):
    """One "- Design:" line in the Map: where the visual direction lives (ui-ux-pro-max MASTER.md)."""
    m = MAP_RX.search(agents)
    if not m or DESIGN_LINE_RX.search(m.group(0)):
        return agents
    slug = re.sub(r"[^a-z0-9]+", "-", project_name(root).lower()).strip("-") or "app"
    master = os.path.join("design-system", slug, "MASTER.md")
    state = "" if os.path.isfile(os.path.join(root, master)) else (
        " (missing: at kickoff, ui-ux-pro-max --design-system makes 3 to 5 directions as prototype variants, the owner "
        "picks one, then --persist writes it)")
    line = "- Design: `%s` and `design-system/%s/pages/<page>.md` overrides; read them before UI work%s." % (
        master, slug, state)
    block = m.group(0)
    new = block.replace("\n" + MAP_END, "\n" + line + "\n" + MAP_END, 1)
    return agents[:m.start()] + new + agents[m.end():]


UI_STANDARD = ("- UI follows `design-system/<app>/MASTER.md` and its page overrides (ui-ux-pro-max). Why: one visual "
               "language across screens; the reviewer checks new UI against it.")


def coding_standards_text(text, ui):
    """CODING_STANDARDS.md: the template when missing; the UI rule appended once when UI is on."""
    out = text if text is not None else CODING_STANDARDS_DOC
    if ui and "design-system/" not in out:
        out = out.rstrip("\n") + "\n" + UI_STANDARD + "\n"
    return out


def docs_baseline_steps(root):
    """The Markdown placement baseline (.ai/docs-allow, committed) once: files outside docs/ today pass."""
    if os.path.isfile(os.path.join(root, ".ai", "docs-allow")) or not docs_strays(root):
        return []
    return [("ai-docs-check --init (Markdown files outside docs/ today pass; a new one fails make check)",
             lambda: run_step([sys.executable, os.path.join(BIN, "ai-docs-check"), "--init", "--dir", root], root, 120))]


def docs_strays(root):
    """Markdown files outside the allowed places today (ai-docs-check rules), [] when none or on error."""
    import importlib.machinery
    import importlib.util
    try:
        loader = importlib.machinery.SourceFileLoader("ai_docs_check", os.path.join(BIN, "ai-docs-check"))
        spec = importlib.util.spec_from_loader("ai_docs_check", loader)
        mod = importlib.util.module_from_spec(spec)
        sys.dont_write_bytecode = True
        loader.exec_module(mod)
        files = mod.git_files(root) or []
        allow = mod.read_allow(root)
        return [f for f in files if mod.is_md(f) and not mod.allowed(f, allow)]
    except (OSError, ImportError, AttributeError):
        return []


PRECOMMIT_MARK ="# ai-adopt pre-commit (ai-precommit)"
PRECOMMIT_HOOK = """#!/bin/sh
%s: lint and format check on the staged files. Local, not committed.
command -v ai-precommit >/dev/null 2>&1 || { echo "ai-precommit not on PATH: pre-commit check skipped"; exit 0; }
exec ai-precommit
""" % PRECOMMIT_MARK


def precommit_steps(root, checks):
    """.git/hooks/pre-commit runs ai-precommit, when the repo has no hook of its own and no core.hooksPath
    (husky, lefthook, pre-commit keep theirs: printed)."""
    hooks_path = (git(root, "config", "--get", "core.hooksPath") or "").strip()
    if hooks_path:
        print("keep: core.hooksPath is %s (the repo's own hooks); no ai pre-commit hook" % hooks_path)
        return []
    git_dir = (git(root, "rev-parse", "--git-path", "hooks") or "").strip()
    if not git_dir:
        return []
    hook = os.path.join(root, git_dir) if not os.path.isabs(git_dir) else git_dir
    path = os.path.join(hook, "pre-commit")
    cur = read(path)
    if cur is not None and PRECOMMIT_MARK not in cur:
        print("keep: .git/hooks/pre-commit is the repo's own; no ai pre-commit hook")
        return []
    if cur == PRECOMMIT_HOOK:
        return []

    def apply():
        os.makedirs(hook, exist_ok=True)
        with open(path, "w") as fh:
            fh.write(PRECOMMIT_HOOK)
        os.chmod(path, 0o755)
    return [("install .git/hooks/pre-commit (ai-precommit: lint and format check on staged files, local)", apply)]


def ratchet_steps(root):
    """The ratchet baseline (.ai/ratchet.json, committed) when it is missing."""
    if os.path.isfile(os.path.join(root, ".ai", "ratchet.json")):
        return []
    return [("ai-ratchet --init (test, skip and lint counts that may only improve)",
             lambda: run_step([sys.executable, os.path.join(BIN, "ai-ratchet"), "--init", "--dir", root], root, 600))]


def measure_check(root, checks):
    import time
    argv = checks["fast_cmd"].split()
    if not which(argv[0]):
        note = "not measured: %s not found" % argv[0]
    else:
        t0 = time.time()
        try:
            res = subprocess.run(argv, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)
            secs = int(round(time.time() - t0))
            note = "measured %d s" % secs
            tail = "\n".join(res.stdout.decode("utf-8", "replace").splitlines()[-15:])
            if res.returncode != 0:
                print("%s FAILS today (exit %d, %d s). Last lines:\n%s" % (checks["fast_cmd"], res.returncode, secs,
                                                                           tail))
                stop_hook_off(root, checks["fast_cmd"])
            elif secs > 60:
                print("%s took %d s, over the 60 s target: keep only lint and fast unit tests in it"
                      % (checks["fast_cmd"], secs))
            else:
                print("%s passed in %d s" % (checks["fast_cmd"], secs))
        except subprocess.TimeoutExpired:
            note = "not measured: over 300 s"
            print("%s ran over 300 s: keep only lint and fast unit tests in it" % checks["fast_cmd"])
    path = os.path.join(root, "AGENTS.md")
    text = read(path) or ""
    new = re.sub(r"(- Check: `[^`]+` \(lint \+ unit tests)[^)]*\)", lambda m: "%s; %s)" % (m.group(1), note), text,
                 count=1)
    if new != text:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(new)


def stop_hook_off(root, fast_cmd):
    """check-fast fails at adopt time: arm no Stop hook that blocks every session on it (owner QA 2026-11-15)."""
    path = os.path.join(root, ".ai", "enabled")
    text = read(path) or ""
    if "no-stop-check" not in read_lines(path):
        text = text.rstrip("\n") + ("\n" if text else "") + \
            "no-stop-check  # check-fast failed at adopt time: remove this line when it is green\n"
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
    print("Stop hook off until check-fast is green: run %s, fix, then remove no-stop-check (.ai/enabled)" % fast_cmd)


# ---------------------------------------------------------------- helpers

def load_routing():
    path = os.path.join(AI_DIR, "build", "routing.json")
    if not os.path.isfile(path):
        subprocess.call([os.path.join(BIN, "ai-render")])
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        sys.exit("no ai/build/routing.json: run ai-render")


def resolver():
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "lib"))
    import resolve
    return resolve


def playwright_dir(ver):
    return os.path.expanduser("~/.local/share/ai/npm/playwright-mcp-%s" % ver)


def playwright_ok(ver):
    return os.access(os.path.join(playwright_dir(ver), "node_modules", ".bin", "mcp-server-playwright"), os.X_OK)


def playwright_installed():
    """Highest installed playwright-mcp-<version> folder with its binary, or None."""
    base = os.path.expanduser("~/.local/share/ai/npm")
    for ver in reversed(resolver().npm_dir_versions(base, "playwright-mcp")):
        if playwright_ok(ver):
            return ver
    return None


def playwright_keep_only(ver):
    """Remove every other playwright-mcp-<version> folder: ai-playwright-mcp starts the highest one, so a HOLD
    to an older version works only when no newer folder is left."""
    base = os.path.expanduser("~/.local/share/ai/npm")
    for other in resolver().npm_dir_versions(base, "playwright-mcp"):
        if other != ver:
            shutil.rmtree(playwright_dir(other), ignore_errors=True)


def ensure_playwright(dry_run=False):
    """Install the newest stable @playwright/mcp (owner decision 2026-11-14; PLAYWRIGHT_MCP_HOLD in ai/pins.env
    holds it) into ~/.local/share/ai/npm/playwright-mcp-<ver>: registry integrity, agent-audit PASS in 24 h
    (profile dev-mac audits no npm installs, owner 2026-11-14: "audit skipped"), --ignore-scripts, then version
    and integrity checked. Offline: the installed version stays.
    False = nothing usable installed (reason printed)."""
    res = resolver()
    have = playwright_installed()
    r = res.resolve("playwright-mcp", write=not dry_run)
    ver, want = r.get("version"), r.get("integrity")
    if r.get("status") in ("none", "cached") and have:
        if ver and ver != have:
            print("Playwright MCP %s kept (newest stable not checked: %s)" % (have, r.get("note")))
        return True
    if not ver:
        print("skip Playwright MCP: newest stable unknown (%s)" % (r.get("note") or "resolver failed"))
        return bool(have)
    if ver == have:
        if not dry_run:
            playwright_keep_only(ver)
        return True
    prefix = playwright_dir(ver)
    if playwright_ok(ver):           # e.g. a HOLD back to a version that is still on disk
        if dry_run:
            print("would keep Playwright MCP %s and remove the other version folders" % ver)
        else:
            playwright_keep_only(ver)
            res.record("playwright-mcp", ver, integrity=want or "")
            print("Playwright MCP %s (already in %s; other versions removed)" % (ver, prefix))
        return True
    pkg = "@playwright/mcp@%s" % ver
    if dry_run:
        print("would install %s into %s (integrity + agent-audit checked first)" % (pkg, prefix))
        return True
    got = (cmd_out(["npm", "view", pkg, "dist.integrity"]) or "").strip()
    if not want or got != want:
        print("skip Playwright MCP %s: npm sees integrity %s, the registry answer was %s%s"
              % (ver, got or "none", want or "none", ("; %s kept" % have) if have else ""))
        return bool(have)
    audit_off, profile = package_audit_off()
    if audit_off:
        print("audit skipped: profile %s (npm @playwright/mcp %s)" % (profile, ver))
    elif not audit_passed("npm", "@playwright/mcp", ver):
        print("skip Playwright MCP %s: no agent-audit PASS in 24 h. Run: agent-audit npm @playwright/mcp %s%s"
              % (ver, ver, ("; %s kept" % have) if have else ""))
        return bool(have)
    os.makedirs(prefix, exist_ok=True)
    rc = subprocess.call(["npm", "install", "--prefix", prefix, "--ignore-scripts", "--no-audit", "--no-fund",
                          "--save-exact", pkg])
    ok, msg = res.verify_npm(prefix, "@playwright/mcp", ver, want) if rc == 0 else (False, "npm install failed (%d)" % rc)
    if not ok:
        print("skip Playwright MCP %s: %s" % (ver, msg))
        shutil.rmtree(prefix, ignore_errors=True)
        return bool(have)
    res.record("playwright-mcp", ver, integrity=want)
    playwright_keep_only(ver)
    print("Playwright MCP %s installed in %s%s. Browsers are not downloaded (--ignore-scripts): run once\n"
          "  %s/node_modules/.bin/playwright install chromium" % (ver, prefix, (" (was %s)" % have) if have else "",
                                                                   prefix))
    return True


def package_audit_off():
    """(off, profile): the profile of this machine audits no npm or PyPI installs (PROFILE_PACKAGE_AUDIT=0, profile
    dev-mac; install.sh audit_ok does the same). An unknown profile audits."""
    name = ai_profile.resolve()[0]
    try:
        return ai_profile.load(name).get("PROFILE_PACKAGE_AUDIT", "1") == "0", name
    except ValueError:
        return False, name


def audit_passed(eco, name, ver):
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    from hooklib import audit_status
    return audit_status(eco, name, ver) == "PASS"


def cmd_out(argv, cwd=None):
    try:
        return subprocess.run(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()
    except OSError:
        return None


def owner_repo(root):
    url = git(root, "remote", "get-url", "origin")
    if not url:
        return True          # local-only repo: nothing is pushed
    owners = allowed_owners()
    owner = repo_owner(url)
    return bool(owner) and owner.lower() in owners


def allowed_owners():
    raw = os.environ.get("AI_GITHUB_OWNERS")
    if not raw:
        for line in (read(os.path.expanduser("~/.config/ai/config.env")) or "").splitlines():
            m = re.match(r"^\s*AI_GITHUB_OWNERS\s*=\s*\"?([^\"]*)\"?", line)
            if m:
                raw = m.group(1)
    if not raw:
        raw = repo_owner(git(AI_HOME, "remote", "get-url", "origin") or "") or ""
    return {o.strip().lower() for o in raw.split(",") if o.strip()}


def repo_owner(url):
    m = re.search(r"[:/]([^/:]+)/[^/]+?(?:\.git)?/?$", url.strip())
    return m.group(1) if m else None


def worktree_main(root):
    """The main checkout of a linked git worktree, or None (root is the main checkout)."""
    common = git(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common:
        return None
    main = os.path.dirname(os.path.normpath(common))
    return None if os.path.realpath(main) == os.path.realpath(root) else main


def project_name(root):
    """The project's folder name; for a linked worktree, the main checkout's (not the worktree folder's)."""
    return os.path.basename(worktree_main(root) or root)


def link_worktree_venv(root, dry_run=False):
    """A linked worktree has no .venv (gitignored): link the main checkout's, so the check targets are detected and
    probed with the project's own Python, as in the main checkout."""
    main = worktree_main(root)
    if not main:
        return
    src, dst = os.path.join(main, ".venv"), os.path.join(root, ".venv")
    if not os.path.isdir(src) or os.path.lexists(dst):
        return
    print("%s .venv -> %s (a linked worktree uses the main checkout's venv)" % ("would link" if dry_run else "link", src))
    if not dry_run:
        os.symlink(src, dst)


def git_root(d):
    return git(os.path.abspath(d), "rev-parse", "--show-toplevel")


def has_remote(root):
    return bool(git(root, "remote"))


def git(d, *args):
    try:
        res = subprocess.run(["git", "-C", d] + list(args), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    out = res.stdout.decode("utf-8").strip()
    return out if res.returncode == 0 and out else None


def ask(question):
    try:
        return input(question).strip().lower() in ("y", "yes")
    except EOFError:
        return False


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return None


def read_lines(path):
    return entries(read(path) or "")


def entries(text):
    return [ln.split("#", 1)[0].strip() for ln in text.splitlines() if ln.split("#", 1)[0].strip()]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
