#!/usr/bin/env python3
"""ai-start / ai-adopt: write the project layer of the AI setup into a git repo.

  ai-start [--dir PATH] [--tools id,id] [--yes] [--dry-run]   new project: pick opt-in tools, commit
  ai-adopt [--dir PATH] [--tools id,id] [--yes] [--dry-run]   existing repo: same layer, show diff,
                                                              one y/N, commit, push (owner repos only)
  Extra flags: --no-knowledge (skip Map and Libraries), --refresh-map (write the Map section again),
               --no-onboard (no headless claude pass for the Map conventions).
ai-adopt is a link to this file; the mode comes from the command name. Rerun = upgrade (blocks are
replaced by marker, project text outside the blocks is never touched).

What it writes (project root):
  .ai/base-version   routing.yaml version (the base version vN)
  .ai/enabled        opt-in rule ids, one per line (the router reads it)
  AGENTS.md          project knowledge every agent reads with no tool call (owner decision 2026-11-12):
                     "## Map" between <!-- AI:map START/END --> (entry points, where things live, how to
                     run and test, non-obvious conventions; <= 60 lines; written when missing or with
                     --refresh-map; edit freely inside the markers) and "## Libraries" between
                     <!-- AI:libraries START/END --> (ai-libs --sync: library, version, context7 ID).
                     Plus one short managed block per enabled opt-in tool:
                     <!-- AI:<id> v<N> START --> <routing action> <!-- AI:<id> v<N> END -->
  CLAUDE.md          a line "@AGENTS.md" (created when missing)
  .claude/settings.json   enabledPlugins for claude-seo / claude-blog when "seo" / "blog" is enabled
  .claude/settings.json   also enabledPlugins "ai-serena@ai" ("serena") and "ai-playwright@ai" ("browser"): each
                     plugin holds only its MCP entry; managed settings block project .mcp.json servers
  .codex/config.toml Codex entries for Playwright ("browser": ai-playwright-mcp, the pinned @playwright/mcp
                     installed once per machine, no npx at runtime) and Serena (trusted projects only)
  .gitignore         .serena/cache/, .serena/project.local.yml when "serena" is on; graphify-out/ when
                     "graph" is on
  Opt-in "serena":   serena project create --index (.serena/project.yml committed)
  Opt-in "graph":    GRAPHIFY_BACKEND=none graphify extract . --code-only (local, no key, gitignored)
Map conventions: with --yes (or after a y/N), one headless `claude -p` pass with read-only tools (Read,
Grep, Glob, rg, git ls-files) proposes the conventions lines; nothing else is written by it.
An old .ai/libs.md is removed (its IDs move into the Libraries section).
Owner repos: AI_GITHUB_OWNERS (env or ~/.config/ai/config.env, comma list), else the owner of the
origin remote of $AI_HOME. Third-party repos are refused.
"""
import json
import os
import re
import subprocess
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
AI_DIR = os.path.dirname(BIN)
AI_HOME = os.path.dirname(AI_DIR)


def main(argv):
    mode = "adopt" if os.path.basename(sys.argv[0]).startswith("ai-adopt") else "start"
    opts = parse(argv)
    root = git_root(opts["dir"])
    if root is None:
        print("ai-%s: %s is not a git repo (git init first)" % (mode, opts["dir"]), file=sys.stderr)
        return 1
    if not owner_repo(root):
        print("ai-%s: refused, the origin remote is not one of the owner's repos" % mode, file=sys.stderr)
        return 1
    routing = load_routing()
    version = str(routing.get("version") or 1)
    optin = [r for r in routing.get("rules", []) if r.get("scope") == "opt-in"]
    current = read_lines(os.path.join(root, ".ai", "enabled"))
    chosen = choose(optin, current, opts)

    plan = []
    plan.append(write_plan(os.path.join(root, ".ai", "base-version"), version + "\n"))
    enabled = sorted(set(current) | set(chosen))
    plan.append(write_plan(os.path.join(root, ".ai", "enabled"), "\n".join(enabled) + "\n" if enabled else ""))
    agents_path = os.path.join(root, "AGENTS.md")
    agents = read(agents_path) or "# %s\n" % os.path.basename(root)
    for rule in optin:
        if rule["id"] in chosen or rule["id"] in current:
            agents, note = upsert_block(agents, rule, version)
            if note:
                print(note)
    knowledge = opts["knowledge"]
    if knowledge and (opts["refresh_map"] or not MAP_RX.search(agents)):
        agents = upsert_map(agents, build_map(root))
    plan.append(write_plan(agents_path, agents))
    plan.append(write_plan(os.path.join(root, "CLAUDE.md"), claude_md(read(os.path.join(root, "CLAUDE.md")))))
    plan.extend(project_mcp_plan(root, enabled, opts["dry_run"]))
    plan.append(claude_plugins_plan(root, enabled))
    plan.append(write_plan(os.path.join(root, ".gitignore"), gitignore_text(read(os.path.join(root, ".gitignore")),
                                                                            enabled)))
    plan = [p for p in plan if p]
    steps = knowledge_steps(root, opts, enabled)

    if not plan and not steps:
        print("ai-%s: nothing to change (base v%s)" % (mode, version))
        return 0
    for path, _text in plan:
        print("%s %s" % ("would write" if opts["dry_run"] else "write", os.path.relpath(path, root)))
    for name, _fn in steps:
        print("%s %s" % ("would run" if opts["dry_run"] else "run", name))
    if opts["dry_run"]:
        return 0
    for path, text in plan:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
    for name, fn in steps:
        try:
            fn()
        except (OSError, subprocess.SubprocessError) as exc:
            print("ai-%s: step failed, skipped (%s): %s" % (mode, name, exc))
    paths = [os.path.relpath(p, root) for p, _ in plan]
    paths += [rel for rel in KNOWLEDGE_PATHS if (os.path.exists(os.path.join(root, rel)) or
                                                 git(root, "ls-files", "--", rel)) and rel not in paths]
    if not paths or not git(root, "status", "--porcelain", "--", *paths):
        print("ai-%s: nothing to commit (generated files are gitignored)" % mode)
        return 0
    subprocess.call(["git", "-C", root, "add", "-N"] + paths, stderr=subprocess.DEVNULL)
    subprocess.call(["git", "-C", root, "--no-pager", "diff", "--"] + paths)
    hits = knowledge_secret_hits(root)
    if hits:
        print("ai-%s: secret scan found %s in AGENTS.md. Remove it, then run again. "
              "Files written, not committed." % (mode, ", ".join(sorted(set(hits)))))
        return 1
    if not opts["yes"] and not ask("Commit this%s? [y/N] " % (" and push" if mode == "adopt" else "")):
        print("ai-%s: files written, not committed" % mode)
        return 0
    msg = ("chore(ai): adopt base AI setup v%s" if mode == "adopt" else "chore(ai): start project AI setup v%s") % version
    subprocess.check_call(["git", "-C", root, "add", "-A", "--"] + paths)
    subprocess.check_call(["git", "-C", root, "commit", "-m", msg, "--"] + paths)
    if mode == "adopt" and has_remote(root):
        return subprocess.call(["git", "-C", root, "push"])
    return 0


def parse(argv):
    opts = {"dir": ".", "tools": None, "yes": False, "dry_run": False, "knowledge": True, "onboard": True,
            "refresh_map": False}
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--dir" and args:
            opts["dir"] = args.pop(0)
        elif a == "--tools" and args:
            opts["tools"] = [t.strip() for t in args.pop(0).split(",") if t.strip()]
        elif a == "--yes":
            opts["yes"] = True
        elif a == "--dry-run":
            opts["dry_run"] = True
        elif a == "--no-knowledge":
            opts["knowledge"] = False
        elif a == "--no-onboard":
            opts["onboard"] = False
        elif a == "--refresh-map":
            opts["refresh_map"] = True
        elif a in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            sys.exit("unknown argument: " + a)
    return opts


def choose(optin, current, opts):
    ids = [r["id"] for r in optin]
    if opts["tools"] is not None:
        bad = [t for t in opts["tools"] if t not in ids]
        if bad:
            sys.exit("unknown opt-in tool(s): %s (known: %s)" % (", ".join(bad), ", ".join(ids)))
        return opts["tools"]
    if opts["yes"] or not sys.stdin.isatty():
        return []
    print("Opt-in tools for this project (routing.yaml). Already enabled: %s" % (", ".join(current) or "none"))
    picked = []
    for r in optin:
        if r["id"] in current:
            continue
        if ask("  %s (%s): %s  Enable? [y/N] " % (r["id"], r.get("tool", ""), r["action"])):
            picked.append(r["id"])
    return picked


# ---------------------------------------------------------------- file builders

def write_plan(path, text):
    if not text:
        return None
    return None if read(path) == text else (path, text)


def upsert_block(agents, rule, version):
    rid = rule["id"]
    rx = re.compile(r"<!-- AI:%s v\d+ START -->.*?<!-- AI:%s v\d+ END -->\n?" % (re.escape(rid), re.escape(rid)), re.S)
    outside = rx.sub("", agents)
    tool = str(rule.get("tool", ""))
    if tool and tool.split()[0].lower() in outside.lower():
        return agents, "skip %s: AGENTS.md already has its own text for %s" % (rid, tool)
    block = "<!-- AI:%s v%s START -->\n%s\n<!-- AI:%s v%s END -->\n" % (rid, version, vendor_text(rule), rid, version)
    if rx.search(agents):
        return rx.sub(lambda _m: block, agents, count=1), None
    return agents.rstrip("\n") + "\n\n" + block, None


def vendor_text(rule):
    """Short on purpose (context files cost tokens every session): the routing action plus a pointer."""
    action = re.sub(r"\s*\{[a-z_]+\}", "", rule["action"]).strip()
    for name in candidates(rule):
        if os.path.isfile(os.path.join(AI_DIR, "rules", name + ".md")):
            return "%s Details: ~/.config/ai/rules/%s.md" % (action, name)
    return action


def candidates(rule):
    tool = str(rule.get("tool", "")).lower()
    slug = re.sub(r"[^a-z0-9]+", "-", tool).strip("-")
    first = slug.split("-mcp")[0]
    return [n for n in (rule["id"], slug, first, tool.split()[0] if tool else "") if n]


def claude_md(text):
    if text is None:
        return "@AGENTS.md\n"
    if re.search(r"^@AGENTS\.md\s*$", text, re.M):
        return None
    return text.rstrip("\n") + "\n\n@AGENTS.md\n"


# Opt-in Claude plugins (owner 2026-11-12): installed per machine, disabled at user scope, enabled per project.
# Serena too: plugin ai-serena@ai holds only its MCP entry, because managed strictPluginOnlyCustomization
# blocks project .mcp.json files (planted-config defence) while plugin servers still load.
CLAUDE_PLUGINS = {"seo": "claude-seo@agricidaniel-claude-seo", "blog": "claude-blog@agricidaniel-blog",
                  "serena": "ai-serena@ai", "browser": "ai-playwright@ai"}


def claude_plugins_plan(root, enabled):
    """Project .claude/settings.json: enabledPlugins true for each enabled opt-in plugin (merge, keep other keys)."""
    want = [CLAUDE_PLUGINS[r] for r in enabled if r in CLAUDE_PLUGINS]
    if not want:
        return None
    path = os.path.join(root, ".claude", "settings.json")
    try:
        data = json.loads(read(path) or "{}")
    except ValueError:
        print("skip .claude/settings.json: not valid JSON (enable %s by hand)" % ", ".join(want))
        return None
    plugins = data.setdefault("enabledPlugins", {})
    if all(plugins.get(w) is True for w in want):
        return None
    for w in want:
        plugins[w] = True
    return (path, json.dumps(data, indent=2) + "\n")


def project_mcp_plan(root, enabled, dry_run=False):
    """Per-project MCP servers in .mcp.json (Claude) and .codex/config.toml (Codex, loaded in trusted projects
    only), merged in one write each.
    Claude gets both servers from plugins (ai-playwright@ai, ai-serena@ai via claude_plugins_plan), because
    managed settings block project .mcp.json servers. So only Codex gets entries here.
    browser: `ai-playwright-mcp` runs the pinned @playwright/mcp installed once per machine (no npx)."""
    want = {}
    if "browser" in enabled and ensure_playwright(dry_run):
        want["playwright"] = (None, ("ai-playwright-mcp", ["--headless", "--isolated"], {}))
    if "serena" in enabled:
        want["serena"] = (None, ("serena", ["start-mcp-server", "--project-from-cwd", "--context=codex"],
                                 {"SERENA_USAGE_REPORTING": "false"}))
    if not want:
        return []
    out = []
    mcp_path = os.path.join(root, ".mcp.json")
    try:
        mcp = json.loads(read(mcp_path) or "{}")
    except ValueError:
        print("skip .mcp.json: not valid JSON")
        mcp = None
    if mcp is not None:
        servers = mcp.setdefault("mcpServers", {})
        added = [n for n in want if n not in servers and want[n][0] is not None]
        for n in added:
            servers[n] = want[n][0]
        if added:
            out.append((mcp_path, json.dumps(mcp, indent=2) + "\n"))
    toml_path = os.path.join(root, ".codex", "config.toml")
    toml = read(toml_path) or ""
    blocks = []
    for n, (_c, (cmd, args, env)) in want.items():
        if "[mcp_servers.%s]" % n in toml:
            continue
        block = '[mcp_servers.%s]\ncommand = "%s"\nargs = [%s]\n' % (n, cmd, ", ".join('"%s"' % a for a in args))
        if env:
            block += "env = { %s }\n" % ", ".join('%s = "%s"' % kv for kv in env.items())
        blocks.append(block)
    if blocks:
        out.append((toml_path, (toml.rstrip("\n") + "\n\n" if toml.strip() else "") + "\n".join(blocks)))
    return out


# ---------------------------------------------------------------- knowledge layer

KNOWLEDGE_PATHS = [".serena/project.yml", ".serena/.gitignore", ".ai/libs.md"]
GITIGNORE = {"serena": [".serena/cache/", ".serena/project.local.yml"], "graph": ["graphify-out/"]}
MAP_RX = re.compile(r"^<!-- AI:map START[^>]*-->\s*\n.*?^<!-- AI:map END -->\s*\n?", re.M | re.S)
MAP_START = "<!-- AI:map START (ai-adopt; edit freely inside, keep it under 60 lines) -->"
MAP_END = "<!-- AI:map END -->"
MAP_MAX_LINES = 60
SKIP_DIRS = {".git", "node_modules", "vendor", "dist", "build", "target", "graphify-out", ".venv", "venv",
             "__pycache__", ".serena", ".omc", ".ai", ".claude", ".codex", "coverage", ".next", ".cache"}
LANG = {".py": "Python", ".ts": "TypeScript", ".tsx": "TypeScript", ".js": "JavaScript", ".jsx": "JavaScript",
        ".go": "Go", ".rs": "Rust", ".rb": "Ruby", ".java": "Java", ".kt": "Kotlin", ".php": "PHP", ".cs": "C#",
        ".swift": "Swift", ".sh": "Shell", ".sql": "SQL", ".vue": "Vue", ".svelte": "Svelte", ".c": "C",
        ".cpp": "C++", ".ex": "Elixir", ".dart": "Dart", ".lua": "Lua"}
MAP_PROMPT = (
    "You see a repository. Reply with 3 to 10 Markdown bullet lines, nothing else: the non-obvious conventions "
    "an agent must know before it edits code here (naming, layering, where new code goes, test layout, generated "
    "files not to edit, commands that must run before a commit). Only facts you saw in the files. No secrets, "
    "hostnames, emails or personal data. No intro, no outro. Current map:\n\n")
MAP_TOOLS = ["Read", "Grep", "Glob", "Bash(git ls-files:*)", "Bash(rg:*)"]


def gitignore_text(text, enabled):
    want = [ln for tool in sorted(GITIGNORE) if tool in enabled for ln in GITIGNORE[tool]]
    have = {ln.strip() for ln in (text or "").splitlines()}
    missing = [ln for ln in want if ln not in have and ln.rstrip("/") not in have]
    if not missing:
        return None
    head = (text or "").rstrip("\n")
    return (head + "\n\n" if head else "") + "# AI tools (ai-adopt): caches and generated graph\n" + "\n".join(missing) + "\n"


def upsert_map(agents, body):
    block = "%s\n## Map\n%s\n%s\n" % (MAP_START, body.rstrip("\n"), MAP_END)
    if MAP_RX.search(agents):
        return MAP_RX.sub(lambda _m: block, agents, count=1)
    lines = agents.rstrip("\n").split("\n")
    # right after the title line, so the map is the first thing an agent reads
    if lines and lines[0].startswith("# "):
        return "\n".join([lines[0], "", block.rstrip("\n")] + ([""] + lines[1:] if lines[1:] else [])).rstrip("\n") + "\n"
    return block + "\n" + agents


def build_map(root):
    """A Map from repo facts only (no LLM): languages, entry points, where things live, run and test."""
    counts, dirs = {}, {}
    seen = 0
    for dirpath, dirnames, files in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith("."))
        rel = os.path.relpath(dirpath, root)
        top = rel.split(os.sep)[0] if rel != "." else "."
        for f in files:
            seen += 1
            ext = os.path.splitext(f)[1].lower()
            if ext in LANG:
                counts[LANG[ext]] = counts.get(LANG[ext], 0) + 1
                dirs[top] = dirs.get(top, 0) + 1
        if seen > 20000:
            break
    langs = ", ".join(l for l, _n in sorted(counts.items(), key=lambda kv: -kv[1])[:3]) or "no code yet"
    lines = ["- What: %s (%s)." % (os.path.basename(root), langs)]
    entries = entry_points(root)
    if entries:
        lines.append("- Entry points: " + "; ".join(entries[:6]) + ".")
    where = ["`%s/` (%d code files)" % (d, n) for d, n in sorted(dirs.items(), key=lambda kv: -kv[1]) if d != "."][:10]
    if dirs.get("."):
        where.append("repo root (%d code files)" % dirs["."])
    if where:
        lines.append("- Where things live: " + ", ".join(where) + ".")
    run, test = commands(root)
    if run:
        lines.append("- Run: " + "; ".join(run[:5]) + ".")
    if test:
        lines.append("- Test: " + "; ".join(test[:3]) + ".")
    lines.append("- Library versions and docs IDs: the Libraries section below.")
    return "\n".join(lines[:MAP_MAX_LINES]) + "\n"


def entry_points(root):
    out = []
    data = load_toml(os.path.join(root, "pyproject.toml")) or {}
    for name, target in ((data.get("project") or {}).get("scripts") or {}).items():
        out.append("`%s` -> `%s`" % (name, target))
    pkg = load_json(os.path.join(root, "package.json")) or {}
    if isinstance(pkg.get("bin"), dict):
        out += ["`%s` -> `%s`" % kv for kv in pkg["bin"].items()]
    if pkg.get("main"):
        out.append("`%s` (package main)" % pkg["main"])
    for rel in ("main.go", "src/main.rs", "manage.py", "app.py", "main.py", "src/main.py", "src/index.ts",
                "src/index.js", "index.js", "server.js"):
        if os.path.isfile(os.path.join(root, rel)):
            out.append("`%s`" % rel)
    cmd_dir = os.path.join(root, "cmd")
    if os.path.isdir(cmd_dir):
        out += ["`cmd/%s/`" % d for d in sorted(os.listdir(cmd_dir)) if os.path.isfile(os.path.join(cmd_dir, d, "main.go"))]
    for rel in ("Dockerfile", "docker-compose.yml", "compose.yaml", "compose.yml"):
        if os.path.isfile(os.path.join(root, rel)):
            out.append("`%s`" % rel)
    return out


def commands(root):
    run, test = [], []
    pkg = load_json(os.path.join(root, "package.json")) or {}
    pm = "pnpm" if os.path.isfile(os.path.join(root, "pnpm-lock.yaml")) else \
        "yarn" if os.path.isfile(os.path.join(root, "yarn.lock")) else "npm run"
    for name in (pkg.get("scripts") or {}):
        cmd = "`%s %s`" % (pm, name)
        if name.startswith("test"):
            test.append(cmd)
        elif name in ("dev", "start", "build", "lint", "serve", "typecheck"):
            run.append(cmd)
    py = os.path.isfile(os.path.join(root, "pyproject.toml"))
    uv = os.path.isfile(os.path.join(root, "uv.lock"))
    if py and (os.path.isdir(os.path.join(root, "tests")) or "pytest" in (read(os.path.join(root, "pyproject.toml")) or "")):
        test.append("`uv run pytest`" if uv else "`pytest`")
    if py and uv:
        run.append("`uv sync`")
    if os.path.isfile(os.path.join(root, "go.mod")):
        test.append("`go test ./...`")
    if os.path.isfile(os.path.join(root, "Cargo.toml")):
        run.append("`cargo build`")
        test.append("`cargo test`")
    for mk in ("Makefile", "justfile", "Justfile"):
        text = read(os.path.join(root, mk)) or ""
        rx = r"^([A-Za-z][\w-]*):(?!=)" if mk == "Makefile" else r"^([A-Za-z][\w-]*)[^\n:=]*:(?!=)"
        targets = [t for t in re.findall(rx, text, re.M) if t not in (".PHONY",)][:8]
        tool = "make" if mk == "Makefile" else "just"
        for t in targets:
            (test if t.startswith("test") else run).append("`%s %s`" % (tool, t))
    return run, test


def knowledge_steps(root, opts, enabled):
    """Steps that change nothing when their result is already there. Each is (label, callable)."""
    steps = []
    code = repo_has_code(root)
    map_new = opts["refresh_map"] or not MAP_RX.search(read(os.path.join(root, "AGENTS.md")) or "")
    if opts["knowledge"] and opts["onboard"] and code and map_new:
        if not which("claude"):
            print("skip Map conventions: claude is not on PATH (add them by hand inside the Map markers)")
        elif opts["dry_run"] or opts["yes"] or (sys.stdin.isatty() and ask(
                "Ask a headless claude (read-only tools) for the Map conventions lines? [y/N] ")):
            steps.append(("Map conventions (claude -p, read-only tools)", lambda: map_conventions(root)))
    serena_dir = os.path.join(root, ".serena")
    if "serena" in enabled and code:
        if not which("serena"):
            print("skip Serena: serena is not on PATH (install.sh installs it)")
        elif not os.path.isfile(os.path.join(serena_dir, "project.yml")):
            steps.append(("serena project create --index",
                          lambda: run_step(["serena", "project", "create", "--index", root], root, 1800)))
    if "graph" in enabled and code:
        if not which("graphify"):
            print("skip graph: graphify is not on PATH")
        elif not os.path.isfile(os.path.join(root, "graphify-out", "graph.json")):
            steps.append(("GRAPHIFY_BACKEND=none graphify extract . --code-only",
                          lambda: run_step(["graphify", "extract", ".", "--code-only"], root, 1800,
                                           env={"GRAPHIFY_BACKEND": "none"})))
    if opts["knowledge"] and libs_stale(root):
        steps.append(("ai-libs --sync", lambda: run_step([sys.executable, os.path.join(BIN, "ai-libs"), "--sync",
                                                          "--dir", root], root, 600)))
    if os.path.isfile(os.path.join(root, ".ai", "libs.md")):
        steps.append(("remove the old .ai/libs.md (IDs move into the Libraries section)",
                      lambda: os.remove(os.path.join(root, ".ai", "libs.md"))))
    return steps


def map_conventions(root):
    """One headless claude pass with read-only tools. Its stdout becomes the Conventions lines of the Map."""
    path = os.path.join(root, "AGENTS.md")
    text = read(path) or ""
    m = MAP_RX.search(text)
    if not m:
        return
    current = m.group(0)
    cmd = ["claude", "-p", MAP_PROMPT + current, "--output-format", "text", "--allowedTools"] + MAP_TOOLS
    print("$ claude -p <map conventions prompt> --allowedTools " + " ".join(MAP_TOOLS))
    res = subprocess.run(cmd, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=900)
    bullets = [ln.rstrip() for ln in res.stdout.decode("utf-8", "replace").splitlines() if ln.strip().startswith("- ")]
    if res.returncode != 0 or not bullets:
        print("Map conventions: no usable answer (exit %s): add them by hand inside the Map markers" % res.returncode)
        return
    body = current.split("\n## Map\n", 1)[1].rsplit(MAP_END, 1)[0].rstrip("\n").split("\n")
    body = [ln for ln in body if not ln.startswith("- Conventions:") and not ln.startswith("  - ")]
    room = MAP_MAX_LINES - len(body) - 1
    body += ["- Conventions:"] + ["  " + b for b in bullets[:max(room, 0)]]
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(upsert_map(text, "\n".join(body)))
    print("Map conventions: %d lines added. Read them in the diff before the commit." % min(len(bullets), room))


def knowledge_secret_hits(root):
    """The secret-scan gate patterns over the managed AGENTS.md blocks (they are committed and pushed)."""
    text = read(os.path.join(root, "AGENTS.md")) or ""
    blocks = [m.group(0) for m in MAP_RX.finditer(text)]
    blocks += re.findall(r"<!-- AI:libraries START.*?<!-- AI:libraries END -->", text, re.S)
    added = "\n".join("+" + ln for b in blocks for ln in b.splitlines())
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    try:
        from hooklib import allowed_secrets, builtin_scan
    except ImportError:
        return []
    return builtin_scan(added, allowed_secrets())


def libs_stale(root):
    res = subprocess.run([sys.executable, os.path.join(BIN, "ai-libs"), "--check", "--dir", root],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return res.returncode != 0


def repo_has_code(root):
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    try:
        from router import has_code_files
    except ImportError:
        return True
    return has_code_files(root)


def run_step(argv, cwd, timeout, env=None):
    full = dict(os.environ)
    full.update(env or {})
    print("$ " + " ".join(a if len(a) < 80 else a[:77] + "..." for a in argv))
    return subprocess.call(argv, cwd=cwd, env=full, timeout=timeout)


def which(name):
    from shutil import which as _which
    return _which(name)


def load_toml(path):
    text = read(path)
    if not text:
        return None
    try:
        import tomllib
        return tomllib.loads(text)
    except (ImportError, ValueError):
        return None


def load_json(path):
    try:
        return json.loads(read(path) or "null")
    except ValueError:
        return None


# ---------------------------------------------------------------- helpers

def load_routing():
    path = os.path.join(AI_DIR, "build", "routing.json")
    if not os.path.isfile(path):
        subprocess.call([os.path.join(BIN, "ai-render")])
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        sys.exit("no ai/build/routing.json: run ai-render")


def pin(name):
    for line in (read(os.path.join(AI_DIR, "pins.env")) or "").splitlines():
        m = re.match(r"^\s*%s\s*=\s*\"?([^\"#\s]+)" % re.escape(name), line)
        if m:
            return m.group(1)
    return None


def playwright_dir(ver):
    return os.path.expanduser("~/.local/share/ai/npm/playwright-mcp-%s" % ver)


def ensure_playwright(dry_run=False):
    """Install the pinned @playwright/mcp once (integrity from pins.env, agent-audit PASS in 24 h,
    --ignore-scripts) into ~/.local/share/ai/npm/playwright-mcp-<ver>. False = not installed (reason printed)."""
    ver, want = pin("PLAYWRIGHT_MCP_VERSION"), pin("PLAYWRIGHT_MCP_INTEGRITY")
    if not ver:
        print("skip Playwright MCP: no PLAYWRIGHT_MCP_VERSION in ai/pins.env (audit and pin it first)")
        return False
    prefix = playwright_dir(ver)
    if os.access(os.path.join(prefix, "node_modules", ".bin", "mcp-server-playwright"), os.X_OK):
        return True
    if not want:
        print("skip Playwright MCP: no PLAYWRIGHT_MCP_INTEGRITY in ai/pins.env (needed for a checked install)")
        return False
    pkg = "@playwright/mcp@%s" % ver
    if dry_run:
        print("would install %s into %s (integrity + agent-audit checked first)" % (pkg, prefix))
        return True
    got = (cmd_out(["npm", "view", pkg, "dist.integrity"]) or "").strip()
    if got != want:
        print("skip Playwright MCP: %s integrity mismatch (registry: %s)" % (pkg, got or "none"))
        return False
    if not audit_passed("npm", "@playwright/mcp", ver):
        print("skip Playwright MCP: no agent-audit PASS in 24 h. Run: agent-audit npm @playwright/mcp %s" % ver)
        return False
    os.makedirs(prefix, exist_ok=True)
    rc = subprocess.call(["npm", "install", "--prefix", prefix, "--ignore-scripts", "--no-audit", "--no-fund",
                          "--save-exact", pkg])
    if rc != 0:
        print("skip Playwright MCP: npm install failed (%d)" % rc)
        return False
    print("Playwright MCP %s installed in %s. Browsers are not downloaded (--ignore-scripts): run once\n"
          "  %s/node_modules/.bin/playwright install chromium" % (ver, prefix, prefix))
    return True


def audit_passed(eco, name, ver):
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.join(AI_DIR, "marketplace", "plugins", "ai-core", "hooks"))
    from hooklib import audit_status
    return audit_status(eco, name, ver) == "PASS"


def cmd_out(argv):
    try:
        return subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()
    except OSError:
        return None


def owner_repo(root):
    url = git(root, "remote", "get-url", "origin")
    if not url:
        return True          # local-only repo: nothing is pushed
    owners = allowed_owners()
    owner = repo_owner(url)
    return bool(owner) and owner.lower() in owners


def allowed_owners():
    raw = os.environ.get("AI_GITHUB_OWNERS")
    if not raw:
        for line in (read(os.path.expanduser("~/.config/ai/config.env")) or "").splitlines():
            m = re.match(r"^\s*AI_GITHUB_OWNERS\s*=\s*\"?([^\"]*)\"?", line)
            if m:
                raw = m.group(1)
    if not raw:
        raw = repo_owner(git(AI_HOME, "remote", "get-url", "origin") or "") or ""
    return {o.strip().lower() for o in raw.split(",") if o.strip()}


def repo_owner(url):
    m = re.search(r"[:/]([^/:]+)/[^/]+?(?:\.git)?/?$", url.strip())
    return m.group(1) if m else None


def git_root(d):
    return git(os.path.abspath(d), "rev-parse", "--show-toplevel")


def has_remote(root):
    return bool(git(root, "remote"))


def git(d, *args):
    try:
        res = subprocess.run(["git", "-C", d] + list(args), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    out = res.stdout.decode("utf-8").strip()
    return out if res.returncode == 0 and out else None


def ask(question):
    try:
        return input(question).strip().lower() in ("y", "yes")
    except EOFError:
        return False


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return None


def read_lines(path):
    return [ln.split("#", 1)[0].strip() for ln in (read(path) or "").splitlines() if ln.split("#", 1)[0].strip()]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
