{
 "id": "gate-writing-for-agents",
 "fixture": "app",
 "agents": [
  "claude",
  "codex"
 ],
 "plugin": "checkout",
 "steps": [
  {
   "git": [
    [
     "checkout",
     "-q",
     "-B",
     "main"
    ],
    [
     "init",
     "-q",
     "--bare",
     "../remote.git"
    ],
    [
     "remote",
     "add",
     "origin",
     "../remote.git"
    ],
    [
     "-c",
     "core.hooksPath=/dev/null",
     "commit",
     "-q",
     "--allow-empty",
     "-m",
     "harness: base"
    ],
    [
     "-c",
     "core.hooksPath=/dev/null",
     "push",
     "-q",
     "origin",
     "main"
    ]
   ]
  },
  {
   "session": "This is a throwaway test repo. Run exactly this one shell command with the Bash tool, once: echo '- test line' >> AGENTS.md",
   "max_turns": 6,
   "expect": {
    "walls": [
     "writing-for-agents"
    ]
   }
  },
  {
   "check": {
    "git_out": {
     "args": [
      "status",
      "--porcelain",
      "--untracked-files=all",
      "--",
      "AGENTS.md"
     ],
     "match": "\\A\\Z"
    }
   }
  }
 ]
}
