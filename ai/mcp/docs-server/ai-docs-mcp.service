# Grounded Docs MCP (arabold/docs-mcp-server), one per network, on the home server (SPEC 4, 17).
# Installed by `install.sh --docs-server`. Flags and the data-path variable live in
# /etc/default/ai-docs-mcp so they can change without a new unit. The firewall opens the port on the
# LAN interface and tailscale0 only (install.sh). Telemetry off (PostHog is on by default).
[Unit]
Description=Grounded Docs MCP server (ai setup)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=ai-docs-mcp
Environment=HOME=/var/lib/ai-docs-mcp
Environment=DOCS_MCP_TELEMETRY=false
# Network clients get read-only tools (SPEC 21). Index libraries with the CLI on the server.
Environment=DOCS_MCP_READ_ONLY=true
Environment=DOCS_MCP_STORE_PATH=/var/lib/ai-docs-mcp
EnvironmentFile=-/etc/default/ai-docs-mcp
ExecStart=/bin/sh -c 'exec docs-mcp-server $DOCS_MCP_ARGS'
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
