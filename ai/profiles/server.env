# Profile server (Ubuntu servers, owner decision 2026-11-14): the full install audit and every gate.
# KEY=VALUE, sourced by bash 3.2 (ai/lib/profile.sh) and read by ai/lib/ai_profile.py. No spaces around "=".
PROFILE_SCANNERS="guarddog osv-scanner"   # audit scanners this setup installs
PROFILE_PACKAGE_AUDIT=1    # npm, PyPI and GitHub sources are agent-audited before install
PROFILE_AUDIT_GATE=1       # the audit-before-install gate (routing row) is on
PROFILE_OPENCODE=1         # opencode may be installed (macOS always, Linux with AI_EXTRA_AGENTS=opencode)
PROFILE_LAST30DAYS=1       # the last30days Claude plugin (skill-scanner still decides)
PROFILE_ROOT_LAYER=1       # Linux: root layer (sandbox, /etc, managed settings, system-wide tools in /usr/local, /opt)
PROFILE_BOX=1              # the box MCP server (plugin ai-box@ai, Codex and Hermes box entries)
PROFILE_GITLEAKS=0         # gitleaks release binary for the secret-scan gate (dev-mac only, owner 2026-11-18)
PROFILE_GUARDS=1         # Claude ask/deny permission rules (config-file edits, secrets.env read, git push asks) and the Stop check
