# Profile dev-mac (both Macs, owner decision 2026-11-14): skill-scanner is the only scanner; package installs
# are not audited (said on every one: "audit skipped: profile dev-mac"); no audit gate, no opencode, no box.
# Skills and plugins are still scanned: a skill-scanner HIGH or CRITICAL finding is never installed.
# KEY=VALUE, sourced by bash 3.2 (ai/lib/profile.sh) and read by ai/lib/ai_profile.py. No spaces around "=".
PROFILE_SCANNERS="skill-scanner"
PROFILE_PACKAGE_AUDIT=0
PROFILE_AUDIT_GATE=0
PROFILE_OPENCODE=0
PROFILE_BOX=0
