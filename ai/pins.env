# ai/pins.env: the ONE place that says where each tool of the `ai` setup comes from (SOURCES file).
# Owner decision 2026-11-14: the setup's own tools follow the NEWEST STABLE release, no cooldown, on every OS.
# Stable = not a pre-release, not a draft, not yanked. ai/lib/resolve.py finds the version (and the commit,
# integrity or checksum) on each install.sh run; every new version still passes agent-audit before it is
# installed (ai/audit-accepted.txt lines are per exact version). What was resolved and installed is in
# ~/.local/state/ai/resolved.json and audit.log.
#
# Lines: <PREFIX>_SOURCE="<type> <name> <channel>"   type: npm | pypi | github (releases) | git (vX.Y.Z tags)
#        <PREFIX>_HOLD=<version>   optional: install exactly this version (a tag or commit for git sources)
#                                  and do not move it. Empty = follow the newest stable. Remove the line to
#                                  let the tool update again. Tool id = prefix in lower case, "_" -> "-".
# Plain KEY=VALUE lines, sourced by bash 3.2 and read by python. No secrets here.
# This file does NOT change the agent rule for project packages (ai/agents-md: exact versions, no @latest).

# ---- harnesses (SPEC 3, 19) ----
CODEX_SOURCE="npm @openai/codex stable"
OMC_SOURCE="npm oh-my-claude-sisyphus stable"          # npm CLI route (AI_OMC_WIRING=cli, Ubuntu only)
OMC_PLUGIN_SOURCE="git https://github.com/Yeachan-Heo/oh-my-claudecode stable"   # Claude plugin route (default)
OMX_SOURCE="npm oh-my-codex stable"
OPENCODE_SOURCE="npm opencode-ai stable"                # closed binary, see SPEC 19
HERDR_SOURCE="github herdrdev/herdr stable"
HERDR_CHECKSUMS=https://herdr.dev/latest.json           # the release has no checksum file: herdr's own manifest

# ---- MCP servers (SPEC 4) ----
SERENA_SOURCE="pypi serena-agent stable"
SERENA_PYTHON=3.13
CONTEXT7_MCP_SOURCE="npm @upstash/context7-mcp stable"  # installed per version folder, no runtime npx
PLAYWRIGHT_MCP_SOURCE="npm @playwright/mcp stable"      # SPEC 21, per project only (ai-start)

# ---- plugins and skills (SPEC 5) ----
PONYTAIL_SOURCE="git https://github.com/DietrichGebert/ponytail stable"
I_HAVE_ADHD_SOURCE="git https://github.com/ayghri/i-have-adhd stable"
GRAPHIFY_SOURCE="pypi graphifyy stable"
CLAUDE_SEO_SOURCE="git https://github.com/AgriciDaniel/claude-seo stable"
CLAUDE_BLOG_SOURCE="git https://github.com/AgriciDaniel/claude-blog stable"
UI_UX_PRO_MAX_SOURCE="git https://github.com/nextlevelbuilder/ui-ux-pro-max-skill stable"   # opt-in per project
MATTPOCOCK_SKILLS_SOURCE="git https://github.com/mattpocock/skills stable"
LLM_WIKI_SOURCE="git https://github.com/atomicstrata/llm-wiki-compiler stable"            # opt-in per project
LAST30DAYS_SOURCE="git https://github.com/mvanhorn/last30days-skill stable"               # Claude plugin, on by default

# ---- CLI tools ----
RTK_SOURCE="github rtk-ai/rtk stable"                  # built from source at the release tag
RTK_CARGO_UPDATE=1                                     # owner 2026-11-12: semver-compatible cargo update before audit + build
NODE_MAJOR_MIN=22
# ---- audit scanners (agent-audit). Bootstrap: they cannot audit themselves (wheels only, sha256 for osv-scanner). ----
GUARDDOG_SOURCE="pypi guarddog stable"
SKILL_SCANNER_SOURCE="pypi cisco-ai-skill-scanner stable"
SKILL_SCANNER_MACOS_LEGACY_VERSION=2.0.14              # macOS < 13 only (platform limit, not a pin): 2.1+ ships macOS 13+ binaries
SCANNER_PYTHON=3.12
OSV_SCANNER_SOURCE="github google/osv-scanner stable"  # binary checked against the release's osv-scanner_SHA256SUMS
GITLEAKS_SOURCE="github gitleaks/gitleaks stable"      # PROPOSED (secret-scan gate, SPEC 17), not installed yet
PYYAML_VERSION=6.0.2                                   # build dependency of ai-render only (uv run --with), kept exact

# ---- dropped and off by default (owner decision 2026-11-14) ----
# Words separated by spaces. A later drop or switch-off is one word here: install.sh acts on these lists and
# ai-doctor checks them. Every removed entry is saved in ~/.local/state/ai/undo/ and uninstall.sh restores it.
AI_DROP_CLAUDE_PLUGINS="caveman@caveman"               # claude plugin uninstall; its marketplace too when no other plugin uses it
AI_DROP_CLAUDE_HOOKS="caveman-activate.js caveman-mode-tracker.js"   # ~/.claude/settings.json hooks whose command has one of these
AI_DROP_MCP="caveman-shrink byterover-mcp"             # user-scope MCP servers: ~/.claude.json and Codex (codex mcp remove)
AI_OFF_CLAUDE_PLUGINS="claude-seo@agricidaniel-claude-seo claude-blog@agricidaniel-blog ui-ux-pro-max@ui-ux-pro-max-skill typesafe@typesafe-ai"   # installed, enabledPlugins false at user scope
