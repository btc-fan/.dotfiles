# Telemetry off, auto-update off, no content upload. One KEY=VALUE per line, no quotes, no spaces.
# install.sh writes these to:
#   ~/.config/ai/env.sh                         (every OS; source it from your shell rc)
#   ~/.claude/settings.json "env"               (Claude and everything it starts: hooks, MCP servers)
#   /etc/profile.d/ai-env.sh + /etc/environment.d/91-ai.conf   (Ubuntu: every user and user services)
# Claude Code (macOS has no managed settings by us; Ubuntu also gets them in managed-settings.json)
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
DISABLE_AUTOUPDATER=1
# Serena, RTK, semgrep (inside guarddog)
SERENA_USAGE_REPORTING=false
RTK_TELEMETRY_DISABLED=1
SEMGREP_SEND_METRICS=off
# graphify: never pick an LLM backend from keys in the environment (contracts-mcp-a finding 1)
GRAPHIFY_BACKEND=none
GRAPHIFY_HOOK_STRICT=0
# oh-my-claudecode: the daily npm ping ignores disableAutoUpdate (SPEC 19)
OMC_UPDATE_REGISTRY_BASE=http://127.0.0.1:9
# oh-my-codex
OMX_AUTO_UPDATE=0
OMX_NATIVE_AUTO_FETCH=0
# opencode
OPENCODE_DISABLE_AUTOUPDATE=1
OPENCODE_DISABLE_MODELS_FETCH=1
OPENCODE_DISABLE_LSP_DOWNLOAD=1
